#!/usr/bin/env bash
# check-generic-math-representation — S0-T1 equal-candidate probe runner for
# the generic-math-types campaign (triga/docs/factory/generic-math-types/).
#
# Executes the source/import/emitter matrix for the three representation
# candidates (alias / direct / wrapper) plus the shared negative and
# gap-probe surfaces. Rows assert the delivery's ideal expectations: a row
# that fails prints the observed command, exit status, and structured
# diagnostic identities, and the run exits non-zero. Observed failures are
# probe evidence for the representation decision record, not runner bugs.
#
# Environment:
#   RADIX_ROOT  (required) assigned committed Radix packet root
#   RADIX_BIN   (required) must canonical-resolve to $RADIX_ROOT/target/debug/radix
#   FABER_BIN   (required) must canonical-resolve to $RADIX_ROOT/target/debug/faber
#
# Temporary output (assembled provider package, emitted sources, compiled
# artifacts) is created only under ${TMPDIR:-/tmp}/triga-generic-math-types/
# and is never committed.
#
# Gates: rustc --edition 2021 --crate-type lib; tsc --noEmit --strict
# --target ES2022 --module ES2022.

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: check-generic-math-representation [--candidate alias|direct|wrapper]
                                          [--matrix] [--all] [-h]
                                          [--selected --operations]
                                          [--selected --targets rust,ts]
                                          [--selected --payload]
                                          [--selected --device-posture]

Options:
  --candidate <name>  run one candidate's source/import/emitter rows
  --matrix            run all three candidates plus negatives and gap probes
  --all               matrix plus every --selected S0-T2 mode
  --selected          run S0-T2 selected-representation rows; requires one of
                      --operations, --targets <list>, --payload, --device-posture
  -h, --help          this message
EOF
}

TRIGA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIXTURES="$TRIGA_ROOT/exempla/conformance/generic-math-types"
WORK_ROOT="${TMPDIR:-/tmp}/triga-generic-math-types"
PROVIDER_PKG="probevectors"
LIBHOME="$WORK_ROOT/libhome"

fail_count=0
declare -a SUMMARY=()

record() {
  # record <pass|fail> <row-id> [evidence lines...]
  local status="$1" row="$2"
  shift 2
  if [[ "$status" == "pass" ]]; then
    echo "[PASS] $row"
  else
    echo "[FAIL] $row"
    fail_count=$((fail_count + 1))
  fi
  local line
  for line in "$@"; do
    [[ -n "$line" ]] && echo "       $line"
  done
  SUMMARY+=("$status $row")
}

first_error_identities() {
  # Print the distinct error[CODE] / error[CODE:issue] identities from a
  # diagnostics stream, capped for readable evidence.
  grep -oE 'error\[[A-Z]+[0-9]+(:[a-z0-9_]+)?\]' | sort -u | head -6
}

# ── environment gates ──────────────────────────────────────────────────────

if [[ -z "${RADIX_ROOT:-}" || -z "${RADIX_BIN:-}" || -z "${FABER_BIN:-}" ]]; then
  echo "check-generic-math-representation: RADIX_ROOT, RADIX_BIN, and FABER_BIN are required" >&2
  exit 2
fi

for tool in rustc tsc; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "check-generic-math-representation: $tool is not on PATH" >&2
    exit 2
  fi
done

canon() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }

for pair in "RADIX_BIN:$RADIX_BIN:$RADIX_ROOT/target/debug/radix" "FABER_BIN:$FABER_BIN:$RADIX_ROOT/target/debug/faber"; do
  var="${pair%%:*}"
  rest="${pair#*:}"
  given="${rest%%:*}"
  expected="${rest#*:}"
  if [[ ! -x "$given" ]]; then
    echo "check-generic-math-representation: $var is not executable: $given" >&2
    exit 2
  fi
  if [[ "$(canon "$given")" != "$(canon "$expected")" ]]; then
    echo "check-generic-math-representation: $var canonical path must be $expected (got $(canon "$given"))" >&2
    exit 2
  fi
done

if [[ ! -d "$FIXTURES" ]]; then
  echo "check-generic-math-representation: missing fixtures at $FIXTURES" >&2
  exit 2
fi

# ── workspace ──────────────────────────────────────────────────────────────

rm -rf "$WORK_ROOT/out"
mkdir -p "$WORK_ROOT/out"
mkdir -p "$LIBHOME/$PROVIDER_PKG/src"

stage_provider() {
  local candidate="$1"
  cp "$FIXTURES/$candidate/provider.fab" "$LIBHOME/$PROVIDER_PKG/src/vectors.fab"
}

write_provider_manifest() {
  cat > "$LIBHOME/$PROVIDER_PKG/faber.toml" <<'EOF'
[package]
name = "probevectors"
version = "0.1.0"

[library]
provider = "probevectors"

[paths]
source = "src"

[build]
kind = "lib"
targets = ["rust", "ts"]
EOF
}

write_provider_manifest

# check_source <label> <file> [extra env...]
check_source() {
  local label="$1" file="$2"
  shift 2
  local out exit_code
  out="$("$@" "$FABER_BIN" check "$file" 2>&1)"
  exit_code=$?
  local identities
  identities="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "$label" "command: faber check $(basename "$file")" "exit: 0"
  else
    record fail "$label" "command: faber check $(basename "$file")" "exit: $exit_code" "errors: ${identities:-none}"
  fi
}

# emit_target <label> <file> <rust|ts> <out-ext> [extra env...]
# On success, writes the artifact and sets EMITTED_ARTIFACT to its path.
emit_target() {
  local label="$1" file="$2" target="$3" ext="$4"
  shift 4
  local artifact="$WORK_ROOT/out/$(basename "$file" .fab).$ext"
  local errfile="$WORK_ROOT/out/$(basename "$file" .fab).$ext.err"
  local err exit_code identities
  "$@" "$RADIX_BIN" emit -t "$target" "$file" > "$artifact" 2> "$errfile"
  exit_code=$?
  err="$(cat "$errfile")"
  if [[ $exit_code -ne 0 ]]; then
    : > "$artifact"
  fi
  identities="$(echo "$err" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -ne 0 ]]; then
    record fail "$label" "command: radix emit -t $target $(basename "$file")" "exit: $exit_code" "errors: ${identities:-none}"
    return 1
  fi
  EMITTED_ARTIFACT="$artifact"
}

# compile_rust <label> <artifact>
compile_rust() {
  local label="$1" artifact="$2"
  local out exit_code
  out="$(rustc --edition 2021 --crate-type lib "$artifact" -o "$WORK_ROOT/out/$(basename "$artifact" .rs).rlib" 2>&1)"
  exit_code=$?
  if [[ $exit_code -eq 0 ]]; then
    record pass "$label" "command: rustc --edition 2021 --crate-type lib $(basename "$artifact")" "exit: 0"
  else
    record fail "$label" "command: rustc --edition 2021 --crate-type lib $(basename "$artifact")" "exit: $exit_code" "first: $(echo "$out" | grep -E '^error' | head -2 | tr '\n' ' ')"
  fi
}

# compile_ts <label> <artifact>
compile_ts() {
  local label="$1" artifact="$2"
  # Emitted library-mode TS imports "@faber/runtime" helpers (e.g.
  # `__faberDisplay`). tsc on a bare file cannot resolve a package import,
  # which surfaces as a harness TS2307 artifact — same family as the T1R
  # provider-module staging fix. Stage a minimal ambient module so the
  # compile measures emitted source, not packaging.
  mkdir -p "$WORK_ROOT/out/node_modules/@faber/runtime"
  cat > "$WORK_ROOT/out/node_modules/@faber/runtime/package.json" <<'EOF'
{
  "name": "@faber/runtime",
  "version": "0.0.0",
  "types": "./index.d.ts"
}
EOF
  cat > "$WORK_ROOT/out/node_modules/@faber/runtime/index.d.ts" <<'EOF'
// Minimal ambient surface for emitted @faber/runtime imports (staged by the
// checker; the real runtime package is not part of this proof).
export declare function __faberDisplay(...values: unknown[]): string;
EOF
  local out exit_code
  out="$(tsc --noEmit --strict --target ES2022 --module ES2022 "$artifact" 2>&1)"
  exit_code=$?
  if [[ $exit_code -eq 0 ]]; then
    record pass "$label" "command: tsc --noEmit --strict --target ES2022 --module ES2022 $(basename "$artifact")" "exit: 0"
  else
    record fail "$label" "command: tsc --noEmit --strict --target ES2022 --module ES2022 $(basename "$artifact")" "exit: $exit_code" "first: $(echo "$out" | grep -E 'error TS' | head -2 | tr '\n' ' ')"
  fi
}

# ── candidate pass ─────────────────────────────────────────────────────────

run_candidate() {
  local candidate="$1"
  echo ""
  echo "== candidate: $candidate =="
  stage_provider "$candidate"

  check_source "$candidate source/provider" "$FIXTURES/$candidate/provider.fab"
  check_source "$candidate source/consumer(imported)" "$FIXTURES/$candidate/consumer.fab" env FABER_LIBRARY_HOME="$LIBHOME"

  if emit_target "$candidate rust/provider-emit" "$FIXTURES/$candidate/provider.fab" rust rs; then
    compile_rust "$candidate rust/provider-compile" "$EMITTED_ARTIFACT"
  fi
  if emit_target "$candidate rust/consumer-emit" "$FIXTURES/$candidate/consumer.fab" rust rs env FABER_LIBRARY_HOME="$LIBHOME"; then
    compile_rust "$candidate rust/consumer-compile" "$EMITTED_ARTIFACT"
  fi
  if emit_target "$candidate ts/provider-emit" "$FIXTURES/$candidate/provider.fab" ts ts; then
    compile_ts "$candidate ts/provider-compile" "$EMITTED_ARTIFACT"
    # The emitted TS consumer imports the library module name
    # ("probevectors:vectors" -> ./probevectors-vectors.js), not the input
    # basename. Stage the emitted provider under that module name so the
    # consumer compile measures the emitted source, not harness file naming.
    # Rust consumers inline the provider (pub mod gmt) and need no staging.
    cp "$EMITTED_ARTIFACT" "$WORK_ROOT/out/$PROVIDER_PKG-vectors.ts"
  fi
  if emit_target "$candidate ts/consumer-emit" "$FIXTURES/$candidate/consumer.fab" ts ts env FABER_LIBRARY_HOME="$LIBHOME"; then
    compile_ts "$candidate ts/consumer-compile" "$EMITTED_ARTIFACT"
  fi
}

# ── negatives ──────────────────────────────────────────────────────────────

run_negatives() {
  echo ""
  echo "== negatives (expected: source-typecheck rejection with structured identity) =="

  local negative identity out exit_code
  for negative in vector-width matrix-shape box-width generic-kind; do
    out="$("$FABER_BIN" check "$FIXTURES/negative/$negative.fab" 2>&1)"
    exit_code=$?
    identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
    if [[ $exit_code -ne 0 && -n "$identity" ]]; then
      # The mismatch rejected in Faber analysis, never deferred to rustc/tsc.
      record pass "negative/$negative" "command: faber check $negative.fab" "exit: $exit_code" "errors: $identity"
    else
      record fail "negative/$negative" "command: faber check $negative.fab" "exit: $exit_code" "errors: ${identity:-none}"
    fi
  done
}

# ── gap probes ─────────────────────────────────────────────────────────────
# Ideal expectations: each form analyzes green. Today's observed failures
# carry the diagnostic identity that routes the narrow Radix unit.

run_gap_probes() {
  echo ""
  echo "== gap probes (ideal: green; observed failures are routed evidence) =="
  local probe out exit_code identity
  probe="$WORK_ROOT/out/gap-box-applied.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

class Gen<size N> {
    vector<f32, N> lanes
}

fn make(vector<f32, 3> lanes) → Gen<3> {
    return Gen<3> { lanes = lanes }
}
EOF
  out="$("$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/box-applied-construction" "exit: 0"
  else
    record fail "gap/box-applied-construction" "command: faber check gap-box-applied.fab" "exit: $exit_code" "errors: $identity"
  fi

  probe="$WORK_ROOT/out/gap-box-bare.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

class Gen<size N> {
    vector<f32, N> lanes
}

fn make(vector<f32, 3> lanes) → Gen<3> {
    return Gen { lanes = lanes }
}
EOF
  out="$("$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/box-bare-construction" "exit: 0"
  else
    record fail "gap/box-bare-construction" "command: faber check gap-box-bare.fab" "exit: $exit_code" "errors: $identity"
  fi

  probe="$WORK_ROOT/out/gap-generic-glyph.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

fn multiply<size R, size K, size C>(matrix<f32, [R, K]> a, matrix<f32, [K, C]> b) → matrix<f32, [R, C]> {
    return a · b
}
EOF
  out="$("$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/generic-glyph-matmul" "exit: 0"
  else
    record fail "gap/generic-glyph-matmul" "command: faber check gap-generic-glyph.fab" "exit: $exit_code" "errors: $identity"
  fi

  # The alias-assignment probe stages a minimal green alias provider: the
  # candidate alias provider is red and would mask the boundary with
  # propagated diagnostics. The probe assigns a builtin outer product to an
  # alias-annotated local — the transparency claim under test.
  cat > "$LIBHOME/$PROVIDER_PKG/src/vectors.fab" <<'EOF'
+++
locale = "en"
+++

@ public
type Matrix<size R, size C> = matrix<f32, [R, C]>
EOF
  probe="$WORK_ROOT/out/gap-alias-assignment.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

import from "probevectors:vectors" gmt

fn probe() → gmt.Matrix<4, 3> {
    const vector<f32, 4> s ← [1.0, 2.0, 3.0, 4.0] ↦ vector<f32, 4>
    const vector<f32, 3> wide ← [1.0, 2.0, 3.0] ↦ vector<f32, 3>
    const gmt.Matrix<4, 3> outer ← s ⊗ wide
    panic "signature probe"
}
EOF
  out="$(env FABER_LIBRARY_HOME="$LIBHOME" "$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/alias-assignment-transparency" "exit: 0"
  else
    record fail "gap/alias-assignment-transparency" "command: faber check gap-alias-assignment.fab" "exit: $exit_code" "errors: $identity"
  fi
}

# ── S0-T2 selected-representation rows ─────────────────────────────────────
# The selected representation is DIRECT NATIVE TYPES (representation-
# decision.md §1): vector<f32, N> / matrix<f32, [R, C]> carriers with
# dimension-neutral Triga free operations and the Box<N> nominal genus.
# Fixtures live in exempla/conformance/generic-math-types/selected/.

SELECTED_FIXTURES="$FIXTURES/selected"
DECISION_DOC="$TRIGA_ROOT/docs/factory/generic-math-types/representation-decision.md"
MIGRATION_DOC="$TRIGA_ROOT/docs/factory/generic-math-types/migration-map.md"

# decision_rows <mode...> — done_when (5)/(9): each selected mode's proof
# must be recorded in the decision doc; a missing row is a checker FAIL.
decision_rows() {
  local row grep_pattern
  while [[ $# -gt 0 ]]; do
    row="$1"
    shift
    case "$row" in
      operations) grep_pattern='S0-T2 operations' ;;
      targets) grep_pattern='S0-T2 rust/typescript' ;;
      payload) grep_pattern='S0-T2 host payload' ;;
      device) grep_pattern='S0-T2 device posture' ;;
      residual) grep_pattern='N1' ;;
      *) grep_pattern="$row" ;;
    esac
    if [[ -f "$DECISION_DOC" ]] && grep -q "$grep_pattern" "$DECISION_DOC"; then
      record pass "decision/row-$row" "pattern: $grep_pattern in representation-decision.md"
    else
      record fail "decision/row-$row" "pattern: $grep_pattern missing from representation-decision.md"
    fi
  done
}

# migration_freeze — done_when (6)/(9): the frozen map must exist with no
# TBD rows and no compatibility destinations. Absent map = routed stop.
migration_freeze() {
  if [[ ! -f "$MIGRATION_DOC" ]]; then
    record fail "migration/map-frozen" "no migration-map.md — S0-T2 stopped on the proven compiler prerequisite (see representation-decision.md §7); freeze resumes after Mind's narrow Radix units land"
    return
  fi
  local tbd
  tbd="$(grep -cE 'TBD' "$MIGRATION_DOC" || true)"
  if [[ "$tbd" -ne 0 ]]; then
    record fail "migration/map-frozen" "migration-map.md carries $tbd TBD row(s)"
  else
    record pass "migration/map-frozen" "migration-map.md present with zero TBD rows"
  fi
}

# numbered_spelling_scan — done_when (9): no numbered compatibility
# spelling may exist in the selected fixtures or the decision doc.
numbered_spelling_scan() {
  local hits
  hits="$(grep -nE '\b(vector[234]|matrix[34]_|box3_|Vector[234]|Matrix[34]|Box3)[a-z_]*\(' \
    "$SELECTED_FIXTURES"/*.fab "$DECISION_DOC" 2>/dev/null || true)"
  if [[ -n "$hits" ]]; then
    record fail "selected/numbered-spelling" "numbered compatibility spelling observed:" "$(echo "$hits" | head -3)"
  else
    record pass "selected/numbered-spelling" "no numbered constructor/helper spelling in selected fixtures or decision doc"
  fi
}

run_selected_operations() {
  echo ""
  echo "== selected: operations (S0-T2 done_when 1-2) =="

  if [[ ! -f "$SELECTED_FIXTURES/operations.fab" ]]; then
    record fail "selected operations/source" "missing fixture: $SELECTED_FIXTURES/operations.fab"
    return
  fi
  check_source "selected operations/source" "$SELECTED_FIXTURES/operations.fab"

  # The compile-time mismatch side stays red while positives are green.
  run_negatives

  decision_rows operations residual
  numbered_spelling_scan
  migration_freeze
}

run_selected_targets() {
  echo ""
  echo "== selected: rust + typescript emission (S0-T2 done_when 2) =="

  local fixture artifact ext compiler_out exit_code
  for fixture in operations payload; do
    if [[ ! -f "$SELECTED_FIXTURES/$fixture.fab" ]]; then
      record fail "selected $fixture/rust-provider-emit" "missing fixture: $SELECTED_FIXTURES/$fixture.fab"
      continue
    fi
    if emit_target "selected $fixture/rust-emit" "$SELECTED_FIXTURES/$fixture.fab" rust rs; then
      artifact="$EMITTED_ARTIFACT"
      compile_rust "selected $fixture/rust-compile" "$artifact"
    fi
    if emit_target "selected $fixture/ts-emit" "$SELECTED_FIXTURES/$fixture.fab" ts ts; then
      artifact="$EMITTED_ARTIFACT"
      compile_ts "selected $fixture/ts-compile" "$artifact"
    fi
  done
  decision_rows targets
}

run_selected_payload() {
  echo ""
  echo "== selected: host payload proof (S0-T2 done_when 3) =="

  if [[ ! -f "$SELECTED_FIXTURES/payload.fab" ]]; then
    record fail "selected payload/source" "missing fixture: $SELECTED_FIXTURES/payload.fab"
    return
  fi
  check_source "selected payload/source" "$SELECTED_FIXTURES/payload.fab"

  # Count/layout oracle: the fixture's own asserts prove 32 f32 / 128
  # bytes, model-then-view-projection order, and column-major placement
  # under the MIR runner. A failing assert exits non-zero.
  local out exit_code
  out="$("$FABER_BIN" run "$SELECTED_FIXTURES/payload.fab" 2>&1)"
  exit_code=$?
  if [[ $exit_code -eq 0 ]]; then
    record pass "selected payload/count-layout" "command: faber run payload.fab" "exit: 0" "floats: $(echo "$out" | tail -1)"
  else
    record fail "selected payload/count-layout" "command: faber run payload.fab" "exit: $exit_code" "output: $(echo "$out" | grep -E 'error|assert' | head -2)"
  fi
  decision_rows payload
}

run_selected_device_posture() {
  echo ""
  echo "== selected: device posture (S0-T2 done_when 4) =="

  if [[ ! -f "$SELECTED_FIXTURES/device.fab" ]]; then
    record fail "selected device/source" "missing fixture: $SELECTED_FIXTURES/device.fab"
    return
  fi
  check_source "selected device/source" "$SELECTED_FIXTURES/device.fab"

  # Either a validated emission or a structured pre-artifact rejection.
  # Overclaim fails: silent success without target markers, or a
  # rejection without a code+issue identity.
  local target marker artifact err exit_code identities size
  for target in wgsl-text metal-text; do
    case "$target" in
      wgsl-text) marker='@compute\|@group' ;;
      metal-text) marker='kernel void\|#include <metal_stdlib>' ;;
    esac
    artifact="$WORK_ROOT/out/device.$target.out"
    err="$WORK_ROOT/out/device.$target.err"
    "$RADIX_BIN" emit -t "$target" "$SELECTED_FIXTURES/device.fab" > "$artifact" 2> "$err"
    exit_code=$?
    identities="$(cat "$err" | first_error_identities | tr '\n' ' ')"
    size="$(wc -c < "$artifact" | tr -d ' ')"
    if [[ $exit_code -eq 0 ]]; then
      if grep -qE "$marker" "$artifact"; then
        record pass "selected device/$target-emits-validated" "exit: 0" "artifact bytes: $size" "markers: $marker"
      else
        record fail "selected device/$target-overclaim" "exit: 0 but artifact lacks $marker markers — unvalidated success"
      fi
    elif [[ -n "$identities" && "$size" -eq 0 ]]; then
      record pass "selected device/$target-fails-closed" "exit: $exit_code" "errors: $identities" "artifact bytes: 0 (rejected before artifact use)"
    else
      record fail "selected device/$target-overclaim" "exit: $exit_code" "errors: ${identities:-none}" "artifact bytes: $size — rejection is not structured-and-empty"
    fi
  done
  decision_rows device
}

# S0-T2 gap probes: ideal expectations are green; observed failures carry
# the identity that routes the narrow Radix unit (decision §7 N1-N3).
run_selected_gap_probes() {
  echo ""
  echo "== selected gap probes (ideal: green; observed failures are routed evidence) =="

  local probe out exit_code identity

  probe="$WORK_ROOT/out/s0t2-gap-parametric-normalize.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

fn normata<size N>(vector<f32, N> v) → vector<f32, N> {
    return v.normalize()
}
EOF
  out="$("$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/parametric-normalize" "exit: 0"
  else
    record fail "gap/parametric-normalize" "command: faber check s0t2-gap-parametric-normalize.fab" "exit: $exit_code" "errors: $identity"
  fi

  probe="$WORK_ROOT/out/s0t2-gap-parametric-scale.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

fn scala<size N>(vector<f32, N> v, f32 s) → vector<f32, N> {
    const vector<f32, 1> w ← [s] ↦ vector<f32, 1>
    const vector<f32, 1> unus ← [1.0] ↦ vector<f32, 1>
    return (v ⊗ w).apply(unus)
}
EOF
  out="$("$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/parametric-scalar-scale" "exit: 0"
  else
    record fail "gap/parametric-scalar-scale" "command: faber check s0t2-gap-parametric-scale.fab" "exit: $exit_code" "errors: $identity"
  fi

  probe="$WORK_ROOT/out/s0t2-gap-lane-index.fab"
  cat > "$probe" <<'EOF'
+++
locale = "en"
+++

fn lane<size N>(vector<f32, N> v, int index) → f32 {
    return v[index]
}
EOF
  out="$("$FABER_BIN" check "$probe" 2>&1)"
  exit_code=$?
  identity="$(echo "$out" | first_error_identities | tr '\n' ' ')"
  if [[ $exit_code -eq 0 ]]; then
    record pass "gap/parametric-lane-index" "exit: 0"
  else
    record fail "gap/parametric-lane-index" "command: faber check s0t2-gap-lane-index.fab" "exit: $exit_code" "errors: $identity"
  fi

  probe="$WORK_ROOT/out/s0t2-gap-matrix-materialize.fab"
  cat > "$probe" <<'EOF'
+++
