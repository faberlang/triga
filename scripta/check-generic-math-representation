# ── args ───────────────────────────────────────────────────────────────────

MODE=""
SELECTED_MODE=""
SELECTED_TARGETS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --candidate)
      shift
      if [[ $# -eq 0 ]]; then
        echo "error: --candidate requires alias|direct|wrapper" >&2
        exit 2
      fi
      if [[ ! "$1" =~ ^(alias|direct|wrapper)$ ]]; then
        echo "error: unknown candidate: $1" >&2
        exit 2
      fi
      MODE="candidate"
      CANDIDATE="$1"
      shift
      ;;
    --matrix)
      MODE="matrix"
      shift
      ;;
    --selected)
      MODE="selected"
      shift
      ;;
    --operations)
      SELECTED_MODE="operations"
      shift
      ;;
    --targets)
      shift
      if [[ $# -eq 0 ]]; then
        echo "error: --targets requires a comma list (rust,ts)" >&2
        exit 2
      fi
      SELECTED_MODE="targets"
      SELECTED_TARGETS="$1"
      shift
      ;;
    --payload)
      SELECTED_MODE="payload"
      shift
      ;;
    --device-posture)
      SELECTED_MODE="device"
      shift
      ;;
    --all)
      MODE="all"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$MODE" ]]; then
  usage >&2
  exit 2
fi

if [[ "$MODE" == "selected" && -z "$SELECTED_MODE" ]]; then
  echo "error: --selected requires --operations, --targets <list>, --payload, or --device-posture" >&2
  exit 2
fi

if [[ -n "$SELECTED_MODE" && "$MODE" != "selected" && "$MODE" != "all" ]]; then
  echo "error: --$SELECTED_MODE belongs with --selected (or --all)" >&2
  exit 2
fi

if [[ "$SELECTED_MODE" == "targets" && "$SELECTED_TARGETS" != "rust,ts" ]]; then
  echo "error: --selected --targets supports exactly rust,ts (got: $SELECTED_TARGETS)" >&2
  exit 2
fi

echo "check-generic-math-representation — S0-T1 equal-candidate probe + S0-T2 selected proof"
echo "triga HEAD: $(git -C "$TRIGA_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
echo "radix HEAD: $(git -C "$RADIX_ROOT" rev-parse HEAD 2>/dev/null || echo unknown) (RADIX_ROOT pin)"
echo "work root:  $WORK_ROOT"

if [[ "$MODE" == "candidate" ]]; then
  run_candidate "$CANDIDATE"
elif [[ "$MODE" == "selected" ]]; then
  case "$SELECTED_MODE" in
    operations) run_selected_operations ;;
    targets) run_selected_targets ;;
    payload) run_selected_payload ;;
    device) run_selected_device_posture ;;
  esac
  run_selected_gap_probes
else
  run_candidate alias
  run_candidate direct
  run_candidate wrapper
  run_negatives
  run_gap_probes
  run_selected_operations
  run_selected_targets
  run_selected_payload
  run_selected_device_posture
  run_selected_gap_probes
fi

echo ""
echo "== summary =="
printf '%s\n' "${SUMMARY[@]}"
echo ""
if [[ $fail_count -eq 0 ]]; then
  echo "result: all executed rows met the delivery's expectations"
  exit 0
fi
echo "result: $fail_count row(s) failed the delivery's expectations — recorded as probe evidence (see docs/factory/generic-math-types/representation-decision.md)"
exit 1
