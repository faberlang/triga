#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FABER_LIBRARY_HOME="$(cd "${FABER_LIBRARY_HOME:-$ROOT/..}" && pwd)"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$(cd "$RADIX_ROOT" && pwd)"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$(cd "$ROOT/../radix" && pwd)"
else
  RADIX="$(cd "$ROOT/../../../radix" && pwd)"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-compile: missing radix checkout at $RADIX" >&2
  exit 1
fi

# Sibling product CLI: FABER_BIN, else release then debug under the library home.
# Do not require a public ../faber/Cargo.toml checkout.
if [[ -z "${FABER_BIN:-}" ]]; then
  if [[ -x "$FABER_LIBRARY_HOME/radix/target/release/faber" ]]; then
    FABER_BIN="$FABER_LIBRARY_HOME/radix/target/release/faber"
  elif [[ -x "$FABER_LIBRARY_HOME/radix/target/debug/faber" ]]; then
    FABER_BIN="$FABER_LIBRARY_HOME/radix/target/debug/faber"
  else
    echo "check-compile: missing faber binary (set FABER_BIN or build $FABER_LIBRARY_HOME/radix/target/{release,debug}/faber)" >&2
    exit 1
  fi
fi

if [[ "$FABER_BIN" != /* ]]; then
  FABER_BIN="$(cd "$(dirname "$FABER_BIN")" && pwd)/$(basename "$FABER_BIN")"
fi

if [[ ! -x "$FABER_BIN" ]]; then
  echo "check-compile: faber binary not executable: $FABER_BIN" >&2
  exit 1
fi

# Child rungs still resolve a public-faber Cargo.toml unless FABER_ROOT is set.
# Point them at the sibling product crate so those rungs still run.
export FABER_ROOT="${FABER_ROOT:-$RADIX/crates/faber}"

RADIX_BIN="${RADIX_BIN:-$RADIX/target/debug/radix}"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix-module --bin radix)
  RADIX_BIN="$RADIX/target/debug/radix"
fi

if [[ ! -x "$RADIX_BIN" ]]; then
  echo "check-compile: radix binary not executable: $RADIX_BIN" >&2
  exit 1
fi

# The triga package now reads English (faber.toml `[reader] locale = "en"`);
# the radix CLI defaults to Latin, so the en reader locale must be passed
# explicitly for each single-file check (--locale, formerly --locale-pack).

export FABER_LIBRARY_HOME
export RADIX_ROOT="$RADIX"
export FABER_BIN

echo "check-compile: parsing leaf modules"
leaf_count=0
while IFS= read -r -d '' leaf; do
  rel="${leaf#"$ROOT/"}"
  echo "check-compile: parsing $rel"
  "$RADIX_BIN" check --locale en "$leaf"
  leaf_count=$((leaf_count + 1))
done < <(find "$ROOT/src" -type f -name '*.fab' -print0 | LC_ALL=C sort -z)

if [[ "$leaf_count" -eq 0 ]]; then
  echo "check-compile: find discovered no src/**/*.fab leaves" >&2
  exit 1
fi
echo "check-compile: parsed $leaf_count live leaves"

echo "check-compile: checking geometry attribute exemplar"
  "$FABER_BIN" check "$ROOT/exempla/triga-geometry-attributes.fab"

echo "check-compile: checking Stage 4 source-owned facts exemplar"
  "$FABER_BIN" check "$ROOT/exempla/triga-stage4-source-facts.fab"

echo "check-compile: checking Hello Voxel first-draw facts exemplar"
  "$FABER_BIN" check "$ROOT/exempla/hello-voxel-first-draw-facts.fab"

echo "check-compile: checking Hello Voxel shaders exemplar"
  "$FABER_BIN" check "$ROOT/exempla/triga-hello-voxel-shaders.fab"

echo "check-compile: checking Hello Voxel pipeline exemplar"
  "$FABER_BIN" check "$ROOT/exempla/triga-hello-voxel-pipeline.fab"

echo "check-compile: checking vertex-fragment stub"
  "$FABER_BIN" check "$ROOT/exempla/triga-vertex-fragment-stub.fab"

echo "check-compile: checking scene-store exemplar"
  "$FABER_BIN" check "$ROOT/exempla/triga-scene-store.fab"

echo "check-compile: checking scene-store exemplar through Faber provider path"
(cd "$ROOT" && "$FABER_BIN" check "$ROOT/exempla/triga-scene-store.fab")

# Scene-store acceptance vs the current faber tips: un-targeted `faber run
# --compile` on a manifest package routes to the store-based FHIR package
# route (faber 6e243e7 portable default). The FHIR dependency-record
# validation (faber src/package/fhir.rs) correctly rejects the library's own
# self-exempla: exempla/triga-scene-store.fab imports triga:* and the triga
# manifest (a library, not a consumer) declares no `[dependencies] triga`
# record — and even a declared record cannot make the FHIR *run* work for a
# library's own exempla (faber.lock + store libs/triga closure required).
# The FHIR validation is a real invariant and is NOT weakened. The
# generated-Rust *run* is separately blocked by the acknowledged radix Rust
# emitter E0308 regression (compiler-lane ledger E0308; owned by the 80
# generated-Rust lane), so the acceptance here is the faber default package
# route's FHIR envelope build (analyze + encode), which is green.
echo "check-compile: building scene-store FHIR package envelope (faber default route; run not applicable to library self-exempla)"
(cd "$ROOT" && "$FABER_BIN" build "$ROOT/exempla/triga-scene-store.fab")

"$ROOT/scripta/check-transforms"
"$ROOT/scripta/check-exempla-inventory"
