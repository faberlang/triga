#!/usr/bin/env bash
# Package-aware transform-chain gate.
# Math leaf lives in src/math.fab; workload is exempla/triga-transforms.fab
# (imports triga:math). Do not cat a combined flat source — the facade
# src/triga.fab holds no genera.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-transforms: missing radix checkout at $RADIX" >&2
  exit 1
fi

if [[ -n "${FABER_ROOT:-}" ]]; then
  FABER="$FABER_ROOT"
elif [[ -f "$ROOT/../faber/Cargo.toml" ]]; then
  FABER="$ROOT/../faber"
else
  FABER="$ROOT/../../../faber"
fi

if [[ ! -f "$FABER/Cargo.toml" ]]; then
  echo "check-transforms: missing faber checkout at $FABER" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

export FABER_LIBRARY_HOME
export RADIX_ROOT="$RADIX"

echo "check-transforms: parsing src/math.fab"
"$RADIX_BIN" check "$ROOT/src/math.fab"

echo "check-transforms: package check exempla/triga-transforms.fab"
(cd "$ROOT" && cargo run -q --manifest-path "$FABER/Cargo.toml" -- check exempla/triga-transforms.fab)

echo "check-transforms: ok"
