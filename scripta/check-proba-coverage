#!/usr/bin/env bash
#
# Run every co-located Triga proba through the package-aware Faber runner and
# refresh the Stage-0.5 section of proof/coverage-scorecard.json.
#
# The gate writes its receipt before returning a non-zero status.  A parse,
# semantic, MIR, runner, or inventory red is evidence, not permission to turn
# a row into a skip.

set -u -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 - "$ROOT" "$@" <<'PY'
from __future__ import annotations

import datetime as dt
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
from collections import Counter
from typing import Any

ROOT = Path(sys.argv[1]).resolve()
SRC = ROOT / "src"
SCORECARD = ROOT / "proof" / "coverage-scorecard.json"
INVENTORY = ROOT / "proof" / "inventory" / "triga-inventory.json"
EXPECTED_MODULE_COUNT = 26
EXPECTED_TIER = "executed-proba"

CASE_RE = re.compile(r'^\s*test\s+"')
GROUP_RE = re.compile(r'^\s*describe\s+"')
DIAGNOSTIC_RE = re.compile(r'\b[A-Z][A-Z0-9]+(?:\.[a-z][a-z0-9_]*)?\b')
SUMMARY_RE = re.compile(
    r"test result:\s*(?P<outcome>[A-Za-z_-]+).*?"
    r"(?P<passed>\d+)\s+passed[,;]\s*"
    r"(?P<failed>\d+)\s+failed[,;]\s*"
    r"(?P<skipped>\d+)\s+skipped",
    re.IGNORECASE | re.DOTALL,
)


def rel(path: Path) -> str:
    return path.relative_to(ROOT).as_posix()


def load_json(path: Path) -> tuple[dict[str, Any] | None, str | None]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return None, f"cannot load {rel(path)}: {exc}"
    if not isinstance(value, dict):
        return None, f"{rel(path)} must contain a JSON object"
    return value, None


def unique_lines(lines: list[str], limit: int = 12) -> list[str]:
    result: list[str] = []
    seen: set[str] = set()
    for line in lines:
        value = line.strip()
        if not value or value in seen:
            continue
        seen.add(value)
        result.append(value)
        if len(result) == limit:
            break
    return result


def diagnostic_counts(output: str) -> dict[str, int]:
    counts: Counter[str] = Counter()
    for line in output.splitlines():
        if not re.search(r"\berror:", line, re.IGNORECASE):
            continue
        for code in DIAGNOSTIC_RE.findall(line):
            if re.match(r"^(?:PARSE|SEM|MIR|LOCALE|PKG|RUN|CODEGEN)\d", code):
                counts[code] += 1
    return dict(sorted(counts.items()))


def error_lines(output: str) -> list[str]:
    return unique_lines(
        [line for line in output.splitlines() if re.search(r"\berror:", line, re.IGNORECASE)]
    )


def parse_summary(output: str) -> dict[str, Any] | None:
    match = SUMMARY_RE.search(output)
    if not match:
        return None
    return {
        "outcome": match.group("outcome").lower(),
        "passed": int(match.group("passed")),
        "failed": int(match.group("failed")),
        "skipped": int(match.group("skipped")),
    }


def proba_shape(path: Path) -> dict[str, int]:
    text = path.read_text(encoding="utf-8")
    return {
        "lines": len(text.splitlines()),
        "groups": sum(1 for line in text.splitlines() if GROUP_RE.search(line)),
        "cases": sum(1 for line in text.splitlines() if CASE_RE.search(line)),
    }


def command_text(command: list[str]) -> str:
    return shlex.join(command)


def run_one(
    module_path: Path,
    proba_path: Path,
    faber: Path,
    library_home: Path,
    package_path: Path,
    timeout_seconds: float,
) -> dict[str, Any]:
    module_name = rel(module_path)
    proba_name = rel(proba_path)
    declared = proba_shape(proba_path)
    command = [str(faber), "test", str(package_path), "--filter", proba_name]
    base: dict[str, Any] = {
        "proba_path": proba_name,
        "case_count": declared["cases"],
        "command": command,
        "command_text": command_text(command),
        "exit_status": None,
        "passed": None,
        "failed": None,
        "skipped": None,
        "status": None,
        "evidence_tier": "structural",
        "diagnostic_codes": {},
        "failures": [],
    }

    if declared["cases"] == 0:
        base["status"] = "count-only"
        base["failures"] = ["proba source declares zero test cases"]
        return base

    if not faber.is_file() or not os.access(faber, os.X_OK):
        base["status"] = "unresolved-prerequisite"
        base["failures"] = [f"Faber binary is not executable: {faber}"]
        return base

    environment = os.environ.copy()
    environment["FABER_LIBRARY_HOME"] = str(library_home)
    try:
        completed = subprocess.run(
            command,
            cwd=ROOT,
            env=environment,
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as exc:
        output = "\n".join(
            part.decode(errors="replace") if isinstance(part, bytes) else part
            for part in (exc.stdout or "", exc.stderr or "")
        )
        base["status"] = "timeout"
        base["failures"] = [f"runner timed out after {timeout_seconds:g}s"]
        base["diagnostic_codes"] = diagnostic_counts(output)
        return base
    except OSError as exc:
        base["status"] = "unresolved-prerequisite"
        base["failures"] = [f"could not execute Faber: {exc}"]
        return base

    output = completed.stdout + ("\n" if completed.stdout and completed.stderr else "") + completed.stderr
    summary = parse_summary(output)
    base["exit_status"] = completed.returncode
    base["diagnostic_codes"] = diagnostic_counts(output)
    base["failures"] = error_lines(output)
    if not base["failures"] and completed.returncode != 0:
        base["failures"] = unique_lines(output.splitlines())[-3:]

    if summary is None:
        # A zero exit without a runner result is not execution evidence.  This
        # also catches a command that only counted or parsed the source.
        base["status"] = "analysis-error" if completed.returncode != 0 else "count-only"
        if not base["failures"]:
            base["failures"] = [
                "runner emitted no `test result` summary; parse/analysis or count-only result"
            ]
        return base

    base["passed"] = summary["passed"]
    base["failed"] = summary["failed"]
    base["skipped"] = summary["skipped"]
    all_cases_passed = (
        completed.returncode == 0
        and summary["outcome"] in {"pass", "passed", "ok", "success", "successful"}
        and summary["passed"] == declared["cases"]
        and summary["failed"] == 0
        and summary["skipped"] == 0
    )
    if all_cases_passed:
        base["status"] = "passed"
        base["evidence_tier"] = EXPECTED_TIER
        return base

    base["status"] = "runner-failure" if completed.returncode != 0 else "failed-cases"
    if summary["passed"] != declared["cases"]:
        base["failures"].append(
            f"runner reported {summary['passed']} passed for {declared['cases']} declared cases"
        )
    if summary["failed"] or summary["skipped"]:
        base["failures"].append(
            f"runner summary: {summary['failed']} failed; {summary['skipped']} skipped"
        )
    base["failures"] = unique_lines(base["failures"])
    return base


def row_for_scorecard(
    existing: dict[str, Any], module_path: Path, proba_path: Path | None, execution: dict[str, Any]
) -> dict[str, Any]:
    row = dict(existing)
    module_name = rel(module_path)
    row["path"] = module_name
    # The old fields remain the Stage-0 structural frame.  Stage-0.5 evidence
    # lives in proba_execution so it cannot be mistaken for inventory data.
    row["proba_execution"] = execution
    row["evidence_tier"] = execution["evidence_tier"]
    if proba_path is not None:
        proba_name = rel(proba_path)
        shape = proba_shape(proba_path)
        row["co_located_proba_refs"] = [proba_name]
        row["co_located_proba"] = {
            "module": module_name,
            **shape,
        }
        row["proba_execution"]["proba_path"] = proba_name
    else:
        row["co_located_proba_refs"] = []
        row["co_located_proba"] = None
    return row


def main() -> int:
    errors: list[str] = []
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    scorecard, scorecard_error = load_json(SCORECARD)
    if scorecard_error:
        errors.append(scorecard_error)
        scorecard = {}
    inventory, inventory_error = load_json(INVENTORY)
    if inventory_error:
        errors.append(inventory_error)
        inventory = None

    modules = sorted(SRC.rglob("*.fab"), key=rel) if SRC.is_dir() else []
    probas = sorted(SRC.rglob("*.proba"), key=rel) if SRC.is_dir() else []
    module_names = sorted(rel(path) for path in modules)
    proba_names = sorted(rel(path) for path in probas)
    if len(modules) != EXPECTED_MODULE_COUNT:
        errors.append(
            f"live module discovery found {len(modules)} .fab files; expected {EXPECTED_MODULE_COUNT}"
        )
    if len(probas) != EXPECTED_MODULE_COUNT:
        errors.append(
            f"live proba discovery found {len(probas)} .proba files; expected {EXPECTED_MODULE_COUNT}"
        )
    if len(set(module_names)) != len(module_names):
        errors.append("live module discovery contains duplicate paths")
    if len(set(proba_names)) != len(proba_names):
        errors.append("live proba discovery contains duplicate paths")

    expected_by_module: dict[str, Path] = {}
    missing_proba: list[str] = []
    for module in modules:
        expected = module.with_suffix(".proba")
        expected_by_module[rel(module)] = expected
        if not expected.is_file():
            missing_proba.append(rel(expected))
    orphan_proba = sorted(
        name for name in proba_names if name not in {rel(path) for path in expected_by_module.values()}
    )
    if missing_proba:
        errors.extend(f"missing sibling proba: {name}" for name in missing_proba)
    if orphan_proba:
        errors.extend(f"orphan proba has no sibling module: {name}" for name in orphan_proba)

    if inventory is not None:
        inventory_paths = sorted(
            record.get("path")
            for record in inventory.get("modules", [])
            if isinstance(record, dict) and isinstance(record.get("path"), str)
        )
        if inventory_paths != module_names:
            errors.append(
                "inventory module set does not equal live src/**/*.fab; "
                "the inventory is foreign or stale and was not modified"
            )

    faber_value = os.environ.get("FABER_BIN")
    library_value = os.environ.get("FABER_LIBRARY_HOME")
    library_home = Path(library_value).expanduser().resolve() if library_value else ROOT.parent.resolve()
    faber = Path(faber_value).expanduser().resolve() if faber_value else library_home / "radix" / "target" / "debug" / "faber"
    timeout_seconds = float(os.environ.get("PROBA_TIMEOUT_SECONDS", "180"))
    package_path = ROOT.resolve()

    existing_rows = {
        row.get("path"): row
        for row in (scorecard or {}).get("modules", [])
        if isinstance(row, dict) and isinstance(row.get("path"), str)
    }
    if sorted(existing_rows) != module_names:
        errors.append("scorecard module rows do not equal the live module set before refresh")

    executions: list[dict[str, Any]] = []
    refreshed_rows: list[dict[str, Any]] = []
    for module in modules:
        module_name = rel(module)
        proba = expected_by_module[module_name]
        if proba.is_file():
            execution = run_one(module, proba, faber, library_home, package_path, timeout_seconds)
        else:
            execution = {
                "proba_path": rel(proba),
                "case_count": 0,
                "command": [str(faber), "test", str(package_path), "--filter", rel(proba)],
                "command_text": command_text([str(faber), "test", str(package_path), "--filter", rel(proba)]),
                "exit_status": None,
                "passed": None,
                "failed": None,
                "skipped": None,
                "status": "missing-proba",
                "evidence_tier": "structural",
                "diagnostic_codes": {},
                "failures": [f"missing sibling proba: {rel(proba)}"],
            }
        executions.append({"module": module_name, **execution})
        base_row = existing_rows.get(module_name, {"path": module_name})
        refreshed_rows.append(row_for_scorecard(base_row, module, proba if proba.is_file() else None, execution))

    executed_count = sum(1 for execution in executions if execution["evidence_tier"] == EXPECTED_TIER)
    failure_rows = [
        {
            "module": item["module"],
            "proba_path": item["proba_path"],
            "status": item["status"],
            "diagnostic_codes": item["diagnostic_codes"],
            "failures": item["failures"],
        }
        for item in executions
        if item["status"] != "passed"
    ]
    observed_codes: Counter[str] = Counter()
    for item in executions:
        observed_codes.update(item["diagnostic_codes"])

    # A package analysis red is an unresolved shared prerequisite until the
    # owning Radix route is repaired.  This is intentionally descriptive: it
    # never converts a red module into a skipped or structural pass.
    prerequisite_status: dict[str, str] = {
        "rdx-s05-1": "unresolved" if any("cannot read" in failure for item in executions for failure in item["failures"]) else "not-observed",
        "rdx-s05-3": "unresolved" if any(
            "MIR" in code
            or "unsupported" in failure.lower()
            for item in executions
            for code in item["diagnostic_codes"]
            for failure in item["failures"]
        ) or any(
            "MIR" in failure or "unsupported" in failure.lower()
            for item in executions
            for failure in item["failures"]
        ) else "not-observed",
    }
    complete = (
        len(modules) == EXPECTED_MODULE_COUNT
        and len(probas) == EXPECTED_MODULE_COUNT
        and not missing_proba
        and not orphan_proba
        and not errors
        and executed_count == EXPECTED_MODULE_COUNT
    )
    stage = {
        "unit": "tgh-s05-gate",
        "status": "complete" if complete else "blocked",
        "complete": complete,
        "run_at_utc": now,
        "module_count": len(modules),
        "proba_source_count": len(probas),
        "executed_module_count": executed_count,
        "executed_tier": EXPECTED_TIER,
        "package_path": str(package_path),
        "faber_bin": str(faber),
        "faber_library_home": str(library_home),
        "filter_mode": "relative-proba-path",
        "command_template": [str(faber), "test", str(package_path), "--filter", "<src-relative>.proba"],
        "prerequisites": prerequisite_status,
        "observed_diagnostic_codes": dict(sorted(observed_codes.items())),
        "discovery_errors": errors,
        "failures": failure_rows,
    }

    if not isinstance(scorecard, dict):
        scorecard = {}
    scorecard["coverage_revision"] = max(int(scorecard.get("coverage_revision", 1)), 2)
    scorecard["modules"] = refreshed_rows
    scorecard["stage0_5"] = stage
    SCORECARD.write_text(json.dumps(scorecard, indent=2) + "\n", encoding="utf-8")

    print(
        f"Stage-0.5 proba coverage: {executed_count}/{len(modules)} modules at "
        f"{EXPECTED_TIER}; scorecard refreshed"
    )
    if observed_codes:
        print("diagnostic reds: " + ", ".join(f"{key}={value}" for key, value in sorted(observed_codes.items())))
    if errors:
        for error in errors:
            print(f"discovery error: {error}", file=sys.stderr)
    for item in failure_rows:
        first = item["failures"][0] if item["failures"] else "no failure detail"
        print(f"red {item['module']}: {item['status']}: {first}", file=sys.stderr)
    return 0 if complete else 1


if __name__ == "__main__":
    raise SystemExit(main())
PY
