#!/usr/bin/env bash
# check-wgsl-shader-contract-conformance
#
# Triga conformance suite for the compiler-owned generic shader-contract
# boundary (docs/factory/wgsl-shader-contract-boundary/ledger.md).
#
# The moved radix U4 conformance tests (the 7 triga_stage4_* tests from
# radix crates/radix/src/tool_test.rs:2373-2864) live here as real triga:*
# corpus programs: real triga:* imports -> generic contract (via the adapter
# declarations mirrored from triga/src/shader_contract.fab) -> faber emit
# -t wgsl-text -> Naga-valid WGSL.
#
# Stage 1 (tgh-s1-3) retired the repository-revision pin. The suite asserts
# emitted-contract behavior against the current sibling Faber binary
# (FABER_BIN or $FABER_LIBRARY_HOME/radix/target/{release,debug}/faber).
# A live-Radix needle miss is an honest red — assertions are not deleted.
# After resolving FABER_BIN, a staleness guard fails if that binary is older
# than the sibling radix source (git crates/ commit time, or file mtime when
# the tree is dirty / not a git checkout). No silent rebuild.
#
# Usage:
#   ./scripta/check-wgsl-shader-contract-conformance
#   FABER_BIN=... FABER_LIBRARY_HOME=... ./scripta/check-wgsl-shader-contract-conformance
#
# Exit non-zero on a stale faber binary, any compile failure, unexpected WGSL,
# naga rejection, or absent naga (the suite hard-requires naga — see below).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"

# Same resolution as check-proba-coverage / tgh-s1-2: explicit FABER_BIN, else
# sibling radix/target/{release,debug}/faber. No public-faber Cargo.toml path
# and no silent rebuild on crates/ drift.
if [[ -z "${FABER_BIN:-}" ]]; then
  if [[ -x "$FABER_LIBRARY_HOME/radix/target/release/faber" ]]; then
    FABER_BIN="$FABER_LIBRARY_HOME/radix/target/release/faber"
  elif [[ -x "$FABER_LIBRARY_HOME/radix/target/debug/faber" ]]; then
    FABER_BIN="$FABER_LIBRARY_HOME/radix/target/debug/faber"
  else
    echo "check-wgsl-shader-contract-conformance: missing faber binary" >&2
    echo "  set FABER_BIN or build sibling radix/target/{release,debug}/faber" >&2
    exit 1
  fi
fi
if [[ ! -x "$FABER_BIN" ]]; then
  echo "check-wgsl-shader-contract-conformance: FABER_BIN is not executable: $FABER_BIN" >&2
  exit 1
fi

# Epoch-seconds mtime. python3, not stat(1): GNU stat's -f is filesystem
# mode and BSD/GNU format flags are not interchangeable.
stat_mtime() {
  python3 -c 'import os, sys; print(int(os.stat(sys.argv[1]).st_mtime))' "$1"
}

# True if any sibling radix compiler source is newer than FABER_BIN.
radix_source_newer_than_bin() {
  local radix="$1" bin="$2" found extra
  found="$(find "$radix/crates" \( -name '*.rs' -o -name 'Cargo.toml' -o -name 'Cargo.lock' \) \
    -type f -newer "$bin" -print -quit 2>/dev/null || true)"
  if [[ -z "$found" ]]; then
    for extra in "$radix/Cargo.toml" "$radix/Cargo.lock"; do
      if [[ -f "$extra" && "$extra" -nt "$bin" ]]; then
        found="$extra"
        break
      fi
    done
  fi
  [[ -n "$found" ]]
}

# Fail if FABER_BIN is older than sibling radix source. Skip when no
# $FABER_LIBRARY_HOME/radix/crates tree exists (published artifact, no
# sibling checkout). Does not cargo-build.
assert_faber_bin_fresh() {
  local radix="$FABER_LIBRARY_HOME/radix"
  local bin_mtime source_ts="" dirty=0 rev=""
  [[ -d "$radix/crates" ]] || return 0

  bin_mtime="$(stat_mtime "$FABER_BIN")" || {
    echo "check-wgsl-shader-contract-conformance: cannot stat FABER_BIN: $FABER_BIN" >&2
    exit 1
  }

  if git -C "$radix" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    rev="$(git -C "$radix" rev-parse --short HEAD 2>/dev/null || true)"
    source_ts="$(git -C "$radix" log -1 --format=%ct -- crates Cargo.toml Cargo.lock 2>/dev/null || true)"
    git -C "$radix" diff --quiet -- crates Cargo.toml Cargo.lock || dirty=1
    git -C "$radix" diff --cached --quiet -- crates Cargo.toml Cargo.lock || dirty=1
    if [[ -n "$(git -C "$radix" ls-files --others --exclude-standard -- crates 2>/dev/null || true)" ]]; then
      dirty=1
    fi
  else
    dirty=1
  fi

  if [[ "$source_ts" =~ ^[0-9]+$ && "$bin_mtime" =~ ^[0-9]+$ && "$source_ts" -gt "$bin_mtime" ]]; then
    echo "check-wgsl-shader-contract-conformance: stale faber binary" >&2
    echo "  FABER_BIN=$FABER_BIN (mtime $bin_mtime)" >&2
    echo "  sibling radix${rev:+ $rev} crates/ commit $source_ts is newer" >&2
    echo "  rebuild sibling radix/target/{release,debug}/faber or set FABER_BIN to a current binary" >&2
    exit 1
  fi
  if [[ "$dirty" -eq 1 ]] && radix_source_newer_than_bin "$radix" "$FABER_BIN"; then
    echo "check-wgsl-shader-contract-conformance: stale faber binary" >&2
    echo "  FABER_BIN=$FABER_BIN (mtime $bin_mtime)" >&2
    echo "  sibling radix${rev:+ $rev} source at $radix is newer than the binary" >&2
    echo "  rebuild sibling radix/target/{release,debug}/faber or set FABER_BIN to a current binary" >&2
    exit 1
  fi
  echo "check-wgsl-shader-contract-conformance: faber binary fresh vs radix source${rev:+ $rev}"
}

assert_faber_bin_fresh

export FABER_LIBRARY_HOME

CONFORMANCE_DIR="$ROOT/exempla/conformance/shader-contract"

# Naga validation is a HARD requirement (P2-1 fix; auditor-1 residual
# 7b946d8d): the moved conformance tests assert Naga-valid WGSL, so a
# naga-less environment must fail the suite — never silently pass without
# validation. `NAGA=/path/to/naga` overrides detection; `NAGA=` (empty)
# deliberately forces the absent path and fails.
if [[ -n "${NAGA+x}" ]]; then
  NAGA_BIN="$NAGA"
elif command -v naga >/dev/null 2>&1; then
  NAGA_BIN="$(command -v naga)"
else
  echo "check-wgsl-shader-contract-conformance: naga not found on PATH; this suite hard-requires naga (the moved conformance tests assert Naga-valid WGSL)" >&2
  echo "  install with: cargo install naga-cli --version 30.0.0" >&2
  exit 1
fi
if [[ -z "$NAGA_BIN" ]]; then
  echo "check-wgsl-shader-contract-conformance: NAGA is set but empty; refusing to skip naga validation" >&2
  echo "  install naga and retry, or unset NAGA to auto-detect" >&2
  exit 1
fi
echo "check-wgsl-shader-contract-conformance: naga validation required ($NAGA_BIN)"

TMPDIR_WORK="$(mktemp -d "${TMPDIR:-/tmp}/triga-sc-conformance.XXXXXX")"
trap 'rm -rf "$TMPDIR_WORK"' EXIT

failures=0

# emit_file <name> <file>  -> emits WGSL to stdout, dies on compile failure.
emit_file() {
  local name="$1"
  local file="$2"
  local out
  if ! out="$("$FABER_BIN" emit -t wgsl-text "$file" 2>"$TMPDIR_WORK/$name.err")"; then
    echo "FAIL $name: faber emit -t wgsl-text failed" >&2
    sed -n 's/^/    /p' "$TMPDIR_WORK/$name.err" | head -20 >&2
    return 1
  fi
  printf '%s\n' "$out"
}

# assert_contains <name> <needle> <wgsl>
assert_contains() {
  local name="$1" needle="$2" wgsl="$3"
  if ! grep -qF -- "$needle" <<<"$wgsl"; then
    echo "FAIL $name: expected WGSL to contain '$needle'"
    return 1
  fi
}

# assert_not_contains <name> <needle> <wgsl>
assert_not_contains() {
  local name="$1" needle="$2" wgsl="$3"
  if grep -qF -- "$needle" <<<"$wgsl"; then
    echo "FAIL $name: expected WGSL NOT to contain '$needle'"
    return 1
  fi
}

# validate_naga <name> <wgsl>
validate_naga() {
  local name="$1" wgsl="$2"
  local wgsl_file="$TMPDIR_WORK/$name.wgsl"
  printf '%s\n' "$wgsl" > "$wgsl_file"
  if ! "$NAGA_BIN" "$wgsl_file" >"$TMPDIR_WORK/$name.naga.out" 2>&1; then
    echo "FAIL $name: naga rejected the WGSL"
    sed -n 's/^/    /p' "$TMPDIR_WORK/$name.naga.out" | head -20
    return 1
  fi
}

# --- moved test 1: triga_stage4_vertex_body_emits_wgsl -----------------------
run_vertex_body_emits() {
  local name="vertex-body-emits-wgsl"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/vertex-body-emits-wgsl.fab")" || return 1
  assert_contains "$name" "@vertex" "$wgsl" || return 1
  assert_contains "$name" "fn hello_voxel_vertex" "$wgsl" || return 1
  assert_contains "$name" "out.position = vec4<f32>(input.position.x, input.position.y, input.position.z" "$wgsl" || return 1
  assert_not_contains "$name" "view_proj * model" "$wgsl" || return 1
  echo "ok $name"
}

# --- moved test 2: triga_stage4_vertex_body_validates_with_naga --------------
run_vertex_body_naga() {
  local name="vertex-body-naga"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/vertex-body-naga.fab")" || return 1
  assert_contains "$name" "@vertex" "$wgsl" || return 1
  assert_contains "$name" "fn hello_voxel_vertex" "$wgsl" || return 1
  validate_naga "$name" "$wgsl" || return 1
  echo "ok $name"
}

# --- moved test 3: triga_stage4_source_fragment_emits_wgsl -------------------
run_source_fragment_emits() {
  local name="source-fragment-emits-wgsl"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/source-fragment-emits-wgsl.fab")" || return 1
  assert_contains "$name" "@fragment" "$wgsl" || return 1
  assert_contains "$name" "fn hello_voxel_fragment" "$wgsl" || return 1
  assert_contains "$name" "  @location(0) @interpolate(perspective) normal: vec3<f32>," "$wgsl" || return 1
  assert_contains "$name" "  @location(1) @interpolate(perspective) uv: vec2<f32>," "$wgsl" || return 1
  assert_contains "$name" "out.color = vec4<f32>(0.0, 0.0, 0.0, 1.0);" "$wgsl" || return 1
  echo "ok $name"
}

# --- moved test 4: triga_stage4_fragment_entry_validates_with_naga -----------
run_fragment_entry_naga() {
  local name="fragment-entry-naga"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/fragment-entry-naga.fab")" || return 1
  assert_contains "$name" "@fragment" "$wgsl" || return 1
  assert_contains "$name" "fn hello_voxel_fragment" "$wgsl" || return 1
  validate_naga "$name" "$wgsl" || return 1
  echo "ok $name"
}

# --- moved test 5: triga_stage4_source_fragment_body_emits_authored_color_widening
run_source_fragment_body_color_widening() {
  local name="source-fragment-body-color-widening"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/source-fragment-body-color-widening.fab")" || return 1
  assert_contains "$name" "  @location(0) @interpolate(perspective) normal: vec3<f32>," "$wgsl" || return 1
  assert_contains "$name" "  @location(1) @interpolate(perspective) color: vec3<f32>," "$wgsl" || return 1
  assert_contains "$name" "out.color = vec4<f32>(input.color.x, input.color.y, input.color.z" "$wgsl" || return 1
  assert_not_contains "$name" "out.color = vec4<f32>(0.0, 0.0, 0.0, 1.0);" "$wgsl" || return 1
  validate_naga "$name" "$wgsl" || return 1
  echo "ok $name"
}

# --- moved test 6: triga_stage4_source_fragment_lambert_emits_authored_math --
run_source_fragment_lambert() {
  local name="source-fragment-lambert"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/source-fragment-lambert.fab")" || return 1
  assert_contains "$name" "var light_direction: vec3<f32>;" "$wgsl" || return 1
  assert_contains "$name" "light_direction = tmp" "$wgsl" || return 1
  assert_contains "$name" "input.normal.x * light_direction.x" "$wgsl" || return 1
  assert_contains "$name" "max(" "$wgsl" || return 1
  assert_contains "$name" "input.color.x * lighting_vec.x" "$wgsl" || return 1
  assert_contains "$name" "out.color = vec4<f32>(lit_color.x, lit_color.y, lit_color.z" "$wgsl" || return 1
  validate_naga "$name" "$wgsl" || return 1
  echo "ok $name"
}

# --- moved test 7: triga_stage4_source_fragment_lambert_negative_empty_body_has_no_lambert_math
run_source_fragment_lambert_negative_empty() {
  local name="source-fragment-lambert-negative-empty"
  local wgsl
  wgsl="$(emit_file "$name" "$CONFORMANCE_DIR/source-fragment-lambert-negative-empty.fab")" || return 1
  assert_not_contains "$name" "light_direction" "$wgsl" || return 1
  assert_not_contains "$name" "max(" "$wgsl" || return 1
  assert_not_contains "$name" "lit_color" "$wgsl" || return 1
  echo "ok $name"
}

echo "check-wgsl-shader-contract-conformance: faber $FABER_BIN"
echo "check-wgsl-shader-contract-conformance: conformance corpus $CONFORMANCE_DIR"

run_vertex_body_emits || failures=$((failures + 1))
run_vertex_body_naga || failures=$((failures + 1))
run_source_fragment_emits || failures=$((failures + 1))
run_fragment_entry_naga || failures=$((failures + 1))
run_source_fragment_body_color_widening || failures=$((failures + 1))
run_source_fragment_lambert || failures=$((failures + 1))
run_source_fragment_lambert_negative_empty || failures=$((failures + 1))

# The moved source-facts fixture (radix crates/radix/src/fixtures/
# triga-stage4-source-facts.fab) lands in triga as the existing exempla file;
# it must stay check-clean against the live sibling Faber binary.
echo "check-wgsl-shader-contract-conformance: source-facts fixture check"
if ! "$FABER_BIN" check "$ROOT/exempla/triga-stage4-source-facts.fab" >"$TMPDIR_WORK/fixture.err" 2>&1; then
  echo "FAIL source-facts fixture: faber check rejected triga-stage4-source-facts.fab"
  sed -n 's/^/    /p' "$TMPDIR_WORK/fixture.err" | head -20
  failures=$((failures + 1))
fi

if [[ "$failures" -gt 0 ]]; then
  echo "check-wgsl-shader-contract-conformance: $failures failure(s)"
  exit 1
fi
echo "check-wgsl-shader-contract-conformance: ok (7 moved conformance tests + source-facts fixture)"
