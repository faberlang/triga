#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-exempla-inventory: missing radix checkout at $RADIX" >&2
  exit 1
fi

# Sibling product CLI: FABER_BIN, else release then debug under the library home.
# The faber product CLI accepts exempla TOML frontmatter and applies the
# package locale from faber.toml (raw `radix check` rejects frontmatter).
if [[ -z "${FABER_BIN:-}" ]]; then
  if [[ -x "$FABER_LIBRARY_HOME/radix/target/release/faber" ]]; then
    FABER_BIN="$FABER_LIBRARY_HOME/radix/target/release/faber"
  elif [[ -x "$FABER_LIBRARY_HOME/radix/target/debug/faber" ]]; then
    FABER_BIN="$FABER_LIBRARY_HOME/radix/target/debug/faber"
  else
    echo "check-exempla-inventory: missing faber binary (set FABER_BIN or build $FABER_LIBRARY_HOME/radix/target/{release,debug}/faber)" >&2
    exit 1
  fi
fi

if [[ "$FABER_BIN" != /* ]]; then
  FABER_BIN="$(cd "$(dirname "$FABER_BIN")" && pwd)/$(basename "$FABER_BIN")"
fi

if [[ ! -x "$FABER_BIN" ]]; then
  echo "check-exempla-inventory: faber binary not executable: $FABER_BIN" >&2
  exit 1
fi

export FABER_LIBRARY_HOME
export RADIX_ROOT="$RADIX"
export FABER_BIN

contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    if [[ "$item" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

documented=()
while IFS= read -r file; do
  documented[${#documented[@]}]="$file"
done < <(
  awk '/^  [^[:space:]]+\.fab[[:space:]]/ { print "exempla/" $1 }' "$ROOT/exempla/README.md" | sort
)
actual=()
while IFS= read -r file; do
  actual[${#actual[@]}]="$file"
done < <(
  cd "$ROOT" && find exempla -maxdepth 1 -type f -name '*.fab' -print | sort
)

if [[ "${#documented[@]}" -eq 0 ]]; then
  echo "check-exempla-inventory: no documented exempla found in exempla/README.md" >&2
  exit 1
fi

status=0

for file in "${actual[@]}"; do
  if ! contains "$file" "${documented[@]}"; then
    echo "check-exempla-inventory: undocumented exemplar file: $file" >&2
    status=1
  fi
done

for file in "${documented[@]}"; do
  if [[ ! -f "$ROOT/$file" ]]; then
    echo "check-exempla-inventory: documented exemplar is missing: $file" >&2
    status=1
  fi
done

if [[ "$status" -ne 0 ]]; then
  exit "$status"
fi

compile_allowlist_reason() {
  case "$1" in
    exempla/triga-basics.fab)
      echo "generated Rust still fails the acknowledged radix emitter defect E0425/E0422 ('cannot find type Vec3 in module crate::math') + E0308 Option-wrap mismatches (CTO-5 registry row 7, E0308 / Vec3, owned by radix-hir-rust; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/triga-box3-genus-spike.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Option-returning calls missing the Some(…) wrap — 'expected Option<f32>, found f32' in model_value/view_projection_value; CTO-5 registry row 7, E0308 / Vec3, owned by radix-hir-rust; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/triga-normal-oracle.fab)
      echo "generated Rust still fails the acknowledged radix emitter defect E0425/E0422 ('cannot find type Vec3 in module crate::math') + E0308 Option-wrap mismatches on the triga:* imports (CTO-5 registry row 7, E0308 / Vec3; compiler-lane ledger E0308); the oracle executes through the TS-emit lane; Radix source check remains required"
      ;;
    exempla/triga-geometry-attributes.fab)
      echo "geometry attribute generated Rust still has list-index and ownership lowering residuals; Radix source check remains required"
      ;;
    exempla/triga-stage4-source-facts.fab)
      echo "Stage 4 source facts depend on geometry layout helpers that share the current generated-Rust geometry lowering residuals; Radix source check remains required"
      ;;
    exempla/triga-graphics-pipeline-facts.fab)
      echo "pipeline facts are annotation-only; no generated-code path"
      ;;
    exempla/triga-vertex-fragment-stub.fab)
      echo "vertex-fragment stub is annotation-only; no generated-code path"
      ;;
    exempla/triga-scene-store.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (&…clone() args to by-value params + Some(…) wraps of ∪ nihil results; compiler-lane ledger E0308, owned by the 80 generated-Rust lane); Radix source check remains required"
      ;;
    exempla/triga-scene-store-empty.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Some(…) wrap of byte_count() ∪ nihil result; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/hello-voxel-first-draw-facts.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Some(…) wraps of Option-returning calls; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/triga-hello-voxel-shaders.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Some(…) wraps + &…clone() args; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/triga-hello-voxel-pipeline.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Some(…) wraps + &…clone() args; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/triga-transforms.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Some(…) wraps + &…clone() args; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    exempla/triga-types-untested.fab)
      echo "generated Rust still fails the acknowledged radix emitter E0308 regression (Some(…) wraps + &…clone() args; compiler-lane ledger E0308); Radix source check remains required"
      ;;
    *)
      return 1
      ;;
  esac
}

for file in "${documented[@]}"; do
  echo "check-exempla-inventory: faber check $file"
  "$FABER_BIN" check "$ROOT/$file"
done

for file in "${documented[@]}"; do
  if reason="$(compile_allowlist_reason "$file")"; then
    echo "check-exempla-inventory: compile allowlist $file - $reason"
    continue
  fi

  # Generated-Rust acceptance rides the product build route (faber 7412e5e5
  # retired `run --target/--compile`; compiled routes fail closed pointing at
  # `faber build`). An un-targeted `faber run` on a manifest package is the
  # store-based FHIR route, which cannot serve triga's own exempla (imports
  # triga:* with no declared dependency record — the FHIR store-closure
  # validation is a real invariant and is NOT weakened).
  echo "check-exempla-inventory: faber build --target rust $file"
  (cd "$ROOT" && "$FABER_BIN" build --target rust "$file")
done
