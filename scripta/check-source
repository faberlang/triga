#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"
status=0

if [[ ! -d "$SRC" ]]; then
  echo "check-source: missing src directory: $SRC" >&2
  exit 1
fi

while IFS= read -r -d '' file; do
  if grep -nE '^[[:space:]]*//' "$file"; then
    echo "check-source: line-start comments are not allowed in $file" >&2
    status=1
  fi

  if grep -nE '@[[:space:]]*(externa|subsidia)\b' "$file"; then
    echo "check-source: retired @ externa/@ subsidia annotation in $file" >&2
    status=1
  fi

  if grep -nE '\bad[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{' "$file"; then
    echo "check-source: route calls must use canonical string route syntax in $file" >&2
    status=1
  fi

  if grep -nE '∪[[:space:]]*nihil[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=' "$file"; then
    echo "check-source: retired optional genus field syntax in $file; use sponte" >&2
    status=1
  fi

  # Naming lint: reject public functions with genus-type prefixes that indicate
  # a receiver-method anti-pattern. Constructors and pure scalar helpers are
  # exempt — they have no genus receiver. See docs/api-shape-policy.md § 5.
  # Exempt patterns are anchored to '(' so they match exact constructor names,
  # not prefixed methods (e.g. scene_mesh( is exempt, scene_mesh_geometry( is not).
  if grep -nE '^functio (vector[234]|box3|matrix[34]|quaternion|euler|sphere|plane|ray|scene|geometry|transform_payload)_[a-z]' "$file" \
     | grep -vE '(vector[234]\(|box3_ex_|matrix[34]_(identitas|translatio|scala|composita|perspectiva|conspectus)|plane_geometry|sphere_geometry|colored_quad_mesh_append|scene_(store|node|group|mesh|camera|light)\(|scene_handle_equals\(|camera_(pitch_coercita|directio_ex|prorsum|dextra|motus|ray_ex|yaw_pitch))'; then
    echo "check-source: genus-prefixed function should be a receiver method (see docs/api-shape-policy.md) in $file" >&2
    status=1
  fi
done < <(find "$SRC" \( -name '*.fab' -o -name '*.proba' \) -print0)

exit "$status"