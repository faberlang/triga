#!/usr/bin/env bash
# Triga's local check: `faber check` on every library module and exemplum,
# `faber corpus` on each exemplum with a `+++ text stdout` section, WGSL
# emission and `faber verify-library` for the stage bindings, then
# `faber test` on the package (the inline `+++ faber test` sections). It
# prints one line per failing file and exits non-zero if anything is red.
#
# FABER_BIN picks the compiler; otherwise the sibling radix build is used.
# FABER_LIBRARY_HOME defaults to this repo's parent directory.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"

if [[ -z "${FABER_BIN:-}" ]]; then
  for candidate in "$FABER_LIBRARY_HOME/radix/target/release/faber" \
                   "$FABER_LIBRARY_HOME/radix/target/debug/faber"; do
    if [[ -x "$candidate" ]]; then
      FABER_BIN="$candidate"
      break
    fi
  done
fi
if [[ -z "${FABER_BIN:-}" || ! -x "$FABER_BIN" ]]; then
  echo "check: no faber binary; set FABER_BIN or build ../radix" >&2
  exit 2
fi

cd "$ROOT"
status=0

# The package check covers every module under src/ in one pass; test
# sections are compiled by `faber test` below.
if "$FABER_BIN" check . >/dev/null 2>&1; then
  echo "check: faber check (library): green"
else
  echo "check: faber check (library): red; run \`faber check .\` for details"
  status=1
fi

# Exempla are standalone programs, so each is checked on its own.
checked=0
failed=0
while IFS= read -r file; do
  checked=$((checked + 1))
  if ! "$FABER_BIN" check "$file" >/dev/null 2>&1; then
    echo "check: red: $file"
    failed=$((failed + 1))
    status=1
  fi
done < <(find exempla -name '*.fab' | sort)

echo "check: faber check (exempla): $((checked - failed))/$checked green"

# Exempla with a `+++ text stdout` section run the way a user's program does:
# copied outside this package and linked against Triga through the library
# home. (Inside the package the compiler links Triga's modules as package
# modules, which can hide a failure a consumer would hit.) The output must
# match the section exactly.
outside_dir="$(mktemp -d)"
goldens=0
golden_failed=0
while IFS= read -r file; do
  goldens=$((goldens + 1))
  copy="$outside_dir/$goldens.fab"
  cp "$file" "$copy"
  expected="$(awk 'found && /^\+\+\+ / {exit} found {print} /^\+\+\+ text stdout$/ {found = 1}' "$file")"
  actual="$("$FABER_BIN" run --library-home "$FABER_LIBRARY_HOME" "$copy" 2>/dev/null)"
  if [[ "$actual" != "$expected" ]]; then
    echo "check: red output: $file"
    golden_failed=$((golden_failed + 1))
    status=1
  fi
done < <(grep -rl --include='*.fab' '^+++ text stdout$' exempla | sort)

echo "check: faber run (exempla output, outside the package): $((goldens - golden_failed))/$goldens green"

# Exempla that declare a graphics stage must emit WGSL, and naga (when it is
# installed) must accept it. Emission needs a faber build with the wgsl-text
# target (cargo feature `mir-wgsl`); without one the step is reported as
# skipped, not green.
wgsl_dir="$(mktemp -d)"
trap 'rm -f "$wgsl_dir"/*.wgsl "$wgsl_dir"/*.err "$outside_dir"/*.fab; rmdir "$wgsl_dir" "$outside_dir"' EXIT
have_naga=0
command -v naga >/dev/null 2>&1 && have_naga=1
stages=0
stage_failed=0
wgsl_skipped=0
while IFS= read -r file; do
  stages=$((stages + 1))
  out="$wgsl_dir/$stages.wgsl"
  err="$wgsl_dir/$stages.err"
  if ! "$FABER_BIN" emit --library-home "$FABER_LIBRARY_HOME" -t wgsl-text "$file" >"$out" 2>"$err"; then
    if grep -q 'target_not_in_this_build' "$err"; then
      wgsl_skipped=1
      break
    fi
    echo "check: red wgsl: $file"
    stage_failed=$((stage_failed + 1))
    status=1
  elif [[ "$have_naga" -eq 1 ]] && ! naga "$out" >/dev/null 2>&1; then
    echo "check: red wgsl (naga): $file"
    stage_failed=$((stage_failed + 1))
    status=1
  fi
done < <(grep -rlE --include='*.fab' '^@ (Vertex|Fragment)$' exempla | sort)

if [[ "$wgsl_skipped" -eq 1 ]]; then
  echo "check: faber emit wgsl-text: skipped (this faber build has no wgsl-text target)"
elif [[ "$have_naga" -eq 1 ]]; then
  echo "check: faber emit wgsl-text + naga: $((stages - stage_failed))/$stages green"
else
  echo "check: faber emit wgsl-text: $((stages - stage_failed))/$stages green (naga not installed; WGSL not validated)"
fi

# The library manifest and its WGSL bindings (types, functions, stage
# contracts) must verify. Skipped, like emission, without the wgsl-text target.
if [[ "$wgsl_skipped" -eq 1 ]]; then
  echo "check: faber verify-library wgsl-text: skipped (this faber build has no wgsl-text target)"
elif "$FABER_BIN" verify-library "$ROOT" --target wgsl-text >/dev/null 2>&1; then
  echo "check: faber verify-library wgsl-text: green"
else
  echo "check: faber verify-library wgsl-text: red; run \`faber verify-library \"\$PWD\" --target wgsl-text\` for details"
  status=1
fi

if "$FABER_BIN" test . ; then
  echo "check: faber test: green"
else
  echo "check: faber test: red"
  status=1
fi

if [[ "$status" -eq 0 ]]; then
  echo "check: green"
else
  echo "check: red"
fi
exit "$status"
