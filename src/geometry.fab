# Backend-agnostic geometry data, vertex attributes, layout, bounds, and draw-batch facts — package map facade.
#
# Public import: import from "triga:geometry" geometry
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:geometry/data       BufferGeometry, ColoredQuadMesh, PrimitiveTopology, free constructors
#   triga:geometry/attribute  BufferAttribute, AttributeData, AttributeUsage
#   triga:geometry/layout     VertexAttributeLayout, VertexFormat, VertexStepMode, code helpers
#   triga:geometry/bounds     BoundingBox, BoundingSphere
#   triga:geometry/batch      DrawRange, GeometryDrawCommand, GeometryGroup, batch facts
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:geometry/data" data

import from "triga:geometry/attribute" attribute

import from "triga:geometry/layout" layout

import from "triga:geometry/bounds" bounds

import from "triga:geometry/batch" batch
