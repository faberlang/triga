+++ toml
locale = "en"

+++ faber
# Backend-agnostic geometry data, vertex attributes, layout, bounds, and draw-batch facts — package map facade.
#
# Public import: import from "triga:geometry"
#
# Prefer leaf modules (one concern per import path):
#   triga:geometry/data       Geometry, ColoredQuadMesh, PrimitiveTopology, free constructors
#   triga:geometry/attribute  Attribute, AttributeData, AttributeUsage
#   triga:geometry/layout     VertexAttributeLayout, VertexFormat, VertexStepMode, code helpers
#   triga:geometry/bounds     BoundingBox, BoundingSphere
#   triga:geometry/batch      DrawRange, GeometryDrawCommand, GeometryGroup, batch facts
#
# This file holds no types. Import the leaf modules above.

import from "triga:geometry/data"

import from "triga:geometry/attribute"

import from "triga:geometry/layout"

import from "triga:geometry/bounds"

import from "triga:geometry/batch"

+++ faber test
# Co-located package test for the geometry facade.  The facade is a package
# map only; leaf types remain owned by their leaf imports.
import from "triga:geometry"

describe "geometry facade discovery" {
    test "geometry facade imports as a package map" {
        assert true
    }
}
