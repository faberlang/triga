# Backend-agnostic geometry attributes and validation — package map facade.
#
# Public import: import from "triga:geometry" private geometry
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:geometry/data       BufferGeometry, ColoredQuadMesh, free constructors
#   triga:geometry/attribute  BufferAttribute, AttributeData, AttributeUsage
#   triga:geometry/layout     VertexAttributeLayout, VertexFormat, VertexStepMode, code helpers
#   triga:geometry/bounds     BoundingBox, BoundingSphere
#   triga:geometry/batch      DrawRange, GeometryDrawCommand, GeometryGroup, batch facts
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:geometry/data" private data

import from "triga:geometry/attribute" private attribute

import from "triga:geometry/layout" private layout

import from "triga:geometry/bounds" private bounds

import from "triga:geometry/batch" private batch
