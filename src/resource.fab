+++ toml
locale = "en"

+++ faber
# Resource handle identity and lifecycle.
#
# Public import: import from "triga:resource"
# Public leaf module. Scene store imports this for mesh resource handles.
#
# Shape: operations on one handle or transition are receiver methods on that
# class; batch queries over a transition list are free functions (no single
# receiver exists) named transition_*/lifecycle_*.

# A ResourceHandle is a stable logical slot plus a generation. Consumers
# compare both fields, so a later resource in the same logical slot cannot be
# mistaken for the handle that named an earlier resource.
@ public
class ResourceHandle {
    mut int index
    mut int generation

    fn equals(ref ResourceHandle other) → bool {
        return self.index ≡ other.index and self.generation ≡ other.generation
    }

    fn next() → ResourceHandle {
        return ResourceHandle {index = self.index, generation = self.generation + 1}
    }

    # --- Replacement transitions for this handle ---

    fn transition_unchanged() → ResourceTransition {
        return ResourceTransition {previous = self, current = self, changed = false}
    }

    fn transition_replaced() → ResourceTransition {
        return ResourceTransition {previous = self, current = self.next(), changed = true}
    }

    # --- Lifecycle transitions for this handle ---

    fn lifecycle_unchanged() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, previous = self, current = self, changed = false, removed = false}
    }

    fn lifecycle_replaced() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, previous = self, current = self.next(), changed = true, removed = false}
    }

    fn lifecycle_removed() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, previous = self, changed = true, removed = true}
    }

    fn lifecycle_created() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, current = self, changed = true, removed = false}
    }
}

# ResourceTransition describes one slot across a replacement boundary. An
# unchanged transition repeats the same generation; a changed transition uses
# the next generation for the same logical index.
@ public
class ResourceTransition {
    mut ResourceHandle previous
    mut ResourceHandle current
    mut bool changed

    fn valid() → bool {
        if self.previous.index ≢ self.current.index then return false
        if self.changed then return self.current.generation ≡ self.previous.generation + 1
        return self.current.generation ≡ self.previous.generation
    }
}

# ResourceLifecycleTransition extends the replacement model with creation and
# removal. Nullable handles make the two one-sided states explicit.
@ public
class ResourceLifecycleTransition {
    mut int logical_index
    mut ResourceHandle previous optional
    mut ResourceHandle current optional
    mut bool changed
    mut bool removed

    fn valid() → bool {
        let ResourceHandle ∪ none previous ← self.previous
        let ResourceHandle ∪ none current ← self.current
        if previous is none and current is none then return false
        if previous not is none and previous.index ≢ self.logical_index then return false
        if current not is none and current.index ≢ self.logical_index then return false
        if self.removed then return (self.changed and previous not is none) and current is none
        if not self.changed {
            if previous is none or current is none then return false
            return previous.generation ≡ current.generation
        }
        if previous is none then return current not is none
        if current is none then return false
        return current.generation ≡ previous.generation + 1
    }
}

# ResourceLifecycleBatchFacts is the aggregate view used by a resource update
# pass. The counts are derived only after the transition list passes its
# uniqueness and generation checks.
@ public
class ResourceLifecycleBatchFacts {
    mut int transition_count
    mut int changed_count
    mut int unchanged_count
    mut int created_count
    mut int removed_count
    mut int live_count
}

# ResourceHandleTraversal is the bounded accumulator used by the scene-store
# traversal (src/scene.fab). `remaining` keeps traversal loops fail-closed if
# a malformed input would otherwise cycle.
@ public
class ResourceHandleTraversal {
    mut list<ResourceHandle> handles
    mut int remaining
}

# --- Replacement batch queries ----------------------------------------------
#
# Free functions over a transition list: validation checks the whole batch
# before facts, counts, or handle projections are derived.

fn transition_index_seen(ref list<ResourceTransition> transitions, int limit, int resource_index) → bool {
    for exclusive limit let i {
        let ResourceTransition transition ← transitions[i]
        if transition.current.index ≡ resource_index then return true
    }
    return false
}

@ public
fn transitions_valid(ref list<ResourceTransition> transitions) → bool {
    for from transitions at [i] let transition {
        if not transition.valid() then return false
        if transition_index_seen(transitions, i, transition.current.index) then return false
    }
    return true
}

@ public
fn transition_changed_count(ref list<ResourceTransition> transitions) → int ∪ none {
    if not transitions_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn transition_unchanged_count(ref list<ResourceTransition> transitions) → int ∪ none {
    if not transitions_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if not transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn transition_changed_indices(ref list<ResourceTransition> transitions) → list<int> ∪ none {
    if not transitions_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if transition.changed {
            indices.append(transition.current.index)
        }
    }
    return indices
}

@ public
fn transition_changed_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ none {
    if not transitions_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        if transition.changed {
            handles.append(transition.current)
        }
    }
    return handles
}

@ public
fn transition_current_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ none {
    if not transitions_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        handles.append(transition.current)
    }
    return handles
}

@ public
fn transition_unchanged_indices(ref list<ResourceTransition> transitions) → list<int> ∪ none {
    if not transitions_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if not transition.changed {
            indices.append(transition.current.index)
        }
    }
    return indices
}

@ public
fn transition_unchanged_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ none {
    if not transitions_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        if not transition.changed {
            handles.append(transition.current)
        }
    }
    return handles
}

# --- Lifecycle batch queries -------------------------------------------------
#
# Lifecycle facts distinguish replacement, creation, and removal while still
# preserving the same logical index. Batch accessors intentionally return
# `null` for duplicate or generation-inconsistent input.

fn lifecycle_index_seen(ref list<ResourceLifecycleTransition> transitions, int limit, int logical_index) → bool {
    for exclusive limit let i {
        let ResourceLifecycleTransition transition ← transitions[i]
        if transition.logical_index ≡ logical_index then return true
    }
    return false
}

@ public
fn lifecycles_valid(ref list<ResourceLifecycleTransition> transitions) → bool {
    for from transitions at [i] let transition {
        if not transition.valid() then return false
        if lifecycle_index_seen(transitions, i, transition.logical_index) then return false
    }
    return true
}

@ public
fn lifecycle_changed_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_unchanged_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if not transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_created_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if transition.previous is none and transition.current not is none {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_removed_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if transition.removed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_live_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut int count ← 0
    for from transitions let transition {
        if transition.current not is none {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_batch_facts(ref list<ResourceLifecycleTransition> transitions) → ResourceLifecycleBatchFacts ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut int changed_count ← 0
    mut int unchanged_count ← 0
    mut int created_count ← 0
    mut int removed_count ← 0
    mut int live_count ← 0
    for from transitions let transition {
        if transition.changed {
            changed_count ← changed_count + 1
        }
        if not transition.changed {
            unchanged_count ← unchanged_count + 1
        }
        if transition.previous is none and transition.current not is none {
            created_count ← created_count + 1
        }
        if transition.removed {
            removed_count ← removed_count + 1
        }
        if transition.current not is none {
            live_count ← live_count + 1
        }
    }
    return ResourceLifecycleBatchFacts {transition_count = transitions.length(), changed_count = changed_count, unchanged_count = unchanged_count, created_count = created_count, removed_count = removed_count, live_count = live_count}
}

@ public
fn lifecycle_changed_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if transition.changed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_unchanged_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if not transition.changed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_removed_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if transition.removed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_live_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if transition.current not is none {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_retired_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<int> indices ← empty
    for from transitions let transition {
        if transition.changed and transition.previous not is none {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_changed_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        if transition.changed {
            let ResourceHandle ∪ none current ← transition.current
            if current not is none {
                handles.append(current)
            }
        }
    }
    return handles
}

@ public
fn lifecycle_unchanged_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        if not transition.changed {
            let ResourceHandle ∪ none current ← transition.current
            if current not is none {
                handles.append(current)
            }
        }
    }
    return handles
}

@ public
fn lifecycle_removed_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        if transition.removed {
            let ResourceHandle ∪ none previous ← transition.previous
            if previous not is none {
                handles.append(previous)
            }
        }
    }
    return handles
}

@ public
fn lifecycle_retired_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        if transition.changed {
            let ResourceHandle ∪ none previous ← transition.previous
            if previous not is none {
                handles.append(previous)
            }
        }
    }
    return handles
}

@ public
fn lifecycle_current_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ none {
    if not lifecycles_valid(transitions) then return null
    mut list<ResourceHandle> handles ← empty
    for from transitions let transition {
        let ResourceHandle ∪ none current ← transition.current
        if current not is none {
            handles.append(current)
        }
    }
    return handles
}

+++ faber test
# Co-located package tests for resource identity and lifecycle transitions.
import from "triga:resource"

describe "resource handle identity" {
    test "generation is part of identity and replacement advances it" {
        let resource.ResourceHandle original ← resource.ResourceHandle {index = 7, generation = 2}
        let resource.ResourceHandle replacement ← original.next()
        let resource.ResourceHandle same ← resource.ResourceHandle {index = 7, generation = 2}
        let resource.ResourceHandle other_slot ← resource.ResourceHandle {index = 8, generation = 2}

        assert original.equals(same)
        assert original.equals(replacement) ≡ false
        assert original.equals(other_slot) ≡ false
        assert replacement.index ≡ original.index
        assert replacement.generation ≡ original.generation + 1
    }

    test "replacement transitions preserve identity and expose changed facts" {
        let resource.ResourceHandle stable_handle ← resource.ResourceHandle {index = 2, generation = 4}
        let resource.ResourceHandle replaced_handle ← resource.ResourceHandle {index = 9, generation = 1}
        let resource.ResourceTransition stable ← stable_handle.transition_unchanged()
        let resource.ResourceTransition replaced ← replaced_handle.transition_replaced()
        mut list<resource.ResourceTransition> transitions ← empty
        transitions.append(stable)
        transitions.append(replaced)

        assert stable.valid()
        assert replaced.valid()
        assert stable.changed ≡ false
        assert replaced.changed
        assert replaced.previous.generation ≡ 1
        assert replaced.current.generation ≡ 2
        assert resource.transitions_valid(transitions)
        let int ∪ none changed_count ← resource.transition_changed_count(transitions)
        let int ∪ none unchanged_count ← resource.transition_unchanged_count(transitions)
        assert changed_count not is none
        assert changed_count ≡ 1
        assert unchanged_count not is none
        assert unchanged_count ≡ 1

        let list<int> ∪ none changed_indices ← resource.transition_changed_indices(transitions)
        let list<int> ∪ none unchanged_indices ← resource.transition_unchanged_indices(transitions)
        let list<resource.ResourceHandle> ∪ none current_handles ← resource.transition_current_handles(transitions)
        assert changed_indices not is none
        assert changed_indices.length() ≡ 1
        assert changed_indices[0] ≡ 9
        assert unchanged_indices not is none
        assert unchanged_indices.length() ≡ 1
        assert unchanged_indices[0] ≡ 2
        assert current_handles not is none
        assert current_handles.length() ≡ 2
        assert current_handles[0].generation ≡ 4
        assert current_handles[1].generation ≡ 2
    }

    test "invalid replacement transitions remain distinct from genuine absence" {
        let resource.ResourceHandle original ← resource.ResourceHandle {index = 3, generation = 5}
        let resource.ResourceTransition wrong_slot ← resource.ResourceTransition {previous = original, current = resource.ResourceHandle {index = 4, generation = 6}, changed = true}
        let resource.ResourceTransition skipped_generation ← resource.ResourceTransition {previous = original, current = resource.ResourceHandle {index = 3, generation = 7}, changed = true}
        let resource.ResourceTransition changed_without_generation ← resource.ResourceTransition {previous = original, current = resource.ResourceHandle {index = 3, generation = 5}, changed = true}
        mut list<resource.ResourceTransition> invalid ← empty
        invalid.append(wrong_slot)

        assert wrong_slot.valid() ≡ false
        assert skipped_generation.valid() ≡ false
        assert changed_without_generation.valid() ≡ false
        assert resource.transitions_valid(invalid) ≡ false
        # Invalid input returns absence from the accessor, not a valid zero count.
        assert resource.transition_changed_count(invalid) is none
        assert resource.transition_current_handles(invalid) is none
    }
}

describe "resource lifecycle facts" {
    test "creation replacement stability and removal form one checked batch" {
        let resource.ResourceHandle created_handle ← resource.ResourceHandle {index = 1, generation = 0}
        let resource.ResourceHandle stable_handle ← resource.ResourceHandle {index = 2, generation = 3}
        let resource.ResourceHandle replaced_handle ← resource.ResourceHandle {index = 4, generation = 8}
        let resource.ResourceHandle removed_handle ← resource.ResourceHandle {index = 6, generation = 2}
        let resource.ResourceLifecycleTransition created ← created_handle.lifecycle_created()
        let resource.ResourceLifecycleTransition stable ← stable_handle.lifecycle_unchanged()
        let resource.ResourceLifecycleTransition replaced ← replaced_handle.lifecycle_replaced()
        let resource.ResourceLifecycleTransition removed ← removed_handle.lifecycle_removed()
        mut list<resource.ResourceLifecycleTransition> transitions ← empty
        transitions.append(created)
        transitions.append(stable)
        transitions.append(replaced)
        transitions.append(removed)

        assert created.valid()
        assert stable.valid()
        assert replaced.valid()
        assert removed.valid()
        assert resource.lifecycles_valid(transitions)
        let int ∪ none changed_count ← resource.lifecycle_changed_count(transitions)
        let int ∪ none unchanged_count ← resource.lifecycle_unchanged_count(transitions)
        let int ∪ none created_count ← resource.lifecycle_created_count(transitions)
        let int ∪ none removed_count ← resource.lifecycle_removed_count(transitions)
        let int ∪ none live_count ← resource.lifecycle_live_count(transitions)
        assert changed_count not is none
        assert changed_count ≡ 3
        assert unchanged_count not is none
        assert unchanged_count ≡ 1
        assert created_count not is none
        assert created_count ≡ 1
        assert removed_count not is none
        assert removed_count ≡ 1
        assert live_count not is none
        assert live_count ≡ 3

        let resource.ResourceLifecycleBatchFacts ∪ none facts ← resource.lifecycle_batch_facts(transitions)
        assert facts not is none
        assert facts.transition_count ≡ 4
        assert facts.changed_count ≡ 3
        assert facts.unchanged_count ≡ 1
        assert facts.created_count ≡ 1
        assert facts.removed_count ≡ 1
        assert facts.live_count ≡ 3

        let list<int> ∪ none changed_indices ← resource.lifecycle_changed_indices(transitions)
        let list<int> ∪ none unchanged_indices ← resource.lifecycle_unchanged_indices(transitions)
        let list<int> ∪ none removed_indices ← resource.lifecycle_removed_indices(transitions)
        let list<int> ∪ none live_indices ← resource.lifecycle_live_indices(transitions)
        let list<int> ∪ none retired_indices ← resource.lifecycle_retired_indices(transitions)
        assert changed_indices not is none
        assert changed_indices.length() ≡ 3
        assert unchanged_indices not is none
        assert unchanged_indices.length() ≡ 1
        assert unchanged_indices[0] ≡ 2
        assert removed_indices not is none
        assert removed_indices.length() ≡ 1
        assert removed_indices[0] ≡ 6
        assert live_indices not is none
        assert live_indices.length() ≡ 3
        assert retired_indices not is none
        assert retired_indices.length() ≡ 2
    }

    test "lifecycle accessors separate live current handles from retired handles" {
        let resource.ResourceHandle created_handle ← resource.ResourceHandle {index = 10, generation = 0}
        let resource.ResourceHandle replaced_handle ← resource.ResourceHandle {index = 11, generation = 2}
        let resource.ResourceHandle removed_handle ← resource.ResourceHandle {index = 12, generation = 5}
        mut list<resource.ResourceLifecycleTransition> transitions ← empty
        transitions.append(created_handle.lifecycle_created())
        transitions.append(replaced_handle.lifecycle_replaced())
        transitions.append(removed_handle.lifecycle_removed())

        let list<resource.ResourceHandle> ∪ none changed_handles ← resource.lifecycle_changed_handles(transitions)
        let list<resource.ResourceHandle> ∪ none unchanged_handles ← resource.lifecycle_unchanged_handles(transitions)
        let list<resource.ResourceHandle> ∪ none removed_handles ← resource.lifecycle_removed_handles(transitions)
        let list<resource.ResourceHandle> ∪ none retired_handles ← resource.lifecycle_retired_handles(transitions)
        let list<resource.ResourceHandle> ∪ none current_handles ← resource.lifecycle_current_handles(transitions)
        assert changed_handles not is none
        assert changed_handles.length() ≡ 2
        assert changed_handles[0].index ≡ 10
        assert changed_handles[1].generation ≡ 3
        assert unchanged_handles not is none
        assert unchanged_handles.length() ≡ 0
        assert removed_handles not is none
        assert removed_handles.length() ≡ 1
        assert removed_handles[0].generation ≡ 5
        assert retired_handles not is none
        # Retired handles are previous identities of changed rows:
        # replaced (index 11) and removed (index 12). Created has no
        # previous, so it is live-current, not retired.
        assert retired_handles.length() ≡ 2
        assert retired_handles[0].index ≡ 11
        assert retired_handles[1].index ≡ 12
        assert current_handles not is none
        assert current_handles.length() ≡ 2
        assert current_handles[0].generation ≡ 0
        assert current_handles[1].generation ≡ 3
    }

    test "invalid lifecycle batches reject duplicates and inconsistent generations" {
        let resource.ResourceHandle original ← resource.ResourceHandle {index = 13, generation = 4}
        let resource.ResourceLifecycleTransition duplicate_a ← original.lifecycle_created()
        let resource.ResourceLifecycleTransition duplicate_b ← original.lifecycle_unchanged()
        let resource.ResourceLifecycleTransition invalid_none ← resource.ResourceLifecycleTransition {logical_index = 14, changed = false, removed = false}
        let resource.ResourceLifecycleTransition invalid_removed ← resource.ResourceLifecycleTransition {logical_index = 15, current = original, changed = true, removed = true}
        mut list<resource.ResourceLifecycleTransition> duplicate_batch ← empty
        duplicate_batch.append(duplicate_a)
        duplicate_batch.append(duplicate_b)
        mut list<resource.ResourceLifecycleTransition> invalid_batch ← empty
        invalid_batch.append(invalid_none)
        invalid_batch.append(invalid_removed)

        assert invalid_none.valid() ≡ false
        assert invalid_removed.valid() ≡ false
        assert resource.lifecycles_valid(duplicate_batch) ≡ false
        assert resource.lifecycles_valid(invalid_batch) ≡ false
        assert resource.lifecycle_batch_facts(duplicate_batch) is none
        assert resource.lifecycle_live_indices(invalid_batch) is none
    }
}
