# Resource handle identity and lifecycle free functions.
#
# Public import: import from "triga:resource" resource
# Public leaf module. Scene store imports this for mesh resource handles.

# A ResourceHandle is a stable logical slot plus a generation. Consumers
# compare both fields, so a later resource in the same logical slot cannot be
# mistaken for the handle that named an earlier resource.
@ public
class ResourceHandle {
    int index
    int generation
}

# ResourceTransition describes one slot across a replacement boundary. An
# unchanged transition repeats the same generation; a changed transition uses
# the next generation for the same logical index.
@ public
class ResourceTransition {
    ResourceHandle previous
    ResourceHandle current
    bool changed
}

# ResourceLifecycleTransition extends the replacement model with creation and
# removal. Nullable handles make the two one-sided states explicit.
@ public
class ResourceLifecycleTransition {
    int logical_index
    ResourceHandle previous optional
    ResourceHandle current optional
    bool changed
    bool removed
}

# ResourceLifecycleBatchFacts is the aggregate view used by a resource update
# pass. The counts are derived only after the transition list passes its
# uniqueness and generation checks.
@ public
class ResourceLifecycleBatchFacts {
    int transition_count
    int changed_count
    int unchanged_count
    int created_count
    int removed_count
    int live_count
}

# ResourceHandleTraversal is the bounded accumulator used by the scene-store
# traversal (src/scene.fab). `remaining` keeps traversal loops fail-closed if
# a malformed input would otherwise cycle.
@ public
class ResourceHandleTraversal {
    list<ResourceHandle> handles
    int remaining
}

# ── Replacement transitions ──────────────────────────────────────────
#
# The first family preserves logical indices while making generation changes
# visible. The list helpers validate the whole batch before returning facts.


@ public
fn resource_handle_equals(ref ResourceHandle a, ref ResourceHandle b) → bool {
    return a.index ≡ b.index and a.generation ≡ b.generation
}

@ public
fn resource_handle_next(ref ResourceHandle handle) → ResourceHandle {
    return ResourceHandle {index = handle.index, generation = handle.generation + 1}
}

@ public
fn resource_transition_unchanged(ref ResourceHandle handle) → ResourceTransition {
    const ResourceHandle stable ← handle
    return ResourceTransition {previous = stable, current = stable, changed = false}
}

@ public
fn resource_transition_replaced(ref ResourceHandle handle) → ResourceTransition {
    const ResourceHandle previous ← handle
    return ResourceTransition {previous = previous, current = resource_handle_next(previous), changed = true}
}

@ public
fn resource_transition_valid(ref ResourceTransition transition) → bool {
    if transition.previous.index ≠ transition.current.index then return false
    if transition.changed then return transition.current.generation ≡ transition.previous.generation + 1
    return transition.current.generation ≡ transition.previous.generation
}

fn _resource_transition_index_seen(ref list<ResourceTransition> transitions, int limit, int resource_index) → bool {
    var int i ← 0
    while i ≺ limit {
        const ResourceTransition transition ← transitions[i]
        if transition.current.index ≡ resource_index then return true
        i ← i + 1
    }
    return false
}

@ public
fn resource_transitions_valid(ref list<ResourceTransition> transitions) → bool {
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if resource_transition_valid(transition) ≡ false then return false
        if _resource_transition_index_seen(transitions, i, transition.current.index) then return false
        i ← i + 1
    }
    return true
}

@ public
fn resource_transition_changed_count(ref list<ResourceTransition> transitions) → int ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var int count ← 0
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if transition.changed {
            count ← count + 1
        }
        i ← i + 1
    }
    return count
}

@ public
fn resource_transition_unchanged_count(ref list<ResourceTransition> transitions) → int ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var int count ← 0
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if transition.changed ≡ false {
            count ← count + 1
        }
        i ← i + 1
    }
    return count
}

@ public
fn resource_transition_changed_indices(ref list<ResourceTransition> transitions) → list<int> ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if transition.changed {
            indices.append(transition.current.index)
        }
        i ← i + 1
    }
    return indices
}

@ public
fn resource_transition_changed_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if transition.changed {
            handles.append(transition.current)
        }
        i ← i + 1
    }
    return handles
}

@ public
fn resource_transition_current_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        handles.append(transition.current)
        i ← i + 1
    }
    return handles
}

@ public
fn resource_transition_unchanged_indices(ref list<ResourceTransition> transitions) → list<int> ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if transition.changed ≡ false {
            indices.append(transition.current.index)
        }
        i ← i + 1
    }
    return indices
}

@ public
fn resource_transition_unchanged_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_transitions_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceTransition transition ← transitions[i]
        if transition.changed ≡ false {
            handles.append(transition.current)
        }
        i ← i + 1
    }
    return handles
}

# ── Lifecycle transitions ────────────────────────────────────────────
#
# Lifecycle facts distinguish replacement, creation, and removal while still
# preserving the same logical index. Batch accessors intentionally return
# `nihil` for duplicate or generation-inconsistent input.

fn _lifecycle_handle(ResourceHandle ∪ null handle) → ResourceHandle ∪ null {
    if handle is null then return null
    const ResourceHandle copy ← handle
    return copy
}

@ public
fn resource_lifecycle_unchanged(ref ResourceHandle handle) → ResourceLifecycleTransition {
    return ResourceLifecycleTransition {logical_index = handle.index, previous = handle, current = handle, changed = false, removed = false}
}

@ public
fn resource_lifecycle_replaced(ref ResourceHandle handle) → ResourceLifecycleTransition {
    return ResourceLifecycleTransition {logical_index = handle.index, previous = handle, current = resource_handle_next(handle), changed = true, removed = false}
}

@ public
fn resource_lifecycle_removed(ref ResourceHandle handle) → ResourceLifecycleTransition {
    return ResourceLifecycleTransition {logical_index = handle.index, previous = handle, changed = true, removed = true}
}

@ public
fn resource_lifecycle_created(ref ResourceHandle handle) → ResourceLifecycleTransition {
    return ResourceLifecycleTransition {logical_index = handle.index, current = handle, changed = true, removed = false}
}

@ public
fn resource_lifecycle_valid(ref ResourceLifecycleTransition transition) → bool {
    if transition.previous is null and transition.current is null then return false
    if transition.previous not is null {
        const ResourceHandle ∪ null previous_opt ← _lifecycle_handle(transition.previous)
        if previous_opt is null then return false
        const ResourceHandle previous ← previous_opt
        if previous.index ≠ transition.logical_index then return false
    }
    if transition.current not is null {
        const ResourceHandle ∪ null current_opt ← _lifecycle_handle(transition.current)
        if current_opt is null then return false
        const ResourceHandle current ← current_opt
        if current.index ≠ transition.logical_index then return false
    }
    if transition.removed then return (transition.changed and transition.previous not is null) and transition.current is null
    if transition.changed ≡ false {
        if transition.previous is null then return false
        if transition.current is null then return false
        const ResourceHandle ∪ null previous_opt ← _lifecycle_handle(transition.previous)
        const ResourceHandle ∪ null current_opt ← _lifecycle_handle(transition.current)
        if previous_opt is null then return false
        if current_opt is null then return false
        const ResourceHandle previous ← previous_opt
        const ResourceHandle current ← current_opt
        return previous.generation ≡ current.generation
    }
    if transition.previous is null then return transition.current not is null
    if transition.current is null then return false
    const ResourceHandle ∪ null previous_opt ← _lifecycle_handle(transition.previous)
    const ResourceHandle ∪ null current_opt ← _lifecycle_handle(transition.current)
    if previous_opt is null then return false
    if current_opt is null then return false
    const ResourceHandle previous ← previous_opt
    const ResourceHandle current ← current_opt
    return current.generation ≡ previous.generation + 1
}

fn _resource_lifecycle_index_seen(ref list<ResourceLifecycleTransition> transitions, int limit, int logical_index) → bool {
    var int i ← 0
    while i ≺ limit {
        const ResourceLifecycleTransition transition ← transitions[i]
        if transition.logical_index ≡ logical_index then return true
        i ← i + 1
    }
    return false
}

@ public
fn resource_lifecycles_valid(ref list<ResourceLifecycleTransition> transitions) → bool {
    var int i ← 0
    while i ≺ transitions.length() {
        const ResourceLifecycleTransition transition ← transitions[i]
        if resource_lifecycle_valid(transition) ≡ false then return false
        if _resource_lifecycle_index_seen(transitions, i, transition.logical_index) then return false
        i ← i + 1
    }
    return true
}

@ public
fn resource_lifecycle_changed_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn resource_lifecycle_unchanged_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.changed ≡ false {
            count ← count + 1
        }
    }
    return count
}

@ public
fn resource_lifecycle_created_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.previous is null and transition.current not is null {
            count ← count + 1
        }
    }
    return count
}

@ public
fn resource_lifecycle_removed_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.removed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn resource_lifecycle_live_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.current not is null {
            count ← count + 1
        }
    }
    return count
}

@ public
fn resource_lifecycle_batch_facts(ref list<ResourceLifecycleTransition> transitions) → ResourceLifecycleBatchFacts ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var int changed_count ← 0
    var int unchanged_count ← 0
    var int created_count ← 0
    var int removed_count ← 0
    var int live_count ← 0
    for from transitions const transition {
        if transition.changed {
            changed_count ← changed_count + 1
        }
        if transition.changed ≡ false {
            unchanged_count ← unchanged_count + 1
        }
        if transition.previous is null and transition.current not is null {
            created_count ← created_count + 1
        }
        if transition.removed {
            removed_count ← removed_count + 1
        }
        if transition.current not is null {
            live_count ← live_count + 1
        }
    }
    return ResourceLifecycleBatchFacts {transition_count = transitions.length(), changed_count = changed_count, unchanged_count = unchanged_count, created_count = created_count, removed_count = removed_count, live_count = live_count}
}

@ public
fn resource_lifecycle_changed_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    for from transitions const transition {
        if transition.changed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn resource_lifecycle_unchanged_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    for from transitions const transition {
        if transition.changed ≡ false {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn resource_lifecycle_removed_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    for from transitions const transition {
        if transition.removed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn resource_lifecycle_live_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    for from transitions const transition {
        if transition.current not is null {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn resource_lifecycle_retired_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← vacua
    for from transitions const transition {
        if transition.changed and transition.previous not is null {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn resource_lifecycle_changed_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    for from transitions const transition {
        if transition.changed and transition.current not is null {
            const ResourceHandle ∪ null current_opt ← _lifecycle_handle(transition.current)
            if current_opt not is null {
                const ResourceHandle current ← current_opt
                handles.append(ResourceHandle {index = current.index, generation = current.generation})
            }
        }
    }
    return handles
}

@ public
fn resource_lifecycle_unchanged_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    for from transitions const transition {
        if transition.changed ≡ false and transition.current not is null {
            const ResourceHandle ∪ null current_opt ← _lifecycle_handle(transition.current)
            if current_opt not is null {
                const ResourceHandle current ← current_opt
                handles.append(ResourceHandle {index = current.index, generation = current.generation})
            }
        }
    }
    return handles
}

@ public
fn resource_lifecycle_removed_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    for from transitions const transition {
        if transition.removed and transition.previous not is null {
            const ResourceHandle ∪ null previous_opt ← _lifecycle_handle(transition.previous)
            if previous_opt not is null {
                const ResourceHandle previous ← previous_opt
                handles.append(ResourceHandle {index = previous.index, generation = previous.generation})
            }
        }
    }
    return handles
}

@ public
fn resource_lifecycle_retired_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    for from transitions const transition {
        if transition.changed and transition.previous not is null {
            const ResourceHandle ∪ null previous_opt ← _lifecycle_handle(transition.previous)
            if previous_opt not is null {
                const ResourceHandle previous ← previous_opt
                handles.append(ResourceHandle {index = previous.index, generation = previous.generation})
            }
        }
    }
    return handles
}

@ public
fn resource_lifecycle_current_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if resource_lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← vacua
    for from transitions const transition {
        if transition.current not is null {
            const ResourceHandle ∪ null current_opt ← _lifecycle_handle(transition.current)
            if current_opt not is null {
                const ResourceHandle current ← current_opt
                handles.append(ResourceHandle {index = current.index, generation = current.generation})
            }
        }
    }
    return handles
}
