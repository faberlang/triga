# Resource handle identity and lifecycle.
#
# Public import: import from "triga:resource" resource
# Public leaf module. Scene store imports this for mesh resource handles.
#
# Shape (api-shape-policy §1): operations on one handle or transition are
# receiver methods on that genus; batch queries over a transition list are
# free functions (no single receiver exists) named transition_*/lifecycle_*.

# A ResourceHandle is a stable logical slot plus a generation. Consumers
# compare both fields, so a later resource in the same logical slot cannot be
# mistaken for the handle that named an earlier resource.
@ public
class ResourceHandle {
    int index
    int generation

    fn equals(ref ResourceHandle other) → bool {
        return self.index ≡ other.index and self.generation ≡ other.generation
    }

    fn next() → ResourceHandle {
        return ResourceHandle {index = self.index, generation = self.generation + 1}
    }

    # --- Replacement transitions for this handle ---

    fn transition_unchanged() → ResourceTransition {
        return ResourceTransition {previous = self, current = self, changed = false}
    }

    fn transition_replaced() → ResourceTransition {
        return ResourceTransition {previous = self, current = self.next(), changed = true}
    }

    # --- Lifecycle transitions for this handle ---

    fn lifecycle_unchanged() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, previous = self, current = self, changed = false, removed = false}
    }

    fn lifecycle_replaced() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, previous = self, current = self.next(), changed = true, removed = false}
    }

    fn lifecycle_removed() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, previous = self, changed = true, removed = true}
    }

    fn lifecycle_created() → ResourceLifecycleTransition {
        return ResourceLifecycleTransition {logical_index = self.index, current = self, changed = true, removed = false}
    }
}

# ResourceTransition describes one slot across a replacement boundary. An
# unchanged transition repeats the same generation; a changed transition uses
# the next generation for the same logical index.
@ public
class ResourceTransition {
    ResourceHandle previous
    ResourceHandle current
    bool changed

    fn valid() → bool {
        if self.previous.index ≠ self.current.index then return false
        if self.changed then return self.current.generation ≡ self.previous.generation + 1
        return self.current.generation ≡ self.previous.generation
    }
}

# ResourceLifecycleTransition extends the replacement model with creation and
# removal. Nullable handles make the two one-sided states explicit.
@ public
class ResourceLifecycleTransition {
    int logical_index
    ResourceHandle previous optional
    ResourceHandle current optional
    bool changed
    bool removed

    fn valid() → bool {
        if self.previous is null and self.current is null then return false
        if self.previous not is null {
            const ResourceHandle previous ← self.previous
            if previous.index ≠ self.logical_index then return false
        }
        if self.current not is null {
            const ResourceHandle current ← self.current
            if current.index ≠ self.logical_index then return false
        }
        if self.removed then return (self.changed and self.previous not is null) and self.current is null
        if self.changed ≡ false {
            if self.previous is null then return false
            if self.current is null then return false
            const ResourceHandle previous ← self.previous
            const ResourceHandle current ← self.current
            return previous.generation ≡ current.generation
        }
        if self.previous is null then return self.current not is null
        if self.current is null then return false
        const ResourceHandle previous ← self.previous
        const ResourceHandle current ← self.current
        return current.generation ≡ previous.generation + 1
    }
}

# ResourceLifecycleBatchFacts is the aggregate view used by a resource update
# pass. The counts are derived only after the transition list passes its
# uniqueness and generation checks.
@ public
class ResourceLifecycleBatchFacts {
    int transition_count
    int changed_count
    int unchanged_count
    int created_count
    int removed_count
    int live_count
}

# ResourceHandleTraversal is the bounded accumulator used by the scene-store
# traversal (src/scene.fab). `remaining` keeps traversal loops fail-closed if
# a malformed input would otherwise cycle.
@ public
class ResourceHandleTraversal {
    list<ResourceHandle> handles
    int remaining
}

# ── Replacement batch queries ────────────────────────────────────────
#
# Free functions over a transition list: validation checks the whole batch
# before facts, counts, or handle projections are derived.

fn transition_index_seen(ref list<ResourceTransition> transitions, int limit, int resource_index) → bool {
    for range 0‥limit const i {
        const ResourceTransition transition ← transitions[i]
        if transition.current.index ≡ resource_index then return true
    }
    return false
}

@ public
fn transitions_valid(ref list<ResourceTransition> transitions) → bool {
    for range 0‥transitions.length() const i {
        const ResourceTransition transition ← transitions[i]
        if transition.valid() ≡ false then return false
        if transition_index_seen(transitions, i, transition.current.index) then return false
    }
    return true
}

@ public
fn transition_changed_count(ref list<ResourceTransition> transitions) → int ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn transition_unchanged_count(ref list<ResourceTransition> transitions) → int ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.changed ≡ false {
            count ← count + 1
        }
    }
    return count
}

@ public
fn transition_changed_indices(ref list<ResourceTransition> transitions) → list<int> ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.changed {
            indices.append(transition.current.index)
        }
    }
    return indices
}

@ public
fn transition_changed_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.changed {
            handles.append(transition.current)
        }
    }
    return handles
}

@ public
fn transition_current_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        handles.append(transition.current)
    }
    return handles
}

@ public
fn transition_unchanged_indices(ref list<ResourceTransition> transitions) → list<int> ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.changed ≡ false {
            indices.append(transition.current.index)
        }
    }
    return indices
}

@ public
fn transition_unchanged_handles(ref list<ResourceTransition> transitions) → list<ResourceHandle> ∪ null {
    if transitions_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.changed ≡ false {
            handles.append(transition.current)
        }
    }
    return handles
}

# ── Lifecycle batch queries ──────────────────────────────────────────
#
# Lifecycle facts distinguish replacement, creation, and removal while still
# preserving the same logical index. Batch accessors intentionally return
# `null` for duplicate or generation-inconsistent input.

fn lifecycle_handle(ResourceHandle ∪ null handle) → ResourceHandle ∪ null {
    if handle is null then return null
    const ResourceHandle copy ← handle
    return copy
}

fn lifecycle_index_seen(ref list<ResourceLifecycleTransition> transitions, int limit, int logical_index) → bool {
    for range 0‥limit const i {
        const ResourceLifecycleTransition transition ← transitions[i]
        if transition.logical_index ≡ logical_index then return true
    }
    return false
}

@ public
fn lifecycles_valid(ref list<ResourceLifecycleTransition> transitions) → bool {
    for range 0‥transitions.length() const i {
        const ResourceLifecycleTransition transition ← transitions[i]
        if transition.valid() ≡ false then return false
        if lifecycle_index_seen(transitions, i, transition.logical_index) then return false
    }
    return true
}

@ public
fn lifecycle_changed_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.changed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_unchanged_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.changed ≡ false {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_created_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.previous is null and transition.current not is null {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_removed_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.removed {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_live_count(ref list<ResourceLifecycleTransition> transitions) → int ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var int count ← 0
    for from transitions const transition {
        if transition.current not is null {
            count ← count + 1
        }
    }
    return count
}

@ public
fn lifecycle_batch_facts(ref list<ResourceLifecycleTransition> transitions) → ResourceLifecycleBatchFacts ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var int changed_count ← 0
    var int unchanged_count ← 0
    var int created_count ← 0
    var int removed_count ← 0
    var int live_count ← 0
    for from transitions const transition {
        if transition.changed {
            changed_count ← changed_count + 1
        }
        if transition.changed ≡ false {
            unchanged_count ← unchanged_count + 1
        }
        if transition.previous is null and transition.current not is null {
            created_count ← created_count + 1
        }
        if transition.removed {
            removed_count ← removed_count + 1
        }
        if transition.current not is null {
            live_count ← live_count + 1
        }
    }
    return ResourceLifecycleBatchFacts {transition_count = transitions.length(), changed_count = changed_count, unchanged_count = unchanged_count, created_count = created_count, removed_count = removed_count, live_count = live_count}
}

@ public
fn lifecycle_changed_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.changed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_unchanged_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.changed ≡ false {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_removed_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.removed {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_live_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.current not is null {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_retired_indices(ref list<ResourceLifecycleTransition> transitions) → list<int> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<int> indices ← empty
    for from transitions const transition {
        if transition.changed and transition.previous not is null {
            indices.append(transition.logical_index)
        }
    }
    return indices
}

@ public
fn lifecycle_changed_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.changed and transition.current not is null {
            const ResourceHandle ∪ null current_opt ← lifecycle_handle(transition.current)
            if current_opt not is null {
                const ResourceHandle current ← current_opt
                handles.append(ResourceHandle {index = current.index, generation = current.generation})
            }
        }
    }
    return handles
}

@ public
fn lifecycle_unchanged_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.changed ≡ false and transition.current not is null {
            const ResourceHandle ∪ null current_opt ← lifecycle_handle(transition.current)
            if current_opt not is null {
                const ResourceHandle current ← current_opt
                handles.append(ResourceHandle {index = current.index, generation = current.generation})
            }
        }
    }
    return handles
}

@ public
fn lifecycle_removed_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.removed and transition.previous not is null {
            const ResourceHandle ∪ null previous_opt ← lifecycle_handle(transition.previous)
            if previous_opt not is null {
                const ResourceHandle previous ← previous_opt
                handles.append(ResourceHandle {index = previous.index, generation = previous.generation})
            }
        }
    }
    return handles
}

@ public
fn lifecycle_retired_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.changed and transition.previous not is null {
            const ResourceHandle ∪ null previous_opt ← lifecycle_handle(transition.previous)
            if previous_opt not is null {
                const ResourceHandle previous ← previous_opt
                handles.append(ResourceHandle {index = previous.index, generation = previous.generation})
            }
        }
    }
    return handles
}

@ public
fn lifecycle_current_handles(ref list<ResourceLifecycleTransition> transitions) → list<ResourceHandle> ∪ null {
    if lifecycles_valid(transitions) ≡ false then return null
    var list<ResourceHandle> handles ← empty
    for from transitions const transition {
        if transition.current not is null {
            const ResourceHandle ∪ null current_opt ← lifecycle_handle(transition.current)
            if current_opt not is null {
                const ResourceHandle current ← current_opt
                handles.append(ResourceHandle {index = current.index, generation = current.generation})
            }
        }
    }
    return handles
}
