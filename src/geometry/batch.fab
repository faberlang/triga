# Geometry draw-range, draw-command, group, and payload byte-count facts.
#
# Public import: import from "triga:geometry/batch" private batch
#
# Owns: DrawRange, GeometryDrawCommand, GeometryGroup, the indexed/line
# draw-batch fact genera, VisibleFaceMeshFacts, and the visible_face_*
# scalar helpers. Geometry-side payload/byte-count facts stay here until
# the render package's render/batch leaf lands at H4 (report §1.4.6).
#
# Zero imports.

# A half-open draw selection in element space. BufferGeometry validates that
# count is non-zero, that start + count stays within the available elements,
# and that the range matches the active primitive topology before it becomes a
# draw command.
class DrawRange {
    int start
    int count
}

# The complete scalar fact set for one host draw. BufferGeometry fills this
# record from a validated draw range or group, preserving indexed mode,
# element origin/count, instance count, and material selection.
class GeometryDrawCommand {
    bool indexed
    int element_count
    int first_element
    int base_vertex
    int instance_count
    int material_index
}

# One material-owned element range. Groups are CPU-side batching metadata;
# BufferGeometry requires non-empty, topology-aligned, in-bounds ranges in
# non-overlapping order before producing group commands.
class GeometryGroup {
    int start
    int count
    int material_index
}

# Upload and draw facts for indexed geometry. The payload fields are byte
# counts, while grouped_element_total describes the elements covered by the
# generated group commands.
class IndexedGeometryDrawBatchFacts {
    int draw_count
    int grouped_element_total
    int vertex_payload_byte_count
    int index_payload_byte_count
    int total_payload_byte_count
}

# Batch facts for line geometry. `line_count` records the number of line
# primitives; the remaining fields carry the same draw, grouped-element, and
# payload-byte facts as the indexed batch shape.
class LineGeometryDrawBatchFacts {
    int draw_count
    int line_count
    int grouped_element_total
    int vertex_payload_byte_count
    int index_payload_byte_count
    int total_payload_byte_count
}

# Exact CPU-side payload facts for the visible-face mesh shape used by the
# geometry helpers: four vertices, six u32 indices, and two triangles per face.
# Position and color each use three float32 scalars per vertex, so the byte
# helpers can describe the host upload without allocating a buffer.
class VisibleFaceMeshFacts {
    int face_count
    int vertex_count
    int index_count
    int triangle_count
    int position_payload_byte_count
    int color_payload_byte_count
    int index_payload_byte_count
    int total_payload_byte_count
}

# --- Scalar payload and mesh-shape helpers ---

# Non-positive face counts are rejected with `nihil`; accepted counts are
# expanded into the fixed visible-face topology and byte counts above.

fn visible_face_vertex_count(int face_count) → int ∪ null {
    if face_count ≤ 0 then return null
    return face_count * 4
}

fn visible_face_index_count(int face_count) → int ∪ null {
    if face_count ≤ 0 then return null
    return face_count * 6
}

fn visible_face_triangle_count(int face_count) → int ∪ null {
    if face_count ≤ 0 then return null
    return face_count * 2
}

fn visible_face_position_payload_byte_count(int face_count) → int ∪ null {
    const int ∪ null vertex_count_result ← visible_face_vertex_count(face_count)
    if vertex_count_result is null then return null
    const int vertex_count ← vertex_count_result coalesce 0
    return (vertex_count * 3) * 4
}

fn visible_face_color_payload_byte_count(int face_count) → int ∪ null {
    const int ∪ null vertex_count_result ← visible_face_vertex_count(face_count)
    if vertex_count_result is null then return null
    const int vertex_count ← vertex_count_result coalesce 0
    return (vertex_count * 3) * 4
}

fn visible_face_index_payload_byte_count(int face_count) → int ∪ null {
    const int ∪ null index_count_result ← visible_face_index_count(face_count)
    if index_count_result is null then return null
    const int index_count ← index_count_result coalesce 0
    return index_count * 4
}

fn visible_face_payload_byte_count(int face_count) → int ∪ null {
    const int ∪ null position_bytes_result ← visible_face_position_payload_byte_count(face_count)
    if position_bytes_result is null then return null
    const int position_bytes ← position_bytes_result coalesce 0
    const int ∪ null color_bytes_result ← visible_face_color_payload_byte_count(face_count)
    if color_bytes_result is null then return null
    const int color_bytes ← color_bytes_result coalesce 0
    const int ∪ null index_bytes_result ← visible_face_index_payload_byte_count(face_count)
    if index_bytes_result is null then return null
    const int index_bytes ← index_bytes_result coalesce 0
    return (position_bytes + color_bytes) + index_bytes
}

fn visible_face_mesh_facts(int face_count) → VisibleFaceMeshFacts ∪ null {
    const int ∪ null vertex_count_result ← visible_face_vertex_count(face_count)
    if vertex_count_result is null then return null
    const int ∪ null index_count_result ← visible_face_index_count(face_count)
    if index_count_result is null then return null
    const int ∪ null triangle_count_result ← visible_face_triangle_count(face_count)
    if triangle_count_result is null then return null
    const int ∪ null position_bytes_result ← visible_face_position_payload_byte_count(face_count)
    if position_bytes_result is null then return null
    const int ∪ null color_bytes_result ← visible_face_color_payload_byte_count(face_count)
    if color_bytes_result is null then return null
    const int ∪ null index_bytes_result ← visible_face_index_payload_byte_count(face_count)
    if index_bytes_result is null then return null
    const int ∪ null total_bytes_result ← visible_face_payload_byte_count(face_count)
    if total_bytes_result is null then return null
    return VisibleFaceMeshFacts {face_count = face_count, vertex_count = vertex_count_result coalesce 0, index_count = index_count_result coalesce 0, triangle_count = triangle_count_result coalesce 0, position_payload_byte_count = position_bytes_result coalesce 0, color_payload_byte_count = color_bytes_result coalesce 0, index_payload_byte_count = index_bytes_result coalesce 0, total_payload_byte_count = total_bytes_result coalesce 0}
}
