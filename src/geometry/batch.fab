+++ toml
locale = "en"

+++ faber
# Geometry draw-range, draw-command, group, and payload byte-count facts.
#
# Public import: import from "triga:geometry/batch"
#
# Owns: DrawRange, GeometryDrawCommand, GeometryGroup, the indexed/line
# draw-batch fact classes, VisibleFaceMeshFacts, and the visible_face_*
# scalar helpers (geometry-side payload and byte-count facts).
#
# Zero imports.

# A half-open draw selection in element space. Geometry validates that
# count is non-zero, that start + count stays within the available elements,
# and that the range matches the active primitive topology before it becomes a
# draw command.
@ public
class DrawRange {
    mut int start
    mut int count
}

# The complete scalar fact set for one host draw. Geometry fills this
# record from a validated draw range or group, preserving indexed mode,
# element origin/count, instance count, and material selection.
@ public
class GeometryDrawCommand {
    mut bool indexed
    mut int element_count
    mut int first_element
    mut int base_vertex
    mut int instance_count
    mut int material_index
}

# One material-owned element range. Groups are CPU-side batching metadata;
# Geometry requires non-empty, topology-aligned, in-bounds ranges in
# non-overlapping order before producing group commands.
@ public
class GeometryGroup {
    mut int start
    mut int count
    mut int material_index
}

# Upload and draw facts for indexed geometry. The payload fields are byte
# counts, while grouped_element_total describes the elements covered by the
# generated group commands.
@ public
class IndexedGeometryDrawBatchFacts {
    mut int draw_count
    mut int grouped_element_total
    mut int vertex_payload_byte_count
    mut int index_payload_byte_count
    mut int total_payload_byte_count
}

# Batch facts for line geometry. `line_count` records the number of line
# primitives; the remaining fields carry the same draw, grouped-element, and
# payload-byte facts as the indexed batch shape.
@ public
class LineGeometryDrawBatchFacts {
    mut int draw_count
    mut int line_count
    mut int grouped_element_total
    mut int vertex_payload_byte_count
    mut int index_payload_byte_count
    mut int total_payload_byte_count
}

# Exact CPU-side payload facts for the visible-face mesh shape used by the
# geometry helpers: four vertices, six u32 indices, and two triangles per face.
# Position and color each use three float32 scalars per vertex, so the byte
# helpers can describe the host upload without allocating a buffer.
@ public
class VisibleFaceMeshFacts {
    mut int face_count
    mut int vertex_count
    mut int index_count
    mut int triangle_count
    mut int position_payload_byte_count
    mut int color_payload_byte_count
    mut int index_payload_byte_count
    mut int total_payload_byte_count
}

# --- Scalar payload and mesh-shape helpers ---

# Non-positive face counts are rejected with `null`; accepted counts are
# expanded into the fixed visible-face topology and byte counts above.

@ public
fn visible_face_vertex_count(int face_count) → int ∪ none {
    if face_count ≤ 0 then return null
    return face_count * 4
}

@ public
fn visible_face_index_count(int face_count) → int ∪ none {
    if face_count ≤ 0 then return null
    return face_count * 6
}

@ public
fn visible_face_triangle_count(int face_count) → int ∪ none {
    if face_count ≤ 0 then return null
    return face_count * 2
}

@ public
fn visible_face_position_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none vertex_count ← visible_face_vertex_count(face_count)
    if vertex_count is none then return null
    return vertex_count * 3 * 4
}

@ public
fn visible_face_color_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none vertex_count ← visible_face_vertex_count(face_count)
    if vertex_count is none then return null
    return vertex_count * 3 * 4
}

@ public
fn visible_face_index_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none index_count ← visible_face_index_count(face_count)
    if index_count is none then return null
    return index_count * 4
}

@ public
fn visible_face_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none position_bytes ← visible_face_position_payload_byte_count(face_count)
    if position_bytes is none then return null
    let int ∪ none color_bytes ← visible_face_color_payload_byte_count(face_count)
    if color_bytes is none then return null
    let int ∪ none index_bytes ← visible_face_index_payload_byte_count(face_count)
    if index_bytes is none then return null
    return position_bytes + color_bytes + index_bytes
}

@ public
fn visible_face_mesh_facts(int face_count) → VisibleFaceMeshFacts ∪ none {
    let int ∪ none vertex_count ← visible_face_vertex_count(face_count)
    if vertex_count is none then return null
    let int ∪ none index_count ← visible_face_index_count(face_count)
    if index_count is none then return null
    let int ∪ none triangle_count ← visible_face_triangle_count(face_count)
    if triangle_count is none then return null
    let int ∪ none position_bytes ← visible_face_position_payload_byte_count(face_count)
    if position_bytes is none then return null
    let int ∪ none color_bytes ← visible_face_color_payload_byte_count(face_count)
    if color_bytes is none then return null
    let int ∪ none index_bytes ← visible_face_index_payload_byte_count(face_count)
    if index_bytes is none then return null
    let int ∪ none total_bytes ← visible_face_payload_byte_count(face_count)
    if total_bytes is none then return null
    return VisibleFaceMeshFacts {face_count = face_count, vertex_count = vertex_count, index_count = index_count, triangle_count = triangle_count, position_payload_byte_count = position_bytes, color_payload_byte_count = color_bytes, index_payload_byte_count = index_bytes, total_payload_byte_count = total_bytes}
}

+++ faber test
# Co-located package tests for visible-face payload and draw-batch facts.
import from "triga:geometry/batch"

describe "geometry batch facts" {
    test "visible face helpers return exact counts and byte totals" {
        assert (batch.visible_face_vertex_count(2) coalesce 0) ≡ 8
        assert (batch.visible_face_index_count(2) coalesce 0) ≡ 12
        assert (batch.visible_face_triangle_count(2) coalesce 0) ≡ 4
        assert (batch.visible_face_position_payload_byte_count(2) coalesce 0) ≡ 96
        assert (batch.visible_face_color_payload_byte_count(2) coalesce 0) ≡ 96
        assert (batch.visible_face_index_payload_byte_count(2) coalesce 0) ≡ 48
        assert (batch.visible_face_payload_byte_count(2) coalesce 0) ≡ 240
    }

    test "visible face mesh facts preserve topology and payload shape" {
        let batch.VisibleFaceMeshFacts ∪ none facts ← batch.visible_face_mesh_facts(2)
        assert facts not is none
        assert facts.face_count ≡ 2
        assert facts.vertex_count ≡ 8
        assert facts.index_count ≡ 12
        assert facts.triangle_count ≡ 4
        assert facts.position_payload_byte_count ≡ 96
        assert facts.color_payload_byte_count ≡ 96
        assert facts.index_payload_byte_count ≡ 48
        assert facts.total_payload_byte_count ≡ 240
    }

    test "empty and malformed face counts are rejected" {
        assert batch.visible_face_vertex_count(0) is none
        assert batch.visible_face_index_count(0) is none
        assert batch.visible_face_triangle_count(0) is none
        assert batch.visible_face_position_payload_byte_count(0) is none
        assert batch.visible_face_color_payload_byte_count(0) is none
        assert batch.visible_face_index_payload_byte_count(0) is none
        assert batch.visible_face_payload_byte_count(0) is none
        assert batch.visible_face_mesh_facts(0) is none
        assert batch.visible_face_mesh_facts(-1) is none
    }

    test "draw ranges groups and commands publish their scalar fields" {
        let batch.DrawRange range ← batch.DrawRange {start = 3, count = 6}
        let batch.GeometryGroup group ← batch.GeometryGroup {start = 6, count = 3, material_index = 4}
        let batch.GeometryDrawCommand command ← batch.GeometryDrawCommand {indexed = true, element_count = 6, first_element = 3, base_vertex = 0, instance_count = 2, material_index = 4}
        let batch.IndexedGeometryDrawBatchFacts indexed_facts ← batch.IndexedGeometryDrawBatchFacts {draw_count = 1, grouped_element_total = 6, vertex_payload_byte_count = 72, index_payload_byte_count = 24, total_payload_byte_count = 96}
        let batch.LineGeometryDrawBatchFacts line_facts ← batch.LineGeometryDrawBatchFacts {draw_count = 1, line_count = 3, grouped_element_total = 6, vertex_payload_byte_count = 48, index_payload_byte_count = 16, total_payload_byte_count = 64}
        assert range.start ≡ 3
        assert range.count ≡ 6
        assert group.start ≡ 6
        assert group.count ≡ 3
        assert group.material_index ≡ 4
        assert command.indexed
        assert command.element_count ≡ 6
        assert command.first_element ≡ 3
        assert command.base_vertex ≡ 0
        assert command.instance_count ≡ 2
        assert command.material_index ≡ 4
        assert indexed_facts.draw_count ≡ 1
        assert indexed_facts.total_payload_byte_count ≡ 96
        assert line_facts.line_count ≡ 3
        assert line_facts.total_payload_byte_count ≡ 64
    }
}
