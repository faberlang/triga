# Geometry draw-range, draw-command, group, and payload byte-count facts.
#
# Public import: import from "triga:geometry/batch" batch
#
# Owns: DrawRange, GeometryDrawCommand, GeometryGroup, the indexed/line
# draw-batch fact genera, VisibleFaceMeshFacts, and the visible_face_*
# scalar helpers. Geometry-side payload/byte-count facts stay here until
# the render package's render/batch leaf lands at H4 (report §1.4.6).
#
# Zero imports.

# A half-open draw selection in element space. Geometry validates that
# count is non-zero, that start + count stays within the available elements,
# and that the range matches the active primitive topology before it becomes a
# draw command.
@ public
class DrawRange {
    mut int start
    mut int count
}

# The complete scalar fact set for one host draw. Geometry fills this
# record from a validated draw range or group, preserving indexed mode,
# element origin/count, instance count, and material selection.
@ public
class GeometryDrawCommand {
    mut bool indexed
    mut int element_count
    mut int first_element
    mut int base_vertex
    mut int instance_count
    mut int material_index
}

# One material-owned element range. Groups are CPU-side batching metadata;
# Geometry requires non-empty, topology-aligned, in-bounds ranges in
# non-overlapping order before producing group commands.
@ public
class GeometryGroup {
    mut int start
    mut int count
    mut int material_index
}

# Upload and draw facts for indexed geometry. The payload fields are byte
# counts, while grouped_element_total describes the elements covered by the
# generated group commands.
@ public
class IndexedGeometryDrawBatchFacts {
    mut int draw_count
    mut int grouped_element_total
    mut int vertex_payload_byte_count
    mut int index_payload_byte_count
    mut int total_payload_byte_count
}

# Batch facts for line geometry. `line_count` records the number of line
# primitives; the remaining fields carry the same draw, grouped-element, and
# payload-byte facts as the indexed batch shape.
@ public
class LineGeometryDrawBatchFacts {
    mut int draw_count
    mut int line_count
    mut int grouped_element_total
    mut int vertex_payload_byte_count
    mut int index_payload_byte_count
    mut int total_payload_byte_count
}

# Exact CPU-side payload facts for the visible-face mesh shape used by the
# geometry helpers: four vertices, six u32 indices, and two triangles per face.
# Position and color each use three float32 scalars per vertex, so the byte
# helpers can describe the host upload without allocating a buffer.
@ public
class VisibleFaceMeshFacts {
    mut int face_count
    mut int vertex_count
    mut int index_count
    mut int triangle_count
    mut int position_payload_byte_count
    mut int color_payload_byte_count
    mut int index_payload_byte_count
    mut int total_payload_byte_count
}

# --- Scalar payload and mesh-shape helpers ---

# Non-positive face counts are rejected with `null`; accepted counts are
# expanded into the fixed visible-face topology and byte counts above.

@ public
fn visible_face_vertex_count(int face_count) → int ∪ none {
    if face_count ≤ 0 then return null
    return face_count * 4
}

@ public
fn visible_face_index_count(int face_count) → int ∪ none {
    if face_count ≤ 0 then return null
    return face_count * 6
}

@ public
fn visible_face_triangle_count(int face_count) → int ∪ none {
    if face_count ≤ 0 then return null
    return face_count * 2
}

@ public
fn visible_face_position_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none vertex_count_result ← visible_face_vertex_count(face_count)
    if vertex_count_result is none then return null
    let int vertex_count ← vertex_count_result
    return (vertex_count * 3) * 4
}

@ public
fn visible_face_color_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none vertex_count_result ← visible_face_vertex_count(face_count)
    if vertex_count_result is none then return null
    let int vertex_count ← vertex_count_result
    return (vertex_count * 3) * 4
}

@ public
fn visible_face_index_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none index_count_result ← visible_face_index_count(face_count)
    if index_count_result is none then return null
    let int index_count ← index_count_result
    return index_count * 4
}

@ public
fn visible_face_payload_byte_count(int face_count) → int ∪ none {
    let int ∪ none position_bytes_result ← visible_face_position_payload_byte_count(face_count)
    if position_bytes_result is none then return null
    let int position_bytes ← position_bytes_result
    let int ∪ none color_bytes_result ← visible_face_color_payload_byte_count(face_count)
    if color_bytes_result is none then return null
    let int color_bytes ← color_bytes_result
    let int ∪ none index_bytes_result ← visible_face_index_payload_byte_count(face_count)
    if index_bytes_result is none then return null
    let int index_bytes ← index_bytes_result
    return (position_bytes + color_bytes) + index_bytes
}

@ public
fn visible_face_mesh_facts(int face_count) → VisibleFaceMeshFacts ∪ none {
    let int ∪ none vertex_count_result ← visible_face_vertex_count(face_count)
    if vertex_count_result is none then return null
    let int ∪ none index_count_result ← visible_face_index_count(face_count)
    if index_count_result is none then return null
    let int ∪ none triangle_count_result ← visible_face_triangle_count(face_count)
    if triangle_count_result is none then return null
    let int ∪ none position_bytes_result ← visible_face_position_payload_byte_count(face_count)
    if position_bytes_result is none then return null
    let int ∪ none color_bytes_result ← visible_face_color_payload_byte_count(face_count)
    if color_bytes_result is none then return null
    let int ∪ none index_bytes_result ← visible_face_index_payload_byte_count(face_count)
    if index_bytes_result is none then return null
    let int ∪ none total_bytes_result ← visible_face_payload_byte_count(face_count)
    if total_bytes_result is none then return null
    let int vertex_count ← vertex_count_result
    let int index_count ← index_count_result
    let int triangle_count ← triangle_count_result
    let int position_bytes ← position_bytes_result
    let int color_bytes ← color_bytes_result
    let int index_bytes ← index_bytes_result
    let int total_bytes ← total_bytes_result
    return VisibleFaceMeshFacts {face_count = face_count, vertex_count = vertex_count, index_count = index_count, triangle_count = triangle_count, position_payload_byte_count = position_bytes, color_payload_byte_count = color_bytes, index_payload_byte_count = index_bytes, total_payload_byte_count = total_bytes}
}
