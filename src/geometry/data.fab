# CPU-side geometry data, topology, and mesh construction.
#
# Public import: import from "triga:geometry/data" data
#
# Owns: Geometry (+ all methods, including index_format_code() and
# topology_code()), ColoredQuadMesh (+ methods), colored_quad_mesh_append,
# the free constructors indexed_triangle_geometry / triangle_geometry /
# line_geometry / colored_indexed_geometry, the private scalar helpers, and
# the standalone free function geometry_vertex_layout_matches.
#
# PrimitiveTopology lives here (not in geometry/layout): Geometry's
# topology discerne sites and the free constructors' variant construction
# must stay same-module under the current file-interface rules, and
# topology_code stays co-located with the enum it matches.
#
# Imports: triga:math, triga:geometry/attribute, triga:geometry/layout,
# triga:geometry/bounds, triga:geometry/batch.

import from "triga:math" math

import from "triga:geometry/attribute" attribute

import from "triga:geometry/layout" layout

import from "triga:geometry/bounds" bounds

import from "triga:geometry/batch" batch

# PrimitiveTopology is the small source-side choice that controls element
# grouping, draw-range validity, and the numeric code passed to shader facts.
@ public
union PrimitiveTopology {
    TriangleList,
    LineList,
    PointList
}

# ColoredQuadMesh is the accumulation-friendly shape used by voxel and face
# examples. Positions, colors, and indices remain parallel lists until the
# `geometry()` projection turns them into a validated Geometry.
@ public
class ColoredQuadMesh {
    mut list<f32> positions
    mut list<f32> colors
    mut list<u32> indices

    fn face_count() → int ∪ none {
        if self.positions.length() ≢ self.colors.length() then return null
        if self.positions.length() % 12 ≢ 0 then return null
        if self.indices.length() % 6 ≢ 0 then return null
        let int count ← self.positions.length() / 12
        if count ≡ 0 then return null
        if self.indices.length() ≢ count * 6 then return null
        return count
    }

    fn geometry() → Geometry ∪ none {
        if self.positions.length() ≢ self.colors.length() then return null
        if self.positions.length() % 3 ≢ 0 then return null
        if self.indices.length() % 3 ≢ 0 then return null
        let int vertex_count ← self.positions.length() / 3
        return colored_indexed_geometry(vertex_count, self.positions, self.colors, self.indices)
    }

    fn facts() → batch.VisibleFaceMeshFacts ∪ none {
        let int ∪ none face_count_result ← self.face_count()
        if face_count_result is none then return null
        let int face_count ← face_count_result
        return batch.visible_face_mesh_facts(face_count)
    }

    fn draw_batch_facts(int instance_count) → batch.IndexedGeometryDrawBatchFacts ∪ none {
        let Geometry ∪ none geometry_result ← self.geometry()
        if geometry_result is none then return null
        let Geometry geom ← geometry_result
        return geom.indexed_draw_batch_facts(instance_count)
    }

    fn bounding_box() → bounds.BoundingBox ∪ none {
        let Geometry ∪ none geometry_result ← self.geometry()
        if geometry_result is none then return null
        let Geometry geom ← geometry_result
        return geom.bounding_box()
    }

    fn bounding_sphere() → bounds.BoundingSphere ∪ none {
        let Geometry ∪ none geometry_result ← self.geometry()
        if geometry_result is none then return null
        let Geometry geom ← geometry_result
        return geom.bounding_sphere()
    }
}

# Geometry is Triga's central CPU-side mesh contract. It keeps attribute
# streams, optional indices, draw ranges, and material groups together so every
# query can validate the same shape before exposing counts, bounds, layout, or
# host draw facts.
@ public
class Geometry {
    mut PrimitiveTopology topology
    mut int vertex_count
    mut list<attribute.Attribute> attributes
    mut bool indexed
    mut list<u32> indices
    mut batch.DrawRange draw_range
    mut list<batch.GeometryGroup> groups

    # --- Validation -----------------------------------------------------
    # Validation-sensitive projections below call `valid()` first. Invalid
    # geometry returns `null` rather than leaking partial facts to a later
    # stage; structural queries such as `element_count()` remain direct.

    fn valid() → bool {
        if self.vertex_count ≡ 0 then return false
        if not self.attributes_valid() then return false
        if not self.indices_valid() then return false
        let int element_count ← self.element_count()
        if self.draw_range.count ≡ 0 then return false
        if self.draw_range.start + self.draw_range.count ≻ element_count then return false
        if not topology_range_valid(self.topology, self.draw_range.start, self.draw_range.count) then return false
        if not self.topology_valid() then return false
        return self.groups_valid()
    }

    fn attributes_valid() → bool {
        mut bool has_position ← false
        for range 0‥self.attributes.length() let i {
            let attribute.Attribute attr ← self.attributes[i]
            if not attr.valid() then return false
            if attr.element_count ≢ self.vertex_count then return false
            if attr.name ≡ "position" {
                has_position ← true
                if attr.component_width ≢ 3 then return false
                if attr.float32_values() is none then return false
            }
            for range 0‥i let j {
                let attribute.Attribute previous ← self.attributes[j]
                if previous.name ≡ attr.name then return false
                if previous.shader_location ≡ attr.shader_location then return false
            }
        }
        return has_position
    }

    fn indices_valid() → bool {
        if not self.indexed then return self.indices.length() ≡ 0
        if self.indices.length() ≡ 0 then return false
        for from self.indices let raw {
            let int index ↤ raw
            if index ≥ self.vertex_count then return false
        }
        return true
    }

    fn groups_valid() → bool {
        let int element_count ← self.element_count()
        mut int previous_end ← 0
        for range 0‥self.groups.length() let i {
            let batch.GeometryGroup group ← self.groups[i]
            if group.count ≡ 0 then return false
            if not topology_range_valid(self.topology, group.start, group.count) then return false
            if group.start ≺ previous_end then return false
            let int group_end ← group.start + group.count
            if group_end ≻ element_count then return false
            previous_end ← group_end
        }
        return true
    }

    fn topology_valid() → bool {
        let int element_count ← self.element_count()
        match self.topology {
            case TriangleList {
                return element_count_divisible(element_count, 3)
            }
            case LineList {
                return element_count_divisible(element_count, 2)
            }
            case PointList {
                return element_count ≻ 0
            }
        }
    }

    # --- Element / vertex / index queries -------------------------------

    fn element_count() → int {
        if not self.indexed then return self.vertex_count
        return self.indices.length()
    }

    fn validated_vertex_count() → int ∪ none {
        if not self.valid() then return null
        return self.vertex_count
    }

    fn index_count() → int ∪ none {
        if not self.valid() then return null
        if not self.indexed then return null
        let int count ← self.indices.length()
        return count
    }

    fn index_format_code() → int ∪ none {
        if not self.valid() then return null
        if not self.indexed then return null
        return 1
    }

    fn group_count() → int ∪ none {
        if not self.valid() then return null
        let int count ← self.groups.length()
        return count
    }

    # --- Attribute payload byte counts ----------------------------------

    fn attribute_byte_count(string name) → int ∪ none {
        if not self.valid() then return null
        for from self.attributes let attribute {
            if attribute.name ≡ name {
                let int scalars ← attribute.scalar_count()
                let int bytes ← scalars * attribute.scalar_bytes()
                return bytes
            }
        }
        return null
    }

    fn attribute_scalar_count(string name) → int ∪ none {
        if not self.valid() then return null
        for from self.attributes let attribute {
            if attribute.name ≡ name then return attribute.scalar_count()
        }
        return null
    }

    fn vertex_payload_byte_count() → int ∪ none {
        if not self.valid() then return null
        mut int total ← 0
        for from self.attributes let attribute {
            total ← total + attribute.scalar_count() * attribute.scalar_bytes()
        }
        return total
    }

    fn index_payload_byte_count() → int ∪ none {
        if not self.valid() then return null
        if not self.indexed then return null
        let int bytes ← self.indices.length() * 4
        return bytes
    }

    fn payload_byte_count() → int ∪ none {
        let int ∪ none vertex_bytes_result ← self.vertex_payload_byte_count()
        if vertex_bytes_result is none then return null
        let int vertex_bytes ← vertex_bytes_result
        let int ∪ none index_bytes_result ← self.index_payload_byte_count()
        if index_bytes_result is none then return vertex_bytes
        let int index_bytes ← index_bytes_result
        return vertex_bytes + index_bytes
    }

    # --- Primitive counts -----------------------------------------------

    fn triangle_count() → int ∪ none {
        if not self.valid() then return null
        match self.topology {
            case TriangleList {
            }
            case LineList {
                return null
            }
            case PointList {
                return null
            }
        }
        return self.element_count() / 3
    }

    fn line_count() → int ∪ none {
        if not self.valid() then return null
        match self.topology {
            case TriangleList {
                return null
            }
            case LineList {
            }
            case PointList {
                return null
            }
        }
        return self.element_count() / 2
    }

    # --- Draw commands ---------------------------------------------------

    fn draw_command(int instance_count) → batch.GeometryDrawCommand ∪ none {
        if not self.valid() then return null
        if instance_count ≡ 0 then return null
        return batch.GeometryDrawCommand {indexed = self.indexed, element_count = self.draw_range.count, first_element = self.draw_range.start, base_vertex = 0, instance_count = instance_count, material_index = 0}
    }

    fn group_draw_command(int group_index, int instance_count) → batch.GeometryDrawCommand ∪ none {
        if not self.valid() then return null
        if group_index ≥ self.groups.length() then return null
        if instance_count ≡ 0 then return null
        let batch.GeometryGroup group ← self.groups[group_index]
        return batch.GeometryDrawCommand {indexed = self.indexed, element_count = group.count, first_element = group.start, base_vertex = 0, instance_count = instance_count, material_index = group.material_index}
    }

    fn group_draw_commands(int instance_count) → list<batch.GeometryDrawCommand> ∪ none {
        if not self.valid() then return null
        if instance_count ≡ 0 then return null
        mut list<batch.GeometryDrawCommand> commands ← empty
        for range 0‥self.groups.length() let i {
            let batch.GeometryDrawCommand ∪ none command ← self.group_draw_command(i, instance_count)
            if command is none then return null
            let batch.GeometryDrawCommand value ← command
            commands.append(value)
        }
        return commands
    }

    fn group_element_total() → int ∪ none {
        if not self.valid() then return null
        mut int total ← 0
        for from self.groups let group {
            total ← total + group.count
        }
        return total
    }

    # --- Bounding volumes ------------------------------------------------

    fn bounding_box() → bounds.BoundingBox ∪ none {
        if not self.valid() then return null
        let list<f32> positions ← self.position_values()
        mut f32 min_x ← positions[0]
        mut f32 min_y ← positions[1]
        mut f32 min_z ← positions[2]
        mut f32 max_x ← positions[0]
        mut f32 max_y ← positions[1]
        mut f32 max_z ← positions[2]
        mut int i ← 3
        while i ≺ positions.length() {
            let f32 x ← positions[i]
            let f32 y ← positions[i + 1]
            let f32 z ← positions[i + 2]
            min_x ← min_x ⤓ x
            min_y ← min_y ⤓ y
            min_z ← min_z ⤓ z
            max_x ← max_x ⤒ x
            max_y ← max_y ⤒ y
            max_z ← max_z ⤒ z
            i ← i + 3
        }
        return bounds.BoundingBox {min_x = min_x, min_y = min_y, min_z = min_z, max_x = max_x, max_y = max_y, max_z = max_z}
    }

    fn group_bounding_box(int group_index) → bounds.BoundingBox ∪ none {
        if not self.valid() then return null
        if group_index ≥ self.groups.length() then return null
        let batch.GeometryGroup group ← self.groups[group_index]
        let list<f32> positions ← self.position_values()
        mut int vertex_index ← group.start
        if self.indexed {
            vertex_index ↤ self.indices[group.start]
        }
        mut int position_index ← vertex_index * 3
        mut f32 min_x ← positions[position_index]
        mut f32 min_y ← positions[position_index + 1]
        mut f32 min_z ← positions[position_index + 2]
        mut f32 max_x ← min_x
        mut f32 max_y ← min_y
        mut f32 max_z ← min_z
        mut int i ← group.start
        let int end ← group.start + group.count
        while i ≺ end {
            vertex_index ← i
            if self.indexed {
                vertex_index ↤ self.indices[i]
            }
            position_index ← vertex_index * 3
            let f32 x ← positions[position_index]
            let f32 y ← positions[position_index + 1]
            let f32 z ← positions[position_index + 2]
            min_x ← min_x ⤓ x
            min_y ← min_y ⤓ y
            min_z ← min_z ⤓ z
            max_x ← max_x ⤒ x
            max_y ← max_y ⤒ y
            max_z ← max_z ⤒ z
            i ← i + 1
        }
        return bounds.BoundingBox {min_x = min_x, min_y = min_y, min_z = min_z, max_x = max_x, max_y = max_y, max_z = max_z}
    }

    fn bounding_sphere() → bounds.BoundingSphere ∪ none {
        let bounds.BoundingBox ∪ none bounds_result ← self.bounding_box()
        if bounds_result is none then return null
        let bounds.BoundingBox bnd ← bounds_result
        let f32 center_x ← (bnd.min_x + bnd.max_x) * 0.5
        let f32 center_y ← (bnd.min_y + bnd.max_y) * 0.5
        let f32 center_z ← (bnd.min_z + bnd.max_z) * 0.5
        let list<f32> positions ← self.position_values()
        mut f32 radius_squared ← 0.0
        mut int i ← 0
        while i ≺ positions.length() {
            let f32 dx ← positions[i] - center_x
            let f32 dy ← positions[i + 1] - center_y
            let f32 dz ← positions[i + 2] - center_z
            let f32 distance_squared ← (dx * dx + dy * dy) + dz * dz
            radius_squared ← distance_squared ⤒ radius_squared
            i ← i + 3
        }
        return bounds.BoundingSphere {center_x = center_x, center_y = center_y, center_z = center_z, radius = math.sqrt_f32(radius_squared)}
    }

    fn group_bounding_sphere(int group_index) → bounds.BoundingSphere ∪ none {
        let bounds.BoundingBox ∪ none bounds_result ← self.group_bounding_box(group_index)
        if bounds_result is none then return null
        let bounds.BoundingBox bnd ← bounds_result
        let f32 center_x ← (bnd.min_x + bnd.max_x) * 0.5
        let f32 center_y ← (bnd.min_y + bnd.max_y) * 0.5
        let f32 center_z ← (bnd.min_z + bnd.max_z) * 0.5
        let batch.GeometryGroup group ← self.groups[group_index]
        let list<f32> positions ← self.position_values()
        mut f32 radius_squared ← 0.0
        mut int i ← group.start
        let int end ← group.start + group.count
        while i ≺ end {
            mut int vertex_index ← i
            if self.indexed {
                vertex_index ↤ self.indices[i]
            }
            let int position_index ← vertex_index * 3
            let f32 dx ← positions[position_index] - center_x
            let f32 dy ← positions[position_index + 1] - center_y
            let f32 dz ← positions[position_index + 2] - center_z
            let f32 distance_squared ← (dx * dx + dy * dy) + dz * dz
            radius_squared ← distance_squared ⤒ radius_squared
            i ← i + 1
        }
        return bounds.BoundingSphere {center_x = center_x, center_y = center_y, center_z = center_z, radius = math.sqrt_f32(radius_squared)}
    }

    # --- Normals and UVs -------------------------------------------------

    fn vertex_normals() → attribute.Attribute ∪ none {
        if not self.valid() then return null
        match self.topology {
            case TriangleList {
            }
            case LineList {
                return null
            }
            case PointList {
                return null
            }
        }
        let list<f32> positions ← self.position_values()
        mut list<f32> normals ← empty
        for range 0‥positions.length() let _ {
            normals.append(0.0)
        }
        mut int i ← 0
        while i ≺ self.element_count() {
            mut int a ← i
            mut int b ← i + 1
            mut int c ← i + 2
            if self.indexed {
                a ↤ self.indices[i]
                b ↤ self.indices[i + 1]
                c ↤ self.indices[i + 2]
            }
            let int ai ← a * 3
            let int bi ← b * 3
            let int ci ← c * 3
            let f32 ab_x ← positions[bi] - positions[ai]
            let f32 ab_y ← positions[bi + 1] - positions[ai + 1]
            let f32 ab_z ← positions[bi + 2] - positions[ai + 2]
            let f32 ac_x ← positions[ci] - positions[ai]
            let f32 ac_y ← positions[ci + 1] - positions[ai + 1]
            let f32 ac_z ← positions[ci + 2] - positions[ai + 2]
            let f32 nx ← ab_y * ac_z - ab_z * ac_y
            let f32 ny ← ab_z * ac_x - ab_x * ac_z
            let f32 nz ← ab_x * ac_y - ab_y * ac_x
            normals[ai] ← normals[ai] + nx
            normals[ai + 1] ← normals[ai + 1] + ny
            normals[ai + 2] ← normals[ai + 2] + nz
            normals[bi] ← normals[bi] + nx
            normals[bi + 1] ← normals[bi + 1] + ny
            normals[bi + 2] ← normals[bi + 2] + nz
            normals[ci] ← normals[ci] + nx
            normals[ci + 1] ← normals[ci + 1] + ny
            normals[ci + 2] ← normals[ci + 2] + nz
            i ← i + 3
        }
        i ← 0
        let f32 zero ← 0.0
        while i ≺ normals.length() {
            let f32 abs_x ← normals[i].abs()
            let f32 abs_y ← normals[i + 1].abs()
            let f32 abs_z ← normals[i + 2].abs()
            let f32 normal_max ← abs_x ⤒ abs_y ⤒ abs_z
            if normal_max ≡ zero then return null
            let f32 scaled_x ← normals[i] / normal_max
            let f32 scaled_y ← normals[i + 1] / normal_max
            let f32 scaled_z ← normals[i + 2] / normal_max
            let f32 normal_scale ← normal_max * math.sqrt_f32((scaled_x * scaled_x + scaled_y * scaled_y) + scaled_z * scaled_z)
            normals[i] ← normals[i] / normal_scale
            normals[i + 1] ← normals[i + 1] / normal_scale
            normals[i + 2] ← normals[i + 2] / normal_scale
            i ← i + 3
        }
        return attribute.float32_attribute("normal", 1, 3, self.vertex_count, normals)
    }

    fn planar_uvs() → attribute.Attribute ∪ none {
        let bounds.BoundingBox ∪ none bounds_result ← self.bounding_box()
        if bounds_result is none then return null
        let bounds.BoundingBox bnd ← bounds_result
        let f32 width ← bnd.max_x - bnd.min_x
        let f32 height ← bnd.max_y - bnd.min_y
        let f32 zero ← 0.0
        if width ≡ zero or height ≡ zero then return null
        let list<f32> positions ← self.position_values()
        mut list<f32> uvs ← empty
        mut int i ← 0
        while i ≺ positions.length() {
            uvs.append((positions[i] - bnd.min_x) / width)
            uvs.append((positions[i + 1] - bnd.min_y) / height)
            i ← i + 3
        }
        return attribute.float32_attribute("uv", 2, 2, self.vertex_count, uvs)
    }

    # --- Vertex layout introspection ------------------------------------
    fn position_values() → list<f32> {
        mut list<f32> positions ← empty
        for from self.attributes let attr {
            if attr.name ≡ "position" {
                let list<f32> ∪ none values ← attr.float32_values()
                if values not is none {
                    positions ← values
                }
            }
        }
        return positions
    }

    fn vertex_layout_at(int index) → layout.VertexAttributeLayout ∪ none {
        if not self.valid() then return null
        if index ≥ self.attributes.length() then return null
        let attribute.Attribute attr ← self.attributes[index]
        return attr.vertex_layout()
    }

    fn topology_code() → int ∪ none {
        if not self.valid() then return null
        return topology_code(self.topology)
    }

    fn vertex_layout_count() → int ∪ none {
        if not self.valid() then return null
        let int count ← self.attributes.length()
        return count
    }

    fn vertex_layout_location(int index) → int ∪ none {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return null
        let layout.VertexAttributeLayout lay ← layout_result
        return lay.shader_location
    }

    fn vertex_layout_source_name(int index) → string ∪ none {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return null
        let layout.VertexAttributeLayout lay ← layout_result
        return lay.source_name
    }

    fn vertex_layout_format_code(int index) → int ∪ none {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return null
        let layout.VertexAttributeLayout lay ← layout_result
        return layout.layout_format_code(lay)
    }

    fn vertex_layout_offset_bytes(int index) → int ∪ none {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return null
        let layout.VertexAttributeLayout lay ← layout_result
        return lay.offset_bytes
    }

    fn vertex_layout_stride_bytes(int index) → int ∪ none {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return null
        let layout.VertexAttributeLayout lay ← layout_result
        return lay.stride_bytes
    }

    fn vertex_layout_step_mode_code(int index) → int ∪ none {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return null
        let layout.VertexAttributeLayout lay ← layout_result
        return layout.layout_step_mode_code(lay)
    }

    fn vertex_layout_matches(int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code) → bool {
        let layout.VertexAttributeLayout ∪ none layout_result ← self.vertex_layout_at(index)
        if layout_result is none then return false
        let layout.VertexAttributeLayout lay ← layout_result
        return ((((lay.source_name ≡ source_name and lay.shader_location ≡ shader_location) and layout.layout_format_code(lay) ≡ format_code) and lay.offset_bytes ≡ offset_bytes) and lay.stride_bytes ≡ stride_bytes) and layout.layout_step_mode_code(lay) ≡ step_mode_code
    }

    fn vertex_layouts() → list<layout.VertexAttributeLayout> ∪ none {
        if not self.valid() then return null
        mut list<layout.VertexAttributeLayout> layouts ← empty
        for from self.attributes let attr {
            let layout.VertexAttributeLayout ∪ none layout_result ← attr.vertex_layout()
            if layout_result is none then return null
            let layout.VertexAttributeLayout lay ← layout_result
            layouts.append(lay)
        }
        return layouts
    }

    # --- Batch facts -----------------------------------------------------

    fn indexed_draw_batch_facts(int instance_count) → batch.IndexedGeometryDrawBatchFacts ∪ none {
        if not self.valid() then return null
        if not self.indexed then return null
        if instance_count ≡ 0 then return null
        let list<batch.GeometryDrawCommand> ∪ none commands_result ← self.group_draw_commands(instance_count)
        if commands_result is none then return null
        let list<batch.GeometryDrawCommand> commands ← commands_result
        let int ∪ none grouped_elements_result ← self.group_element_total()
        if grouped_elements_result is none then return null
        let int ∪ none vertex_bytes_result ← self.vertex_payload_byte_count()
        if vertex_bytes_result is none then return null
        let int ∪ none index_bytes_result ← self.index_payload_byte_count()
        if index_bytes_result is none then return null
        let int ∪ none total_bytes_result ← self.payload_byte_count()
        if total_bytes_result is none then return null
        return batch.IndexedGeometryDrawBatchFacts {draw_count = commands.length(), grouped_element_total = grouped_elements_result, vertex_payload_byte_count = vertex_bytes_result, index_payload_byte_count = index_bytes_result, total_payload_byte_count = total_bytes_result}
    }

    fn line_draw_batch_facts(int instance_count) → batch.LineGeometryDrawBatchFacts ∪ none {
        if not self.valid() then return null
        if not self.indexed then return null
        if instance_count ≡ 0 then return null
        let int ∪ none line_count_result ← self.line_count()
        if line_count_result is none then return null
        let batch.IndexedGeometryDrawBatchFacts ∪ none batch_result ← self.indexed_draw_batch_facts(instance_count)
        if batch_result is none then return null
        let int line_count_value ← line_count_result
        let batch.IndexedGeometryDrawBatchFacts batch_facts ← batch_result
        return batch.LineGeometryDrawBatchFacts {draw_count = batch_facts.draw_count, line_count = line_count_value, grouped_element_total = batch_facts.grouped_element_total, vertex_payload_byte_count = batch_facts.vertex_payload_byte_count, index_payload_byte_count = batch_facts.index_payload_byte_count, total_payload_byte_count = batch_facts.total_payload_byte_count}
    }
}

# --- Free constructors for Geometry ---

# These constructors make the indexed/non-indexed choice explicit while
# sharing the same attribute, range, and group validation path.

@ public
fn indexed_triangle_geometry(int vertex_count, ref list<attribute.Attribute> attributes, list<u32> indices, batch.DrawRange draw_range, list<batch.GeometryGroup> groups) → Geometry {
    return Geometry {topology = TriangleList(), vertex_count = vertex_count, attributes = attributes, indexed = true, indices = indices, draw_range = draw_range, groups = groups}
}

@ public
fn triangle_geometry(int vertex_count, ref list<attribute.Attribute> attributes, batch.DrawRange draw_range, list<batch.GeometryGroup> groups) → Geometry {
    return Geometry {topology = TriangleList(), vertex_count = vertex_count, attributes = attributes, indexed = false, indices = empty, draw_range = draw_range, groups = groups}
}

@ public
fn line_geometry(int vertex_count, ref list<attribute.Attribute> attributes, list<u32> indices, batch.DrawRange draw_range, list<batch.GeometryGroup> groups) → Geometry {
    return Geometry {topology = LineList(), vertex_count = vertex_count, attributes = attributes, indexed = true, indices = indices, draw_range = draw_range, groups = groups}
}

@ public
fn colored_indexed_geometry(int vertex_count, list<f32> positions, list<f32> colors, list<u32> indices) → Geometry ∪ none {
    let attribute.Attribute position_attribute ← attribute.float32_attribute("position", 0, 3, vertex_count, positions)
    let attribute.Attribute color_attribute ← attribute.float32_attribute("color", 1, 3, vertex_count, colors)
    let Geometry geometry ← indexed_triangle_geometry(vertex_count, [position_attribute, color_attribute], indices, batch.DrawRange {start = 0, count = indices.length()}, [batch.GeometryGroup {start = 0, count = indices.length(), material_index = 0}])
    if not geometry.valid() then return null
    return geometry
}

# --- Free helper functions ---

# Append helpers preserve the same parallel-list contract as ColoredQuadMesh;
# they are useful when a caller wants to build a mesh one face at a time.

@ public
fn colored_quad_mesh_append(list<f32> positions, list<f32> colors, list<u32> indices, vector<f32, 3> a, vector<f32, 3> b, vector<f32, 3> c, vector<f32, 3> d, ref math.Color color) → ColoredQuadMesh ∪ none {
    if positions.length() ≢ colors.length() then return null
    if positions.length() % 3 ≢ 0 then return null
    if indices.length() % 3 ≢ 0 then return null
    mut list<f32> next_positions ← empty
    for from positions let value {
        next_positions.append(value)
    }
    mut list<f32> next_colors ← empty
    for from colors let value {
        next_colors.append(value)
    }
    mut list<u32> next_indices ← empty
    for from indices let value {
        next_indices.append(value)
    }
    let int vertex_base ← positions.length() / 3
    next_positions.append(math.x(a))
    next_positions.append(math.y(a))
    next_positions.append(math.z(a))
    next_positions.append(math.x(b))
    next_positions.append(math.y(b))
    next_positions.append(math.z(b))
    next_positions.append(math.x(c))
    next_positions.append(math.y(c))
    next_positions.append(math.z(c))
    next_positions.append(math.x(d))
    next_positions.append(math.y(d))
    next_positions.append(math.z(d))
    for range 0‥4 let corner {
        next_colors.append(color.r)
        next_colors.append(color.g)
        next_colors.append(color.b)
    }
    # A base index that does not fit u32 is an invalid mesh, reported the same
    # way as the other invalid inputs above.
    do {
        next_indices.append(vertex_base ↦ u32)
        next_indices.append(vertex_base + 1 ↦ u32)
        next_indices.append(vertex_base + 2 ↦ u32)
        next_indices.append(vertex_base ↦ u32)
        next_indices.append(vertex_base + 2 ↦ u32)
        next_indices.append(vertex_base + 3 ↦ u32)
    }
    catch err {
        return null
    }
    return ColoredQuadMesh {positions = next_positions, colors = next_colors, indices = next_indices}
}

# --- Private scalar and code helpers (free, no genus receiver) ---

fn topology_code(ref PrimitiveTopology topology) → int {
    match topology {
        case TriangleList {
            return 1
        }
        case LineList {
            return 2
        }
        case PointList {
            return 3
        }
    }
}

fn element_count_divisible(int element_count, int divisor) → bool {
    return element_count % divisor ≡ 0
}

fn topology_range_valid(ref PrimitiveTopology topology, int start, int count) → bool {
    match topology {
        case TriangleList {
            return element_count_divisible(start, 3) and element_count_divisible(count, 3)
        }
        case LineList {
            return element_count_divisible(start, 2) and element_count_divisible(count, 2)
        }
        case PointList {
            return count ≻ 0
        }
    }
}

# --- Standalone vertex-layout assertion (wraps Geometry method) ---
#
# Contract-role adapter: the compiler-owned `@ shader_contract "vertex_layout"`
# annotation maps this real Triga API onto the generic shader-contract surface
# radix recognizes (see src/shader_contract.fab). The argument shape matches
# the canonical vertex_layout role: (geo, index, source_name, location,
# format_code, offset_bytes, stride_bytes, step_mode_code).

@ public
@ shader_contract "vertex_layout"
fn geometry_vertex_layout_matches(Geometry geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code) → bool {
    return geo.vertex_layout_matches(index, source_name, shader_location, format_code, offset_bytes, stride_bytes, step_mode_code)
}
