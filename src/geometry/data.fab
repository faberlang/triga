# CPU-side geometry data, topology, and mesh construction.
#
# Public import: import from "triga:geometry/data" data
#
# Owns: BufferGeometry (+ all methods, including index_format_code() and
# topology_code()), ColoredQuadMesh (+ methods), colored_quad_mesh_append,
# the free constructors indexed_triangle_geometry / triangle_geometry /
# line_geometry / colored_indexed_geometry, the private scalar helpers, and
# the standalone free function geometry_vertex_layout_matches.
#
# PrimitiveTopology lives here (not in geometry/layout): BufferGeometry's
# topology discerne sites and the free constructors' variant construction
# must stay same-module under the current file-interface rules, and
# topology_code stays co-located with the enum it matches.
#
# Imports: triga:math, triga:geometry/attribute, triga:geometry/layout,
# triga:geometry/bounds, triga:geometry/batch.

import from "triga:math" math

import from "triga:geometry/attribute" attribute

import from "triga:geometry/layout" layout

import from "triga:geometry/bounds" bounds

import from "triga:geometry/batch" batch

# PrimitiveTopology is the small source-side choice that controls element
# grouping, draw-range validity, and the numeric code passed to shader facts.
@ public
union PrimitiveTopology {
    TriangleList,
    LineList,
    PointList
}

# ColoredQuadMesh is the accumulation-friendly shape used by voxel and face
# examples. Positions, colors, and indices remain parallel lists until the
# `geometry()` projection turns them into a validated BufferGeometry.
@ public
class ColoredQuadMesh {
    list<f32> positions
    list<f32> colors
    list<u32> indices

    fn face_count() → int ∪ null {
        if self.positions.length() ≠ self.colors.length() then return null
        if self.positions.length() % 12 ≠ 0 then return null
        if self.indices.length() % 6 ≠ 0 then return null
        const int count ← self.positions.length() / 12
        if count ≡ 0 then return null
        if self.indices.length() ≠ count * 6 then return null
        return count
    }

    fn geometry() → BufferGeometry ∪ null {
        if self.positions.length() ≠ self.colors.length() then return null
        if self.positions.length() % 3 ≠ 0 then return null
        if self.indices.length() % 3 ≠ 0 then return null
        const int vertex_count ← self.positions.length() / 3
        return colored_indexed_geometry(vertex_count, self.positions, self.colors, self.indices)
    }

    fn facts() → batch.VisibleFaceMeshFacts ∪ null {
        const int ∪ null face_count_result ← self.face_count()
        if face_count_result is null then return null
        const int face_count ← face_count_result
        return batch.visible_face_mesh_facts(face_count)
    }

    fn draw_batch_facts(int instance_count) → batch.IndexedGeometryDrawBatchFacts ∪ null {
        const BufferGeometry ∪ null geometry_result ← self.geometry()
        if geometry_result is null then return null
        const BufferGeometry geom ← geometry_result
        return geom.indexed_draw_batch_facts(instance_count)
    }

    fn bounding_box() → bounds.BoundingBox ∪ null {
        const BufferGeometry ∪ null geometry_result ← self.geometry()
        if geometry_result is null then return null
        const BufferGeometry geom ← geometry_result
        return geom.bounding_box()
    }

    fn bounding_sphere() → bounds.BoundingSphere ∪ null {
        const BufferGeometry ∪ null geometry_result ← self.geometry()
        if geometry_result is null then return null
        const BufferGeometry geom ← geometry_result
        return geom.bounding_sphere()
    }
}

# BufferGeometry is Triga's central CPU-side mesh contract. It keeps attribute
# streams, optional indices, draw ranges, and material groups together so every
# query can validate the same shape before exposing counts, bounds, layout, or
# host draw facts.
@ public
class BufferGeometry {
    PrimitiveTopology topology
    int vertex_count
    list<attribute.BufferAttribute> attributes
    bool indexed
    list<u32> indices
    batch.DrawRange draw_range
    list<batch.GeometryGroup> groups

    # --- Validation -----------------------------------------------------
    # Validation-sensitive projections below call `valida()` first. Invalid
    # geometry returns `null` rather than leaking partial facts to a later
    # stage; structural queries such as `element_count()` remain direct.

    fn valida() → bool {
        if self.vertex_count ≡ 0 then return false
        if self.attributes_valid() ≡ false then return false
        if self.indices_valid() ≡ false then return false
        const int element_count ← self.element_count()
        if self.draw_range.count ≡ 0 then return false
        if self.draw_range.start + self.draw_range.count ≻ element_count then return false
        if topology_range_valid(self.topology, self.draw_range.start, self.draw_range.count) ≡ false then return false
        if self.topology_valid() ≡ false then return false
        return self.groups_valid()
    }

    fn attributes_valid() → bool {
        var bool has_position ← false
        for range 0‥self.attributes.length() const i {
            const attribute.BufferAttribute attr ← self.attributes[i]
            if attr.valida() ≡ false then return false
            if attr.element_count ≠ self.vertex_count then return false
            if attr.name ≡ "position" {
                has_position ← true
                if attr.component_width ≠ 3 then return false
                if attr.float32_values() is null then return false
            }
            for range 0‥i const j {
                const attribute.BufferAttribute previous ← self.attributes[j]
                if previous.name ≡ attr.name then return false
                if previous.shader_location ≡ attr.shader_location then return false
            }
        }
        return has_position
    }

    fn indices_valid() → bool {
        if self.indexed ≡ false then return self.indices.length() ≡ 0
        if self.indices.length() ≡ 0 then return false
        for range 0‥self.indices.length() const i {
            const int index ↤ self.indices[i]
            if index ≥ self.vertex_count then return false
        }
        return true
    }

    fn groups_valid() → bool {
        const int element_count ← self.element_count()
        var int previous_end ← 0
        for range 0‥self.groups.length() const i {
            const batch.GeometryGroup group ← self.groups[i]
            if group.count ≡ 0 then return false
            if topology_range_valid(self.topology, group.start, group.count) ≡ false then return false
            if group.start ≺ previous_end then return false
            const int group_end ← group.start + group.count
            if group_end ≻ element_count then return false
            previous_end ← group_end
        }
        return true
    }

    fn topology_valid() → bool {
        const int element_count ← self.element_count()
        match self.topology {
            case TriangleList {
                return element_count_divisible(element_count, 3)
            }
            case LineList {
                return element_count_divisible(element_count, 2)
            }
            case PointList {
                return element_count ≻ 0
            }
        }
    }

    # --- Element / vertex / index queries -------------------------------

    fn element_count() → int {
        if self.indexed ≡ false then return self.vertex_count
        return self.indices.length()
    }

    fn validated_vertex_count() → int ∪ null {
        if self.valida() ≡ false then return null
        return self.vertex_count
    }

    fn index_count() → int ∪ null {
        if self.valida() ≡ false then return null
        if self.indexed ≡ false then return null
        const int count ← self.indices.length()
        return count
    }

    fn index_format_code() → int ∪ null {
        if self.valida() ≡ false then return null
        if self.indexed ≡ false then return null
        return 1
    }

    fn group_count() → int ∪ null {
        if self.valida() ≡ false then return null
        const int count ← self.groups.length()
        return count
    }

    # --- Attribute payload byte counts ----------------------------------

    fn attribute_byte_count(string name) → int ∪ null {
        if self.valida() ≡ false then return null
        for from self.attributes const attribute {
            if attribute.name ≡ name {
                const int scalars ← attribute.scalar_count()
                const int bytes ← scalars * attribute.scalar_bytes()
                return bytes
            }
        }
        return null
    }

    fn attribute_scalar_count(string name) → int ∪ null {
        if self.valida() ≡ false then return null
        for range 0‥self.attributes.length() const i {
            const attribute.BufferAttribute attribute ← self.attributes[i]
            if attribute.name ≡ name then return attribute.scalar_count()
        }
        return null
    }

    fn vertex_payload_byte_count() → int ∪ null {
        if self.valida() ≡ false then return null
        var int total ← 0
        for from self.attributes const attribute {
            total ← total + attribute.scalar_count() * attribute.scalar_bytes()
        }
        return total
    }

    fn index_payload_byte_count() → int ∪ null {
        if self.valida() ≡ false then return null
        if self.indexed ≡ false then return null
        const int bytes ← self.indices.length() * 4
        return bytes
    }

    fn payload_byte_count() → int ∪ null {
        const int ∪ null vertex_bytes_result ← self.vertex_payload_byte_count()
        if vertex_bytes_result is null then return null
        const int vertex_bytes ← vertex_bytes_result
        const int ∪ null index_bytes_result ← self.index_payload_byte_count()
        if index_bytes_result is null then return vertex_bytes
        const int index_bytes ← index_bytes_result
        return vertex_bytes + index_bytes
    }

    # --- Primitive counts -----------------------------------------------

    fn triangle_count() → int ∪ null {
        if self.valida() ≡ false then return null
        match self.topology {
            case TriangleList {
            }
            case LineList {
                return null
            }
            case PointList {
                return null
            }
        }
        return self.element_count() / 3
    }

    fn line_count() → int ∪ null {
        if self.valida() ≡ false then return null
        match self.topology {
            case TriangleList {
                return null
            }
            case LineList {
            }
            case PointList {
                return null
            }
        }
        return self.element_count() / 2
    }

    # --- Draw commands ---------------------------------------------------

    fn draw_command(int instance_count) → batch.GeometryDrawCommand ∪ null {
        if self.valida() ≡ false then return null
        if instance_count ≡ 0 then return null
        return batch.GeometryDrawCommand {indexed = self.indexed, element_count = self.draw_range.count, first_element = self.draw_range.start, base_vertex = 0, instance_count = instance_count, material_index = 0}
    }

    fn group_draw_command(int group_index, int instance_count) → batch.GeometryDrawCommand ∪ null {
        if self.valida() ≡ false then return null
        if group_index ≥ self.groups.length() then return null
        if instance_count ≡ 0 then return null
        const batch.GeometryGroup group ← self.groups[group_index]
        return batch.GeometryDrawCommand {indexed = self.indexed, element_count = group.count, first_element = group.start, base_vertex = 0, instance_count = instance_count, material_index = group.material_index}
    }

    fn group_draw_commands(int instance_count) → list<batch.GeometryDrawCommand> ∪ null {
        if self.valida() ≡ false then return null
        if instance_count ≡ 0 then return null
        var list<batch.GeometryDrawCommand> commands ← empty
        for range 0‥self.groups.length() const i {
            const batch.GeometryDrawCommand ∪ null command ← self.group_draw_command(i, instance_count)
            if command is null then return null
            const batch.GeometryDrawCommand value ← command
            commands.append(value)
        }
        return commands
    }

    fn group_element_total() → int ∪ null {
        if self.valida() ≡ false then return null
        var int total ← 0
        for range 0‥self.groups.length() const i {
            total ← total + self.groups[i].count
        }
        return total
    }

    # --- Bounding volumes ------------------------------------------------

    fn bounding_box() → bounds.BoundingBox ∪ null {
        if self.valida() ≡ false then return null
        const list<f32> positions ← self.position_values()
        var f32 min_x ← positions[0]
        var f32 min_y ← positions[1]
        var f32 min_z ← positions[2]
        var f32 max_x ← positions[0]
        var f32 max_y ← positions[1]
        var f32 max_z ← positions[2]
        var int i ← 3
        while i ≺ positions.length() {
            const f32 x ← positions[i]
            const f32 y ← positions[i + 1]
            const f32 z ← positions[i + 2]
            if x ≺ min_x {
                min_x ← x
            }
            if y ≺ min_y {
                min_y ← y
            }
            if z ≺ min_z {
                min_z ← z
            }
            if x ≻ max_x {
                max_x ← x
            }
            if y ≻ max_y {
                max_y ← y
            }
            if z ≻ max_z {
                max_z ← z
            }
            i ← i + 3
        }
        return bounds.BoundingBox {min_x = min_x, min_y = min_y, min_z = min_z, max_x = max_x, max_y = max_y, max_z = max_z}
    }

    fn group_bounding_box(int group_index) → bounds.BoundingBox ∪ null {
        if self.valida() ≡ false then return null
        if group_index ≥ self.groups.length() then return null
        const batch.GeometryGroup group ← self.groups[group_index]
        const list<f32> positions ← self.position_values()
        var int vertex_index ← group.start
        if self.indexed {
            vertex_index ↤ self.indices[group.start]
        }
        var int position_index ← vertex_index * 3
        var f32 min_x ← positions[position_index]
        var f32 min_y ← positions[position_index + 1]
        var f32 min_z ← positions[position_index + 2]
        var f32 max_x ← min_x
        var f32 max_y ← min_y
        var f32 max_z ← min_z
        var int i ← group.start
        const int end ← group.start + group.count
        while i ≺ end {
            vertex_index ← i
            if self.indexed {
                vertex_index ↤ self.indices[i]
            }
            position_index ← vertex_index * 3
            const f32 x ← positions[position_index]
            const f32 y ← positions[position_index + 1]
            const f32 z ← positions[position_index + 2]
            if x ≺ min_x {
                min_x ← x
            }
            if y ≺ min_y {
                min_y ← y
            }
            if z ≺ min_z {
                min_z ← z
            }
            if x ≻ max_x {
                max_x ← x
            }
            if y ≻ max_y {
                max_y ← y
            }
            if z ≻ max_z {
                max_z ← z
            }
            i ← i + 1
        }
        return bounds.BoundingBox {min_x = min_x, min_y = min_y, min_z = min_z, max_x = max_x, max_y = max_y, max_z = max_z}
    }

    fn bounding_sphere() → bounds.BoundingSphere ∪ null {
        const bounds.BoundingBox ∪ null bounds_result ← self.bounding_box()
        if bounds_result is null then return null
        const bounds.BoundingBox bnd ← bounds_result
        const f32 center_x ← (bnd.min_x + bnd.max_x) * 0.5
        const f32 center_y ← (bnd.min_y + bnd.max_y) * 0.5
        const f32 center_z ← (bnd.min_z + bnd.max_z) * 0.5
        const list<f32> positions ← self.position_values()
        var f32 radius_squared ← 0.0
        var int i ← 0
        while i ≺ positions.length() {
            const f32 dx ← positions[i] - center_x
            const f32 dy ← positions[i + 1] - center_y
            const f32 dz ← positions[i + 2] - center_z
            const f32 distance_squared ← (dx * dx + dy * dy) + dz * dz
            if distance_squared ≻ radius_squared {
                radius_squared ← distance_squared
            }
            i ← i + 3
        }
        return bounds.BoundingSphere {center_x = center_x, center_y = center_y, center_z = center_z, radius = math.radix_f32(radius_squared)}
    }

    fn group_bounding_sphere(int group_index) → bounds.BoundingSphere ∪ null {
        const bounds.BoundingBox ∪ null bounds_result ← self.group_bounding_box(group_index)
        if bounds_result is null then return null
        const bounds.BoundingBox bnd ← bounds_result
        const f32 center_x ← (bnd.min_x + bnd.max_x) * 0.5
        const f32 center_y ← (bnd.min_y + bnd.max_y) * 0.5
        const f32 center_z ← (bnd.min_z + bnd.max_z) * 0.5
        const batch.GeometryGroup group ← self.groups[group_index]
        const list<f32> positions ← self.position_values()
        var f32 radius_squared ← 0.0
        var int i ← group.start
        const int end ← group.start + group.count
        while i ≺ end {
            var int vertex_index ← i
            if self.indexed {
                vertex_index ↤ self.indices[i]
            }
            const int position_index ← vertex_index * 3
            const f32 dx ← positions[position_index] - center_x
            const f32 dy ← positions[position_index + 1] - center_y
            const f32 dz ← positions[position_index + 2] - center_z
            const f32 distance_squared ← (dx * dx + dy * dy) + dz * dz
            if distance_squared ≻ radius_squared {
                radius_squared ← distance_squared
            }
            i ← i + 1
        }
        return bounds.BoundingSphere {center_x = center_x, center_y = center_y, center_z = center_z, radius = math.radix_f32(radius_squared)}
    }

    # --- Normals and UVs -------------------------------------------------

    fn vertex_normals() → attribute.BufferAttribute ∪ null {
        if self.valida() ≡ false then return null
        match self.topology {
            case TriangleList {
            }
            case LineList {
                return null
            }
            case PointList {
                return null
            }
        }
        const list<f32> positions ← self.position_values()
        var list<f32> normals ← empty
        var int i ← 0
        while i ≺ positions.length() {
            normals.append(0.0)
            i ← i + 1
        }
        i ← 0
        while i ≺ self.element_count() {
            var int a ← i
            var int b ← i + 1
            var int c ← i + 2
            if self.indexed {
                a ↤ self.indices[i]
                b ↤ self.indices[i + 1]
                c ↤ self.indices[i + 2]
            }
            const int ai ← a * 3
            const int bi ← b * 3
            const int ci ← c * 3
            const f32 ab_x ← positions[bi] - positions[ai]
            const f32 ab_y ← positions[bi + 1] - positions[ai + 1]
            const f32 ab_z ← positions[bi + 2] - positions[ai + 2]
            const f32 ac_x ← positions[ci] - positions[ai]
            const f32 ac_y ← positions[ci + 1] - positions[ai + 1]
            const f32 ac_z ← positions[ci + 2] - positions[ai + 2]
            const f32 nx ← ab_y * ac_z - ab_z * ac_y
            const f32 ny ← ab_z * ac_x - ab_x * ac_z
            const f32 nz ← ab_x * ac_y - ab_y * ac_x
            normals[ai] ← normals[ai] + nx
            normals[ai + 1] ← normals[ai + 1] + ny
            normals[ai + 2] ← normals[ai + 2] + nz
            normals[bi] ← normals[bi] + nx
            normals[bi + 1] ← normals[bi + 1] + ny
            normals[bi + 2] ← normals[bi + 2] + nz
            normals[ci] ← normals[ci] + nx
            normals[ci + 1] ← normals[ci + 1] + ny
            normals[ci + 2] ← normals[ci + 2] + nz
            i ← i + 3
        }
        i ← 0
        const f32 zero ← 0.0
        while i ≺ normals.length() {
            const f32 abs_x ← normals[i].abs()
            const f32 abs_y ← normals[i + 1].abs()
            const f32 abs_z ← normals[i + 2].abs()
            var f32 normal_max ← abs_x
            if abs_y ≻ normal_max {
                normal_max ← abs_y
            }
            if abs_z ≻ normal_max {
                normal_max ← abs_z
            }
            if normal_max ≡ zero then return null
            const f32 scaled_x ← normals[i] / normal_max
            const f32 scaled_y ← normals[i + 1] / normal_max
            const f32 scaled_z ← normals[i + 2] / normal_max
            const f32 normal_scale ← normal_max * math.radix_f32((scaled_x * scaled_x + scaled_y * scaled_y) + scaled_z * scaled_z)
            normals[i] ← normals[i] / normal_scale
            normals[i + 1] ← normals[i + 1] / normal_scale
            normals[i + 2] ← normals[i + 2] / normal_scale
            i ← i + 3
        }
        return attribute.float32_attribute("normal", 1, 3, self.vertex_count, normals)
    }

    fn planar_uvs() → attribute.BufferAttribute ∪ null {
        const bounds.BoundingBox ∪ null bounds_result ← self.bounding_box()
        if bounds_result is null then return null
        const bounds.BoundingBox bnd ← bounds_result
        const f32 width ← bnd.max_x - bnd.min_x
        const f32 height ← bnd.max_y - bnd.min_y
        const f32 zero ← 0.0
        if width ≡ zero or height ≡ zero then return null
        const list<f32> positions ← self.position_values()
        var list<f32> uvs ← empty
        var int i ← 0
        while i ≺ positions.length() {
            uvs.append((positions[i] - bnd.min_x) / width)
            uvs.append((positions[i + 1] - bnd.min_y) / height)
            i ← i + 3
        }
        return attribute.float32_attribute("uv", 2, 2, self.vertex_count, uvs)
    }

    # --- Vertex layout introspection ------------------------------------
    fn position_values() → list<f32> {
        var list<f32> positions ← empty
        var int i ← 0
        while i ≺ self.attributes.length() {
            const attribute.BufferAttribute attr ← self.attributes[i]
            if attr.name ≡ "position" {
                const list<f32> ∪ null values ← attr.float32_values()
                if values not is null {
                    positions ← values
                }
            }
            i ← i + 1
        }
        return positions
    }

    fn vertex_layout_at(int index) → layout.VertexAttributeLayout ∪ null {
        if self.valida() ≡ false then return null
        if index ≥ self.attributes.length() then return null
        const attribute.BufferAttribute attr ← self.attributes[index]
        return attr.vertex_layout()
    }

    fn topology_code() → int ∪ null {
        if self.valida() ≡ false then return null
        return topology_code(self.topology)
    }

    fn vertex_layout_count() → int ∪ null {
        if self.valida() ≡ false then return null
        const int count ← self.attributes.length()
        return count
    }

    fn vertex_layout_location(int index) → int ∪ null {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return null
        const layout.VertexAttributeLayout lay ← layout_result
        return lay.shader_location
    }

    fn vertex_layout_source_name(int index) → string ∪ null {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return null
        const layout.VertexAttributeLayout lay ← layout_result
        return lay.source_name
    }

    fn vertex_layout_format_code(int index) → int ∪ null {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return null
        const layout.VertexAttributeLayout lay ← layout_result
        return layout.layout_format_code(lay)
    }

    fn vertex_layout_offset_bytes(int index) → int ∪ null {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return null
        const layout.VertexAttributeLayout lay ← layout_result
        return lay.offset_bytes
    }

    fn vertex_layout_stride_bytes(int index) → int ∪ null {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return null
        const layout.VertexAttributeLayout lay ← layout_result
        return lay.stride_bytes
    }

    fn vertex_layout_step_mode_code(int index) → int ∪ null {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return null
        const layout.VertexAttributeLayout lay ← layout_result
        return layout.layout_step_mode_code(lay)
    }

    fn vertex_layout_matches(int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code) → bool {
        const layout.VertexAttributeLayout ∪ null layout_result ← self.vertex_layout_at(index)
        if layout_result is null then return false
        const layout.VertexAttributeLayout lay ← layout_result
        return ((((lay.source_name ≡ source_name and lay.shader_location ≡ shader_location) and layout.layout_format_code(lay) ≡ format_code) and lay.offset_bytes ≡ offset_bytes) and lay.stride_bytes ≡ stride_bytes) and layout.layout_step_mode_code(lay) ≡ step_mode_code
    }

    fn vertex_layouts() → list<layout.VertexAttributeLayout> ∪ null {
        if self.valida() ≡ false then return null
        var list<layout.VertexAttributeLayout> layouts ← empty
        var int i ← 0
        while i ≺ self.attributes.length() {
            const attribute.BufferAttribute attr ← self.attributes[i]
            const layout.VertexAttributeLayout ∪ null layout_result ← attr.vertex_layout()
            if layout_result is null then return null
            const layout.VertexAttributeLayout lay ← layout_result
            layouts.append(lay)
            i ← i + 1
        }
        return layouts
    }

    # --- Batch facts -----------------------------------------------------

    fn indexed_draw_batch_facts(int instance_count) → batch.IndexedGeometryDrawBatchFacts ∪ null {
        if self.valida() ≡ false then return null
        if self.indexed ≡ false then return null
        if instance_count ≡ 0 then return null
        const list<batch.GeometryDrawCommand> ∪ null commands_result ← self.group_draw_commands(instance_count)
        if commands_result is null then return null
        const list<batch.GeometryDrawCommand> commands ← commands_result
        const int ∪ null grouped_elements_result ← self.group_element_total()
        if grouped_elements_result is null then return null
        const int ∪ null vertex_bytes_result ← self.vertex_payload_byte_count()
        if vertex_bytes_result is null then return null
        const int ∪ null index_bytes_result ← self.index_payload_byte_count()
        if index_bytes_result is null then return null
        const int ∪ null total_bytes_result ← self.payload_byte_count()
        if total_bytes_result is null then return null
        return batch.IndexedGeometryDrawBatchFacts {draw_count = commands.length(), grouped_element_total = grouped_elements_result, vertex_payload_byte_count = vertex_bytes_result, index_payload_byte_count = index_bytes_result, total_payload_byte_count = total_bytes_result}
    }

    fn line_draw_batch_facts(int instance_count) → batch.LineGeometryDrawBatchFacts ∪ null {
        if self.valida() ≡ false then return null
        if self.indexed ≡ false then return null
        if instance_count ≡ 0 then return null
        const int ∪ null line_count_result ← self.line_count()
        if line_count_result is null then return null
        const batch.IndexedGeometryDrawBatchFacts ∪ null batch_result ← self.indexed_draw_batch_facts(instance_count)
        if batch_result is null then return null
        const int line_count_value ← line_count_result
        const batch.IndexedGeometryDrawBatchFacts batch_facts ← batch_result
        return batch.LineGeometryDrawBatchFacts {draw_count = batch_facts.draw_count, line_count = line_count_value, grouped_element_total = batch_facts.grouped_element_total, vertex_payload_byte_count = batch_facts.vertex_payload_byte_count, index_payload_byte_count = batch_facts.index_payload_byte_count, total_payload_byte_count = batch_facts.total_payload_byte_count}
    }
}

# --- Free constructors for BufferGeometry ---

# These constructors make the indexed/non-indexed choice explicit while
# sharing the same attribute, range, and group validation path.

@ public
fn indexed_triangle_geometry(int vertex_count, ref list<attribute.BufferAttribute> attributes, list<u32> indices, batch.DrawRange draw_range, list<batch.GeometryGroup> groups) → BufferGeometry {
    return BufferGeometry {topology = TriangleList(), vertex_count = vertex_count, attributes = attributes, indexed = true, indices = indices, draw_range = draw_range, groups = groups}
}

@ public
fn triangle_geometry(int vertex_count, ref list<attribute.BufferAttribute> attributes, batch.DrawRange draw_range, list<batch.GeometryGroup> groups) → BufferGeometry {
    return BufferGeometry {topology = TriangleList(), vertex_count = vertex_count, attributes = attributes, indexed = false, indices = empty, draw_range = draw_range, groups = groups}
}

@ public
fn line_geometry(int vertex_count, ref list<attribute.BufferAttribute> attributes, list<u32> indices, batch.DrawRange draw_range, list<batch.GeometryGroup> groups) → BufferGeometry {
    return BufferGeometry {topology = LineList(), vertex_count = vertex_count, attributes = attributes, indexed = true, indices = indices, draw_range = draw_range, groups = groups}
}

@ public
fn colored_indexed_geometry(int vertex_count, list<f32> positions, list<f32> colors, list<u32> indices) → BufferGeometry ∪ null {
    const attribute.BufferAttribute position_attribute ← attribute.float32_attribute("position", 0, 3, vertex_count, positions)
    const attribute.BufferAttribute color_attribute ← attribute.float32_attribute("color", 1, 3, vertex_count, colors)
    const BufferGeometry geometry ← indexed_triangle_geometry(vertex_count, [position_attribute, color_attribute], indices, batch.DrawRange {start = 0, count = indices.length()}, [batch.GeometryGroup {start = 0, count = indices.length(), material_index = 0}])
    if geometry.valida() ≡ false then return null
    return geometry
}

# --- Free helper functions ---

# Append helpers preserve the same parallel-list contract as ColoredQuadMesh;
# they are useful when a caller wants to build a mesh one face at a time.

@ public
fn colored_quad_mesh_append(list<f32> positions, list<f32> colors, list<u32> indices, ref math.Vector3 a, ref math.Vector3 b, ref math.Vector3 c, ref math.Vector3 d, ref math.Color color) → ColoredQuadMesh ∪ null {
    if positions.length() ≠ colors.length() then return null
    if positions.length() % 3 ≠ 0 then return null
    if indices.length() % 3 ≠ 0 then return null
    var list<f32> next_positions ← empty
    for from positions const value {
        next_positions.append(value)
    }
    var list<f32> next_colors ← empty
    for from colors const value {
        next_colors.append(value)
    }
    var list<u32> next_indices ← empty
    for from indices const value {
        next_indices.append(value)
    }
    const int vertex_base ← positions.length() / 3
    next_positions.append(a.x)
    next_positions.append(a.y)
    next_positions.append(a.z)
    next_positions.append(b.x)
    next_positions.append(b.y)
    next_positions.append(b.z)
    next_positions.append(c.x)
    next_positions.append(c.y)
    next_positions.append(c.z)
    next_positions.append(d.x)
    next_positions.append(d.y)
    next_positions.append(d.z)
    for range 0‥4 const corner {
        next_colors.append(color.r)
        next_colors.append(color.g)
        next_colors.append(color.b)
    }
    next_indices.append(vertex_base ↦ int<u32>)
    next_indices.append(vertex_base + 1 ↦ int<u32>)
    next_indices.append(vertex_base + 2 ↦ int<u32>)
    next_indices.append(vertex_base ↦ int<u32>)
    next_indices.append(vertex_base + 2 ↦ int<u32>)
    next_indices.append(vertex_base + 3 ↦ int<u32>)
    return ColoredQuadMesh {positions = next_positions, colors = next_colors, indices = next_indices}
}

# --- Private scalar and code helpers (free, no genus receiver) ---

fn topology_code(ref PrimitiveTopology topology) → int {
    match topology {
        case TriangleList {
            return 1
        }
        case LineList {
            return 2
        }
        case PointList {
            return 3
        }
    }
}

fn element_count_divisible(int element_count, int divisor) → bool {
    return element_count % divisor ≡ 0
}

fn topology_range_valid(ref PrimitiveTopology topology, int start, int count) → bool {
    match topology {
        case TriangleList {
            return element_count_divisible(start, 3) and element_count_divisible(count, 3)
        }
        case LineList {
            return element_count_divisible(start, 2) and element_count_divisible(count, 2)
        }
        case PointList {
            return count ≻ 0
        }
    }
}

# --- Standalone vertex-layout assertion (wraps BufferGeometry method) ---
#
# Contract-role adapter: the compiler-owned `@ shader_contract "vertex_layout"`
# annotation maps this real Triga API onto the generic shader-contract surface
# radix recognizes (see src/shader_contract.fab). The argument shape matches
# the canonical vertex_layout role: (geo, index, source_name, location,
# format_code, offset_bytes, stride_bytes, step_mode_code).

@ public
@ shader_contract "vertex_layout"
fn geometry_vertex_layout_matches(BufferGeometry geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code) → bool {
    return geo.vertex_layout_matches(index, source_name, shader_location, format_code, offset_bytes, stride_bytes, step_mode_code)
}
