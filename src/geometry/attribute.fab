# Typed CPU-side vertex attributes.
#
# Public import: import from "triga:geometry/attribute" private attribute
#
# Owns: BufferAttribute (+ all methods), AttributeData, AttributeUsage, and
# the free constructor float32_attribute. AttributeData lives here so the
# variant discerne sites (scalar_count / scalar_bytes / float32_values /
# _vertex_format) and float32_values() stay co-located with the enum
# (corpus README: variants are not in scope cross-module).
#
# Imports: triga:geometry/layout (VertexAttributeLayout, VertexFormat,
# VertexStepMode, and the VertexFormat / VertexStepMode variant constructors).

import from "triga:geometry/layout" private layout

# Update intent carried alongside a CPU-side attribute. The value is available
# to upload or streaming code; this leaf records the intent but does not
# schedule updates itself.
union AttributeUsage {
    StaticAttribute,
    DynamicAttribute,
    StreamAttribute,
}

# The scalar payload kept by a BufferAttribute. Both representations use
# four-byte scalars; the typed distinction controls the vertex format and
# whether a float32 view can be projected for interleaving.
union AttributeData {
    Float32Attribute {
        list<f32> values
    },
    Uint32Attribute {
        list<int<u32>> values
    },
}

# One named CPU-side vertex stream and the facts needed to describe it to a
# host. `valida()` is the projection boundary: a valid stream has a non-empty
# name, an unnormalized component width from 1 through 4, a positive element
# count, and exactly component_width * element_count scalars.
class BufferAttribute {
    string name
    int shader_location
    int component_width
    int element_count
    bool normalized
    AttributeUsage usage
    AttributeData data

    # --- Format and host-layout projection ---

    # The payload type and component width select the host vertex format.
    # `vertex_layout()` exposes the resulting tightly packed stream with a
    # zero offset, a scalar-derived stride, and per-vertex stepping.
    @ private { }
    fn _vertex_format() → layout.VertexFormat {
        match self.data {
            case Float32Attribute const values {
                return layout.vertex_format_from_component_width(self.component_width, true)
            }
            case Uint32Attribute const values {
                return layout.vertex_format_from_component_width(self.component_width, false)
            }
        }
    }

    # Vertex format is exported through vertex_layout; standalone enum
    # results are not file-interface carriers.
    @ private { }
    fn vertex_format() → layout.VertexFormat ∪ null {
        if self.valida() ≡ false then return null
        return self._vertex_format()
    }

    # --- Validation and CPU-side queries ---

    # Validation intentionally stays close to the payload: it checks the
    # metadata and the scalar count before any host-facing layout is emitted.
    fn valida() → bool {
        if self.name ≡ "" then return false
        if self.normalized then return false
        if self.component_width ≺ 1 or self.component_width ≻ 4 then return false
        if self.element_count ≡ 0 then return false
        return self.scalar_count() ≡ self.component_width * self.element_count
    }

    fn scalar_count() → int {
        match self.data {
            case Float32Attribute const values {
                return values.length()
            }
            case Uint32Attribute const values {
                return values.length()
            }
        }
    }

    fn scalar_bytes() → int {
        match self.data {
            case Float32Attribute const values {
                return 4
            }
            case Uint32Attribute const values {
                return 4
            }
        }
    }

    # Projection: float32 payload for consumers that interleave attributes into
    # host vertex buffers. `nihil` marks a uint32 payload; the variant match is
    # kept here because consumers cannot `discerne` AttributeData across this
    # file boundary.
    fn float32_values() → list<f32> ∪ null {
        match self.data {
            case Float32Attribute const values {
                return values
            }
            case Uint32Attribute const values {
                return null
            }
        }
    }

    fn stride_bytes() → int {
        return self.component_width * self.scalar_bytes()
    }

    fn vertex_layout() → layout.VertexAttributeLayout ∪ null {
        if self.valida() ≡ false then return null
        return layout.VertexAttributeLayout {source_name = self.name, shader_location = self.shader_location, vertex_format = self._vertex_format(), offset_bytes = 0, stride_bytes = self.stride_bytes(), step_mode = layout.vertex_step_mode_vertex_step()}
    }
}

# --- Free constructors for BufferAttribute ---

# The starter constructor makes the common CPU-side case explicit: a static,
# unnormalized float32 stream. `valida()` remains the authority for checking
# that the supplied values match the declared element shape.
fn float32_attribute(string name, int shader_location, int component_width, int element_count, list<f32> values) → BufferAttribute {
    return BufferAttribute {name = name, shader_location = shader_location, component_width = component_width, element_count = element_count, normalized = false, usage = StaticAttribute(), data = Float32Attribute(values)}
}
