+++ toml
locale = "en"

+++ faber
# triga.fab — package map facade for the graphics library.
#
# Public import: import from "triga:triga" triga
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:math            vectors, matrices, volumes, rays, transform payload
#   triga:graph/object    Object, Scene
#   triga:graph/camera    PerspectiveCamera, OrthographicCamera, projection facts
#   triga:lighting/light  Light family (Light, AmbientLight, DirectionalLight, PointLight)
#   triga:material/base   Material, MaterialPipelineFacts, TextureDescriptor (H3 seed)
#   triga:material/basic  UnlitMaterial
#   triga:material/lit    PhongMaterial
#   triga:material/standard StandardMaterial
#   triga:renderable/mesh Mesh (graph + geometry + material composition)
#   triga:face            voxel face-code helpers
#   triga:geometry/data   Geometry (plus attribute/layout/bounds/batch leaves)
#   triga:primitives/basic mesh generators (procedural/terrain/voxel planned)
#   triga:scene           scene store + identity
#   triga:resource        resource handle lifecycle free functions
#   triga:shader          Texture2D, Sampler, bound sample (WGSL manifest)
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:math"

import from "triga:graph/object" let graph_object

import from "triga:graph/camera"

import from "triga:material/base"

import from "triga:material/basic"

import from "triga:material/lit"

import from "triga:material/standard"

import from "triga:face"

+++ faber test
# Co-located package smoke for the top-level triga facade.
#
# The facade is an import map only. Leaf types remain owned by their leaf
# modules, so this case proves discoverability without inventing re-exports.
import from "triga:triga"

test "triga facade is discoverable" {
    assert true
}
