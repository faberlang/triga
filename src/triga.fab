# triga.fab — package map facade for the graphics library.
#
# Public import: import from "triga:triga" private triga
#
# Full module map (facade modules included): docs/module-map.md
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:math            vectors, matrices, volumes, rays, transform payload
#   triga:graph/object    Object3D, Scene
#   triga:graph/camera    PerspectiveCamera, OrthographicCamera, projection facts
#   triga:lighting/light  Light family (Light, AmbientLight, DirectionalLight, PointLight)
#   triga:material/base   Material, MaterialPipelineFacts, TextureDescriptor (H3 seed)
#   triga:material/basic  MeshBasicMaterial
#   triga:material/lit    MeshPhongMaterial
#   triga:material/standard MeshStandardMaterial
#   triga:renderable/mesh Mesh (graph + geometry + material composition)
#   triga:face            voxel face-code helpers
#   triga:geometry/data   BufferGeometry (plus attribute/layout/bounds/batch leaves)
#   triga:primitives/basic mesh generators (procedural/terrain/voxel planned)
#   triga:scene           scene store + identity
#   triga:resource        resource handle lifecycle free functions
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:math" private math

import from "triga:graph/object" private object as graph_object

import from "triga:graph/camera" private camera

import from "triga:material/base" private base

import from "triga:material/basic" private basic

import from "triga:material/lit" private lit

import from "triga:material/standard" private standard

import from "triga:face" private face
