# triga.fab — package map facade for the graphics library.
#
# Public import: importa ex "triga:triga" privata triga
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:math       vectors, matrices, volumes, rays, transform payload
#   triga:graph      Object3D, Scene, cameras, lights
#   triga:material   Material family, Mesh, MeshGeometry
#   triga:face       voxel face-code helpers
#   triga:geometry   BufferGeometry / vertex layout
#   triga:primitives mesh generators
#   triga:scene      scene store + identity
#   triga:resource   resource handle lifecycle free functions
#
# This file intentionally holds no genera. Import the leaf modules above.

importa ex "triga:math" privata math
importa ex "triga:graph" privata graph
importa ex "triga:material" privata material
importa ex "triga:face" privata face
