# Material family shape contracts — package map facade.
#
# Public import: import from "triga:material" private material
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:material/base       Material, MaterialPipelineFacts, TextureDescriptor (H3 seed), base helpers
#   triga:material/basic      MeshBasicMaterial + helpers
#   triga:material/lit        MeshPhongMaterial
#   triga:material/standard   MeshStandardMaterial
#
# Mesh moved to triga:renderable/mesh (report §1.2); MeshGeometry was retired
# into geometry/data's BufferGeometry (§1.4.3). texture/sampler leaves are
# planned at H3 (report §1.3); the TextureDescriptor placeholder currently
# lives in material/base.fab as the H3 seed.
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:material/base" private base

import from "triga:material/basic" private basic

import from "triga:material/lit" private lit

import from "triga:material/standard" private standard
