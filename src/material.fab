# Materials, mesh binding, and mesh geometry shape contracts.
#
# Public import: importa ex "triga:material" privata material
# Depends on: triga:math, triga:graph/object

importa ex "triga:math" privata math
importa ex "triga:graph/object" privata object

genus MeshGeometry {
    lista<f32> positions
    lista<f32> normals sponte
    lista<f32> uvs sponte
    lista<f32> uvs2 sponte
    lista<f32> colors sponte
    lista<f32> tangents sponte
    lista<u32> indices sponte
    numerus draw_start = 0
    numerus draw_count sponte
}

# =========================================================================
# MATERIAL
#
# Mirror THREE.Material, THREE.MeshStandardMaterial (PBR),
#       THREE.MeshBasicMaterial, THREE.MeshPhongMaterial
# =========================================================================

genus Material {
    textus name
    # side: 0=FrontSide 1=BackSide 2=DoubleSide
    numerus<u32> side = 0
    bivalens transparent = falsum
    f32 opacity = 1.0
    bivalens depth_write = verum
    bivalens depth_test = verum
    f32 alpha_test = 0.0
}

genus MaterialPipelineFacts {
    numerus side_code
    bivalens depth_test_enabled
    bivalens depth_write_enabled
    bivalens transparent
    f32 alpha
    f32 alpha_test
}

genus MeshStandardMaterial {
    Material base
    math.Color color
    f32 roughness = 1.0
    f32 metalness = 0.0
    math.Color emissive
    f32 emissive_intensity = 0.0
}

genus MeshBasicMaterial {
    Material base
    math.Color color
}

genus MeshPhongMaterial {
    Material base
    math.Color color
    math.Color specular
    f32 shininess = 30.0
}

# =========================================================================
# MESH
#
# Mirror THREE.Mesh — the primary renderable object.
# =========================================================================

genus Mesh {
    object.Object3D base
    MeshGeometry geometry
    MeshStandardMaterial ∪ MeshBasicMaterial ∪ MeshPhongMaterial material sponte
}

functio materia_ex_nomine(textus name) → Material {
    redde Material { name = name, side = 0, transparent = falsum, opacity = 1.0, depth_write = verum, depth_test = verum, alpha_test = 0.0 }
}

functio material_valida(de Material value) → bivalens {
    si value.name ≡ "" ergo redde falsum
    si value.side > 2 ergo redde falsum
    si value.opacity < 0.0 aut value.opacity > 1.0 ergo redde falsum
    si value.alpha_test < 0.0 aut value.alpha_test > 1.0 ergo redde falsum
    redde verum
}

functio material_double_sided(de Material value) → Material {
    redde Material { name = value.name, side = 2, transparent = value.transparent, opacity = value.opacity, depth_write = value.depth_write, depth_test = value.depth_test, alpha_test = value.alpha_test }
}

functio material_est_double_sided(de Material value) → bivalens {
    redde value.side ≡ (2 ↦ numerus<u32>)
}

functio material_side_code(de Material value) → numerus ∪ nihil {
    si material_valida(value) ≡ falsum ergo redde nihil
    redde value.side ↦ numerus
}

functio material_depth_enabled(de Material value) → bivalens {
    redde value.depth_test et value.depth_write
}

functio material_depth_test_enabled(de Material value) → bivalens {
    redde value.depth_test
}

functio material_depth_write_enabled(de Material value) → bivalens {
    redde value.depth_write
}

functio material_pipeline_facts(de Material value) → MaterialPipelineFacts ∪ nihil {
    si material_valida(value) ≡ falsum ergo redde nihil
    redde MaterialPipelineFacts { side_code = value.side ↦ numerus, depth_test_enabled = value.depth_test, depth_write_enabled = value.depth_write, transparent = value.transparent, alpha = value.opacity, alpha_test = value.alpha_test }
}

functio mesh_basic_material(textus name, de math.Color color) → MeshBasicMaterial ∪ nihil {
    fixum Material base ← materia_ex_nomine(name)
    si material_valida(base) ≡ falsum ergo redde nihil
    redde MeshBasicMaterial { base = base, color = color }
}

functio mesh_basic_material_valida(de MeshBasicMaterial value) → bivalens {
    redde material_valida(value.base) et math.color_valida(value.color)
}

functio mesh_basic_material_color_r(de MeshBasicMaterial value) → f32 ∪ nihil {
    si mesh_basic_material_valida(value) ≡ falsum ergo redde nihil
    redde value.color.r
}

functio mesh_basic_material_color_g(de MeshBasicMaterial value) → f32 ∪ nihil {
    si mesh_basic_material_valida(value) ≡ falsum ergo redde nihil
    redde value.color.g
}

functio mesh_basic_material_color_b(de MeshBasicMaterial value) → f32 ∪ nihil {
    si mesh_basic_material_valida(value) ≡ falsum ergo redde nihil
    redde value.color.b
}

functio mesh_basic_material_alpha(de MeshBasicMaterial value) → f32 ∪ nihil {
    si mesh_basic_material_valida(value) ≡ falsum ergo redde nihil
    redde value.base.opacity
}

functio mesh_basic_material_pipeline_facts(de MeshBasicMaterial value) → MaterialPipelineFacts ∪ nihil {
    si mesh_basic_material_valida(value) ≡ falsum ergo redde nihil
    redde material_pipeline_facts(value.base)
}

# =========================================================================
# TEXTURE (minimal placeholder)
#
# Mirror THREE.Texture, THREE.DataTexture
#
# Placeholder definition for the shape contract. Will be expanded
# when texture pipeline (samplers, mipmaps, render targets) is designed.
# =========================================================================

genus TextureDescriptor {
    numerus<u32> width
    numerus<u32> height
    # Format string: e.g. "rgba8unorm", "depth32float"
    textus format
    lista<f32> data sponte
    bivalens generate_mipmaps = verum
}

# =========================================================================
# MATH OPERATIONS
#
# Triga records are domain/storage values. Compiler vector/matrix types are
# register values; conversion between the two representations stays explicit.
# math.Matrix4 elements are column-major and multiply column vectors.
# =========================================================================

