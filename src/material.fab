+++ toml
locale = "en"

+++ faber
# Material family shape contracts — package map facade.
#
# Public import: import from "triga:material" material
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:material/base       Material, MaterialPipelineFacts, TextureDescriptor (H3 seed), base helpers
#   triga:material/basic      UnlitMaterial + helpers
#   triga:material/lit        PhongMaterial
#   triga:material/standard   StandardMaterial
#
# Mesh moved to triga:renderable/mesh (report §1.2); MeshGeometry was retired
# into geometry/data's Geometry (§1.4.3). texture/sampler leaves are
# planned at H3 (report §1.3); the TextureDescriptor placeholder currently
# lives in material/base.fab as the H3 seed.
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:material/base"

import from "triga:material/basic"

import from "triga:material/lit"

import from "triga:material/standard"

+++ faber test
# Co-located package smoke for the map-only material facade.
# Leaf contracts remain owned by triga:material/base, /basic, /lit, and
# /standard; this case proves only that the public facade path is discoverable.
import from "triga:material"

test "material facade is discoverable" {
    assert true
}
