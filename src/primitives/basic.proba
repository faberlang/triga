    test "torus publishes exact tube grid normals UVs and winding" {
        const data.BufferGeometry ∪ null result ← basic.torus_geometry(2.0, 1.0)
        const list<f32> positions ← [
        3.0, 0.0, 0.0, 2.0, 1.0, 0.0, 1.0, 0.0, 0.0, 2.0, -1.0, 0.0,
        3.0, 0.0, 0.0, 2.12132025, 0.0, 2.12132025, 1.41421354, 1.0, 1.41421354, 0.707106769, 0.0, 0.707106769,
