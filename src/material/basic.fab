# MeshBasicMaterial and its construction/access helpers.
#
# Public import: import from "triga:material/basic" basic
#
# Owns: MeshBasicMaterial (+ receiver methods) and the basic_material
# constructor.
#
# Imports: triga:math, triga:material/base.

import from "triga:math" math

import from "triga:material/base" base

# MeshBasicMaterial is the unlit material path. Its base contract carries
# depth, alpha, and side state; this leaf adds only the source color used by
# the basic pipeline facts. Operations on a material value are receiver
# methods (api-shape-policy §1); basic_material is the free constructor.
@ public
class MeshBasicMaterial {
    base.Material base
    math.Color color

    fn valid() → bool {
        return self.base.valid() and self.color.valid()
    }

    fn color_r() → f32 ∪ null {
        if not self.valid() then return null
        return self.color.r
    }

    fn color_g() → f32 ∪ null {
        if not self.valid() then return null
        return self.color.g
    }

    fn color_b() → f32 ∪ null {
        if not self.valid() then return null
        return self.color.b
    }

    fn alpha() → f32 ∪ null {
        if not self.valid() then return null
        return self.base.opacity
    }

    fn pipeline_facts() → base.MaterialPipelineFacts ∪ null {
        if not self.valid() then return null
        return self.base.pipeline_facts()
    }
}

@ public
fn basic_material(string name, ref math.Color color) → MeshBasicMaterial ∪ null {
    const base.Material base_material ← base.material_from_name(name)
    if not base_material.valid() then return null
    # The ∪ null contract extends to the color: every accessor already
    # fails closed on an invalid color (valid), so the constructor must not
    # return a material whose accessors all return null (the correctness-fix
    # slice — the accessors were the authority, the constructor now matches
    # the contract).
    if not color.valid() then return null
    return MeshBasicMaterial {base = base_material, color = color}
}
