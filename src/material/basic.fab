+++ toml
locale = "en"

+++ faber
# UnlitMaterial and its construction/access helpers.
#
# Public import: import from "triga:material/basic" basic
#
# Owns: UnlitMaterial (+ receiver methods) and the basic_material
# constructor.
#
# Imports: triga:math, triga:material/base.

import from "triga:math"

import from "triga:material/base"

# UnlitMaterial is the unlit material path. Its base contract carries
# depth, alpha, and side state; this leaf adds only the source color used by
# the basic pipeline facts. Operations on a material value are receiver
# methods (api-shape-policy §1); basic_material is the free constructor.
@ public
class UnlitMaterial {
    mut base.Material base
    mut math.Color color

    fn valid() → bool {
        return self.base.valid() and self.color.valid()
    }

    fn color_r() → f32 ∪ none {
        if not self.valid() then return null
        return self.color.r
    }

    fn color_g() → f32 ∪ none {
        if not self.valid() then return null
        return self.color.g
    }

    fn color_b() → f32 ∪ none {
        if not self.valid() then return null
        return self.color.b
    }

    fn alpha() → f32 ∪ none {
        if not self.valid() then return null
        return self.base.opacity
    }

    fn pipeline_facts() → base.MaterialPipelineFacts ∪ none {
        if not self.valid() then return null
        return self.base.pipeline_facts()
    }
}

@ public
fn basic_material(string name, ref math.Color color) → UnlitMaterial ∪ none {
    let base.Material base_material ← base.material_from_name(name)
    if not base_material.valid() then return null
    # The ∪ null contract extends to the color: every accessor already
    # fails closed on an invalid color (valid), so the constructor must not
    # return a material whose accessors all return null (the correctness-fix
    # slice — the accessors were the authority, the constructor now matches
    # the contract).
    if not color.valid() then return null
    return UnlitMaterial {base = base_material, color = color}
}

+++ faber test
# Co-located package tests for material/basic.fab.
# The basic leaf owns construction, color accessors, alpha, and projection of
# the validated base pipeline facts. Invalid names, colors, and base policy
# reject; they are not treated as a rendered unlit path.
import from "triga:material/basic"
import from "triga:material/base"
import from "triga:math"

test "basic material construction exposes color alpha and pipeline facts" {
    let math.Color color ← math.Color {r = 0.2, g = 0.4, b = 0.8}
    let basic.UnlitMaterial ∪ none result ← basic.basic_material("basic", color)

    assert result not is none
    if result not is none {
        let basic.UnlitMaterial material ← basic.UnlitMaterial {base = result!.base, color = result!.color}
        let base.MaterialPipelineFacts ∪ none facts_result ← material.pipeline_facts()

        assert material.valid()
        assert (material.color_r() coalesce -1.0) ≡ (0.2 ∷ f32)
        assert (material.color_g() coalesce -1.0) ≡ (0.4 ∷ f32)
        assert (material.color_b() coalesce -1.0) ≡ (0.8 ∷ f32)
        assert (material.alpha() coalesce -1.0) ≡ (1.0 ∷ f32)
        assert facts_result not is none
        if facts_result not is none {
            assert facts_result!.side_code ≡ 0
            assert facts_result!.depth_test_enabled
            assert facts_result!.depth_write_enabled
            assert facts_result!.transparent ≡ false
            assert facts_result!.alpha ≡ (1.0 ∷ f32)
            assert facts_result!.alpha_test ≡ (0.0 ∷ f32)
        }
    }
}

test "basic material preserves a custom base policy" {
    let base.Material policy ← base.Material {name = "basic-policy", side = 2 ∷ u32, transparent = true, opacity = 0.6, depth_write = false, depth_test = false, alpha_test = 0.5}
    let basic.UnlitMaterial material ← basic.UnlitMaterial {base = policy, color = math.Color {r = 1.0, g = 0.5, b = 0.0}}
    let base.MaterialPipelineFacts ∪ none facts_result ← material.pipeline_facts()

    assert material.valid()
    assert (material.color_r() coalesce -1.0) ≡ (1.0 ∷ f32)
    assert (material.color_g() coalesce -1.0) ≡ (0.5 ∷ f32)
    assert (material.color_b() coalesce -1.0) ≡ (0.0 ∷ f32)
    assert (material.alpha() coalesce -1.0) ≡ (0.6 ∷ f32)
    assert facts_result not is none
    if facts_result not is none {
        assert facts_result!.side_code ≡ 2
        assert facts_result!.depth_test_enabled ≡ false
        assert facts_result!.depth_write_enabled ≡ false
        assert facts_result!.transparent
        assert facts_result!.alpha ≡ (0.6 ∷ f32)
        assert facts_result!.alpha_test ≡ (0.5 ∷ f32)
    }
}

test "basic material rejects invalid names and colors" {
    let math.Color invalid_color ← math.Color {r = 1.1, g = 0.0, b = 0.0}
    let math.Color valid_color ← math.Color {r = 0.0, g = 0.0, b = 0.0}
    let basic.UnlitMaterial ∪ none invalid_color_result ← basic.basic_material("invalid-color", invalid_color)
    let basic.UnlitMaterial ∪ none invalid_name_result ← basic.basic_material("", valid_color)
    let basic.UnlitMaterial invalid ← basic.UnlitMaterial {base = base.material_from_name("invalid"), color = invalid_color}

    assert invalid_color_result is none
    assert invalid_name_result is none
    assert invalid.valid() ≡ false
    assert invalid.color_r() is none
    assert invalid.color_g() is none
    assert invalid.color_b() is none
    assert invalid.alpha() is none
    assert invalid.pipeline_facts() is none
}
