# StandardMaterial — PBR standard material contract.
#
# Public import: import from "triga:material/standard" standard
#
# Owns: StandardMaterial.
#
# Imports: triga:math, triga:material/base.

import from "triga:math" math

import from "triga:material/base" base

# StandardMaterial is the PBR-shaped material carrier. The fields are
# source data only; texture sampling, environment lighting, and pipeline
# allocation belong to the future material/render seams.
@ public
class StandardMaterial {
    mut base.Material base
    mut math.Color color
    mut f32 roughness = 1.0
    mut f32 metalness = 0.0
    mut math.Color emissive
    mut f32 emissive_intensity = 0.0
}
