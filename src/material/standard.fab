# MeshStandardMaterial — PBR standard material contract.
#
# Public import: import from "triga:material/standard" private standard
#
# Owns: MeshStandardMaterial.
#
# Imports: triga:math, triga:material/base.

import from "triga:math" private math

import from "triga:material/base" private base

# MeshStandardMaterial is the PBR-shaped material carrier. The fields are
# source data only; texture sampling, environment lighting, and pipeline
# allocation belong to the future material/render seams.
@ public
class MeshStandardMaterial {
    base.Material base
    math.Color color
    f32 roughness = 1.0
    f32 metalness = 0.0
    math.Color emissive
    f32 emissive_intensity = 0.0
}
