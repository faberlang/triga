# Material base contracts, pipeline facts, and the texture descriptor seed.
#
# Public import: import from "triga:material/base" private base
#
# Owns: Material, MaterialPipelineFacts, TextureDescriptor (H3 placeholder
# seed), and the base material free helpers (materia_ex_nomine,
# material_valida, material_double_sided, material_est_double_sided,
# material_side_code, material_depth_enabled, material_depth_test_enabled,
# material_depth_write_enabled, material_pipeline_facts).
#
# MaterialPipelineFacts.side_code is frozen ABI (api-shape-policy §3) and
# survives the split verbatim. TextureDescriptor relocates to
# material/texture.fab when the texture pipeline (samplers, mipmaps, render
# targets) is designed (report §1.3) — base.fab is its temporary home.
#
# Zero imports.

# =========================================================================
# MATERIAL
#
# Mirror THREE.Material
#
# Material is deliberately a small value contract. The fields describe
# pipeline-relevant state; texture storage and host allocation belong to later
# material leaves and the sibling renderer.
# =========================================================================

class Material {
    string name
    # side: 0=FrontSide 1=BackSide 2=DoubleSide
    int<u32> side = 0
    bool transparent = false
    f32 opacity = 1.0
    bool depth_write = true
    bool depth_test = true
    f32 alpha_test = 0.0
}

# MaterialPipelineFacts is the validated, compact view used by pipeline-facing
# examples. `side_code` is a frozen ABI field; the remaining fields expose the
# depth and alpha decisions without requiring consumers to inspect Material.
class MaterialPipelineFacts {
    int side_code
    bool depth_test_enabled
    bool depth_write_enabled
    bool transparent
    f32 alpha
    f32 alpha_test
}

# =========================================================================
# TEXTURE (minimal placeholder)
#
# Mirror THREE.Texture, THREE.DataTexture
#
# Placeholder definition for the shape contract. Will be expanded
# when texture pipeline (samplers, mipmaps, render targets) is designed.
# Relocates to material/texture.fab at H3; see header comment.
# =========================================================================

class TextureDescriptor {
    int<u32> width
    int<u32> height
    # Format string: e.g. "rgba8unorm", "depth32float"
    string format
    list<f32> data optional
    bool generate_mipmaps = true
}

# --- Base material free helpers ---

fn materia_ex_nomine(string name) → Material {
    return Material {name = name, side = 0, transparent = false, opacity = 1.0, depth_write = true, depth_test = true, alpha_test = 0.0}
}

fn material_valida(ref Material value) → bool {
    if value.name ≡ "" then return false
    if value.side ≻ 2 then return false
    if value.opacity ≺ 0.0 or value.opacity ≻ 1.0 then return false
    if value.alpha_test ≺ 0.0 or value.alpha_test ≻ 1.0 then return false
    return true
}

fn material_double_sided(ref Material value) → Material {
    return Material {name = value.name, side = 2, transparent = value.transparent, opacity = value.opacity, depth_write = value.depth_write, depth_test = value.depth_test, alpha_test = value.alpha_test}
}

fn material_est_double_sided(ref Material value) → bool {
    return value.side ≡ (2 ↦ int<u32>)
}

fn material_side_code(ref Material value) → int ∪ null {
    if material_valida(value) ≡ false then return null
    return value.side ↦ int
}

fn material_depth_enabled(ref Material value) → bool {
    return value.depth_test and value.depth_write
}

fn material_depth_test_enabled(ref Material value) → bool {
    return value.depth_test
}

fn material_depth_write_enabled(ref Material value) → bool {
    return value.depth_write
}

fn material_pipeline_facts(ref Material value) → MaterialPipelineFacts ∪ null {
    if material_valida(value) ≡ false then return null
    return MaterialPipelineFacts {side_code = value.side ↦ int, depth_test_enabled = value.depth_test, depth_write_enabled = value.depth_write, transparent = value.transparent, alpha = value.opacity, alpha_test = value.alpha_test}
}
