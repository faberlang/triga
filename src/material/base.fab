+++ toml
locale = "en"

+++ faber
# Material base contracts, pipeline facts, and the texture descriptor seed.
#
# Public import: import from "triga:material/base"
#
# Owns: Material (+ receiver methods), MaterialPipelineFacts, TextureDescriptor
# and the material_from_name constructor. TextureDescriptor is a placeholder
# until the texture pipeline (samplers, mipmaps, render targets) is designed.

# Material is deliberately a small value contract. The
# fields describe pipeline-relevant state; texture storage and host
# allocation belong to later material leaves and the host renderer.
@ public
class Material {
    mut string name
    # side: 0=FrontSide 1=BackSide 2=DoubleSide
    mut u32 side = 0
    mut bool transparent = false
    mut f32 opacity = 1.0
    mut bool depth_write = true
    mut bool depth_test = true
    mut f32 alpha_test = 0.0

    fn valid() → bool {
        if self.name ≡ "" then return false

        if self.side ≻ 2 then return false

        if self.opacity ≺ 0.0 or self.opacity ≻ 1.0 then return false

        if self.alpha_test ≺ 0.0 or self.alpha_test ≻ 1.0 then return false

        return true
    }

    fn double_sided() → Material {
        return Material { side = 2 } from self
    }

    fn is_double_sided() → bool {
        return self.side ≡ 2
    }

    fn side_code() → int ∪ none {
        if not self.valid() then return null

        return self.side
    }

    fn depth_enabled() → bool {
        return self.depth_test and self.depth_write
    }

    fn depth_test_enabled() → bool {
        return self.depth_test
    }

    fn depth_write_enabled() → bool {
        return self.depth_write
    }

    fn pipeline_facts() → MaterialPipelineFacts ∪ none {
        if not self.valid() then return null

        return MaterialPipelineFacts { side_code = self.side, depth_test_enabled = self.depth_test, depth_write_enabled = self.depth_write, transparent = self.transparent, alpha = self.opacity, alpha_test = self.alpha_test }
    }
}

# MaterialPipelineFacts is the validated, compact view used by pipeline-facing
# examples. Hosts read `side_code` by its numeric value, so the codes don't
# change; the remaining fields expose the depth and alpha decisions without
# requiring consumers to inspect Material.
@ public
class MaterialPipelineFacts {
    mut int side_code
    mut bool depth_test_enabled
    mut bool depth_write_enabled
    mut bool transparent
    mut f32 alpha
    mut f32 alpha_test
}

# TextureDescriptor is the CPU-side description of a texture. The GPU handle
# is `Texture2D` in triga:shader.
@ public
class TextureDescriptor {
    mut u32 width
    mut u32 height
    # Format string: e.g. "rgba8unorm", "depth32float"
    mut string format
    mut list<f32> data optional
    mut bool generate_mipmaps = true
}

@ public
fn material_from_name(string name) → Material {
    return Material { name = name, side = 0, transparent = false, opacity = 1.0, depth_write = true, depth_test = true, alpha_test = 0.0 }
}

+++ faber test
# Co-located package tests for material/base.fab.
# These cases cover construction, validation, side/depth/alpha policy, compact
# pipeline facts, and the temporary texture descriptor carrier. Out-of-range
# opacity/alpha and unsupported side values fail closed; they are not treated
# as rendered capability.
import from "triga:material/base"

test "base material construction preserves defaults and pipeline facts" {
    let base.Material material ← base.material_from_name("base")
    let int side_code ← material.side_code() coalesce -1
    let base.MaterialPipelineFacts ∪ none facts_result ← material.pipeline_facts()

    assert material.name ≡ "base"
    assert material.side ≡ (0 ∷ u32)
    assert material.transparent ≡ false
    assert material.opacity ≡ (1.0 ∷ f32)
    assert material.depth_write
    assert material.depth_test
    assert material.alpha_test ≡ (0.0 ∷ f32)
    assert material.valid()
    assert side_code ≡ 0
    assert material.depth_enabled()
    assert material.depth_test_enabled()
    assert material.depth_write_enabled()
    assert facts_result not is none
    if facts_result not is none {
        assert facts_result!.side_code ≡ 0
        assert facts_result!.depth_test_enabled
        assert facts_result!.depth_write_enabled
        assert facts_result!.transparent ≡ false
        assert facts_result!.alpha ≡ (1.0 ∷ f32)
        assert facts_result!.alpha_test ≡ (0.0 ∷ f32)
    }
}

test "side and depth policies project into validated facts" {
    let base.Material policy ← base.Material {name = "policy", side = 1 ∷ u32, transparent = true, opacity = 0.4, depth_write = false, depth_test = true, alpha_test = 0.25}
    let int side_code ← policy.side_code() coalesce -1
    let base.MaterialPipelineFacts ∪ none facts_result ← policy.pipeline_facts()
    let base.Material double_sided ← policy.double_sided()

    assert policy.valid()
    assert side_code ≡ 1
    assert policy.is_double_sided() ≡ false
    assert policy.depth_enabled() ≡ false
    assert policy.depth_test_enabled()
    assert policy.depth_write_enabled() ≡ false
    assert facts_result not is none
    if facts_result not is none {
        assert facts_result!.side_code ≡ 1
        assert facts_result!.depth_test_enabled
        assert facts_result!.depth_write_enabled ≡ false
        assert facts_result!.transparent
        assert facts_result!.alpha ≡ (0.4 ∷ f32)
        assert facts_result!.alpha_test ≡ (0.25 ∷ f32)
    }

    assert double_sided.side ≡ (2 ∷ u32)
    assert double_sided.is_double_sided()
    assert (double_sided.side_code() coalesce -1) ≡ 2
    assert double_sided.transparent
    assert double_sided.opacity ≡ (0.4 ∷ f32)
    assert double_sided.depth_write ≡ false
    assert double_sided.depth_test
    assert double_sided.alpha_test ≡ (0.25 ∷ f32)
}

test "opacity alpha and unsupported side values fail closed" {
    let base.Material empty_name ← base.Material {name = "", side = 0 ∷ u32, opacity = 1.0, alpha_test = 0.0}
    let base.Material invalid_side ← base.Material {name = "invalid-side", side = 3 ∷ u32, opacity = 1.0, alpha_test = 0.0}
    let base.Material opacity_low ← base.Material {name = "opacity-low", side = 0 ∷ u32, opacity = -0.01, alpha_test = 0.0}
    let base.Material opacity_high ← base.Material {name = "opacity-high", side = 0 ∷ u32, opacity = 1.01, alpha_test = 0.0}
    let base.Material alpha_low ← base.Material {name = "alpha-low", side = 0 ∷ u32, opacity = 1.0, alpha_test = -0.01}
    let base.Material alpha_high ← base.Material {name = "alpha-high", side = 0 ∷ u32, opacity = 1.0, alpha_test = 1.01}

    assert empty_name.valid() ≡ false
    assert invalid_side.valid() ≡ false
    assert opacity_low.valid() ≡ false
    assert opacity_high.valid() ≡ false
    assert alpha_low.valid() ≡ false
    assert alpha_high.valid() ≡ false
    assert empty_name.side_code() is none
    assert invalid_side.side_code() is none
    assert opacity_low.pipeline_facts() is none
    assert opacity_high.pipeline_facts() is none
    assert alpha_low.pipeline_facts() is none
    assert alpha_high.pipeline_facts() is none
}

test "texture descriptor preserves its placeholder shape" {
    let base.TextureDescriptor descriptor ← base.TextureDescriptor {width = 4 ∷ u32, height = 2 ∷ u32, format = "rgba8unorm"}

    assert descriptor.width ≡ (4 ∷ u32)
    assert descriptor.height ≡ (2 ∷ u32)
    assert descriptor.format ≡ "rgba8unorm"
    assert descriptor.data is none
    assert descriptor.generate_mipmaps
}
