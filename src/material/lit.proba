# Co-located package tests for material/lit.fab.
# MeshPhongMaterial is a carrier; base pipeline facts remain the validated
# projection authority and no lighting evaluation is claimed here.
import from "triga:material/lit" lit
import from "triga:material/base" base
import from "triga:math" math

test "Phong material preserves lit carrier fields and base pipeline facts" {
    const base.Material policy ← base.Material {name = "phong", side = 1 ∷ int<u32>, transparent = true, opacity = 0.75, depth_write = false, depth_test = true, alpha_test = 0.2}
    const math.Color color ← math.Color {r = 0.3, g = 0.5, b = 0.7}
    const math.Color specular ← math.Color {r = 0.9, g = 0.8, b = 0.6}
    const lit.MeshPhongMaterial material ← lit.MeshPhongMaterial {base = policy, color = color, specular = specular, shininess = 60.0}
    const base.MaterialPipelineFacts ∪ null facts_result ← material.base.pipeline_facts()

    assert material.base.name ≡ "phong"
    assert material.color.r ≡ (0.3 ∷ f32)
    assert material.color.g ≡ (0.5 ∷ f32)
    assert material.color.b ≡ (0.7 ∷ f32)
    assert material.specular.r ≡ (0.9 ∷ f32)
    assert material.specular.g ≡ (0.8 ∷ f32)
    assert material.specular.b ≡ (0.6 ∷ f32)
    assert material.shininess ≡ (60.0 ∷ f32)
    assert facts_result not is null
    if facts_result not is null {
        assert facts_result!.side_code ≡ 1
        assert facts_result!.depth_test_enabled
        assert facts_result!.depth_write_enabled ≡ false
        assert facts_result!.transparent
        assert facts_result!.alpha ≡ (0.75 ∷ f32)
        assert facts_result!.alpha_test ≡ (0.2 ∷ f32)
    }
}

test "Phong defaults remain explicit carrier values" {
    const lit.MeshPhongMaterial material ← lit.MeshPhongMaterial {base = base.material_from_name("phong-default"), color = math.Color {r = 1.0, g = 1.0, b = 1.0}, specular = math.Color {r = 0.0, g = 0.0, b = 0.0}}

    assert material.shininess ≡ (30.0 ∷ f32)
    assert material.base.valid()
    assert material.base.pipeline_facts() not is null
}

test "Phong carrier exposes invalid base facts as unsupported" {
    const base.Material invalid_base ← base.Material {name = "invalid-phong", side = 0 ∷ int<u32>, opacity = 1.2}
    const lit.MeshPhongMaterial material ← lit.MeshPhongMaterial {base = invalid_base, color = math.Color {r = 1.0, g = 1.0, b = 1.0}, specular = math.Color {r = 0.0, g = 0.0, b = 0.0}}

    assert material.base.valid() ≡ false
    assert material.base.pipeline_facts() is null
    assert material.shininess ≡ (30.0 ∷ f32)
}
