# PhongMaterial — Phong-shaded material contract.
#
# Public import: import from "triga:material/lit" lit
#
# Owns: PhongMaterial.
#
# Imports: triga:math, triga:material/base.

import from "triga:math" math

import from "triga:material/base" base

# PhongMaterial is the first lit-material shape. The Triga presenter fixture
# (`host/fixtures/scene.fab`) draws color/specular from the same module consts
# that build this record; full `.power(shininess)` WGSL emit is still open.
@ public
class PhongMaterial {
    var base.Material base
    var math.Color color
    var math.Color specular
    var f32 shininess = 30.0
}
