# MeshPhongMaterial — Phong-shaded material contract.
#
# Public import: import from "triga:material/lit" lit
#
# Owns: MeshPhongMaterial.
#
# Imports: triga:math, triga:material/base.

import from "triga:math" math

import from "triga:material/base" base

# MeshPhongMaterial is the first lit-material shape. It keeps the three.js
# familiar carrier name while leaving lighting evaluation to the later shader
# and host contracts.
@ public
class MeshPhongMaterial {
    var base.Material base
    var math.Color color
    var math.Color specular
    var f32 shininess = 30.0
}
