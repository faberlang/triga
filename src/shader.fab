+++ toml
locale = "en"

+++ faber
# Shader vocabulary Triga owns and Radix only spells.
#
# Public import: import from "triga:shader"
#
# Stage contracts, opaque resource types and bound functions. The WGSL
# spellings live in bindings/wgsl.toml (`[target.wgsl-text]`). The compiler
# emits the manifest text and does not learn these names.

# --- Stage contracts -------------------------------------------------------
# A stage is an ordinary typed function. Its parameters are the stage inputs
# and its return value is the stage output. A vertex stage returns a class
# whose clip-space field carries `@ Position`; a fragment stage returns its
# color. Without the WGSL bindings these annotations are plain metadata.

# Marks a function as a vertex stage. Bound to WGSL `@vertex`.
@ public
@ annotation { target = functio }
class Vertex {
}

# Marks a function as a fragment stage. Bound to WGSL `@fragment`.
@ public
@ annotation { target = functio }
class Fragment {
}

# Marks the clip-space position field of a vertex stage's output class.
# Bound to WGSL `@builtin(position)`.
@ public
@ annotation { target = field }
class Position {
}

# --- Resources -------------------------------------------------------------

# GPU-facing 2D texture handle. Not `TextureDescriptor` in material/base
# (that is the CPU-side seed). Mapped to `texture_2d<f32>` in the WGSL
# manifest.
@ public
class Texture2D {
}

# GPU-facing sampler handle. Mapped to `sampler` in the WGSL manifest.
@ public
class Sampler {
}

# Bound sampling function. The WGSL spelling is `textureSample`. Faber still
# requires a return on a typed `fn`; this dummy is not the emit body.
@ public
fn sample(Texture2D texture, Sampler sampler, vector<f32, size 2> uv) → vector<f32, size 4> {
    return [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, size 4>
}

+++ faber test
# Co-located coverage for the WGSL-bound shader vocabulary.
# Construction only. Stage-body `sample` lives on the presenter fixture.
import from "triga:shader"

describe "shader resource types" {
    test "Texture2D and Sampler are constructible opaque handles" {
        let shader.Texture2D texture ← shader.Texture2D {}
        let shader.Sampler sampler ← shader.Sampler {}
        assert texture is shader.Texture2D
        assert sampler is shader.Sampler
    }
}
