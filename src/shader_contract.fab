+++ toml
locale = "en"

+++ faber
# Triga's adapter onto the compiler's generic shader-contract surface.
#
# Public import: import from "triga:shader_contract" let contract
#
# The compiler owns the generic `@ shader_contract "<role>"` annotation: it
# collects facts from calls to annotated functions, checks them against fixed
# code tables, and refuses unknown codes. Triga owns the concrete contract and
# maps its API onto that surface. This module is that mapping:
#
#   * one role function per fact family (vertex_layout, varying,
#     fragment_output, pipeline, resource_binding, bound_resource_binding).
#     Each stage-I/O fact names its role explicitly through
#     `stage_io_role_code`; the compiler never infers a role from a name;
#   * Triga's default pipeline: bgra8unorm color, depth24plus with compare
#     less and writes on, triangle-list, 36 vertices, and a read-only
#     transform storage buffer at group 0 binding 0.
#
# Triga never emits WGSL itself. The stage entry points come from the stage
# contracts in triga:shader (`@ Vertex`, `@ Fragment`, `@ Position`) and
# their bindings in bindings/wgsl.toml, and the compiler emits them. A stage's
# typed signature already carries its inputs, varyings and output, so
# `@ shader_contract` keeps only the facts a signature cannot state:
#
#   * where a bound stage resource sits (`bound_resource_binding`: the WGSL
#     backend needs one per Texture2D or Sampler parameter);
#   * vertex-buffer layout, storage-resource placement and pipeline state
#     (`vertex_layout`, `resource_binding`, `pipeline`), which the host reads.
#
# `varying` and `fragment_output` restate what the stage signature declares.
# They stay until the presenter host reads stage I/O from the stage
# signature; then they are removed.
#
# The compiler recognizes a contract-role function when the annotated
# function is declared in the compiled unit and its constant-argument calls
# appear in `assert` statements. Triga's real API function
# `geometry.geometry_vertex_layout_matches` (src/geometry/data.fab) is the
# vertex-layout member of this contract.
#
# Code tables (fixed by the compiler; an unknown code is refused with a
# diagnostic):
#   vertex format   2 = float32x2, 3 = float32x3, 4 = float32x4
#   color target    1 = bgra8unorm, 2 = bgra8unorm-srgb
#   topology        1 = triangle-list, 2 = line-list, 3 = point-list
#   depth compare   0 = no depth attachment,
#                   1 = less, 2 = equal, 3 = less-equal, 4 = greater,
#                   5 = not-equal, 6 = greater-equal, 7 = always
#   step mode       1 = vertex, 2 = instance
#   interpolation   1 = perspective, 2 = linear, 3 = flat
#   stage-io role   1 = position, 2 = color, 3 = transform, 4 = other
#   resource kind   1 = storage buffer, 2 = runtime extent
#   resource role   1 = input, 2 = output
#   resource access 1 = read, 2 = write, 3 = read-write
#   scalar layout   1 = f32 (4 bytes), 2 = f64 (8), 3 = i32 (4), 4 = u32 (4)

# ---------------------------------------------------------------------------
# Contract-role functions
#
# Each declaration mirrors one slice of the generic shader contract. The
# compiler registers the annotation by identity and ingests facts from
# constant-argument calls.
# ---------------------------------------------------------------------------

# Vertex-buffer attribute layout: source semantic, shader location, canonical
# format, offset/stride in bytes, and input step mode. Maps Triga's
# geometry.geometry_vertex_layout_matches real API onto the vertex_layout role.
@ public
@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

# Interstage varying: source semantic, location, format, and interpolation.
# Varyings are declared explicitly.
@ public
@ shader_contract "varying"
fn varying_matches(string source_name, int shader_location, int format_code, int interpolation_code, int stage_io_role_code) → bool {
    return true
}

# Fragment render-target output: location and canonical color format.
@ public
@ shader_contract "fragment_output"
fn fragment_output_matches(int location, int format_code, int stage_io_role_code) → bool {
    return true
}

# Pipeline state: color target, depth compare + write, topology, vertex count.
# Maps Triga's geometry.geometry_pipeline_descriptor_matches contract onto the
# pipeline role; Triga's defaults are the DEFAULT_* constants below.
@ public
@ shader_contract "pipeline"
fn pipeline_matches(int color_target_format_code, int depth_compare_code, int depth_write_enabled_code, int primitive_topology_code, int vertex_count) → bool {
    return true
}

# Resource binding: group/binding, kind, role, access, element count + scalar
# layout, and the source semantic (e.g. "transform").
@ public
@ shader_contract "resource_binding"
fn resource_binding_matches(int group, int binding, int kind_code, int role_code, int access_code, int element_count, int layout_code, string source_name, int stage_io_role_code) → bool {
    return true
}

# Bound stage resource: places a stage parameter whose type is bound in the
# WGSL manifest (`Texture2D`, `Sampler`) at a bind group and binding. The
# name is the stage parameter's name. Each bound parameter needs exactly one.
@ public
@ shader_contract "bound_resource_binding"
fn bound_resource_matches(int group, int binding, string source_name) → bool {
    return true
}

# ---------------------------------------------------------------------------
# Default pipeline
#
# Color target bgra8unorm, depth24plus with compare less and writes enabled,
# triangle-list topology, 36 vertices, and a group-0 binding-0 read-only
# transform storage buffer (32 f32). Programs assert these through the
# pipeline and resource_binding role functions above.
# ---------------------------------------------------------------------------

@ public
const int DEFAULT_COLOR_TARGET_FORMAT_CODE = 1

@ public
const int DEFAULT_DEPTH_COMPARE_CODE = 1

@ public
const int DEFAULT_DEPTH_WRITE_ENABLED_CODE = 1

@ public
const int DEFAULT_PRIMITIVE_TOPOLOGY_CODE = 1

@ public
const int DEFAULT_VERTEX_COUNT = 36

# Position input layout: location 0, float32x3, offset 0, stride 12, vertex
# step mode.

@ public
const int DEFAULT_POSITION_FORMAT_CODE = 3

@ public
const int DEFAULT_POSITION_OFFSET_BYTES = 0

@ public
const int DEFAULT_POSITION_STRIDE_BYTES = 12

@ public
const int DEFAULT_STEP_MODE_VERTEX = 1

# Transform resource: group 0 binding 0, storage buffer, input role, read
# access, 32 f32 elements, f32 scalar layout.

@ public
const int DEFAULT_TRANSFORM_GROUP = 0

@ public
const int DEFAULT_TRANSFORM_BINDING = 0

@ public
const int DEFAULT_TRANSFORM_KIND_CODE = 1

@ public
const int DEFAULT_TRANSFORM_ROLE_CODE = 1

@ public
const int DEFAULT_TRANSFORM_ACCESS_CODE = 1

@ public
const int DEFAULT_TRANSFORM_ELEMENT_COUNT = 32

@ public
const int DEFAULT_TRANSFORM_LAYOUT_CODE = 1

# Fragment color output: location 0, float32x4.

@ public
const int DEFAULT_FRAGMENT_OUTPUT_LOCATION = 0

@ public
const int DEFAULT_FRAGMENT_OUTPUT_FORMAT_CODE = 4

+++ faber test
# The role functions accept Triga's default pipeline facts. The compiler checks
# every code in these calls against its tables, so an unknown code here fails
# the build rather than the test.
import from "triga:shader_contract" let contract

describe "default pipeline facts" {
    test "the position input is float32x3 at location 0 with a 12-byte stride" {
        assert contract.vertex_layout_matches(0, 0, "position", 0, contract.DEFAULT_POSITION_FORMAT_CODE, contract.DEFAULT_POSITION_OFFSET_BYTES, contract.DEFAULT_POSITION_STRIDE_BYTES, contract.DEFAULT_STEP_MODE_VERTEX, 1)
        assert contract.DEFAULT_POSITION_FORMAT_CODE ≡ 3
        assert contract.DEFAULT_POSITION_STRIDE_BYTES ≡ 12
    }

    test "the color varying and the fragment output are float32x4" {
        assert contract.varying_matches("color", 0, 4, 1, 2)
        assert contract.fragment_output_matches(contract.DEFAULT_FRAGMENT_OUTPUT_LOCATION, contract.DEFAULT_FRAGMENT_OUTPUT_FORMAT_CODE, 2)
        assert contract.DEFAULT_FRAGMENT_OUTPUT_FORMAT_CODE ≡ 4
    }

    test "the pipeline is bgra8unorm, depth less with writes, triangle-list, 36 vertices" {
        assert contract.pipeline_matches(contract.DEFAULT_COLOR_TARGET_FORMAT_CODE, contract.DEFAULT_DEPTH_COMPARE_CODE, contract.DEFAULT_DEPTH_WRITE_ENABLED_CODE, contract.DEFAULT_PRIMITIVE_TOPOLOGY_CODE, contract.DEFAULT_VERTEX_COUNT)
        assert contract.DEFAULT_COLOR_TARGET_FORMAT_CODE ≡ 1
        assert contract.DEFAULT_DEPTH_COMPARE_CODE ≡ 1
        assert contract.DEFAULT_PRIMITIVE_TOPOLOGY_CODE ≡ 1
        assert contract.DEFAULT_VERTEX_COUNT ≡ 36
    }

    test "the transform is a read-only 32-float storage buffer at group 0 binding 0" {
        assert contract.resource_binding_matches(contract.DEFAULT_TRANSFORM_GROUP, contract.DEFAULT_TRANSFORM_BINDING, contract.DEFAULT_TRANSFORM_KIND_CODE, contract.DEFAULT_TRANSFORM_ROLE_CODE, contract.DEFAULT_TRANSFORM_ACCESS_CODE, contract.DEFAULT_TRANSFORM_ELEMENT_COUNT, contract.DEFAULT_TRANSFORM_LAYOUT_CODE, "transform", 3)
        assert contract.DEFAULT_TRANSFORM_ELEMENT_COUNT ≡ 32
        assert contract.DEFAULT_TRANSFORM_ACCESS_CODE ≡ 1
    }

    test "a bound texture and sampler take their group and binding" {
        assert contract.bound_resource_matches(1, 0, "albedo")
        assert contract.bound_resource_matches(1, 1, "albedo_sampler")
    }
}
