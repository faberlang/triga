# Triga's adapter onto the compiler-owned generic shader-contract surface.
#
# Public import: import from "triga:shader_contract" contract
#
# The compiler (radix) owns the generic shader-contract lane: the
# `@ shader_contract "<role>"` annotation, identity-resolved ingestion,
# fail-closed code tables, validation, reflection, and WGSL emission.
# Triga owns the concrete external Faber contract and maps its real API onto
# that generic surface. This module is that mapping:
#
#   * contract-role functions carrying the compiler-owned annotation, whose
#     call argument shapes match the canonical surface radix recognizes
#     (roles: vertex_layout / varying / fragment_output / pipeline /
#     resource_binding), each stage-I/O role declared explicitly via
#     `stage_io_role_code` (radix U6; roles are never synthesized from
#     source-name spelling or location);
#   * Triga's canonical code vocabulary (the codes the conformance programs
#     assert — they must be canonical radix_mir::shader_contract codes);
#   * the Goal-01 pipeline defaults, which per decision D2 live HERE as
#     Triga's contract, not in radix (bgra8unorm, depth24plus less+write,
#     triangle-list, 36 vertices, transform storage buffer).
#
# Council lock: Triga never emits WGSL. It maps its API to the generic
# surface; radix emits.
#
# The radix driver recognizes a contract-role function when the annotated
# function is declared in the compiled unit and its constant-argument calls
# appear in `adfirma` assertions. Triga's real API function
# `geometry.geometry_vertex_layout_matches` (src/geometry/data.fab) is the
# vertex-layout member of this contract; conformance programs
# (exempla/conformance/shader-contract/*) declare the adapter pattern and
# assert facts against it.
#
# Canonical code tables (radix_mir::shader_contract; unknown codes fail
# closed with a structured diagnostic):
#   vertex format   2 = float32x2, 3 = float32x3, 4 = float32x4
#   color target    1 = bgra8unorm, 2 = bgra8unorm-srgb
#   topology        1 = triangle-list, 2 = line-list, 3 = point-list
#   depth compare   0 = no depth attachment (driver sentinel),
#                   1 = less, 2 = equal, 3 = less-equal, 4 = greater,
#                   5 = not-equal, 6 = greater-equal, 7 = always
#   step mode       1 = vertex, 2 = instance
#   interpolation   1 = perspective, 2 = linear, 3 = flat
#   stage-io role   1 = position, 2 = color, 3 = transform, 4 = other
#   (stage_io_role_code, radix_mir::shader_contract::stage_io_role_from_code:
#   the explicit stage-I/O role declared on each vertex_layout / varying /
#   fragment_output / resource_binding call — never synthesized from
#   source-name spelling or location)
#   resource kind   1 = storage buffer, 2 = runtime extent
#   resource role   1 = input, 2 = output
#   resource access 1 = read, 2 = write, 3 = read-write
#   scalar layout   1 = f32 (4 bytes), 2 = f64 (8), 3 = i32 (4), 4 = u32 (4)

# ---------------------------------------------------------------------------
# Contract-role adapter functions (decision D1 surface)
#
# Each declaration mirrors one slice of the generic shader contract. The
# compiler registers the annotation by identity and ingests facts from
# constant-argument calls.
# ---------------------------------------------------------------------------

# Vertex-buffer attribute layout: source semantic, shader location, canonical
# format, offset/stride in bytes, and input step mode. Maps Triga's
# geometry.geometry_vertex_layout_matches real API onto the vertex_layout role.
@ public
@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

# Interstage varying: source semantic, location, format, and interpolation.
# Explicit varying declarations are Triga's contract (decision D3).
@ public
@ shader_contract "varying"
fn varying_matches(string source_name, int shader_location, int format_code, int interpolation_code, int stage_io_role_code) → bool {
    return true
}

# Fragment render-target output: location and canonical color format.
@ public
@ shader_contract "fragment_output"
fn fragment_output_matches(int location, int format_code, int stage_io_role_code) → bool {
    return true
}

# Pipeline state: color target, depth compare + write, topology, vertex count.
# Maps Triga's geometry.geometry_pipeline_descriptor_matches contract onto the
# pipeline role; the Goal-01 defaults are declared as named constants below
# (decision D2).
@ public
@ shader_contract "pipeline"
fn pipeline_matches(int color_target_format_code, int depth_compare_code, int depth_write_enabled_code, int primitive_topology_code, int vertex_count) → bool {
    return true
}

# Resource binding: group/binding, kind, role, access, element count + scalar
# layout, and the source semantic (e.g. "transform").
@ public
@ shader_contract "resource_binding"
fn resource_binding_matches(int group, int binding, int kind_code, int role_code, int access_code, int element_count, int layout_code, string source_name, int stage_io_role_code) → bool {
    return true
}

# ---------------------------------------------------------------------------
# Goal-01 pipeline defaults (decision D2 — Triga's contract)
#
# The first-pipeline contract locked by docs/factory/hello-voxel/goals/
# 01-source-graphics-pipeline.md: color target bgra8unorm, depth24plus with
# compare less + writes enabled, triangle-list topology, 36 vertices, and a
# group-0 binding-0 read-only transform storage buffer (32 f32). Conformance
# programs assert these defaults through the pipeline / resource_binding role
# functions above.
# ---------------------------------------------------------------------------

const int goal_color_target_format_code ← 1

const int goal_depth_compare_code ← 1

const int goal_depth_write_enabled_code ← 1

const int goal_primitive_topology_code ← 1

const int goal_vertex_count ← 36
# Position input layout: location 0, float32x3, offset 0, stride 12, vertex
# step mode.

const int goal_position_format_code ← 3

const int goal_position_offset_bytes ← 0

const int goal_position_stride_bytes ← 12

const int goal_step_mode_vertex ← 1

# Transform resource: group 0 binding 0, storage buffer, input role, read
# access, 32 f32 elements, f32 scalar layout.

const int goal_transform_group ← 0

const int goal_transform_binding ← 0

const int goal_transform_kind_code ← 1

const int goal_transform_role_code ← 1

const int goal_transform_access_code ← 1

const int goal_transform_element_count ← 32

const int goal_transform_layout_code ← 1

# Fragment color output: location 0, float32x4.

const int goal_fragment_output_location ← 0

const int goal_fragment_output_format_code ← 4
