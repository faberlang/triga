+++ toml
locale = "en"

+++ faber
# Light family shape contracts (Light, AmbientLight, DirectionalLight, PointLight).
#
# Public import: import from "triga:lighting/light" lighting
# Depends on: triga:math, triga:graph/object (Object base)

import from "triga:math"

import from "triga:graph/object" let graph_object

# Light is the shared scene-graph payload for the current light families.
# `color` and `intensity` are source-side facts; the host decides how a later
# renderer turns them into bindings or shader inputs.
@ public
class Light {
    mut graph_object.Object base
    mut math.Color color
    mut f32 intensity = 1.0
}

# AmbientLight contributes a light family with no direction or position of its
# own. It keeps the common Object and Light data visible through `base`.
@ public
class AmbientLight {
    mut Light base
}

# DirectionalLight points at an explicit target position. Keeping the target in
# the source contract makes the intended direction deterministic for examples
# and host adapters.
@ public
class DirectionalLight {
    mut Light base
    mut vector<f32, size 3> target_position
}

# PointLight carries the distance and decay fields for the point-light path.
# Their defaults are part of the source shape; the eventual renderer owns the
# interpretation of cutoff and attenuation.
@ public
class PointLight {
    mut Light base
    mut f32 distance = 0.0
    mut f32 decay = 2.0
}

+++ faber test
# Co-located package tests for lighting/light.fab.
# These cases prove source-side carrier facts only. They do not claim that a
# host renderer consumes, evaluates, or otherwise executes a light.
# PointLight is a published carrier; it is not a Profile v0 host lighting row.
import from "triga:lighting/light"
import from "triga:graph/object" let graph_object
import from "triga:math"

fn spawn_light(string name) → graph_object.Object {
    return graph_object.Object {position = [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, size 3>, matrix = math.matrix_identity(), children = empty, name = name}
}

fn spawn_light_at(string name, f32 x, f32 y, f32 z) → graph_object.Object {
    return graph_object.Object {position = [x, y, z] ↦ vector<f32, size 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, size 3>, matrix = math.matrix_identity(), children = empty, name = name}
}

test "Light preserves color and default intensity as carrier facts" {
    let light.Light source ← light.Light {base = spawn_light("shared"), color = math.Color {r = 0.0, g = 0.0, b = 0.0}, intensity = 1.0}

    assert source.base.name ≡ "shared"
    assert source.color.r ≡ (0.0 ∷ f32)
    assert source.color.g ≡ (0.0 ∷ f32)
    assert source.color.b ≡ (0.0 ∷ f32)
    assert source.intensity ≡ (1.0 ∷ f32)
}

test "AmbientLight carries color and zero-intensity boundaries" {
    let light.Light source ← light.Light {base = spawn_light("ambient"), color = math.Color {r = 0.0, g = 0.5, b = 1.0}, intensity = 0.0}
    let light.AmbientLight ambient ← light.AmbientLight {base = source}

    assert ambient.base.base.name ≡ "ambient"
    assert ambient.base.color.r ≡ (0.0 ∷ f32)
    assert ambient.base.color.g ≡ (0.5 ∷ f32)
    assert ambient.base.color.b ≡ (1.0 ∷ f32)
    assert ambient.base.intensity ≡ (0.0 ∷ f32)
}

test "DirectionalLight carries target position and full-intensity boundary" {
    let vector<f32, size 3> target ← [-2.0, 0.0, 5.0] ↦ vector<f32, size 3>
    let light.Light source ← light.Light {base = spawn_light("directional"), color = math.Color {r = 1.0, g = 1.0, b = 1.0}, intensity = 1.0}
    let light.DirectionalLight directional ← light.DirectionalLight {base = source, target_position = target}

    assert directional.base.base.name ≡ "directional"
    assert directional.base.color.r ≡ (1.0 ∷ f32)
    assert directional.base.color.g ≡ (1.0 ∷ f32)
    assert directional.base.color.b ≡ (1.0 ∷ f32)
    assert directional.base.intensity ≡ (1.0 ∷ f32)
    assert directional.target_position[0] ≡ (-2.0 ∷ f32)
    assert directional.target_position[1] ≡ (0.0 ∷ f32)
    assert directional.target_position[2] ≡ (5.0 ∷ f32)
}

test "DirectionalLight records position and target as direction carriers" {
    let vector<f32, size 3> target ← [0.0, 0.0, 0.0] ↦ vector<f32, size 3>
    let light.Light source ← light.Light {base = spawn_light_at("from-above", 0.0, 4.0, 0.0), color = math.Color {r = 1.0, g = 1.0, b = 1.0}, intensity = 1.0}
    let light.DirectionalLight directional ← light.DirectionalLight {base = source, target_position = target}

    assert directional.base.base.name ≡ "from-above"
    assert directional.base.base.position[0] ≡ (0.0 ∷ f32)
    assert directional.base.base.position[1] ≡ (4.0 ∷ f32)
    assert directional.base.base.position[2] ≡ (0.0 ∷ f32)
    assert directional.target_position[0] ≡ (0.0 ∷ f32)
    assert directional.target_position[1] ≡ (0.0 ∷ f32)
    assert directional.target_position[2] ≡ (0.0 ∷ f32)
}

test "DirectionalLight keeps a coincident target as a degenerate direction carrier" {
    let vector<f32, size 3> origin ← [1.0, 2.0, 3.0] ↦ vector<f32, size 3>
    let light.Light source ← light.Light {base = spawn_light_at("coincident", 1.0, 2.0, 3.0), color = math.Color {r = 0.0, g = 0.0, b = 0.0}, intensity = 0.0}
    let light.DirectionalLight directional ← light.DirectionalLight {base = source, target_position = origin}

    assert directional.base.base.position[0] ≡ (1.0 ∷ f32)
    assert directional.base.base.position[1] ≡ (2.0 ∷ f32)
    assert directional.base.base.position[2] ≡ (3.0 ∷ f32)
    assert directional.target_position[0] ≡ (1.0 ∷ f32)
    assert directional.target_position[1] ≡ (2.0 ∷ f32)
    assert directional.target_position[2] ≡ (3.0 ∷ f32)
    assert directional.base.intensity ≡ (0.0 ∷ f32)
}

test "PointLight preserves distance and decay carrier fields" {
    let light.Light source ← light.Light {base = spawn_light("point"), color = math.Color {r = 0.25, g = 0.5, b = 0.75}, intensity = 2.0}
    let light.PointLight point ← light.PointLight {base = source, distance = 25.0, decay = 0.0}

    assert point.base.base.name ≡ "point"
    assert point.base.color.r ≡ (0.25 ∷ f32)
    assert point.base.color.g ≡ (0.5 ∷ f32)
    assert point.base.color.b ≡ (0.75 ∷ f32)
    assert point.base.intensity ≡ (2.0 ∷ f32)
    assert point.distance ≡ (25.0 ∷ f32)
    assert point.decay ≡ (0.0 ∷ f32)
}

test "PointLight defaults remain explicit carrier values" {
    let light.Light source ← light.Light {base = spawn_light("point-defaults"), color = math.Color {r = 0.0, g = 0.0, b = 0.0}, intensity = 1.0}
    let light.PointLight point ← light.PointLight {base = source, distance = 0.0, decay = 2.0}

    assert point.base.base.name ≡ "point-defaults"
    assert point.base.intensity ≡ (1.0 ∷ f32)
    assert point.distance ≡ (0.0 ∷ f32)
    assert point.decay ≡ (2.0 ∷ f32)
}

test "Presenter-shaped AmbientLight and DirectionalLight carriers" {
    # Same abstract field shape as host/fixtures/scene.fab (scene params, not API).
    let light.AmbientLight ambient ← light.AmbientLight {base = light.Light {base = spawn_light("presenter-ambient"), color = math.Color {r = 1.0, g = 0.0, b = 1.0}, intensity = 0.55}}
    let light.DirectionalLight sun ← light.DirectionalLight {base = light.Light {base = spawn_light_at("presenter-sun", 2.0, 4.0, 1.0), color = math.Color {r = 1.0, g = 0.98, b = 0.92}, intensity = 1.0}, target_position = [0.0, 0.0, -1.0] ↦ vector<f32, size 3>}

    assert ambient.base.base.name ≡ "presenter-ambient"
    assert ambient.base.color.r ≡ (1.0 ∷ f32)
    assert ambient.base.color.g ≡ (0.0 ∷ f32)
    assert ambient.base.color.b ≡ (1.0 ∷ f32)
    assert ambient.base.intensity ≡ (0.55 ∷ f32)
    assert sun.base.base.name ≡ "presenter-sun"
    assert sun.base.intensity ≡ (1.0 ∷ f32)
    assert sun.base.base.position[0] ≡ (2.0 ∷ f32)
    assert sun.base.base.position[1] ≡ (4.0 ∷ f32)
    assert sun.base.base.position[2] ≡ (1.0 ∷ f32)
    assert sun.target_position[2] ≡ (-1.0 ∷ f32)
}
