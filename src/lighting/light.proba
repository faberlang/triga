+++
locale = "en"
+++
# Co-located package tests for lighting/light.fab.
# These cases prove source-side carrier facts only. They do not claim that a
# host renderer consumes, evaluates, or otherwise executes a light.
# PointLight is a published carrier; it is not a Profile v0 host lighting row.
import from "triga:lighting/light" light
import from "triga:graph/object" graph_object
import from "triga:math" math

fn spawn_light(string nomen) → graph_object.Object3D {
    return graph_object.Object3D {position = math.vector3(0.0, 0.0, 0.0), rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = math.vector3(1.0, 1.0, 1.0), matrix = math.matrix4_identitas(), children = empty, name = nomen}
}

fn spawn_light_at(string nomen, f32 x, f32 y, f32 z) → graph_object.Object3D {
    return graph_object.Object3D {position = math.vector3(x, y, z), rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = math.vector3(1.0, 1.0, 1.0), matrix = math.matrix4_identitas(), children = empty, name = nomen}
}

test "Light preserves color and default intensity as carrier facts" {
    const light.Light source ← light.Light {base = spawn_light("shared"), color = math.Color {r = 0.0, g = 0.0, b = 0.0}, intensity = 1.0}

    assert source.base.name ≡ "shared"
    assert source.color.r ≡ (0.0 ∷ f32)
    assert source.color.g ≡ (0.0 ∷ f32)
    assert source.color.b ≡ (0.0 ∷ f32)
    assert source.intensity ≡ (1.0 ∷ f32)
}

test "AmbientLight carries color and zero-intensity boundaries" {
    const light.Light source ← light.Light {base = spawn_light("ambient"), color = math.Color {r = 0.0, g = 0.5, b = 1.0}, intensity = 0.0}
    const light.AmbientLight ambient ← light.AmbientLight {base = source}

    assert ambient.base.base.name ≡ "ambient"
    assert ambient.base.color.r ≡ (0.0 ∷ f32)
    assert ambient.base.color.g ≡ (0.5 ∷ f32)
    assert ambient.base.color.b ≡ (1.0 ∷ f32)
    assert ambient.base.intensity ≡ (0.0 ∷ f32)
}

test "DirectionalLight carries target position and full-intensity boundary" {
    const math.Vector3 target ← math.vector3(-2.0, 0.0, 5.0)
    const light.Light source ← light.Light {base = spawn_light("directional"), color = math.Color {r = 1.0, g = 1.0, b = 1.0}, intensity = 1.0}
    const light.DirectionalLight directional ← light.DirectionalLight {base = source, target_position = target}

    assert directional.base.base.name ≡ "directional"
    assert directional.base.color.r ≡ (1.0 ∷ f32)
    assert directional.base.color.g ≡ (1.0 ∷ f32)
    assert directional.base.color.b ≡ (1.0 ∷ f32)
    assert directional.base.intensity ≡ (1.0 ∷ f32)
    assert directional.target_position.x ≡ (-2.0 ∷ f32)
    assert directional.target_position.y ≡ (0.0 ∷ f32)
    assert directional.target_position.z ≡ (5.0 ∷ f32)
}

test "DirectionalLight records position and target as direction carriers" {
    const math.Vector3 target ← math.vector3(0.0, 0.0, 0.0)
    const light.Light source ← light.Light {base = spawn_light_at("from-above", 0.0, 4.0, 0.0), color = math.Color {r = 1.0, g = 1.0, b = 1.0}, intensity = 1.0}
    const light.DirectionalLight directional ← light.DirectionalLight {base = source, target_position = target}

    assert directional.base.base.name ≡ "from-above"
    assert directional.base.base.position.x ≡ (0.0 ∷ f32)
    assert directional.base.base.position.y ≡ (4.0 ∷ f32)
    assert directional.base.base.position.z ≡ (0.0 ∷ f32)
    assert directional.target_position.x ≡ (0.0 ∷ f32)
    assert directional.target_position.y ≡ (0.0 ∷ f32)
    assert directional.target_position.z ≡ (0.0 ∷ f32)
}

test "DirectionalLight keeps a coincident target as a degenerate direction carrier" {
    const math.Vector3 origin ← math.vector3(1.0, 2.0, 3.0)
    const light.Light source ← light.Light {base = spawn_light_at("coincident", 1.0, 2.0, 3.0), color = math.Color {r = 0.0, g = 0.0, b = 0.0}, intensity = 0.0}
    const light.DirectionalLight directional ← light.DirectionalLight {base = source, target_position = origin}

    assert directional.base.base.position.x ≡ (1.0 ∷ f32)
    assert directional.base.base.position.y ≡ (2.0 ∷ f32)
    assert directional.base.base.position.z ≡ (3.0 ∷ f32)
    assert directional.target_position.x ≡ (1.0 ∷ f32)
    assert directional.target_position.y ≡ (2.0 ∷ f32)
    assert directional.target_position.z ≡ (3.0 ∷ f32)
    assert directional.base.intensity ≡ (0.0 ∷ f32)
}

test "PointLight preserves distance and decay carrier fields" {
    const light.Light source ← light.Light {base = spawn_light("point"), color = math.Color {r = 0.25, g = 0.5, b = 0.75}, intensity = 2.0}
    const light.PointLight point ← light.PointLight {base = source, distance = 25.0, decay = 0.0}

    assert point.base.base.name ≡ "point"
    assert point.base.color.r ≡ (0.25 ∷ f32)
    assert point.base.color.g ≡ (0.5 ∷ f32)
    assert point.base.color.b ≡ (0.75 ∷ f32)
    assert point.base.intensity ≡ (2.0 ∷ f32)
    assert point.distance ≡ (25.0 ∷ f32)
    assert point.decay ≡ (0.0 ∷ f32)
}

test "PointLight defaults remain explicit carrier values" {
    const light.Light source ← light.Light {base = spawn_light("point-defaults"), color = math.Color {r = 0.0, g = 0.0, b = 0.0}, intensity = 1.0}
    const light.PointLight point ← light.PointLight {base = source, distance = 0.0, decay = 2.0}

    assert point.base.base.name ≡ "point-defaults"
    assert point.base.intensity ≡ (1.0 ∷ f32)
    assert point.distance ≡ (0.0 ∷ f32)
    assert point.decay ≡ (2.0 ∷ f32)
}
