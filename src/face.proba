# Co-located package tests for oriented FaceQuad construction and colored
# mesh accumulation.
import from "triga:face" face
import from "triga:geometry/data" data
import from "triga:math" math

describe "face quad builders" {
    test "negative X face publishes exact corners" {
        const face.FaceQuad ∪ none quad_result ← face.face_code_unit_quad(1, 10.0, 20.0, 30.0, 2.0)
        assert quad_result not is none
        const face.FaceQuad quad ← quad_result
        assert math.x(quad.a) ≡ (10.0 ∷ f32)
        assert math.y(quad.a) ≡ (20.0 ∷ f32)
        assert math.z(quad.a) ≡ (30.0 ∷ f32)
        assert math.z(quad.b) ≡ (32.0 ∷ f32)
        assert math.y(quad.c) ≡ (22.0 ∷ f32)
        assert math.x(quad.d) ≡ (10.0 ∷ f32)
    }

    test "all face codes preserve their orientation and winding" {
        const face.FaceQuad ∪ none positive_x_result ← face.face_code_unit_quad(2, 1.0, 2.0, 3.0, 4.0)
        assert positive_x_result not is none
        const face.FaceQuad positive_x ← positive_x_result
        const face.FaceQuad ∪ none negative_y_result ← face.face_code_unit_quad(3, 1.0, 2.0, 3.0, 4.0)
        assert negative_y_result not is none
        const face.FaceQuad negative_y ← negative_y_result
        const face.FaceQuad ∪ none positive_y_result ← face.face_code_unit_quad(4, 1.0, 2.0, 3.0, 4.0)
        assert positive_y_result not is none
        const face.FaceQuad positive_y ← positive_y_result
        const face.FaceQuad ∪ none negative_z_result ← face.face_code_unit_quad(5, 1.0, 2.0, 3.0, 4.0)
        assert negative_z_result not is none
        const face.FaceQuad negative_z ← negative_z_result
        const face.FaceQuad ∪ none positive_z_result ← face.face_code_unit_quad(6, 1.0, 2.0, 3.0, 4.0)
        assert positive_z_result not is none
        const face.FaceQuad positive_z ← positive_z_result
        assert math.x(positive_x.a) ≡ (5.0 ∷ f32)
        assert math.z(positive_x.a) ≡ (7.0 ∷ f32)
        assert math.z(positive_x.d) ≡ (7.0 ∷ f32)
        assert math.y(negative_y.a) ≡ (2.0 ∷ f32)
        assert math.x(negative_y.b) ≡ (5.0 ∷ f32)
        assert math.y(positive_y.a) ≡ (6.0 ∷ f32)
        assert math.z(positive_y.c) ≡ (3.0 ∷ f32)
        assert math.z(negative_z.a) ≡ (3.0 ∷ f32)
        assert math.x(negative_z.b) ≡ (1.0 ∷ f32)
        assert math.z(positive_z.a) ≡ (7.0 ∷ f32)
        assert math.y(positive_z.c) ≡ (6.0 ∷ f32)
    }

    test "invalid codes and non-positive sizes return absence" {
        assert face.face_code_unit_quad(0, 0.0, 0.0, 0.0, 1.0) is none
        assert face.face_code_unit_quad(7, 0.0, 0.0, 0.0, 1.0) is none
        assert face.face_code_unit_quad(1, 0.0, 0.0, 0.0, 0.0) is none
        assert face.face_code_unit_quad(1, 0.0, 0.0, 0.0, -1.0) is none
        assert face.face_code_colored_quad_mesh_append(empty, empty, empty, 9, 0.0, 0.0, 0.0, 1.0) is none
        assert face.face_code_colored_quad_mesh_append([0.0], empty, empty, 1, 0.0, 0.0, 0.0, 1.0) is none
    }

    test "colored face append publishes exact position color and index arrays" {
        const data.ColoredQuadMesh ∪ none mesh_result ← face.face_code_colored_quad_mesh_append(empty, empty, empty, 6, 1.0, 2.0, 3.0, 2.0)
        assert mesh_result not is none
        const data.ColoredQuadMesh mesh ← mesh_result
        assert mesh.positions.length() ≡ 12
        assert mesh.colors.length() ≡ 12
        assert mesh.indices.length() ≡ 6
        assert mesh.positions[0] ≡ (1.0 ∷ f32)
        assert mesh.positions[2] ≡ (5.0 ∷ f32)
        assert mesh.positions[5] ≡ (5.0 ∷ f32)
        assert mesh.positions[8] ≡ (5.0 ∷ f32)
        assert mesh.positions[9] ≡ (1.0 ∷ f32)
        assert mesh.positions[11] ≡ (5.0 ∷ f32)
        assert mesh.colors[0] ≡ (0.4 ∷ f32)
        assert mesh.colors[1] ≡ (0.4 ∷ f32)
        assert mesh.colors[2] ≡ (1.0 ∷ f32)
        assert mesh.indices[0] ≡ (0 ∷ u32)
        assert mesh.indices[1] ≡ (1 ∷ u32)
        assert mesh.indices[2] ≡ (2 ∷ u32)
        assert mesh.indices[3] ≡ (0 ∷ u32)
        assert mesh.indices[4] ≡ (2 ∷ u32)
        assert mesh.indices[5] ≡ (3 ∷ u32)
        assert (mesh.face_count() coalesce 0) ≡ 1
        assert mesh.geometry() not is none
    }
}
