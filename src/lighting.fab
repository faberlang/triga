+++ toml
locale = "en"

+++ faber
# lighting.fab — package map facade for the lighting package.
#
# Public import: import from "triga:lighting"
#
# Prefer leaf modules (one concern per import path):
#   triga:lighting/light    Light family (Light, AmbientLight, DirectionalLight, PointLight)
#
# This file holds no types. Import the leaf modules above.

import from "triga:lighting/light" let lighting

+++ faber test
# Co-located package smoke for the map-only lighting facade.
# Light family behavior belongs to triga:lighting/light; this case proves
# only that the public facade path is discoverable.
import from "triga:lighting"

test "lighting facade is discoverable" {
    assert true
}
