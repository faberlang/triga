# Stable, backend-agnostic scene identity and heterogeneous node storage.
#
# Public import: import from "triga:scene" scene
# Depends on: triga:math, triga:resource

import from "triga:math" math

import from "triga:resource" resource

# A SceneHandle names a slot and its generation. Handles are the stable value
# passed between scene edits and render queries; callers never need to hold a
# mutable SceneNode reference.
@ public
class SceneHandle {
    int index
    int generation
}

# SceneNodeKind keeps the heterogeneous scene payload explicit. Mesh nodes
# carry resource handles; groups, cameras, and lights remain distinct cases so
# traversal can filter without guessing from a name or field convention.
@ public
union SceneNodeKind {
    SceneGroup,
    SceneMesh {
        resource.ResourceHandle geometry
        resource.ResourceHandle material
    },
    SceneCamera,
    SceneLight,
}

# SceneNode stores local and cached world transforms together with hierarchy
# links. `world_dirty` marks the cache after a local edit or reparent; the store
# refreshes it before a render-facing query.
@ public
class SceneNode {
    string name
    SceneNodeKind kind
    SceneHandle parent optional
    list<SceneHandle> children
    bool visible
    math.Matrix4 local_matrix
    math.Matrix4 world_matrix
    bool world_dirty

    fn mesh_geometria() → resource.ResourceHandle ∪ null {
        match self.kind {
            case SceneMesh const geometry, material {
                return geometry
            }
            case SceneGroup {
                return null
            }
            case SceneCamera {
                return null
            }
            case SceneLight {
                return null
            }
        }
    }

    fn mesh_materia() → resource.ResourceHandle ∪ null {
        match self.kind {
            case SceneMesh const geometry, material {
                return material
            }
            case SceneGroup {
                return null
            }
            case SceneCamera {
                return null
            }
            case SceneLight {
                return null
            }
        }
    }
}

# SceneSlot is the store's generation-checked storage cell. A deleted node
# leaves its slot behind so an old handle cannot silently refer to a new node.
@ public
class SceneSlot {
    int generation
    bool alive
    SceneNode node
}

# SceneStore owns mutation, hierarchy validation, world-transform refresh, and
# bounded preorder traversal. It is the stateful boundary of this otherwise
# backend-agnostic source module, so callers bind it with `varia`.
@ public
class SceneStore {
    list<SceneSlot> slots

    # ── Mutation (Imperativus) ──────────────────────────────────────────
    # These methods reject stale handles, duplicate parents, and cycles while
    # preserving the slot/generation identity of every live node.

    fn insere(SceneNode nodus) → SceneHandle {
        const int index ← self.slots.length()
        self.slots.append(SceneSlot {generation = 0, alive = true, node = nodus})
        return SceneHandle {index = index, generation = 0}
    }

    fn continet(ref SceneHandle manubrium) → bool {
        if manubrium.index ≥ self.slots.length() then return false
        const SceneSlot socors ← self.slots[manubrium.index]
        return socors.alive and socors.generation ≡ manubrium.generation
    }

    fn cape(ref SceneHandle manubrium) → SceneNode ∪ null {
        if self.continet(manubrium) ≡ false then return null
        return self.slots[manubrium.index].node
    }

    fn adiunge(ref SceneHandle filius, ref SceneHandle parens) → bool {
        if self.continet(filius) ≡ false then return false
        if self.continet(parens) ≡ false then return false
        if self._circuitum_faceret(filius, parens) then return false
        const SceneNode ∪ null filius_result ← self.cape(filius)
        const SceneNode ∪ null parens_result ← self.cape(parens)
        if filius_result is null then return false
        if parens_result is null then return false
        const SceneNode filius_nodus ← SceneNode {name = filius_result!.name, kind = filius_result!.kind, parent = filius_result!.parent, children = filius_result!.children, visible = filius_result!.visible, local_matrix = filius_result!.local_matrix, world_matrix = filius_result!.world_matrix, world_dirty = filius_result!.world_dirty}
        const SceneNode parens_nodus ← SceneNode {name = parens_result!.name, kind = parens_result!.kind, parent = parens_result!.parent, children = parens_result!.children, visible = parens_result!.visible, local_matrix = parens_result!.local_matrix, world_matrix = parens_result!.world_matrix, world_dirty = parens_result!.world_dirty}
        if filius_nodus.parent not is null {
            const SceneHandle exsistens_parens ← SceneHandle {index = filius_nodus.parent!.index, generation = filius_nodus.parent!.generation}
            if scene_handle_equals(exsistens_parens, parens) then return false
        }
        # Remove child from old parent's children list if it had one
        if filius_nodus.parent not is null {
            const SceneHandle vetus_parens ← SceneHandle {index = filius_nodus.parent!.index, generation = filius_nodus.parent!.generation}
            const SceneNode ∪ null vetus_parens_result ← self.cape(vetus_parens)
            if vetus_parens_result is null then return false
            const SceneNode vetus_nodus ← SceneNode {name = vetus_parens_result!.name, kind = vetus_parens_result!.kind, parent = vetus_parens_result!.parent, children = vetus_parens_result!.children, visible = vetus_parens_result!.visible, local_matrix = vetus_parens_result!.local_matrix, world_matrix = vetus_parens_result!.world_matrix, world_dirty = vetus_parens_result!.world_dirty}
            self._reple(vetus_parens, self._sine_liberis(vetus_nodus, filius))
        }
        # Add child to parent's children list
        var list<SceneHandle> liberi ← vacua
        var int i ← 0
        while i ≺ parens_nodus.children.length() {
            const SceneHandle exsistens ← parens_nodus.children[i]
            liberi.append(SceneHandle {index = exsistens.index, generation = exsistens.generation})
            i ← i + 1
        }
        liberi.append(SceneHandle {index = filius.index, generation = filius.generation})
        const SceneNode renovatus_parens ← SceneNode {name = parens_nodus.name, kind = parens_nodus.kind, parent = parens_nodus.parent, children = liberi, visible = parens_nodus.visible, local_matrix = parens_nodus.local_matrix, world_matrix = parens_nodus.world_matrix, world_dirty = parens_nodus.world_dirty}
        const SceneNode renovatus_filius ← SceneNode {name = filius_nodus.name, kind = filius_nodus.kind, parent = SceneHandle {index = parens.index, generation = parens.generation}, children = filius_nodus.children, visible = filius_nodus.visible, local_matrix = filius_nodus.local_matrix, world_matrix = filius_nodus.world_matrix, world_dirty = true}
        self._reple(parens, renovatus_parens)
        self._reple(filius, renovatus_filius)
        self._nota_mundum_sordidum(filius)
        return true
    }

    fn seiunge(ref SceneHandle filius) → bool {
        if self.continet(filius) ≡ false then return false
        const SceneNode ∪ null filius_result ← self.cape(filius)
        if filius_result is null then return false
        const SceneNode filius_nodus ← SceneNode {name = filius_result!.name, kind = filius_result!.kind, parent = filius_result!.parent, children = filius_result!.children, visible = filius_result!.visible, local_matrix = filius_result!.local_matrix, world_matrix = filius_result!.world_matrix, world_dirty = filius_result!.world_dirty}
        if filius_nodus.parent is null then return false
        const SceneHandle parens_manubrium ← SceneHandle {index = filius_nodus.parent!.index, generation = filius_nodus.parent!.generation}
        const SceneNode ∪ null parens_result ← self.cape(parens_manubrium)
        if parens_result is null then return false
        const SceneNode parens_nodus ← SceneNode {name = parens_result!.name, kind = parens_result!.kind, parent = parens_result!.parent, children = parens_result!.children, visible = parens_result!.visible, local_matrix = parens_result!.local_matrix, world_matrix = parens_result!.world_matrix, world_dirty = parens_result!.world_dirty}
        const SceneNode seiunctus_filius ← SceneNode {name = filius_nodus.name, kind = filius_nodus.kind, children = filius_nodus.children, visible = filius_nodus.visible, local_matrix = filius_nodus.local_matrix, world_matrix = filius_nodus.world_matrix, world_dirty = true}
        self._reple(parens_manubrium, self._sine_liberis(parens_nodus, filius))
        self._reple(filius, seiunctus_filius)
        self._nota_mundum_sordidum(filius)
        return true
    }

    fn detrahe(ref SceneHandle manubrium) → bool {
        if self.continet(manubrium) ≡ false then return false
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return false
        if nodus_result!.children.length() ≻ 0 then return false
        if nodus_result!.parent not is null {
            const bool seiunctus ← self.seiunge(manubrium)
            if seiunctus ≡ false then return false
        }
        const SceneSlot socors ← self.slots[manubrium.index]
        self.slots[manubrium.index] ← SceneSlot {generation = socors.generation + 1, alive = false, node = socors.node}
        return true
    }

    fn inveni(string nomen) → SceneHandle ∪ null {
        const SceneTraversal ∪ null result ← self._traverse_preorder(SceneHandle {index = 0, generation = 0}, vacua, self.slots.length())
        if result is null then return null
        const SceneTraversal peragratio ← SceneTraversal {handles = result!.handles, remaining = result!.remaining}
        var int i ← 0
        while i ≺ peragratio.handles.length() {
            const SceneHandle manubrium ← peragratio.handles[i]
            const SceneNode ∪ null nodus ← self.cape(manubrium)
            if nodus is null then return null
            if nodus!.name ≡ nomen then return SceneHandle {index = manubrium.index, generation = manubrium.generation}
            i ← i + 1
        }
        return null
    }

    fn pone_visibile(ref SceneHandle manubrium, bool valor) → bool {
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return false
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        self._reple(manubrium, SceneNode {name = nodus.name, kind = nodus.kind, parent = nodus.parent, children = nodus.children, visible = valor, local_matrix = nodus.local_matrix, world_matrix = nodus.world_matrix, world_dirty = nodus.world_dirty})
        return true
    }

    fn pone_matrix_localem(ref SceneHandle manubrium, ref math.Matrix4 matrix) → bool {
        if matrix.elements.length() ≠ 16 then return false
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return false
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        self._reple(manubrium, SceneNode {name = nodus.name, kind = nodus.kind, parent = nodus.parent, children = nodus.children, visible = nodus.visible, local_matrix = matrix, world_matrix = nodus.world_matrix, world_dirty = true})
        self._nota_mundum_sordidum(manubrium)
        return true
    }

    fn matrix_mundi_mesh(ref SceneHandle manubrium) → math.Matrix4 ∪ null {
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return null
        match nodus_result!.kind {
            case SceneMesh const geometry, material {
                return nodus_result!.world_matrix
            }
            case SceneGroup {
                return null
            }
            case SceneCamera {
                return null
            }
            case SceneLight {
                return null
            }
        }
    }

    fn efficax_visibile(ref SceneHandle manubrium) → bool {
        var SceneHandle cursor ← SceneHandle {index = manubrium.index, generation = manubrium.generation}
        var int remaining ← self.slots.length() + 1
        while remaining ≻ 0 {
            const SceneNode ∪ null current ← self.cape(cursor)
            if current is null then return false
            if current!.visible ≡ false then return false
            if current!.parent is null then return true
            const SceneHandle parens ← SceneHandle {index = current!.parent!.index, generation = current!.parent!.generation}
            cursor ← SceneHandle {index = parens.index, generation = parens.generation}
            remaining ← remaining - 1
        }
        return false
    }

    fn renova_mundum(ref SceneHandle radix) → bool {
        const SceneNode ∪ null radix_result ← self.cape(radix)
        if radix_result is null then return false
        if radix_result!.parent not is null then return false
        self._renova_mundum_nodum(radix, math.matrix4_identitas())
        return true
    }

    # ── Internal helpers ────────────────────────────────────────────────

    fn _traversal_continet(ref list<SceneHandle> handles, ref SceneHandle manubrium) → bool {
        var int i ← 0
        while i ≺ handles.length() {
            const SceneHandle exsistens ← handles[i]
            if scene_handle_equals(exsistens, manubrium) ≡ true then return true
            i ← i + 1
        }
        return false
    }

    # TRAVERSAL — Five preorder variants that share the same structural skeleton:
    # node fetch → field copy → seen-set guard → payload accumulation → child iteration.
    # Every variant below must keep these steps in lockstep. If you fix a bug in
    # the skeleton (e.g., seen-set disposal, remaining-counter, child iteration
    # order), apply the fix to ALL FIVE.
    #
    #   (1) _traverse_preorder                    — unfiltered; all visited handles
    #   (2) _traverse_visibile_preorder           — visible nodes only
    #   (3) _traverse_visibile_rete_preorder      — visible mesh-node handles only
    #   (4) _traverse_visibile_rete_opes_preorder — visible mesh resource pairs
    #   (5) _visibile_rete_opes_manubria_preorder — visible mesh geometry or
    #       material handles (selected by `geometria_manubria`)
    #
    # WHEN FABER GAINS CLOSURES/VISITORS: collapse these into a single
    # scene_traverse(store, root, filter, accumulator) and delete the copies.
    # Until then, treat this block as generated code — change the template, not
    # one copy. See also DEFER-121 (sub-module split gated on Faber module system).

    fn _traverse_preorder(ref SceneHandle manubrium, list<SceneHandle> handles, int remaining) → SceneTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self._traversal_continet(handles, manubrium) then return null
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return null
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        var list<SceneHandle> renovata_handles ← handles
        renovata_handles.append(SceneHandle {index = manubrium.index, generation = manubrium.generation})
        var SceneTraversal peragratio ← SceneTraversal {handles = renovata_handles, remaining = remaining - 1}
        var int i ← 0
        while i ≺ nodus.children.length() {
            const SceneTraversal ∪ null current ← self._traverse_preorder(nodus.children[i], peragratio.handles, peragratio.remaining)
            if current is null then return null
            const SceneTraversal current_value ← SceneTraversal {handles = current!.handles, remaining = current!.remaining}
            peragratio ← SceneTraversal {handles = current_value.handles, remaining = current_value.remaining}
            i ← i + 1
        }
        return peragratio
    }

    fn _traverse_visibile_preorder(ref SceneHandle manubrium, list<SceneHandle> handles, int remaining, bool parens_visibile) → SceneTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self._traversal_continet(handles, manubrium) then return null
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return null
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        const bool efficax_visibile ← parens_visibile and nodus.visible
        var list<SceneHandle> renovata_handles ← handles
        if efficax_visibile {
            renovata_handles.append(SceneHandle {index = manubrium.index, generation = manubrium.generation})
        }
        var SceneTraversal peragratio ← SceneTraversal {handles = renovata_handles, remaining = remaining - 1}
        var int i ← 0
        while i ≺ nodus.children.length() {
            const SceneTraversal ∪ null current ← self._traverse_visibile_preorder(nodus.children[i], peragratio.handles, peragratio.remaining, efficax_visibile)
            if current is null then return null
            const SceneTraversal current_value ← SceneTraversal {handles = current!.handles, remaining = current!.remaining}
            peragratio ← SceneTraversal {handles = current_value.handles, remaining = current_value.remaining}
            i ← i + 1
        }
        return peragratio
    }

    fn _traverse_visibile_rete_preorder(ref SceneHandle manubrium, list<SceneHandle> handles, int remaining, bool parens_visibile) → SceneTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self._traversal_continet(handles, manubrium) then return null
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return null
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        const bool efficax_visibile ← parens_visibile and nodus.visible
        var list<SceneHandle> renovata_handles ← handles
        if efficax_visibile {
            match nodus.kind {
                case SceneMesh const geometry, material {
                    renovata_handles.append(SceneHandle {index = manubrium.index, generation = manubrium.generation})
                }
                case SceneGroup {
                }
                case SceneCamera {
                }
                case SceneLight {
                }
            }
        }
        var SceneTraversal peragratio ← SceneTraversal {handles = renovata_handles, remaining = remaining - 1}
        var int i ← 0
        while i ≺ nodus.children.length() {
            const SceneTraversal ∪ null current ← self._traverse_visibile_rete_preorder(nodus.children[i], peragratio.handles, peragratio.remaining, efficax_visibile)
            if current is null then return null
            const SceneTraversal current_value ← SceneTraversal {handles = current!.handles, remaining = current!.remaining}
            peragratio ← SceneTraversal {handles = current_value.handles, remaining = current_value.remaining}
            i ← i + 1
        }
        return peragratio
    }

    fn _traverse_visibile_rete_opes_preorder(ref SceneHandle manubrium, list<SceneMeshResources> resources, list<SceneHandle> seen, int remaining, bool parens_visibile) → SceneMeshResourceTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self._traversal_continet(seen, manubrium) then return null
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return null
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        const bool efficax_visibile ← parens_visibile and nodus.visible
        var list<SceneHandle> renovata_seen ← seen
        renovata_seen.append(SceneHandle {index = manubrium.index, generation = manubrium.generation})
        var list<SceneMeshResources> renovata_resources ← resources
        if efficax_visibile {
            match nodus.kind {
                case SceneMesh const geometry, material {
                    renovata_resources.append(SceneMeshResources {node = SceneHandle {index = manubrium.index, generation = manubrium.generation}, geometry = resource.ResourceHandle {index = geometry.index, generation = geometry.generation}, material = resource.ResourceHandle {index = material.index, generation = material.generation}})
                }
                case SceneGroup {
                }
                case SceneCamera {
                }
                case SceneLight {
                }
            }
        }
        var SceneMeshResourceTraversal peragratio ← SceneMeshResourceTraversal {resources = renovata_resources, remaining = remaining - 1}
        var int i ← 0
        while i ≺ nodus.children.length() {
            const SceneMeshResourceTraversal ∪ null current ← self._traverse_visibile_rete_opes_preorder(nodus.children[i], peragratio.resources, renovata_seen, peragratio.remaining, efficax_visibile)
            if current is null then return null
            const SceneMeshResourceTraversal current_value ← SceneMeshResourceTraversal {resources = current!.resources, remaining = current!.remaining}
            peragratio ← SceneMeshResourceTraversal {resources = current_value.resources, remaining = current_value.remaining}
            renovata_seen.append(SceneHandle {index = nodus.children[i].index, generation = nodus.children[i].generation})
            i ← i + 1
        }
        return peragratio
    }

    fn _visibile_rete_opes_manubria_preorder(ref SceneHandle manubrium, list<resource.ResourceHandle> handles, list<SceneHandle> seen, int remaining, bool parens_visibile, bool geometria_manubria) → resource.ResourceHandleTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self._traversal_continet(seen, manubrium) then return null
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return null
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        const bool efficax_visibile ← parens_visibile and nodus.visible
        var list<SceneHandle> renovata_seen ← seen
        renovata_seen.append(SceneHandle {index = manubrium.index, generation = manubrium.generation})
        var list<resource.ResourceHandle> renovata_handles ← handles
        if efficax_visibile {
            match nodus.kind {
                case SceneMesh const geometry, material {
                    if geometria_manubria {
                        renovata_handles.append(resource.ResourceHandle {index = geometry.index, generation = geometry.generation})
                    }
                    else {
                        renovata_handles.append(resource.ResourceHandle {index = material.index, generation = material.generation})
                    }
                }
                case SceneGroup {
                }
                case SceneCamera {
                }
                case SceneLight {
                }
            }
        }
        var resource.ResourceHandleTraversal peragratio ← resource.ResourceHandleTraversal {handles = renovata_handles, remaining = remaining - 1}
        var int i ← 0
        while i ≺ nodus.children.length() {
            const resource.ResourceHandleTraversal ∪ null current ← self._visibile_rete_opes_manubria_preorder(nodus.children[i], peragratio.handles, renovata_seen, peragratio.remaining, efficax_visibile, geometria_manubria)
            if current is null then return null
            const resource.ResourceHandleTraversal current_value ← resource.ResourceHandleTraversal {handles = current!.handles, remaining = current!.remaining}
            peragratio ← resource.ResourceHandleTraversal {handles = current_value.handles, remaining = current_value.remaining}
            renovata_seen.append(SceneHandle {index = nodus.children[i].index, generation = nodus.children[i].generation})
            i ← i + 1
        }
        return peragratio
    }

    fn _reple(ref SceneHandle manubrium, SceneNode nodus) → bool {
        const SceneSlot socors ← self.slots[manubrium.index]
        self.slots[manubrium.index] ← SceneSlot {generation = socors.generation, alive = true, node = nodus}
        return true
    }

    fn _sine_liberis(SceneNode parens, ref SceneHandle filius) → SceneNode {
        var list<SceneHandle> liberi ← vacua
        var int i ← 0
        while i ≺ parens.children.length() {
            const SceneHandle exsistens ← parens.children[i]
            if scene_handle_equals(exsistens, filius) ≡ false {
                liberi.append(SceneHandle {index = exsistens.index, generation = exsistens.generation})
            }
            i ← i + 1
        }
        return SceneNode {name = parens.name, kind = parens.kind, parent = parens.parent, children = liberi, visible = parens.visible, local_matrix = parens.local_matrix, world_matrix = parens.world_matrix, world_dirty = parens.world_dirty}
    }

    fn _circuitum_faceret(ref SceneHandle filius, ref SceneHandle parens) → bool {
        var SceneHandle cursor ← SceneHandle {index = parens.index, generation = parens.generation}
        var int remaining ← self.slots.length() + 1
        while remaining ≻ 0 {
            if scene_handle_equals(cursor, filius) then return true
            const SceneNode ∪ null current ← self.cape(cursor)
            if current is null then return false
            const SceneNode current_nodus ← SceneNode {name = current!.name, kind = current!.kind, parent = current!.parent, children = current!.children, visible = current!.visible, local_matrix = current!.local_matrix, world_matrix = current!.world_matrix, world_dirty = current!.world_dirty}
            if current_nodus.parent is null then return false
            const SceneHandle current_parens ← SceneHandle {index = current_nodus.parent!.index, generation = current_nodus.parent!.generation}
            cursor ← SceneHandle {index = current_parens.index, generation = current_parens.generation}
            remaining ← remaining - 1
        }
        return true
    }

    fn _nota_mundum_sordidum(ref SceneHandle manubrium) → bool {
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return false
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        self._reple(manubrium, SceneNode {name = nodus.name, kind = nodus.kind, parent = nodus.parent, children = nodus.children, visible = nodus.visible, local_matrix = nodus.local_matrix, world_matrix = nodus.world_matrix, world_dirty = true})
        var int i ← 0
        while i ≺ nodus.children.length() {
            self._nota_mundum_sordidum(nodus.children[i])
            i ← i + 1
        }
        return true
    }

    fn _renova_mundum_nodum(ref SceneHandle manubrium, ref math.Matrix4 parens_mundus) → bool {
        const SceneNode ∪ null nodus_result ← self.cape(manubrium)
        if nodus_result is null then return false
        const SceneNode nodus ← SceneNode {name = nodus_result!.name, kind = nodus_result!.kind, parent = nodus_result!.parent, children = nodus_result!.children, visible = nodus_result!.visible, local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix, world_dirty = nodus_result!.world_dirty}
        const math.Matrix4 mundus ← parens_mundus.multiplicata(nodus.local_matrix)
        self._reple(manubrium, SceneNode {name = nodus.name, kind = nodus.kind, parent = nodus.parent, children = nodus.children, visible = nodus.visible, local_matrix = nodus.local_matrix, world_matrix = mundus, world_dirty = false})
        var int i ← 0
        while i ≺ nodus.children.length() {
            self._renova_mundum_nodum(nodus.children[i], mundus)
            i ← i + 1
        }
        return true
    }

    fn traverse(ref SceneHandle radix) → list<SceneHandle> ∪ null {
        const SceneTraversal ∪ null peragratio ← self._traverse_preorder(radix, vacua, self.slots.length())
        if peragratio is null then return null
        return peragratio!.handles
    }

    fn traverse_visibilia(ref SceneHandle radix) → list<SceneHandle> ∪ null {
        const SceneTraversal ∪ null peragratio ← self._traverse_visibile_preorder(radix, vacua, self.slots.length(), true)
        if peragratio is null then return null
        return peragratio!.handles
    }

    fn traverse_visibilia_rete(ref SceneHandle radix) → list<SceneHandle> ∪ null {
        const SceneTraversal ∪ null peragratio ← self._traverse_visibile_rete_preorder(radix, vacua, self.slots.length(), true)
        if peragratio is null then return null
        return peragratio!.handles
    }
}

# Traversal fact carriers keep internal bounds and the render-facing payload
# separate. The `remaining` field belongs to the bounded traversal machinery;
# the other genera are compact projections consumed by examples or hosts.
@ public
class SceneTraversal {
    list<SceneHandle> handles
    int remaining
}

# SceneCount is the count-only traversal projection.
@ public
class SceneCount {
    int count
    int remaining
}

# SceneMeshResources associates a visible mesh node with the two logical
# resources needed to draw it.
@ public
class SceneMeshResources {
    SceneHandle node
    resource.ResourceHandle geometry
    resource.ResourceHandle material
}

# SceneMeshTransformPayload pairs a mesh identity with the packed model/view
# projection data described by `triga:math`.
@ public
class SceneMeshTransformPayload {
    SceneHandle node
    math.TransformPayload payload
}

# SceneMeshDrawPacket is the source-side draw unit assembled by `visibilia`.
# It contains identities and facts, not host GPU objects.
@ public
class SceneMeshDrawPacket {
    SceneHandle node
    resource.ResourceHandle geometry
    resource.ResourceHandle material
    math.TransformPayload transform
}

# These two fact genera summarize the number of packets and resource identities
# without forcing a consumer to inspect the full traversal payload.
@ public
class SceneVisibleMeshDrawBatchFacts {
    int packet_count
    int transform_payload_byte_count
}

@ public
class SceneVisibleMeshResourceFacts {
    int mesh_count
    int resource_pair_count
    int geometry_handle_count
    int material_handle_count
}

# SceneMeshResourceTraversal is the resource-only traversal projection.
@ public
class SceneMeshResourceTraversal {
    list<SceneMeshResources> resources
    int remaining
}

# VisibiliaRetium is the deliberately small result of one visible-mesh walk.
# Its parallel lists stay aligned by index; `ductus()` turns them into the
# explicit draw packets used by the next stage.
@ public
class VisibiliaRetium {
    list<SceneHandle> manubria = vacua
    list<resource.ResourceHandle> geometria_opes = vacua
    list<resource.ResourceHandle> materia_opes = vacua
    list<math.TransformPayload> onera = vacua

    fn numerus() → int {
        return self.manubria.length()
    }

    fn geometriae() → list<resource.ResourceHandle> {
        return self.geometria_opes
    }

    fn materiae() → list<resource.ResourceHandle> {
        return self.materia_opes
    }

    fn octeta() → int {
        var int summa ← 0
        for from self.onera const onus {
            summa ← summa + (onus.byte_count() coalesce 0)
        }
        return summa
    }

    fn ductus() → list<SceneMeshDrawPacket> {
        var list<SceneMeshDrawPacket> fasciculi ← vacua
        var int i ← 0
        while i ≺ self.manubria.length() {
            fasciculi.append(SceneMeshDrawPacket {node = SceneHandle {index = self.manubria[i].index, generation = self.manubria[i].generation}, geometry = resource.ResourceHandle {index = self.geometria_opes[i].index, generation = self.geometria_opes[i].generation}, material = resource.ResourceHandle {index = self.materia_opes[i].index, generation = self.materia_opes[i].generation}, transform = self.onera[i]})
            i ← i + 1
        }
        return fasciculi
    }
}

# ── Visibilia entry point ─────────────────────────────────────────────

# One traversal collects visible mesh handles, resource handles, and packed
# transforms. Keeping this as one query avoids making callers repeat the scene
# walk and gives the host a coherent snapshot of the visible set.
fn visibilia(ref SceneStore store, ref SceneHandle radix, ref math.Matrix4 visio_proiectio) → VisibiliaRetium ∪ null {
    if visio_proiectio.validum() ≡ false then return null
    # Single traversal: collect all visible mesh data at once
    const SceneTraversal ∪ null handles_result ← store._traverse_visibile_rete_preorder(radix, vacua, store.slots.length(), true)
    if handles_result is null then return null
    var VisibiliaRetium retia ← VisibiliaRetium {manubria = vacua, geometria_opes = vacua, materia_opes = vacua, onera = vacua}
    for from handles_result!.handles const manubrium {
        const SceneNode ∪ null nodus_result ← store.cape(manubrium)
        if nodus_result is null then return null
        retia.manubria.append(SceneHandle {index = manubrium.index, generation = manubrium.generation})
        match nodus_result!.kind {
            case SceneMesh const geometry, material {
                retia.geometria_opes.append(resource.ResourceHandle {index = geometry.index, generation = geometry.generation})
                retia.materia_opes.append(resource.ResourceHandle {index = material.index, generation = material.generation})
                const math.TransformPayload ∪ null onus ← math.transform_payload(nodus_result!.world_matrix, visio_proiectio)
                if onus is null then return null
                retia.onera.append(onus coalesce math.TransformPayload {values = vacua})
            }
            case SceneGroup {
            }
            case SceneCamera {
            }
            case SceneLight {
            }
        }
    }
    return retia
}

# ── Free constructors ─────────────────────────────────────────────────

# Constructors establish identity defaults in one place: empty children,
# identity local/world matrices, and a dirty world cache.
@ public
fn scene_store() → SceneStore {
    return SceneStore {slots = vacua}
}

@ public
fn scene_node(string name, SceneNodeKind kind) → SceneNode {
    return SceneNode {name = name, kind = kind, children = vacua, visible = true, local_matrix = math.matrix4_identitas(), world_matrix = math.matrix4_identitas(), world_dirty = true}
}

@ public
fn scene_group(string name) → SceneNode {
    return scene_node(name, SceneGroup())
}

@ public
fn scene_mesh(string name, ref resource.ResourceHandle geometry, ref resource.ResourceHandle material) → SceneNode {
    return scene_node(name, SceneMesh(resource.ResourceHandle {index = geometry.index, generation = geometry.generation}, resource.ResourceHandle {index = material.index, generation = material.generation}))
}

@ public
fn scene_camera(string name) → SceneNode {
    return scene_node(name, SceneCamera())
}

@ public
fn scene_light(string name) → SceneNode {
    return scene_node(name, SceneLight())
}

# ── Free utilities on handles ─────────────────────────────────────────

@ public
fn scene_handle_equals(ref SceneHandle a, ref SceneHandle b) → bool {
    return a.index ≡ b.index and a.generation ≡ b.generation
}
