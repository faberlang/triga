# Stable, backend-agnostic scene identity and heterogeneous node storage.
#
# Public import: import from "triga:scene" scene
# Depends on: triga:math, triga:resource

import from "triga:math" math

import from "triga:resource" resource

# A SceneHandle names a slot and its generation. Handles are the stable value
# passed between scene edits and render queries; callers never need to hold a
# mutable SceneNode reference.
@ public
class SceneHandle {
    int index
    int generation
}

# SceneNodeKind keeps the heterogeneous scene payload explicit. Mesh nodes
# carry resource handles; groups, cameras, and lights remain distinct cases so
# traversal can filter without guessing from a name or field convention.
@ public
union SceneNodeKind {
    SceneGroup,
    SceneMesh {
        resource.ResourceHandle geometry
        resource.ResourceHandle material
    },
    SceneCamera,
    SceneLight
}

# SceneNode stores local and cached world transforms together with hierarchy
# links. `world_dirty` marks the cache after a local edit or reparent; the store
# refreshes it before a render-facing query.
@ public
class SceneNode {
    string name
    SceneNodeKind kind
    SceneHandle parent optional
    list<SceneHandle> children
    bool visible
    math.Matrix4 local_matrix
    math.Matrix4 world_matrix
    bool world_dirty

    fn mesh_geometry() → resource.ResourceHandle ∪ null {
        match self.kind {
            case SceneMesh const geometry, material {
                return geometry
            }
            case SceneGroup {
                return null
            }
            case SceneCamera {
                return null
            }
            case SceneLight {
                return null
            }
        }
    }

    fn mesh_material() → resource.ResourceHandle ∪ null {
        match self.kind {
            case SceneMesh const geometry, material {
                return material
            }
            case SceneGroup {
                return null
            }
            case SceneCamera {
                return null
            }
            case SceneLight {
                return null
            }
        }
    }
}

# SceneSlot is the store's generation-checked storage cell. A deleted node
# leaves its slot behind so an old handle cannot silently refer to a new node.
@ public
class SceneSlot {
    int generation
    bool alive
    SceneNode node
}

# SceneStore owns mutation, hierarchy validation, world-transform refresh, and
# bounded preorder traversal. It is the stateful boundary of this otherwise
# backend-agnostic source module, so callers bind it with `varia`.
@ public
class SceneStore {
    list<SceneSlot> slots

    # ── Mutation (Imperativus) ──────────────────────────────────────────
    # These methods reject stale handles, duplicate parents, and cycles while
    # preserving the slot/generation identity of every live node.

    fn insert(SceneNode node) → SceneHandle {
        const int index ← self.slots.length()
        self.slots.append(SceneSlot {generation = 0, alive = true, node = node})
        return SceneHandle {index = index, generation = 0}
    }

    fn contains(ref SceneHandle handle) → bool {
        if handle.index ≥ self.slots.length() then return false
        const SceneSlot slot ← self.slots[handle.index]
        return slot.alive and slot.generation ≡ handle.generation
    }

    fn take(ref SceneHandle handle) → SceneNode ∪ null {
        if self.contains(handle) ≡ false then return null
        return self.slots[handle.index].node
    }

    fn attach(ref SceneHandle child, ref SceneHandle parent) → bool {
        if self.contains(child) ≡ false then return false
        if self.contains(parent) ≡ false then return false
        if self.would_cycle(child, parent) then return false
        const SceneNode ∪ null child_result ← self.take(child)
        const SceneNode ∪ null parent_result ← self.take(parent)
        if child_result is null then return false
        if parent_result is null then return false
        const SceneNode child_node ← child_result
        const SceneNode parent_node ← parent_result
        if child_node.parent not is null {
            const SceneHandle ∪ null existing_parent_opt ← parent_handle(child_node.parent)
            if existing_parent_opt is null then return false
            const SceneHandle existing_parent ← existing_parent_opt
            if scene_handle_equals(existing_parent, parent) then return false
        }
        # Remove child from old parent's children list if it had one
        if child_node.parent not is null {
            const SceneHandle ∪ null old_parent_opt ← parent_handle(child_node.parent)
            if old_parent_opt is null then return false
            const SceneHandle old_parent ← old_parent_opt
            const SceneNode ∪ null old_parent_result ← self.take(old_parent)
            if old_parent_result is null then return false
            const SceneNode old_node ← old_parent_result
            self.replace(old_parent, self.without_children(old_node, child))
        }
        # Add child to parent's children list
        var list<SceneHandle> children ← empty
        for range 0‥parent_node.children.length() const i {
            const SceneHandle existing ← parent_node.children[i]
            children.append(existing)
        }
        children.append(child)
        const SceneNode updated_parent ← SceneNode {name = parent_node.name, kind = parent_node.kind, parent = parent_node.parent, children = children, visible = parent_node.visible, local_matrix = parent_node.local_matrix, world_matrix = parent_node.world_matrix, world_dirty = parent_node.world_dirty}
        const SceneNode updated_child ← SceneNode {name = child_node.name, kind = child_node.kind, parent = parent, children = child_node.children, visible = child_node.visible, local_matrix = child_node.local_matrix, world_matrix = child_node.world_matrix, world_dirty = true}
        self.replace(parent, updated_parent)
        self.replace(child, updated_child)
        self.mark_world_dirty(child)
        return true
    }

    fn detach(ref SceneHandle child) → bool {
        if self.contains(child) ≡ false then return false
        const SceneNode ∪ null child_result ← self.take(child)
        if child_result is null then return false
        const SceneNode child_node ← child_result
        if child_node.parent is null then return false
        const SceneHandle ∪ null parent_opt ← parent_handle(child_node.parent)
        if parent_opt is null then return false
        const SceneHandle parent_value ← parent_opt
        const SceneNode ∪ null parent_result ← self.take(parent_value)
        if parent_result is null then return false
        const SceneNode parent_node ← parent_result
        const SceneNode detached_child ← SceneNode {name = child_node.name, kind = child_node.kind, children = child_node.children, visible = child_node.visible, local_matrix = child_node.local_matrix, world_matrix = child_node.world_matrix, world_dirty = true}
        self.replace(parent_value, self.without_children(parent_node, child))
        self.replace(child, detached_child)
        self.mark_world_dirty(child)
        return true
    }

    fn remove(ref SceneHandle handle) → bool {
        if self.contains(handle) ≡ false then return false
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return false
        const SceneNode node ← node_result
        if node.children.length() ≻ 0 then return false
        if node.parent not is null {
            const bool detached ← self.detach(handle)
            if detached ≡ false then return false
        }
        const SceneSlot slot ← self.slots[handle.index]
        self.slots[handle.index] ← SceneSlot {generation = slot.generation + 1, alive = false, node = slot.node}
        return true
    }

    fn find(string name) → SceneHandle ∪ null {
        const SceneTraversal ∪ null result ← self.traverse_preorder(SceneHandle {index = 0, generation = 0}, empty, self.slots.length())
        if result is null then return null
        const SceneTraversal traversal ← result
        for range 0‥traversal.handles.length() const i {
            const SceneHandle handle ← traversal.handles[i]
            const SceneNode ∪ null node_result ← self.take(handle)
            if node_result is null then return null
            const SceneNode node ← node_result
            if node.name ≡ name then return handle
        }
        return null
    }

    fn set_visible(ref SceneHandle handle, bool value) → bool {
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return false
        const SceneNode node ← node_result
        self.replace(handle, SceneNode {name = node.name, kind = node.kind, parent = node.parent, children = node.children, visible = value, local_matrix = node.local_matrix, world_matrix = node.world_matrix, world_dirty = node.world_dirty})
        return true
    }

    fn set_local_matrix(ref SceneHandle handle, ref math.Matrix4 matrix) → bool {
        if matrix.elements.length() ≠ 16 then return false
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return false
        const SceneNode node ← node_result
        self.replace(handle, SceneNode {name = node.name, kind = node.kind, parent = node.parent, children = node.children, visible = node.visible, local_matrix = matrix, world_matrix = node.world_matrix, world_dirty = true})
        self.mark_world_dirty(handle)
        return true
    }

    fn mesh_world_matrix(ref SceneHandle handle) → math.Matrix4 ∪ null {
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        match node.kind {
            case SceneMesh const geometry, material {
                return node.world_matrix
            }
            case SceneGroup {
                return null
            }
            case SceneCamera {
                return null
            }
            case SceneLight {
                return null
            }
        }
    }

    fn effectively_visible(ref SceneHandle handle) → bool {
        var SceneHandle cursor ← handle
        var int remaining ← self.slots.length() + 1
        while remaining ≻ 0 {
            const SceneNode ∪ null current_result ← self.take(cursor)
            if current_result is null then return false
            const SceneNode current_node ← current_result
            if current_node.visible ≡ false then return false
            if current_node.parent is null then return true
            const SceneHandle ∪ null parent_opt ← parent_handle(current_node.parent)
            if parent_opt is null then return true
            const SceneHandle parent ← parent_opt
            cursor ← parent
            remaining ← remaining - 1
        }
        return false
    }

    fn refresh_world(ref SceneHandle root) → bool {
        const SceneNode ∪ null root_result ← self.take(root)
        if root_result is null then return false
        const SceneNode root_node ← root_result
        if root_node.parent not is null then return false
        self.refresh_world_node(root, math.matrix4_identity())
        return true
    }

    # ── Internal helpers ────────────────────────────────────────────────

    fn traversal_contains(ref list<SceneHandle> handles, ref SceneHandle handle) → bool {
        for range 0‥handles.length() const i {
            const SceneHandle existing ← handles[i]
            if scene_handle_equals(existing, handle) ≡ true then return true
        }
        return false
    }

    # TRAVERSAL — Five preorder variants that share the same structural skeleton:
    # node fetch → field copy → seen-set guard → payload accumulation → child iteration.
    # Every variant below must keep these steps in lockstep. If you fix a bug in
    # the skeleton (e.g., seen-set disposal, remaining-counter, child iteration
    # order), apply the fix to ALL FIVE.
    #
    #   (1) traverse_preorder                    — unfiltered; all visited handles
    #   (2) traverse_visible_preorder           — visible nodes only
    #   (3) traverse_visible_mesh_preorder      — visible mesh-node handles only
    #   (4) traverse_visible_mesh_resources_preorder — visible mesh resource pairs
    #   (5) visible_mesh_resource_handles_preorder — visible mesh geometry or
    #       material handles (selected by `geometry_handles`)
    #
    # WHEN FABER GAINS CLOSURES/VISITORS: collapse these into a single
    # scene_traverse(store, root, filter, accumulator) and delete the copies.
    # Until then, treat this block as generated code — change the template, not
    # one copy. See also DEFER-121 (sub-module split gated on Faber module system).

    fn traverse_preorder(ref SceneHandle handle, list<SceneHandle> handles, int remaining) → SceneTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self.traversal_contains(handles, handle) then return null
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        var list<SceneHandle> updated_handles ← handles
        updated_handles.append(handle)
        var SceneTraversal traversal ← SceneTraversal {handles = updated_handles, remaining = remaining - 1}
        for range 0‥node.children.length() const i {
            const SceneTraversal ∪ null current ← self.traverse_preorder(node.children[i], traversal.handles, traversal.remaining)
            if current is null then return null
            const SceneTraversal current_value ← current
            traversal ← SceneTraversal {handles = current_value.handles, remaining = current_value.remaining}
        }
        return traversal
    }

    fn traverse_visible_preorder(ref SceneHandle handle, list<SceneHandle> handles, int remaining, bool parent_visible) → SceneTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self.traversal_contains(handles, handle) then return null
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        const bool effectively_visible ← parent_visible and node.visible
        var list<SceneHandle> updated_handles ← handles
        if effectively_visible {
            updated_handles.append(handle)
        }
        var SceneTraversal traversal ← SceneTraversal {handles = updated_handles, remaining = remaining - 1}
        for range 0‥node.children.length() const i {
            const SceneTraversal ∪ null current ← self.traverse_visible_preorder(node.children[i], traversal.handles, traversal.remaining, effectively_visible)
            if current is null then return null
            const SceneTraversal current_value ← current
            traversal ← SceneTraversal {handles = current_value.handles, remaining = current_value.remaining}
        }
        return traversal
    }

    fn traverse_visible_mesh_preorder(ref SceneHandle handle, list<SceneHandle> handles, int remaining, bool parent_visible) → SceneTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self.traversal_contains(handles, handle) then return null
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        const bool effectively_visible ← parent_visible and node.visible
        var list<SceneHandle> updated_handles ← handles
        if effectively_visible {
            match node.kind {
                case SceneMesh const geometry, material {
                    updated_handles.append(handle)
                }
                case SceneGroup {
                }
                case SceneCamera {
                }
                case SceneLight {
                }
            }
        }
        var SceneTraversal traversal ← SceneTraversal {handles = updated_handles, remaining = remaining - 1}
        for range 0‥node.children.length() const i {
            const SceneTraversal ∪ null current ← self.traverse_visible_mesh_preorder(node.children[i], traversal.handles, traversal.remaining, effectively_visible)
            if current is null then return null
            const SceneTraversal current_value ← current
            traversal ← SceneTraversal {handles = current_value.handles, remaining = current_value.remaining}
        }
        return traversal
    }

    fn traverse_visible_mesh_resources_preorder(ref SceneHandle handle, list<SceneMeshResources> resources, list<SceneHandle> seen, int remaining, bool parent_visible) → SceneMeshResourceTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self.traversal_contains(seen, handle) then return null
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        const bool effectively_visible ← parent_visible and node.visible
        var list<SceneHandle> updated_seen ← seen
        updated_seen.append(handle)
        var list<SceneMeshResources> updated_resources ← resources
        if effectively_visible {
            match node.kind {
                case SceneMesh const geometry, material {
                    updated_resources.append(SceneMeshResources {node = handle, geometry = geometry, material = material})
                }
                case SceneGroup {
                }
                case SceneCamera {
                }
                case SceneLight {
                }
            }
        }
        var SceneMeshResourceTraversal traversal ← SceneMeshResourceTraversal {resources = updated_resources, remaining = remaining - 1}
        for range 0‥node.children.length() const i {
            const SceneMeshResourceTraversal ∪ null current ← self.traverse_visible_mesh_resources_preorder(node.children[i], traversal.resources, updated_seen, traversal.remaining, effectively_visible)
            if current is null then return null
            const SceneMeshResourceTraversal current_value ← current
            traversal ← SceneMeshResourceTraversal {resources = current_value.resources, remaining = current_value.remaining}
            updated_seen.append(SceneHandle {index = node.children[i].index, generation = node.children[i].generation})
        }
        return traversal
    }

    fn visible_mesh_resource_handles_preorder(ref SceneHandle handle, list<resource.ResourceHandle> handles, list<SceneHandle> seen, int remaining, bool parent_visible, bool geometry_handles) → resource.ResourceHandleTraversal ∪ null {
        if remaining ≡ 0 then return null
        if self.traversal_contains(seen, handle) then return null
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        const bool effectively_visible ← parent_visible and node.visible
        var list<SceneHandle> updated_seen ← seen
        updated_seen.append(handle)
        var list<resource.ResourceHandle> updated_handles ← handles
        if effectively_visible {
            match node.kind {
                case SceneMesh const geometry, material {
                    if geometry_handles {
                        updated_handles.append(geometry)
                    }
                    else {
                        updated_handles.append(material)
                    }
                }
                case SceneGroup {
                }
                case SceneCamera {
                }
                case SceneLight {
                }
            }
        }
        var resource.ResourceHandleTraversal traversal ← resource.ResourceHandleTraversal {handles = updated_handles, remaining = remaining - 1}
        for range 0‥node.children.length() const i {
            const resource.ResourceHandleTraversal ∪ null current ← self.visible_mesh_resource_handles_preorder(node.children[i], traversal.handles, updated_seen, traversal.remaining, effectively_visible, geometry_handles)
            if current is null then return null
            const resource.ResourceHandleTraversal current_value ← current
            traversal ← resource.ResourceHandleTraversal {handles = current_value.handles, remaining = current_value.remaining}
            updated_seen.append(SceneHandle {index = node.children[i].index, generation = node.children[i].generation})
        }
        return traversal
    }

    fn replace(ref SceneHandle handle, SceneNode node) → bool {
        const SceneSlot slot ← self.slots[handle.index]
        self.slots[handle.index] ← SceneSlot {generation = slot.generation, alive = true, node = node}
        return true
    }

    fn without_children(SceneNode parent, ref SceneHandle child) → SceneNode {
        var list<SceneHandle> children ← empty
        for range 0‥parent.children.length() const i {
            const SceneHandle existing ← parent.children[i]
            if scene_handle_equals(existing, child) ≡ false {
                children.append(existing)
            }
        }
        return SceneNode {name = parent.name, kind = parent.kind, parent = parent.parent, children = children, visible = parent.visible, local_matrix = parent.local_matrix, world_matrix = parent.world_matrix, world_dirty = parent.world_dirty}
    }

    fn would_cycle(ref SceneHandle child, ref SceneHandle parent) → bool {
        var SceneHandle cursor ← parent
        var int remaining ← self.slots.length() + 1
        while remaining ≻ 0 {
            if scene_handle_equals(cursor, child) then return true
            const SceneNode ∪ null current ← self.take(cursor)
            if current is null then return false
            const SceneNode current_node ← current
            if current_node.parent is null then return false
            const SceneHandle ∪ null parent_opt ← parent_handle(current_node.parent)
            if parent_opt is null then return false
            const SceneHandle current_parent ← parent_opt
            cursor ← current_parent
            remaining ← remaining - 1
        }
        return true
    }

    fn mark_world_dirty(ref SceneHandle handle) → bool {
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return false
        const SceneNode node ← node_result
        self.replace(handle, SceneNode {name = node.name, kind = node.kind, parent = node.parent, children = node.children, visible = node.visible, local_matrix = node.local_matrix, world_matrix = node.world_matrix, world_dirty = true})
        for range 0‥node.children.length() const i {
            self.mark_world_dirty(node.children[i])
        }
        return true
    }

    fn refresh_world_node(ref SceneHandle handle, ref math.Matrix4 parent_world) → bool {
        const SceneNode ∪ null node_result ← self.take(handle)
        if node_result is null then return false
        const SceneNode node ← node_result
        const math.Matrix4 world ← parent_world.multiply(node.local_matrix)
        self.replace(handle, SceneNode {name = node.name, kind = node.kind, parent = node.parent, children = node.children, visible = node.visible, local_matrix = node.local_matrix, world_matrix = world, world_dirty = false})
        for range 0‥node.children.length() const i {
            self.refresh_world_node(node.children[i], world)
        }
        return true
    }

    fn traverse(ref SceneHandle root) → list<SceneHandle> ∪ null {
        const SceneTraversal ∪ null traversal ← self.traverse_preorder(root, empty, self.slots.length())
        if traversal is null then return null
        const SceneTraversal traversal_value ← traversal
        return traversal_value.handles
    }

    fn traverse_visible(ref SceneHandle root) → list<SceneHandle> ∪ null {
        const SceneTraversal ∪ null traversal ← self.traverse_visible_preorder(root, empty, self.slots.length(), true)
        if traversal is null then return null
        const SceneTraversal traversal_value ← traversal
        return traversal_value.handles
    }

    fn traverse_visible_mesh(ref SceneHandle root) → list<SceneHandle> ∪ null {
        const SceneTraversal ∪ null traversal ← self.traverse_visible_mesh_preorder(root, empty, self.slots.length(), true)
        if traversal is null then return null
        const SceneTraversal traversal_value ← traversal
        return traversal_value.handles
    }
}

# Traversal fact carriers keep internal bounds and the render-facing payload
# separate. The `remaining` field belongs to the bounded traversal machinery;
# the other genera are compact projections consumed by examples or hosts.
@ public
class SceneTraversal {
    list<SceneHandle> handles
    int remaining
}

# SceneMeshResources associates a visible mesh node with the two logical
# resources needed to draw it.
@ public
class SceneMeshResources {
    SceneHandle node
    resource.ResourceHandle geometry
    resource.ResourceHandle material
}

# SceneMeshTransformPayload pairs a mesh identity with the packed model/view
# projection data described by `triga:math`.
@ public
class SceneMeshTransformPayload {
    SceneHandle node
    math.TransformPayload payload
}

# SceneMeshDrawPacket is the source-side draw unit assembled by `visible_meshes`.
# It contains identities and facts, not host GPU objects.
@ public
class SceneMeshDrawPacket {
    SceneHandle node
    resource.ResourceHandle geometry
    resource.ResourceHandle material
    math.TransformPayload transform
}

# These two fact genera summarize the number of packets and resource identities
# without forcing a consumer to inspect the full traversal payload.
@ public
class SceneVisibleMeshDrawBatchFacts {
    int packet_count
    int transform_payload_byte_count
}

@ public
class SceneVisibleMeshResourceFacts {
    int mesh_count
    int resource_pair_count
    int geometry_handle_count
    int material_handle_count
}

# SceneMeshResourceTraversal is the resource-only traversal projection.
@ public
class SceneMeshResourceTraversal {
    list<SceneMeshResources> resources
    int remaining
}

# VisibleMeshes is the deliberately small result of one visible-mesh walk.
# Its parallel lists stay aligned by index; `packets()` turns them into the
# explicit draw packets used by the next stage.
@ public
class VisibleMeshes {
    list<SceneHandle> handles = empty
    list<resource.ResourceHandle> geometry_resources = empty
    list<resource.ResourceHandle> material_resources = empty
    list<math.TransformPayload> payloads = empty

    fn count() → int {
        return self.handles.length()
    }

    fn geometries() → list<resource.ResourceHandle> {
        return self.geometry_resources
    }

    fn materials() → list<resource.ResourceHandle> {
        return self.material_resources
    }

    fn bytes() → int {
        var int total ← 0
        for from self.payloads const payload {
            total ← total + (payload.byte_count() coalesce 0)
        }
        return total
    }

    fn packets() → list<SceneMeshDrawPacket> {
        var list<SceneMeshDrawPacket> packets ← empty
        for range 0‥self.handles.length() const i {
            packets.append(SceneMeshDrawPacket {node = SceneHandle {index = self.handles[i].index, generation = self.handles[i].generation}, geometry = resource.ResourceHandle {index = self.geometry_resources[i].index, generation = self.geometry_resources[i].generation}, material = resource.ResourceHandle {index = self.material_resources[i].index, generation = self.material_resources[i].generation}, transform = self.payloads[i]})
        }
        return packets
    }
}

# ── Visibilia entry point ─────────────────────────────────────────────

# One traversal collects visible mesh handles, resource handles, and packed
# transforms. Keeping this as one query avoids making callers repeat the scene
# walk and gives the host a coherent snapshot of the visible set.
@ public
fn visible_meshes(ref SceneStore store, ref SceneHandle root, ref math.Matrix4 view_projection) → VisibleMeshes ∪ null {
    if view_projection.valid() ≡ false then return null
    # Single traversal: collect all visible mesh data at once
    const SceneTraversal ∪ null handles_result ← store.traverse_visible_mesh_preorder(root, empty, store.slots.length(), true)
    if handles_result is null then return null
    const SceneTraversal traversal ← handles_result
    var VisibleMeshes meshes ← VisibleMeshes {handles = empty, geometry_resources = empty, material_resources = empty, payloads = empty}
    for from traversal.handles const handle {
        const SceneNode ∪ null node_result ← store.take(handle)
        if node_result is null then return null
        const SceneNode node ← node_result
        meshes.handles.append(handle)
        match node.kind {
            case SceneMesh const geometry, material {
                meshes.geometry_resources.append(geometry)
                meshes.material_resources.append(material)
                const math.TransformPayload ∪ null payload ← math.transform_payload(node.world_matrix, view_projection)
                if payload is null then return null
                meshes.payloads.append(payload)
            }
            case SceneGroup {
            }
            case SceneCamera {
            }
            case SceneLight {
            }
        }
    }
    return meshes
}

# ── Free constructors ─────────────────────────────────────────────────

# Constructors establish identity defaults in one place: empty children,
# identity local/world matrices, and a dirty world cache.
@ public
fn scene_store() → SceneStore {
    return SceneStore {slots = empty}
}

@ public
fn scene_node(string name, SceneNodeKind kind) → SceneNode {
    return SceneNode {name = name, kind = kind, children = empty, visible = true, local_matrix = math.matrix4_identity(), world_matrix = math.matrix4_identity(), world_dirty = true}
}

@ public
fn scene_group(string name) → SceneNode {
    return scene_node(name, SceneGroup())
}

@ public
fn scene_mesh(string name, ref resource.ResourceHandle geometry, ref resource.ResourceHandle material) → SceneNode {
    return scene_node(name, SceneMesh(resource.ResourceHandle {index = geometry.index, generation = geometry.generation}, resource.ResourceHandle {index = material.index, generation = material.generation}))
}

@ public
fn scene_camera(string name) → SceneNode {
    return scene_node(name, SceneCamera())
}

@ public
fn scene_light(string name) → SceneNode {
    return scene_node(name, SceneLight())
}

# ── Free utilities on handles ─────────────────────────────────────────

fn parent_handle(SceneHandle ∪ null parent) → SceneHandle ∪ null {
    if parent is null then return null
    const SceneHandle copy ← parent
    return copy
}

@ public
fn scene_handle_equals(ref SceneHandle a, ref SceneHandle b) → bool {
    return a.index ≡ b.index and a.generation ≡ b.generation
}
