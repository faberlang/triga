# Stable, backend-agnostic scene identity and heterogeneous node storage.
#
# Public import: importa ex "triga:scene" privata scene
# Depends on: triga:math, triga:resource

importa ex "triga:math" privata math
importa ex "triga:resource" privata resource

genus SceneHandle {
    numerus index
    numerus generation
}

discretio SceneNodeKind {
    SceneGroup { },
    SceneMesh { resource.ResourceHandle geometry, resource.ResourceHandle material },
    SceneCamera { },
    SceneLight { },
}

genus SceneNode {
    textus name
    SceneNodeKind kind
    SceneHandle parent sponte
    lista<SceneHandle> children
    bivalens visible
    math.Matrix4 local_matrix
    math.Matrix4 world_matrix
    bivalens world_dirty

    functio mesh_geometria() → resource.ResourceHandle ∪ nihil {
        discerne ego.kind {
            casu SceneMesh fixum geometry, material { redde geometry }
            casu SceneGroup { redde nihil }
            casu SceneCamera { redde nihil }
            casu SceneLight { redde nihil }
        }
    }

    functio mesh_materia() → resource.ResourceHandle ∪ nihil {
        discerne ego.kind {
            casu SceneMesh fixum geometry, material { redde material }
            casu SceneGroup { redde nihil }
            casu SceneCamera { redde nihil }
            casu SceneLight { redde nihil }
        }
    }
}

genus SceneSlot {
    numerus generation
    bivalens alive
    SceneNode node
}

genus SceneStore {
    lista<SceneSlot> slots

    # ── Mutation (Imperativus) ──────────────────────────────────────────

    functio insere(SceneNode nodus) → SceneHandle {
        fixum numerus index ← ego.slots.longitudo()
        ego.slots.appende(SceneSlot { generation = 0, alive = verum, node = nodus })
        redde SceneHandle { index = index, generation = 0 }
    }

    functio continet(de SceneHandle manubrium) → bivalens {
        si manubrium.index ≥ ego.slots.longitudo() ergo redde falsum
        fixum SceneSlot socors ← ego.slots[manubrium.index]
        redde socors.alive et socors.generation ≡ manubrium.generation
    }

    functio cape(de SceneHandle manubrium) → SceneNode ∪ nihil {
        si ego.continet(manubrium) ≡ falsum ergo redde nihil
        redde ego.slots[manubrium.index].node
    }

    functio adiunge(de SceneHandle filius, de SceneHandle parens) → bivalens {
        si ego.continet(filius) ≡ falsum ergo redde falsum
        si ego.continet(parens) ≡ falsum ergo redde falsum
        si ego._circuitum_faceret(filius, parens) ergo redde falsum
        fixum SceneNode ∪ nihil filius_result ← ego.cape(filius)
        fixum SceneNode ∪ nihil parens_result ← ego.cape(parens)
        si filius_result est nihil ergo redde falsum
        si parens_result est nihil ergo redde falsum
        fixum SceneNode filius_nodus ← SceneNode {
            name = filius_result!.name, kind = filius_result!.kind,
            parent = filius_result!.parent, children = filius_result!.children,
            visible = filius_result!.visible,
            local_matrix = filius_result!.local_matrix, world_matrix = filius_result!.world_matrix,
            world_dirty = filius_result!.world_dirty
        }
        fixum SceneNode parens_nodus ← SceneNode {
            name = parens_result!.name, kind = parens_result!.kind,
            parent = parens_result!.parent, children = parens_result!.children,
            visible = parens_result!.visible,
            local_matrix = parens_result!.local_matrix, world_matrix = parens_result!.world_matrix,
            world_dirty = parens_result!.world_dirty
        }
        si filius_nodus.parent non est nihil {
            fixum SceneHandle exsistens_parens ← SceneHandle {
                index = filius_nodus.parent!.index, generation = filius_nodus.parent!.generation
            }
            si scene_handle_equals(exsistens_parens, parens) ergo redde falsum
        }
        # Remove child from old parent's children list if it had one
        si filius_nodus.parent non est nihil {
            fixum SceneHandle vetus_parens ← SceneHandle {
                index = filius_nodus.parent!.index,
                generation = filius_nodus.parent!.generation
            }
            fixum SceneNode ∪ nihil vetus_parens_result ← ego.cape(vetus_parens)
            si vetus_parens_result est nihil ergo redde falsum
            fixum SceneNode vetus_nodus ← SceneNode {
                name = vetus_parens_result!.name, kind = vetus_parens_result!.kind,
                parent = vetus_parens_result!.parent, children = vetus_parens_result!.children,
                visible = vetus_parens_result!.visible,
                local_matrix = vetus_parens_result!.local_matrix,
                world_matrix = vetus_parens_result!.world_matrix,
                world_dirty = vetus_parens_result!.world_dirty
            }
            ego._reple(vetus_parens, ego._sine_liberis(vetus_nodus, filius))
        }
        # Add child to parent's children list
        varia lista<SceneHandle> liberi ← vacua
        varia numerus i ← 0
        dum i < parens_nodus.children.longitudo() {
            fixum SceneHandle exsistens ← parens_nodus.children[i]
            liberi.appende(SceneHandle { index = exsistens.index, generation = exsistens.generation })
            i ← i + 1
        }
        liberi.appende(SceneHandle { index = filius.index, generation = filius.generation })
        fixum SceneNode renovatus_parens ← SceneNode {
            name = parens_nodus.name, kind = parens_nodus.kind,
            parent = parens_nodus.parent, children = liberi,
            visible = parens_nodus.visible,
            local_matrix = parens_nodus.local_matrix, world_matrix = parens_nodus.world_matrix,
            world_dirty = parens_nodus.world_dirty
        }
        fixum SceneNode renovatus_filius ← SceneNode {
            name = filius_nodus.name, kind = filius_nodus.kind,
            parent = SceneHandle { index = parens.index, generation = parens.generation },
            children = filius_nodus.children,
            visible = filius_nodus.visible,
            local_matrix = filius_nodus.local_matrix, world_matrix = filius_nodus.world_matrix,
            world_dirty = verum
        }
        ego._reple(parens, renovatus_parens)
        ego._reple(filius, renovatus_filius)
        ego._nota_mundum_sordidum(filius)
        redde verum
    }

    functio seiunge(de SceneHandle filius) → bivalens {
        si ego.continet(filius) ≡ falsum ergo redde falsum
        fixum SceneNode ∪ nihil filius_result ← ego.cape(filius)
        si filius_result est nihil ergo redde falsum
        fixum SceneNode filius_nodus ← SceneNode {
            name = filius_result!.name, kind = filius_result!.kind,
            parent = filius_result!.parent, children = filius_result!.children,
            visible = filius_result!.visible,
            local_matrix = filius_result!.local_matrix, world_matrix = filius_result!.world_matrix,
            world_dirty = filius_result!.world_dirty
        }
        si filius_nodus.parent est nihil ergo redde falsum
        fixum SceneHandle parens_manubrium ← SceneHandle {
            index = filius_nodus.parent!.index, generation = filius_nodus.parent!.generation
        }
        fixum SceneNode ∪ nihil parens_result ← ego.cape(parens_manubrium)
        si parens_result est nihil ergo redde falsum
        fixum SceneNode parens_nodus ← SceneNode {
            name = parens_result!.name, kind = parens_result!.kind,
            parent = parens_result!.parent, children = parens_result!.children,
            visible = parens_result!.visible,
            local_matrix = parens_result!.local_matrix, world_matrix = parens_result!.world_matrix,
            world_dirty = parens_result!.world_dirty
        }
        fixum SceneNode seiunctus_filius ← SceneNode {
            name = filius_nodus.name, kind = filius_nodus.kind, children = filius_nodus.children,
            visible = filius_nodus.visible,
            local_matrix = filius_nodus.local_matrix, world_matrix = filius_nodus.world_matrix,
            world_dirty = verum
        }
        ego._reple(parens_manubrium, ego._sine_liberis(parens_nodus, filius))
        ego._reple(filius, seiunctus_filius)
        ego._nota_mundum_sordidum(filius)
        redde verum
    }

    functio detrahe(de SceneHandle manubrium) → bivalens {
        si ego.continet(manubrium) ≡ falsum ergo redde falsum
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde falsum
        si nodus_result!.children.longitudo() > 0 ergo redde falsum
        si nodus_result!.parent non est nihil {
            fixum bivalens seiunctus ← ego.seiunge(manubrium)
            si seiunctus ≡ falsum ergo redde falsum
        }
        fixum SceneSlot socors ← ego.slots[manubrium.index]
        ego.slots[manubrium.index] ← SceneSlot {
            generation = socors.generation + 1, alive = falsum, node = socors.node
        }
        redde verum
    }

    functio inveni(textus nomen) → SceneHandle ∪ nihil {
        fixum SceneTraversal ∪ nihil result ← ego._traverse_preorder(SceneHandle { index = 0, generation = 0 }, vacua, ego.slots.longitudo())
        si result est nihil ergo redde nihil
        fixum SceneTraversal peragratio ← SceneTraversal {
            handles = result!.handles, remaining = result!.remaining
        }
        varia numerus i ← 0
        dum i < peragratio.handles.longitudo() {
            fixum SceneHandle manubrium ← peragratio.handles[i]
            fixum SceneNode ∪ nihil nodus ← ego.cape(manubrium)
            si nodus est nihil ergo redde nihil
            si nodus!.name ≡ nomen {
                redde SceneHandle { index = manubrium.index, generation = manubrium.generation }
            }
            i ← i + 1
        }
        redde nihil
    }

    functio pone_visibile(de SceneHandle manubrium, bivalens valor) → bivalens {
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde falsum
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        ego._reple(manubrium, SceneNode {
            name = nodus.name, kind = nodus.kind,
            parent = nodus.parent, children = nodus.children,
            visible = valor,
            local_matrix = nodus.local_matrix, world_matrix = nodus.world_matrix,
            world_dirty = nodus.world_dirty
        })
        redde verum
    }

    functio pone_matrix_localem(de SceneHandle manubrium, de math.Matrix4 matrix) → bivalens {
        si matrix.elements.longitudo() ≠ 16 ergo redde falsum
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde falsum
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        ego._reple(manubrium, SceneNode {
            name = nodus.name, kind = nodus.kind,
            parent = nodus.parent, children = nodus.children,
            visible = nodus.visible,
            local_matrix = matrix, world_matrix = nodus.world_matrix,
            world_dirty = verum
        })
        ego._nota_mundum_sordidum(manubrium)
        redde verum
    }

    functio matrix_mundi_mesh(de SceneHandle manubrium) → math.Matrix4 ∪ nihil {
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde nihil
        discerne nodus_result!.kind {
            casu SceneMesh fixum geometry, material { redde nodus_result!.world_matrix }
            casu SceneGroup { redde nihil }
            casu SceneCamera { redde nihil }
            casu SceneLight { redde nihil }
        }
    }

    functio efficax_visibile(de SceneHandle manubrium) → bivalens {
        varia SceneHandle cursor ← SceneHandle { index = manubrium.index, generation = manubrium.generation }
        varia numerus remaining ← ego.slots.longitudo() + 1
        dum remaining > 0 {
            fixum SceneNode ∪ nihil current ← ego.cape(cursor)
            si current est nihil ergo redde falsum
            si current!.visible ≡ falsum ergo redde falsum
            si current!.parent est nihil ergo redde verum
            fixum SceneHandle parens ← SceneHandle {
                index = current!.parent!.index, generation = current!.parent!.generation
            }
            cursor ← SceneHandle {
                index = parens.index, generation = parens.generation
            }
            remaining ← remaining - 1
        }
        redde falsum
    }

    functio renova_mundum(de SceneHandle radix) → bivalens {
        fixum SceneNode ∪ nihil radix_result ← ego.cape(radix)
        si radix_result est nihil ergo redde falsum
        si radix_result!.parent non est nihil ergo redde (falsum)
        ego._renova_mundum_nodum(radix, math.matrix4_identitas())
        redde verum
    }

    # ── Internal helpers ────────────────────────────────────────────────

    functio _traversal_continet(
        de lista<SceneHandle> handles,
        de SceneHandle manubrium
    ) → bivalens {
        varia numerus i ← 0
        dum i < handles.longitudo() {
            fixum SceneHandle exsistens ← handles[i]
            si scene_handle_equals(exsistens, manubrium) ≡ verum {
                redde verum
            }
            i ← i + 1
        }
        redde falsum
    }

    # TRAVERSAL — Four preorder variants that share the same structural skeleton:
    # node fetch → field copy → seen-set guard → visitor action → child iteration.
    # Every variant below must keep these steps in lockstep. If you fix a bug in
    # the skeleton (e.g., seen-set disposal, remaining-counter, child iteration
    # order), apply the fix to ALL FOUR.
    #
    #   (1) _traverse_preorder               — unfiltered; calls visitor callback
    #   (2) _traverse_visibile_preorder      — filters to visible nodes only
    #   (3) _traverse_visibile_rete_preorder — visible mesh-node handles
    #   (4) _traverse_visibile_rete_opes_preorder — visible mesh
    #       resource handles + transition facts
    #
    # WHEN FABER GAINS CLOSURES/VISITORS: collapse these into a single
    # scene_traverse(store, root, filter, accumulator) and delete the copies.
    # Until then, treat this block as generated code — change the template, not
    # one copy. See also DEFER-121 (sub-module split gated on Faber module system).

    functio _traverse_preorder(
        de SceneHandle manubrium,
        lista<SceneHandle> handles,
        numerus remaining
    ) → SceneTraversal ∪ nihil {
        si remaining ≡ 0 ergo redde nihil
        si ego._traversal_continet(handles, manubrium) ergo redde nihil
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde nihil
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        varia lista<SceneHandle> renovata_handles ← handles
        renovata_handles.appende(SceneHandle { index = manubrium.index, generation = manubrium.generation })
        varia SceneTraversal peragratio ← SceneTraversal {
            handles = renovata_handles, remaining = remaining - 1
        }
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            fixum SceneTraversal ∪ nihil current ← ego._traverse_preorder(
                nodus.children[i], peragratio.handles, peragratio.remaining
            )
            si current est nihil ergo redde nihil
            fixum SceneTraversal current_value ← SceneTraversal {
                handles = current!.handles, remaining = current!.remaining
            }
            peragratio ← SceneTraversal {
                handles = current_value.handles, remaining = current_value.remaining
            }
            i ← i + 1
        }
        redde peragratio
    }

    functio _traverse_visibile_preorder(
        de SceneHandle manubrium,
        lista<SceneHandle> handles,
        numerus remaining,
        bivalens parens_visibile
    ) → SceneTraversal ∪ nihil {
        si remaining ≡ 0 ergo redde nihil
        si ego._traversal_continet(handles, manubrium) ergo redde nihil
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde nihil
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        fixum bivalens efficax_visibile ← parens_visibile et nodus.visible
        varia lista<SceneHandle> renovata_handles ← handles
        si efficax_visibile {
            renovata_handles.appende(SceneHandle { index = manubrium.index, generation = manubrium.generation })
        }
        varia SceneTraversal peragratio ← SceneTraversal {
            handles = renovata_handles, remaining = remaining - 1
        }
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            fixum SceneTraversal ∪ nihil current ← ego._traverse_visibile_preorder(
                nodus.children[i], peragratio.handles, peragratio.remaining, efficax_visibile
            )
            si current est nihil ergo redde nihil
            fixum SceneTraversal current_value ← SceneTraversal {
                handles = current!.handles, remaining = current!.remaining
            }
            peragratio ← SceneTraversal {
                handles = current_value.handles, remaining = current_value.remaining
            }
            i ← i + 1
        }
        redde peragratio
    }

    functio _traverse_visibile_rete_preorder(
        de SceneHandle manubrium,
        lista<SceneHandle> handles,
        numerus remaining,
        bivalens parens_visibile
    ) → SceneTraversal ∪ nihil {
        si remaining ≡ 0 ergo redde nihil
        si ego._traversal_continet(handles, manubrium) ergo redde nihil
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde nihil
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        fixum bivalens efficax_visibile ← parens_visibile et nodus.visible
        varia lista<SceneHandle> renovata_handles ← handles
        si efficax_visibile {
            discerne nodus.kind {
                casu SceneMesh fixum geometry, material {
                    renovata_handles.appende(SceneHandle {
                        index = manubrium.index,
                        generation = manubrium.generation
                    })
                }
                casu SceneGroup { }
                casu SceneCamera { }
                casu SceneLight { }
            }
        }
        varia SceneTraversal peragratio ← SceneTraversal {
            handles = renovata_handles, remaining = remaining - 1
        }
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            fixum SceneTraversal ∪ nihil current ← ego._traverse_visibile_rete_preorder(
                nodus.children[i], peragratio.handles, peragratio.remaining, efficax_visibile
            )
            si current est nihil ergo redde nihil
            fixum SceneTraversal current_value ← SceneTraversal {
                handles = current!.handles, remaining = current!.remaining
            }
            peragratio ← SceneTraversal {
                handles = current_value.handles, remaining = current_value.remaining
            }
            i ← i + 1
        }
        redde peragratio
    }

    functio _traverse_visibile_rete_opes_preorder(
        de SceneHandle manubrium,
        lista<SceneMeshResources> resources,
        lista<SceneHandle> seen,
        numerus remaining,
        bivalens parens_visibile
    ) → SceneMeshResourceTraversal ∪ nihil {
        si remaining ≡ 0 ergo redde nihil
        si ego._traversal_continet(seen, manubrium) ergo redde nihil
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde nihil
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        fixum bivalens efficax_visibile ← parens_visibile et nodus.visible
        varia lista<SceneHandle> renovata_seen ← seen
        renovata_seen.appende(SceneHandle { index = manubrium.index, generation = manubrium.generation })
        varia lista<SceneMeshResources> renovata_resources ← resources
        si efficax_visibile {
            discerne nodus.kind {
                casu SceneMesh fixum geometry, material {
                    renovata_resources.appende(SceneMeshResources {
                        node = SceneHandle { index = manubrium.index, generation = manubrium.generation },
                        geometry = resource.ResourceHandle {
                            index = geometry.index, generation = geometry.generation
                        },
                        material = resource.ResourceHandle {
                            index = material.index, generation = material.generation
                        }
                    })
                }
                casu SceneGroup { }
                casu SceneCamera { }
                casu SceneLight { }
            }
        }
        varia SceneMeshResourceTraversal peragratio ← SceneMeshResourceTraversal {
            resources = renovata_resources, remaining = remaining - 1
        }
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            fixum SceneMeshResourceTraversal ∪ nihil current ←
                ego._traverse_visibile_rete_opes_preorder(
                    nodus.children[i], peragratio.resources, renovata_seen,
                    peragratio.remaining, efficax_visibile
                )
            si current est nihil ergo redde nihil
            fixum SceneMeshResourceTraversal current_value ← SceneMeshResourceTraversal {
                resources = current!.resources, remaining = current!.remaining
            }
            peragratio ← SceneMeshResourceTraversal {
                resources = current_value.resources, remaining = current_value.remaining
            }
            renovata_seen.appende(SceneHandle {
                index = nodus.children[i].index,
                generation = nodus.children[i].generation
            })
            i ← i + 1
        }
        redde peragratio
    }

    functio _visibile_rete_opes_manubria_preorder(
        de SceneHandle manubrium,
        lista<resource.ResourceHandle> handles,
        lista<SceneHandle> seen,
        numerus remaining,
        bivalens parens_visibile,
        bivalens geometria_manubria
    ) → resource.ResourceHandleTraversal ∪ nihil {
        si remaining ≡ 0 ergo redde nihil
        si ego._traversal_continet(seen, manubrium) ergo redde nihil
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde nihil
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        fixum bivalens efficax_visibile ← parens_visibile et nodus.visible
        varia lista<SceneHandle> renovata_seen ← seen
        renovata_seen.appende(SceneHandle { index = manubrium.index, generation = manubrium.generation })
        varia lista<resource.ResourceHandle> renovata_handles ← handles
        si efficax_visibile {
            discerne nodus.kind {
                casu SceneMesh fixum geometry, material {
                    si geometria_manubria {
                        renovata_handles.appende(resource.ResourceHandle {
                            index = geometry.index, generation = geometry.generation
                        })
                    } secus {
                        renovata_handles.appende(resource.ResourceHandle {
                            index = material.index, generation = material.generation
                        })
                    }
                }
                casu SceneGroup { }
                casu SceneCamera { }
                casu SceneLight { }
            }
        }
        varia resource.ResourceHandleTraversal peragratio ← resource.ResourceHandleTraversal {
            handles = renovata_handles, remaining = remaining - 1
        }
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            fixum resource.ResourceHandleTraversal ∪ nihil current ←
                ego._visibile_rete_opes_manubria_preorder(
                    nodus.children[i], peragratio.handles, renovata_seen,
                    peragratio.remaining, efficax_visibile, geometria_manubria
                )
            si current est nihil ergo redde nihil
            fixum resource.ResourceHandleTraversal current_value ← resource.ResourceHandleTraversal {
                handles = current!.handles, remaining = current!.remaining
            }
            peragratio ← resource.ResourceHandleTraversal {
                handles = current_value.handles, remaining = current_value.remaining
            }
            renovata_seen.appende(SceneHandle {
                index = nodus.children[i].index,
                generation = nodus.children[i].generation
            })
            i ← i + 1
        }
        redde peragratio
    }

    functio _reple(de SceneHandle manubrium, SceneNode nodus) → bivalens {
        fixum SceneSlot socors ← ego.slots[manubrium.index]
        ego.slots[manubrium.index] ← SceneSlot {
            generation = socors.generation, alive = verum, node = nodus
        }
        redde verum
    }

    functio _sine_liberis(
        SceneNode parens,
        de SceneHandle filius
    ) → SceneNode {
        varia lista<SceneHandle> liberi ← vacua
        varia numerus i ← 0
        dum i < parens.children.longitudo() {
            fixum SceneHandle exsistens ← parens.children[i]
            si scene_handle_equals(exsistens, filius) ≡ falsum {
                liberi.appende(SceneHandle {
                    index = exsistens.index, generation = exsistens.generation
                })
            }
            i ← i + 1
        }
        redde SceneNode {
            name = parens.name, kind = parens.kind,
            parent = parens.parent, children = liberi,
            visible = parens.visible,
            local_matrix = parens.local_matrix, world_matrix = parens.world_matrix,
            world_dirty = parens.world_dirty
        }
    }

    functio _circuitum_faceret(
        de SceneHandle filius,
        de SceneHandle parens
    ) → bivalens {
        varia SceneHandle cursor ← SceneHandle { index = parens.index, generation = parens.generation }
        varia numerus remaining ← ego.slots.longitudo() + 1
        dum remaining > 0 {
            si scene_handle_equals(cursor, filius) ergo redde verum
            fixum SceneNode ∪ nihil current ← ego.cape(cursor)
            si current est nihil ergo redde falsum
            fixum SceneNode current_nodus ← SceneNode {
                name = current!.name, kind = current!.kind,
                parent = current!.parent, children = current!.children,
                visible = current!.visible,
                local_matrix = current!.local_matrix, world_matrix = current!.world_matrix,
                world_dirty = current!.world_dirty
            }
            si current_nodus.parent est nihil ergo redde falsum
            fixum SceneHandle current_parens ← SceneHandle {
                index = current_nodus.parent!.index,
                generation = current_nodus.parent!.generation
            }
            cursor ← SceneHandle {
                index = current_parens.index,
                generation = current_parens.generation
            }
            remaining ← remaining - 1
        }
        redde verum
    }

    functio _nota_mundum_sordidum(de SceneHandle manubrium) → bivalens {
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde falsum
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        ego._reple(manubrium, SceneNode {
            name = nodus.name, kind = nodus.kind,
            parent = nodus.parent, children = nodus.children,
            visible = nodus.visible,
            local_matrix = nodus.local_matrix, world_matrix = nodus.world_matrix,
            world_dirty = verum
        })
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            ego._nota_mundum_sordidum(nodus.children[i])
            i ← i + 1
        }
        redde verum
    }

    functio _renova_mundum_nodum(
        de SceneHandle manubrium,
        de math.Matrix4 parens_mundus
    ) → bivalens {
        fixum SceneNode ∪ nihil nodus_result ← ego.cape(manubrium)
        si nodus_result est nihil ergo redde falsum
        fixum SceneNode nodus ← SceneNode {
            name = nodus_result!.name, kind = nodus_result!.kind,
            parent = nodus_result!.parent, children = nodus_result!.children,
            visible = nodus_result!.visible,
            local_matrix = nodus_result!.local_matrix, world_matrix = nodus_result!.world_matrix,
            world_dirty = nodus_result!.world_dirty
        }
        fixum math.Matrix4 mundus ← parens_mundus.multiplicata(nodus.local_matrix)
        ego._reple(manubrium, SceneNode {
            name = nodus.name, kind = nodus.kind,
            parent = nodus.parent, children = nodus.children,
            visible = nodus.visible,
            local_matrix = nodus.local_matrix, world_matrix = mundus,
            world_dirty = falsum
        })
        varia numerus i ← 0
        dum i < nodus.children.longitudo() {
            ego._renova_mundum_nodum(nodus.children[i], mundus)
            i ← i + 1
        }
        redde verum
    }

    functio traverse(de SceneHandle radix) → lista<SceneHandle> ∪ nihil {
        fixum SceneTraversal ∪ nihil peragratio ← ego._traverse_preorder(radix, vacua, ego.slots.longitudo())
        si peragratio est nihil ergo redde nihil
        redde peragratio!.handles
    }

    functio traverse_visibilia(de SceneHandle radix) → lista<SceneHandle> ∪ nihil {
        fixum SceneTraversal ∪ nihil peragratio ← ego._traverse_visibile_preorder(radix, vacua, ego.slots.longitudo(), verum)
        si peragratio est nihil ergo redde nihil
        redde peragratio!.handles
    }

    functio traverse_visibilia_rete(de SceneHandle radix) → lista<SceneHandle> ∪ nihil {
        fixum SceneTraversal ∪ nihil peragratio ← ego._traverse_visibile_rete_preorder(radix, vacua, ego.slots.longitudo(), verum)
        si peragratio est nihil ergo redde nihil
        redde peragratio!.handles
    }
}

genus SceneTraversal {
    lista<SceneHandle> handles
    numerus remaining
}

genus SceneCount {
    numerus count
    numerus remaining
}

genus SceneMeshResources {
    SceneHandle node
    resource.ResourceHandle geometry
    resource.ResourceHandle material
}

genus SceneMeshTransformPayload {
    SceneHandle node
    math.TransformPayload payload
}

genus SceneMeshDrawPacket {
    SceneHandle node
    resource.ResourceHandle geometry
    resource.ResourceHandle material
    math.TransformPayload transform
}

genus SceneVisibleMeshDrawBatchFacts {
    numerus packet_count
    numerus transform_payload_byte_count
}

genus SceneVisibleMeshResourceFacts {
    numerus mesh_count
    numerus resource_pair_count
    numerus geometry_handle_count
    numerus material_handle_count
}

genus SceneMeshResourceTraversal {
    lista<SceneMeshResources> resources
    numerus remaining
}

genus VisibiliaRetium {
    lista<SceneHandle> manubria = vacua
    lista<resource.ResourceHandle> geometria_opes = vacua
    lista<resource.ResourceHandle> materia_opes = vacua
    lista<math.TransformPayload> onera = vacua

    functio numerus() → numerus {
        redde ego.manubria.longitudo()
    }

    functio geometriae() → lista<resource.ResourceHandle> {
        redde ego.geometria_opes
    }

    functio materiae() → lista<resource.ResourceHandle> {
        redde ego.materia_opes
    }

    functio octeta() → numerus {
        varia numerus summa ← 0
        itera ex ego.onera fixum onus {
            fixum numerus ∪ nihil bytes ← onus.byte_count()
            si bytes non est nihil { summa ← summa + (bytes vel 0) }
        }
        redde summa
    }

    functio ductus() → lista<SceneMeshDrawPacket> {
        varia lista<SceneMeshDrawPacket> fasciculi ← vacua
        varia numerus i ← 0
        dum i < ego.manubria.longitudo() {
            fasciculi.appende(SceneMeshDrawPacket {
                node = SceneHandle {
                    index = ego.manubria[i].index,
                    generation = ego.manubria[i].generation
                },
                geometry = resource.ResourceHandle {
                    index = ego.geometria_opes[i].index,
                    generation = ego.geometria_opes[i].generation
                },
                material = resource.ResourceHandle {
                    index = ego.materia_opes[i].index,
                    generation = ego.materia_opes[i].generation
                },
                transform = ego.onera[i]
            })
            i ← i + 1
        }
        redde fasciculi
    }
}

# ── Visibilia entry point ─────────────────────────────────────────────

functio visibilia(
    de SceneStore store,
    de SceneHandle radix,
    de math.Matrix4 visio_proiectio
) → VisibiliaRetium ∪ nihil {
    si visio_proiectio.validum() ≡ falsum ergo redde nihil
    # Single traversal: collect all visible mesh data at once
    fixum SceneTraversal ∪ nihil handles_result ← store._traverse_visibile_rete_preorder(
        radix, vacua, store.slots.longitudo(), verum
    )
    si handles_result est nihil ergo redde nihil
    fixum SceneTraversal peragratio ← SceneTraversal {
        handles = handles_result!.handles, remaining = handles_result!.remaining
    }
    varia VisibiliaRetium retia ← VisibiliaRetium {
        manubria = vacua,
        geometria_opes = vacua,
        materia_opes = vacua,
        onera = vacua
    }
    itera ex peragratio.handles fixum manubrium {
        fixum SceneNode ∪ nihil nodus_result ← store.cape(manubrium)
        si nodus_result est nihil ergo redde (nihil)
        retia.manubria.appende(SceneHandle {
            index = manubrium.index, generation = manubrium.generation
        })
        discerne nodus_result!.kind {
            casu SceneMesh fixum geometry, material {
                retia.geometria_opes.appende(resource.ResourceHandle {
                    index = geometry.index, generation = geometry.generation
                })
                retia.materia_opes.appende(resource.ResourceHandle {
                    index = material.index, generation = material.generation
                })
                fixum math.TransformPayload ∪ nihil onus ←
                    math.transform_payload(nodus_result!.world_matrix, visio_proiectio)
                si onus est nihil ergo redde (nihil)
                retia.onera.appende(onus vel math.TransformPayload { values = vacua })
            }
            casu SceneGroup { }
            casu SceneCamera { }
            casu SceneLight { }
        }
    }
    redde retia
}

# ── Free constructors ─────────────────────────────────────────────────

functio scene_store() → SceneStore {
    redde SceneStore { slots = vacua }
}

functio scene_node(textus name, SceneNodeKind kind) → SceneNode {
    redde SceneNode {
        name = name, kind = kind, children = vacua,
        visible = verum,
        local_matrix = math.matrix4_identitas(),
        world_matrix = math.matrix4_identitas(),
        world_dirty = verum
    }
}

functio scene_group(textus name) → SceneNode {
    redde scene_node(name, finge SceneGroup)
}

functio scene_mesh(
    textus name,
    de resource.ResourceHandle geometry,
    de resource.ResourceHandle material
) → SceneNode {
    redde scene_node(name, finge SceneMesh {
        geometry = resource.ResourceHandle { index = geometry.index, generation = geometry.generation },
        material = resource.ResourceHandle { index = material.index, generation = material.generation }
    })
}

functio scene_camera(textus name) → SceneNode {
    redde scene_node(name, finge SceneCamera)
}

functio scene_light(textus name) → SceneNode {
    redde scene_node(name, finge SceneLight)
}

# ── Free utilities on handles ─────────────────────────────────────────

functio scene_handle_equals(de SceneHandle a, de SceneHandle b) → bivalens {
    redde a.index ≡ b.index et a.generation ≡ b.generation
}

