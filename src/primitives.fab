+++ toml
locale = "en"

+++ faber
# Deterministic mesh primitive generators — package map facade.
#
# Public import: import from "triga:primitives"
#
# Prefer leaf modules (one concern per import path):
#   triga:primitives/basic   plane, circle, sphere, cylinder, cone, torus,
#                            box, box wire generators
#
# This file holds no types. Import the leaf modules above.

import from "triga:primitives/basic"

+++ faber test
# Co-located package test for the primitive facade. The facade is a package
# map only; generator contracts remain owned by the basic leaf import.
import from "triga:primitives"

describe "primitives facade discovery" {
    test "primitives facade imports as a package map" {
        assert true
    }
}
