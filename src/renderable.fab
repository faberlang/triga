+++ toml
locale = "en"

+++ faber
# Renderable objects — package map facade.
#
# Public import: import from "triga:renderable" renderable
#
# Prefer leaf modules (Norma style — one concern per import path):
#   triga:renderable/mesh   Mesh (Object + Geometry + material union)
#
# Planned (report §1.3): renderable/skin, renderable/morph at H5;
# renderable/instance at H6. Created only when they own content.
#
# This file intentionally holds no genera. Import the leaf modules above.

import from "triga:renderable/mesh"

+++ faber test
# Co-located package smoke for the renderable facade.
#
# The facade intentionally contains only imports. This case proves that the
# public `triga:renderable` path is discoverable without claiming that it
# re-exports Mesh or that a host draws the composed carrier.

import from "triga:renderable"

test "renderable facade is discoverable" {
    assert true
}
