# Voxel face quad construction helpers.
#
# Public import: import from "triga:face" face
# Face-code tables (valida/normal/color/offsets) live in triga:math so RayBox3Hit
# can call them without a math↔face import cycle.
# Depends on: triga:math, triga:geometry/data

import from "triga:math" math

import from "triga:geometry/data" data

# FaceQuad is the four-corner source shape used by voxel-style face builders.
# Face-code orientation and color stay in `triga:math`; this leaf only turns a
# code plus an origin/size into geometry-ready corners.
@ public
class FaceQuad {
    math.Vector3 a
    math.Vector3 b
    math.Vector3 c
    math.Vector3 d
}

# Build one oriented quad. Invalid face codes and non-positive sizes return
# `nihil` so callers can keep malformed voxel input out of geometry buffers.
@ public
fn face_code_unit_quad(int code, f32 x, f32 y, f32 z, f32 size) → FaceQuad ∪ null {
    if math.face_code_valida(code) ≡ false then return null
    if size ≤ 0.0 then return null
    const f32 x1 ← x + size
    const f32 y1 ← y + size
    const f32 z1 ← z + size
    switch code {
        case 1 {
            return FaceQuad {a = math.vector3(x, y, z), b = math.vector3(x, y, z1), c = math.vector3(x, y1, z1), d = math.vector3(x, y1, z)}
        }
        case 2 {
            return FaceQuad {a = math.vector3(x1, y, z1), b = math.vector3(x1, y, z), c = math.vector3(x1, y1, z), d = math.vector3(x1, y1, z1)}
        }
        case 3 {
            return FaceQuad {a = math.vector3(x, y, z), b = math.vector3(x1, y, z), c = math.vector3(x1, y, z1), d = math.vector3(x, y, z1)}
        }
        case 4 {
            return FaceQuad {a = math.vector3(x, y1, z1), b = math.vector3(x1, y1, z1), c = math.vector3(x1, y1, z), d = math.vector3(x, y1, z)}
        }
        case 5 {
            return FaceQuad {a = math.vector3(x1, y, z), b = math.vector3(x, y, z), c = math.vector3(x, y1, z), d = math.vector3(x1, y1, z)}
        }
        case 6 {
            return FaceQuad {a = math.vector3(x, y, z1), b = math.vector3(x1, y, z1), c = math.vector3(x1, y1, z1), d = math.vector3(x, y1, z1)}
        }
        default {
            return null
        }
    }
}

# Append the same face directly into position/color/index arrays, preserving
# the accumulation shape used by the voxel exempla.
@ public
fn face_code_colored_quad_mesh_append(list<f32> positions, list<f32> colors, list<u32> indices, int code, f32 x, f32 y, f32 z, f32 size) → data.ColoredQuadMesh ∪ null {
    const FaceQuad ∪ null quad_result ← face_code_unit_quad(code, x, y, z, size)
    if quad_result is null then return null
    const FaceQuad quad ← quad_result
    const math.Color ∪ null color_result ← math.face_code_color(code)
    if color_result is null then return null
    const math.Color color ← color_result
    return data.colored_quad_mesh_append(positions, colors, indices, quad.a, quad.b, quad.c, quad.d, color)
}
