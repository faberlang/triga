# Voxel face quad construction helpers.
#
# Public import: import from "triga:face" face
# Face-code tables (valid/normal/color/offsets) live in triga:math so RayBoxHit
# can call them without a math↔face import cycle.
# Depends on: triga:math, triga:geometry/data

import from "triga:math" math

import from "triga:geometry/data" data

# FaceQuad is the four-corner source shape used by voxel-style face builders.
# Face-code orientation and color stay in `triga:math`; this leaf only turns a
# code plus an origin/size into geometry-ready corners.
@ public
class FaceQuad {
    var vector<f32, 3> a
    var vector<f32, 3> b
    var vector<f32, 3> c
    var vector<f32, 3> d
}

# Build one oriented quad. Invalid face codes and non-positive sizes return
# `null` so callers can keep malformed voxel input out of geometry buffers.
@ public
fn face_code_unit_quad(int code, f32 x, f32 y, f32 z, f32 size) → FaceQuad ∪ none {
    if not math.face_code_valid(code) then return null
    if size ≤ 0.0 then return null
    const f32 x1 ← x + size
    const f32 y1 ← y + size
    const f32 z1 ← z + size
    switch code {
        case 1 {
            return FaceQuad {a = [x, y, z] ↦ vector<f32, 3>, b = [x, y, z1] ↦ vector<f32, 3>, c = [x, y1, z1] ↦ vector<f32, 3>, d = [x, y1, z] ↦ vector<f32, 3>}
        }
        case 2 {
            return FaceQuad {a = [x1, y, z1] ↦ vector<f32, 3>, b = [x1, y, z] ↦ vector<f32, 3>, c = [x1, y1, z] ↦ vector<f32, 3>, d = [x1, y1, z1] ↦ vector<f32, 3>}
        }
        case 3 {
            return FaceQuad {a = [x, y, z] ↦ vector<f32, 3>, b = [x1, y, z] ↦ vector<f32, 3>, c = [x1, y, z1] ↦ vector<f32, 3>, d = [x, y, z1] ↦ vector<f32, 3>}
        }
        case 4 {
            return FaceQuad {a = [x, y1, z1] ↦ vector<f32, 3>, b = [x1, y1, z1] ↦ vector<f32, 3>, c = [x1, y1, z] ↦ vector<f32, 3>, d = [x, y1, z] ↦ vector<f32, 3>}
        }
        case 5 {
            return FaceQuad {a = [x1, y, z] ↦ vector<f32, 3>, b = [x, y, z] ↦ vector<f32, 3>, c = [x, y1, z] ↦ vector<f32, 3>, d = [x1, y1, z] ↦ vector<f32, 3>}
        }
        case 6 {
            return FaceQuad {a = [x, y, z1] ↦ vector<f32, 3>, b = [x1, y, z1] ↦ vector<f32, 3>, c = [x1, y1, z1] ↦ vector<f32, 3>, d = [x, y1, z1] ↦ vector<f32, 3>}
        }
        default {
            return null
        }
    }
}

# Append the same face directly into position/color/index arrays, preserving
# the accumulation shape used by the voxel exempla.
@ public
fn face_code_colored_quad_mesh_append(list<f32> positions, list<f32> colors, list<u32> indices, int code, f32 x, f32 y, f32 z, f32 size) → data.ColoredQuadMesh ∪ none {
    const FaceQuad ∪ none quad_result ← face_code_unit_quad(code, x, y, z, size)
    if quad_result is none then return null
    const FaceQuad quad ← quad_result
    const math.Color ∪ none color_result ← math.face_code_color(code)
    if color_result is none then return null
    const math.Color color ← color_result
    return data.colored_quad_mesh_append(positions, colors, indices, quad.a, quad.b, quad.c, quad.d, color)
}
