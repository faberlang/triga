# Mesh renderable — scene-graph node bound to geometry and a material.
#
# Public import: import from "triga:renderable/mesh" private mesh
# Depends on: triga:graph/object, triga:geometry/data,
#             triga:material/{standard,basic,lit}
#
# Mesh is the primary renderable object (mirrors THREE.Mesh). It owns no
# material-family type: the `material` field is a union of the three material
# leaves' genera. Cross-module union CONSTRUCTION works (DS-A union probe,
# 2026-08-01); union PATTERN-MATCHING (discerne/casu) does not — compiler
# gap, semantics enum-only — so consumers must not case over the union; use
# dedicated accessors / common union fields instead.

import from "triga:graph/object" private object as graph_object

import from "triga:geometry/data" private data

import from "triga:material/standard" private standard

import from "triga:material/basic" private basic

import from "triga:material/lit" private lit

# Mesh is the primary renderable composition: graph transform plus geometry
# plus one of the current material families. The union is intentionally a
# source-side contract; consumers use the shared fields and dedicated facts,
# while the host owns resource and draw submission.
class Mesh {
    graph_object.Object3D base
    data.BufferGeometry geometry
    basic.MeshBasicMaterial ∪ lit.MeshPhongMaterial ∪ standard.MeshStandardMaterial material optional
}
