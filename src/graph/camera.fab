# Camera shape contracts (PerspectiveCamera, OrthographicCamera, projection facts).
#
# Public import: import from "triga:graph/camera" camera
# Depends on: triga:math, triga:graph/object

import from "triga:math" math

import from "triga:graph/object" object as graph_object

# PerspectiveCamera is a value-level camera contract. The projection methods
# return `null` when the matrix inputs cannot form a valid payload, so camera
# setup stays in ordinary Faber control flow.
@ public
class PerspectiveCamera {
    var graph_object.Object base
    var f32 fov = 50.0
    var f32 aspect = 1.0
    var f32 near = 0.1
    var f32 far = 2000.0

    fn projection() → matrix<f32, [4, 4]> ∪ none {
        return math.matrix_perspective(self.fov, self.aspect, self.near, self.far)
    }

    fn projection_facts() → PerspectiveCameraProjectionFacts ∪ none {
        const matrix<f32, [4, 4]> ∪ none projection_result ← self.projection()
        if projection_result is none then return null
        const matrix<f32, [4, 4]> projection ← projection_result
        return PerspectiveCameraProjectionFacts {fov_y_degrees = self.fov, aspect = self.aspect, near = self.near, far = self.far, projection_float_count = 16, x_scale = math.matrix_element(projection, 0, 0), y_scale = math.matrix_element(projection, 1, 1), depth_scale = math.matrix_element(projection, 2, 2)}
    }

    fn view_projection(vector<f32, 3> eye, vector<f32, 3> target, vector<f32, 3> up) → matrix<f32, [4, 4]> ∪ none {
        const matrix<f32, [4, 4]> ∪ none projection_result ← self.projection()
        if projection_result is none then return null
        const matrix<f32, [4, 4]> ∪ none view_result ← math.matrix_look_at(eye, target, up)
        if view_result is none then return null
        const matrix<f32, [4, 4]> projection ← projection_result
        const matrix<f32, [4, 4]> view ← view_result
        return projection · view
    }

    fn view_projection_facts(vector<f32, 3> eye, vector<f32, 3> target, vector<f32, 3> up) → ViewProjectionFacts ∪ none {
        const matrix<f32, [4, 4]> ∪ none view_projection_result ← self.view_projection(eye, target, up)
        if view_projection_result is none then return null
        const matrix<f32, [4, 4]> view_projection ← view_projection_result
        return ViewProjectionFacts {float_count = 16, x_scale = math.matrix_element(view_projection, 0, 0), y_scale = math.matrix_element(view_projection, 1, 1), depth_scale = math.matrix_element(view_projection, 2, 2), view_translation_z = math.matrix_element(view_projection, 2, 3)}
    }
}

# Projection facts are the small, host-readable summary of a perspective
# matrix. They keep a consumer from decoding the matrix merely to inspect its
# scale and depth terms.
@ public
class PerspectiveCameraProjectionFacts {
    var f32 fov_y_degrees
    var f32 aspect
    var f32 near
    var f32 far
    var int projection_float_count
    var f32 x_scale
    var f32 y_scale
    var f32 depth_scale
}

# ViewProjectionFacts describes the combined projection × view result used by
# a render path. The full matrix remains available from `view_projection`; this
# genus is for compact validation and reflection facts.
@ public
class ViewProjectionFacts {
    var int float_count
    var f32 x_scale
    var f32 y_scale
    var f32 depth_scale
    var f32 view_translation_z
}

# OrthographicCamera reserves the same composed Object shape for the
# orthographic projection family. Its fields are plain data so the projection
# implementation can share the public graph contract.
@ public
class OrthographicCamera {
    var graph_object.Object base
    var f32 left
    var f32 right
    var f32 top
    var f32 bottom
    var f32 near = 0.1
    var f32 far = 2000.0
}
