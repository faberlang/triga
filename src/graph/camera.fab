+++ toml
locale = "en"

+++ faber
# Camera shape contracts (PerspectiveCamera, OrthographicCamera, projection facts).
#
# Public import: import from "triga:graph/camera" camera
# Depends on: triga:math, triga:graph/object

import from "triga:math"

import from "triga:graph/object" let graph_object

# PerspectiveCamera is a value-level camera contract. The projection methods
# return `null` when the matrix inputs cannot form a valid payload, so camera
# setup stays in ordinary Faber control flow.
@ public
class PerspectiveCamera {
    mut graph_object.Object base
    mut f32 fov = 50.0
    mut f32 aspect = 1.0
    mut f32 near = 0.1
    mut f32 far = 2000.0

    fn projection() → matrix<f32, [4, 4]> ∪ none {
        return math.matrix_perspective(self.fov, self.aspect, self.near, self.far)
    }

    fn projection_facts() → PerspectiveCameraProjectionFacts ∪ none {
        let matrix<f32, [4, 4]> ∪ none projection_result ← self.projection()
        if projection_result is none then return null
        let matrix<f32, [4, 4]> projection ← projection_result
        return PerspectiveCameraProjectionFacts {fov_y_degrees = self.fov, aspect = self.aspect, near = self.near, far = self.far, projection_float_count = 16, x_scale = projection[[0, 0]], y_scale = projection[[1, 1]], depth_scale = projection[[2, 2]]}
    }

    fn view_projection(vector<f32, size 3> eye, vector<f32, size 3> target, vector<f32, size 3> up) → matrix<f32, [4, 4]> ∪ none {
        let matrix<f32, [4, 4]> ∪ none projection_result ← self.projection()
        if projection_result is none then return null
        let matrix<f32, [4, 4]> ∪ none view_result ← math.matrix_look_at(eye, target, up)
        if view_result is none then return null
        let matrix<f32, [4, 4]> projection ← projection_result
        let matrix<f32, [4, 4]> view ← view_result
        return projection · view
    }

    fn view_projection_facts(vector<f32, size 3> eye, vector<f32, size 3> target, vector<f32, size 3> up) → ViewProjectionFacts ∪ none {
        let matrix<f32, [4, 4]> ∪ none view_projection_result ← self.view_projection(eye, target, up)
        if view_projection_result is none then return null
        let matrix<f32, [4, 4]> view_projection ← view_projection_result
        return ViewProjectionFacts {float_count = 16, x_scale = view_projection[[0, 0]], y_scale = view_projection[[1, 1]], depth_scale = view_projection[[2, 2]], view_translation_z = view_projection[[2, 3]]}
    }
}

# Projection facts are the small, host-readable summary of a perspective
# matrix. They keep a consumer from decoding the matrix merely to inspect its
# scale and depth terms.
@ public
class PerspectiveCameraProjectionFacts {
    mut f32 fov_y_degrees
    mut f32 aspect
    mut f32 near
    mut f32 far
    mut int projection_float_count
    mut f32 x_scale
    mut f32 y_scale
    mut f32 depth_scale
}

# ViewProjectionFacts describes the combined projection × view result used by
# a render path. The full matrix remains available from `view_projection`; this
# genus is for compact validation and reflection facts.
@ public
class ViewProjectionFacts {
    mut int float_count
    mut f32 x_scale
    mut f32 y_scale
    mut f32 depth_scale
    mut f32 view_translation_z
}

# OrthographicCamera reserves the same composed Object shape for the
# orthographic projection family. Its fields are plain data so the projection
# implementation can share the public graph contract.
@ public
class OrthographicCamera {
    mut graph_object.Object base
    mut f32 left
    mut f32 right
    mut f32 top
    mut f32 bottom
    mut f32 near = 0.1
    mut f32 far = 2000.0
}

+++ faber test
# Co-located package tests for graph/camera.fab.
#
# These cases pin the camera data facts, projection matrices, compact facts,
# view-projection composition, and fail-closed invalid-input behavior.
# matrix<f32, [4, 4]> is a type invariant; facts read cells with m[[row, column]].

import from "triga:graph/camera"
import from "triga:graph/object" let graph_object
import from "triga:math"

const f32 TOLERATIO = 0.01

fn base_camera(string name, f32 z) → graph_object.Object {
    return graph_object.Object {position = [0.0, 0.0, z] ↦ vector<f32, size 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, size 3>, matrix = math.matrix_identity(), children = empty, visible = true, name = name}
}

fn empty_projection_facts() → camera.PerspectiveCameraProjectionFacts {
    return camera.PerspectiveCameraProjectionFacts {fov_y_degrees = 0.0, aspect = 0.0, near = 0.0, far = 0.0, projection_float_count = 0, x_scale = 0.0, y_scale = 0.0, depth_scale = 0.0}
}

fn empty_view_facts() → camera.ViewProjectionFacts {
    return camera.ViewProjectionFacts {float_count = 0, x_scale = 0.0, y_scale = 0.0, depth_scale = 0.0, view_translation_z = 0.0}
}

test "PerspectiveCamera emits a valid projection and projection facts" {
    let camera.PerspectiveCamera cam ← camera.PerspectiveCamera {base = base_camera("cam", 5.0), fov = 90.0, aspect = 2.0, near = 0.1, far = 100.0}
    let matrix<f32, [4, 4]> ∪ none projection_result ← cam.projection()
    let matrix<f32, [4, 4]> projection ← projection_result coalesce math.matrix_identity()
    assert cam.base.name ≡ "cam"
    assert cam.fov ≡ (90.0 ∷ f32)
    assert cam.aspect ≡ (2.0 ∷ f32)
    assert projection_result not is none
    assert projection[[3, 2]] ≡ (-1.0 ∷ f32)

    let camera.PerspectiveCameraProjectionFacts ∪ none facts_result ← cam.projection_facts()
    let camera.PerspectiveCameraProjectionFacts facts ← facts_result coalesce empty_projection_facts()
    assert facts_result not is none
    assert facts.fov_y_degrees ≡ (90.0 ∷ f32)
    assert facts.aspect ≡ (2.0 ∷ f32)
    assert facts.near ≡ (0.1 ∷ f32)
    assert facts.far ≡ (100.0 ∷ f32)
    assert facts.projection_float_count ≡ 16
    assert facts.x_scale.approx(0.5, TOLERATIO)
    assert facts.y_scale.approx(1.0, TOLERATIO)
    assert facts.depth_scale.approx(-1.001, TOLERATIO)
}

test "PerspectiveCamera emits view-projection output and facts" {
    let camera.PerspectiveCamera cam ← camera.PerspectiveCamera {base = base_camera("view-camera", 5.0), fov = 90.0, aspect = 2.0, near = 0.1, far = 100.0}
    let matrix<f32, [4, 4]> ∪ none view_projection_result ← cam.view_projection([0.0, 0.0, 5.0] ↦ vector<f32, size 3>, [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 1.0, 0.0] ↦ vector<f32, size 3>)
    let matrix<f32, [4, 4]> view_projection ← view_projection_result coalesce math.matrix_identity()
    assert view_projection_result not is none
    assert view_projection[[3, 2]] ≡ (-1.0 ∷ f32)

    let camera.ViewProjectionFacts ∪ none facts_result ← cam.view_projection_facts([0.0, 0.0, 5.0] ↦ vector<f32, size 3>, [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 1.0, 0.0] ↦ vector<f32, size 3>)
    let camera.ViewProjectionFacts facts ← facts_result coalesce empty_view_facts()
    assert facts_result not is none
    assert facts.float_count ≡ 16
    assert facts.x_scale.approx(0.5, TOLERATIO)
    assert facts.y_scale.approx(1.0, TOLERATIO)
    assert facts.depth_scale.approx(-1.001, TOLERATIO)
    assert facts.view_translation_z.approx(4.905, TOLERATIO)
}

test "OrthographicCamera preserves extents and camera defaults" {
    let camera.OrthographicCamera orthographic ← camera.OrthographicCamera {base = base_camera("orthographic", 0.0), left = -10.0, right = 10.0, top = 8.0, bottom = -8.0, near = 0.1, far = 2000.0}
    assert orthographic.base.name ≡ "orthographic"
    assert orthographic.base.visible
    assert orthographic.left ≡ (-10.0 ∷ f32)
    assert orthographic.right ≡ (10.0 ∷ f32)
    assert orthographic.top ≡ (8.0 ∷ f32)
    assert orthographic.bottom ≡ (-8.0 ∷ f32)
    assert orthographic.near ≡ (0.1 ∷ f32)
    assert orthographic.far ≡ (2000.0 ∷ f32)
}

test "PerspectiveCamera rejects invalid projection field ranges" {
    let camera.PerspectiveCamera bad_fov ← camera.PerspectiveCamera {base = base_camera("bad-fov", 0.0), fov = 0.0, aspect = 1.0, near = 0.1, far = 100.0}
    let camera.PerspectiveCamera bad_aspect ← camera.PerspectiveCamera {base = base_camera("bad-aspect", 0.0), fov = 50.0, aspect = 0.0, near = 0.1, far = 100.0}
    let camera.PerspectiveCamera bad_near ← camera.PerspectiveCamera {base = base_camera("bad-near", 0.0), fov = 50.0, aspect = 1.0, near = 0.0, far = 100.0}
    let camera.PerspectiveCamera bad_far ← camera.PerspectiveCamera {base = base_camera("bad-far", 0.0), fov = 50.0, aspect = 1.0, near = 100.0, far = 100.0}
    assert bad_fov.projection() is none
    assert bad_fov.projection_facts() is none
    assert bad_aspect.projection() is none
    assert bad_near.projection() is none
    assert bad_far.projection() is none
}

test "PerspectiveCamera rejects degenerate view inputs" {
    let camera.PerspectiveCamera cam ← camera.PerspectiveCamera {base = base_camera("degenerate-view", 5.0), fov = 50.0, aspect = 1.0, near = 0.1, far = 100.0}
    assert cam.view_projection([0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 1.0, 0.0] ↦ vector<f32, size 3>) is none
    assert cam.view_projection([0.0, 0.0, 5.0] ↦ vector<f32, size 3>, [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 0.0, 1.0] ↦ vector<f32, size 3>) is none
    assert cam.view_projection_facts([0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, [0.0, 1.0, 0.0] ↦ vector<f32, size 3>) is none
}
