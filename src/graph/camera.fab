# Camera shape contracts (PerspectiveCamera, OrthographicCamera, projection facts).
#
# Public import: import from "triga:graph/camera" camera
# Depends on: triga:math, triga:graph/object

import from "triga:math" math

import from "triga:graph/object" object as graph_object

# PerspectiveCamera is a value-level camera contract. The projection methods
# return `null` when the matrix inputs cannot form a valid payload, so camera
# setup stays in ordinary Faber control flow.
@ public
class PerspectiveCamera {
    var graph_object.Object3D base
    var f32 fov = 50.0
    var f32 aspect = 1.0
    var f32 near = 0.1
    var f32 far = 2000.0

    fn projection() → math.Matrix4 ∪ none {
        return math.matrix4_perspective(self.fov, self.aspect, self.near, self.far)
    }

    fn projection_facts() → PerspectiveCameraProjectionFacts ∪ none {
        const math.Matrix4 ∪ none projection_result ← self.projection()
        if projection_result is none then return null
        const math.Matrix4 projection ← projection_result
        if not projection.valid() then return null
        return PerspectiveCameraProjectionFacts {fov_y_degrees = self.fov, aspect = self.aspect, near = self.near, far = self.far, projection_float_count = projection.elements.length(), x_scale = projection.elements[0], y_scale = projection.elements[5], depth_scale = projection.elements[10]}
    }

    fn view_projection(ref math.Vector3 eye, ref math.Vector3 target, ref math.Vector3 up) → math.Matrix4 ∪ none {
        const math.Matrix4 ∪ none projection_result ← self.projection()
        if projection_result is none then return null
        const math.Matrix4 ∪ none view_result ← math.matrix4_look_at(eye, target, up)
        if view_result is none then return null
        const math.Matrix4 projection ← projection_result
        const math.Matrix4 view ← view_result
        return projection.multiply(view)
    }

    fn view_projection_facts(ref math.Vector3 eye, ref math.Vector3 target, ref math.Vector3 up) → ViewProjectionFacts ∪ none {
        const math.Matrix4 ∪ none view_projection_result ← self.view_projection(eye, target, up)
        if view_projection_result is none then return null
        const math.Matrix4 view_projection ← view_projection_result
        if not view_projection.valid() then return null
        return ViewProjectionFacts {float_count = view_projection.elements.length(), x_scale = view_projection.elements[0], y_scale = view_projection.elements[5], depth_scale = view_projection.elements[10], view_translation_z = view_projection.elements[14]}
    }
}

# Projection facts are the small, host-readable summary of a perspective
# matrix. They keep a consumer from decoding the matrix merely to inspect its
# scale and depth terms.
@ public
class PerspectiveCameraProjectionFacts {
    var f32 fov_y_degrees
    var f32 aspect
    var f32 near
    var f32 far
    var int projection_float_count
    var f32 x_scale
    var f32 y_scale
    var f32 depth_scale
}

# ViewProjectionFacts describes the combined projection × view result used by
# a render path. The full matrix remains available from `view_projection`; this
# genus is for compact validation and reflection facts.
@ public
class ViewProjectionFacts {
    var int float_count
    var f32 x_scale
    var f32 y_scale
    var f32 depth_scale
    var f32 view_translation_z
}

# OrthographicCamera reserves the same composed Object3D shape for the
# orthographic projection family. Its fields are plain data so the projection
# implementation can share the public graph contract.
@ public
class OrthographicCamera {
    var graph_object.Object3D base
    var f32 left
    var f32 right
    var f32 top
    var f32 bottom
    var f32 near = 0.1
    var f32 far = 2000.0
}
