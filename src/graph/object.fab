# Object scene-graph node and Scene container shape contracts.
#
# Public import: import from "triga:graph/object" object
# Depends on: triga:math

import from "triga:math" math

# Object is the common scene-graph payload. Triga keeps composition explicit:
# a camera, light, or scene stores an Object in its `base` field instead of
# relying on inheritance. That makes the data crossing the Faber/host seam
# visible in the type itself.
@ public
class Object {
    mut vector<f32, 3> position
    mut math.Euler rotation
    mut math.Quaternion quaternion
    mut vector<f32, 3> scale
    mut matrix<f32, [4, 4]> matrix
    mut list<Object> children
    mut bool visible = true
    mut string name
}

# Scene adds only an optional background color to the common Object shape.
# The scene store in `triga:scene` owns identity and hierarchy; this genus is
# the lightweight value shape used by graph-facing APIs.
@ public
class Scene {
    mut Object base
    mut math.Color background optional
}
