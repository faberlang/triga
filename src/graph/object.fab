+++ toml
locale = "en"

+++ faber
# Object scene-graph node and Scene container shape contracts.
#
# Public import: import from "triga:graph/object"
# Depends on: triga:math

import from "triga:math"

# Object is the common scene-graph payload. Triga keeps composition explicit:
# a camera, light, or scene stores an Object in its `base` field instead of
# relying on inheritance. That makes the data crossing the Faber/host seam
# visible in the type itself.
@ public
class Object {
    mut vector<f32, size 3> position
    mut math.Euler rotation
    mut math.Quaternion quaternion
    mut vector<f32, size 3> scale
    mut matrix<f32, [4, 4]> matrix
    mut list<Object> children
    mut bool visible = true
    mut string name
}

# Scene adds only an optional background color to the common Object shape.
# The scene store in `triga:scene` owns identity and hierarchy; this class is
# the lightweight value shape used by graph-facing APIs.
@ public
class Scene {
    mut Object base
    mut math.Color background optional
}

+++ faber test
# Co-located package tests for graph/object.fab.
#
# Object is a composed value shape. The graph contract keeps hierarchy in
# the children list; it does not invent a parent field on Object. Scene adds
# an optional background while preserving the Object base identity.

import from "triga:graph/object" let graph_object
import from "triga:math"

fn objectum(string name) → graph_object.Object {
    return graph_object.Object {position = [1.0, 2.0, 3.0] ↦ vector<f32, size 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, size 3>, matrix = math.matrix_identity(), children = empty, visible = true, name = name}
}

test "Object preserves identity and default node state" {
    let graph_object.Object node ← objectum("root")
    assert node.name ≡ "root"
    assert node.position[0] ≡ (1.0 ∷ f32)
    assert node.position[1] ≡ (2.0 ∷ f32)
    assert node.position[2] ≡ (3.0 ∷ f32)
    assert node.rotation.order ≡ "XYZ"
    assert node.quaternion.w ≡ (1.0 ∷ f32)
    assert node.scale[0] ≡ (1.0 ∷ f32)
    assert node.matrix[[0, 0]] ≡ (1.0 ∷ f32)
    assert node.children.length() ≡ 0
    assert node.visible
}

test "Object child lists preserve parent and child defaults" {
    let graph_object.Object child ← objectum("child")
    let graph_object.Object parent ← graph_object.Object {position = [0.0, 0.0, 0.0] ↦ vector<f32, size 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, size 3>, matrix = math.matrix_identity(), children = [child], visible = true, name = "parent"}
    assert parent.name ≡ "parent"
    assert parent.children.length() ≡ 1
    assert parent.children[0].name ≡ "child"
    assert parent.children[0].children.length() ≡ 0
    assert parent.children[0].visible
}

test "Scene preserves its Object base and optional background" {
    let graph_object.Object base ← objectum("scene-root")
    let graph_object.Scene scene ← graph_object.Scene {base = base, background = math.Color {r = 0.2, g = 0.4, b = 0.6}}
    let math.Color background ← scene.background coalesce math.Color {r = -1.0, g = -1.0, b = -1.0}
    assert scene.base.name ≡ "scene-root"
    assert scene.background not is none
    assert background.r ≡ (0.2 ∷ f32)
    assert background.g ≡ (0.4 ∷ f32)
    assert background.b ≡ (0.6 ∷ f32)
}

test "Scene background is absent by default" {
    let graph_object.Scene scene ← graph_object.Scene {base = objectum("plain-scene")}
    assert scene.background is none
}
