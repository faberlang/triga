# Co-located package tests for graph/object.fab.
#
# Object is a composed value shape. The graph contract keeps hierarchy in
# the children list; it does not invent a parent field on Object. Scene adds
# an optional background while preserving the Object base identity.

import from "triga:graph/object" graph_object
import from "triga:math" math

fn objectum(string name) → graph_object.Object {
    return graph_object.Object {position = [1.0, 2.0, 3.0] ↦ vector<f32, 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, 3>, matrix = math.matrix_identity(), children = empty, visible = true, name = name}
}

test "Object preserves identity and default node state" {
    const graph_object.Object node ← objectum("root")
    assert node.name ≡ "root"
    assert math.x(node.position) ≡ (1.0 ∷ f32)
    assert math.y(node.position) ≡ (2.0 ∷ f32)
    assert math.z(node.position) ≡ (3.0 ∷ f32)
    assert node.rotation.order ≡ "XYZ"
    assert node.quaternion.w ≡ (1.0 ∷ f32)
    assert math.x(node.scale) ≡ (1.0 ∷ f32)
    assert math.matrix_element(node.matrix, 0, 0) ≡ (1.0 ∷ f32)
    assert node.children.length() ≡ 0
    assert node.visible
}

test "Object child lists preserve parent and child defaults" {
    const graph_object.Object child ← objectum("child")
    const graph_object.Object parent ← graph_object.Object {position = [0.0, 0.0, 0.0] ↦ vector<f32, 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, 3>, matrix = math.matrix_identity(), children = [child], visible = true, name = "parent"}
    assert parent.name ≡ "parent"
    assert parent.children.length() ≡ 1
    assert parent.children[0].name ≡ "child"
    assert parent.children[0].children.length() ≡ 0
    assert parent.children[0].visible
}

test "Scene preserves its Object base and optional background" {
    const graph_object.Object base ← objectum("scene-root")
    const graph_object.Scene scene ← graph_object.Scene {base = base, background = math.Color {r = 0.2, g = 0.4, b = 0.6}}
    const math.Color background ← scene.background coalesce math.Color {r = -1.0, g = -1.0, b = -1.0}
    assert scene.base.name ≡ "scene-root"
    assert scene.background not is none
    assert background.r ≡ (0.2 ∷ f32)
    assert background.g ≡ (0.4 ∷ f32)
    assert background.b ≡ (0.6 ∷ f32)
}

test "Scene background is absent by default" {
    const graph_object.Scene scene ← graph_object.Scene {base = objectum("plain-scene")}
    assert scene.background is none
}
