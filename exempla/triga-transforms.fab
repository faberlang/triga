+++
term = "triga-transforms"
kind = "concept"
category = "library"
canonical = true
summary = "Triga Vector3 and Matrix4 transform-chain policy and CPU proof."
+++
importa ex "triga:triga" privata triga

incipit {
    fixum triga.Matrix4 translation ← triga.matrix4_translatio(triga.vector3(5.0, -2.0 ∷ f32, 3.0))
    fixum triga.Matrix4 scale ← triga.matrix4_scala(triga.vector3(2.0, 3.0, 4.0))
    fixum triga.Matrix4 world ← translation.multiplicata(scale)
    fixum triga.Vector3 local ← triga.vector3(1.0, 2.0, -1.0 ∷ f32)
    fixum triga.Vector3 transformed ← world.applica_punctum(local)
    adfirma (transformed.x - 7.0).absolutum() ≤ 0.0001, "scaled and translated x"
    adfirma (transformed.y - 4.0).absolutum() ≤ 0.0001, "scaled and translated y"
    adfirma (transformed.z + 1.0).absolutum() ≤ 0.0001, "scaled and translated z"
    adfirma world.validum(), "matrix4 validation accepts sixteen values"
    fixum triga.TransformPayload ∪ nihil packed_transform_result ← triga.transform_payload(world, scale)
    adfirma packed_transform_result non est nihil, "transform payload accepts model and view-projection matrices"
    fixum triga.TransformPayload packed_transform ← triga.TransformPayload { values = packed_transform_result!.values }
    adfirma (packed_transform.float_count() vel 0) ≡ 32, "transform payload locks thirty-two f32 values"
    adfirma (packed_transform.byte_count() vel 0) ≡ 128, "transform payload exposes byte count for one f32 storage buffer"
    adfirma (packed_transform.model_value(0) vel 0.0) ≡ (world.elements)[0], "transform payload starts with model matrix values"
    adfirma (packed_transform.model_value(15) vel 0.0) ≡ (world.elements)[15], "transform payload keeps full model matrix first"
    adfirma (packed_transform.view_projection_value(0) vel 0.0) ≡ (scale.elements)[0], "transform payload stores view-projection matrix after model matrix"
    adfirma packed_transform.model_value(16) est nihil, "transform payload rejects model indices outside sixteen values"
    fixum triga.Matrix4 invalid_matrix ← triga.Matrix4 { elements = [1.0] }
    adfirma invalid_matrix.validum() ≡ falsum, "matrix4 validation rejects non-sixteen-value matrices"
    adfirma triga.transform_payload(invalid_matrix, scale) est nihil, "transform payload rejects invalid model matrices"
    fixum triga.TransformPayload malformed_payload ← triga.TransformPayload { values = [1.0] }
    adfirma malformed_payload.byte_count() est nihil, "transform payload byte count rejects malformed payloads"

    fixum triga.Matrix4 ∪ nihil inverse ← world.inversa_affinis()
    adfirma inverse non est nihil, "non-singular affine inverse succeeds"
    fixum triga.Matrix4 inverse_value ← triga.Matrix4 { elements = inverse!.elements }
    fixum triga.Vector3 round_trip ← inverse_value.applica_punctum(transformed)
    adfirma (round_trip.x - local.x).absolutum() ≤ 0.0001, "inverse round-trip x"
    adfirma (round_trip.y - local.y).absolutum() ≤ 0.0001, "inverse round-trip y"
    adfirma (round_trip.z - local.z).absolutum() ≤ 0.0001, "inverse round-trip z"

    fixum triga.Matrix4 singular ← triga.matrix4_scala(triga.vector3(1.0, 0.0, 1.0))
    adfirma singular.inversa_affinis() est nihil, "singular inverse rejects"

    fixum triga.Quaternion identity_rotation ← triga.quaternion(0.0, 0.0, 0.0, 1.0)
    fixum triga.Quaternion stable_rotation ← identity_rotation.interpolata(identity_rotation, 0.5)
    adfirma stable_rotation.w ≡ (1.0 ∷ f32), "quaternion interpolation is normalized"
    fixum triga.Quaternion normalized_rotation ← triga.quaternion(0.0, 0.0, 0.0, 2.0).normata()
    adfirma normalized_rotation.w ≡ (1.0 ∷ f32), "quaternion normalization"
    fixum triga.Quaternion multiplied_rotation ← identity_rotation.multiplicata(normalized_rotation)
    adfirma multiplied_rotation.w ≡ (1.0 ∷ f32), "quaternion identity composition"
    fixum triga.Euler zero_euler ← triga.euler(0.0, 0.0, 0.0)
    fixum triga.Quaternion ∪ nihil zero_euler_quaternion ← zero_euler.ad_quaternionem()
    adfirma zero_euler_quaternion!.w ≡ (1.0 ∷ f32), "Euler converts to identity quaternion"
    fixum triga.Quaternion ∪ nihil composed_euler ← zero_euler.composita(zero_euler)
    adfirma composed_euler!.w ≡ (1.0 ∷ f32), "Euler composition uses quaternions"
    fixum triga.Euler quarter_turn ← triga.euler(0.0, 0.0, 1.57079633)
    fixum triga.Euler ∪ nihil midpoint_euler ← zero_euler.interpolata(quarter_turn, 0.5)
    adfirma (midpoint_euler!.z - 0.78539816).absolutum() ≤ 0.0001, "Euler interpolation"
    fixum triga.Euler unsupported_euler ← triga.Euler { x = 0.0, y = 0.0, z = 0.0, order = "ZYX" }
    adfirma unsupported_euler.ad_quaternionem() est nihil, "unsupported Euler order rejects"
    fixum triga.Matrix4 composed ← triga.matrix4_composita(triga.vector3(5.0, -2.0 ∷ f32, 3.0), identity_rotation, triga.vector3(2.0, 3.0, 4.0))
    fixum triga.Vector3 composed_point ← composed.applica_punctum(local)
    adfirma (composed_point.x - transformed.x).absolutum() ≤ 0.0001, "quaternion composition matches identity rotation chain"
    fixum triga.Vector3 forward_zero ← triga.camera_prorsum_planus_ex_yaw(0.0)
    adfirma forward_zero.y ≡ (0.0 ∷ f32) et forward_zero.z ≡ (-1.0 ∷ f32), "camera flat forward uses locked yaw convention"
    fixum triga.Vector3 right_zero ← triga.camera_dextra_ex_yaw(0.0)
    adfirma right_zero.x ≡ (1.0 ∷ f32) et right_zero.y ≡ (0.0 ∷ f32), "camera right uses locked yaw convention"
    fixum triga.Vector3 forward_turn ← triga.camera_prorsum_planus_ex_yaw(90.0)
    adfirma (forward_turn.x - 1.0).absolutum() ≤ 0.0001 et forward_turn.y ≡ (0.0 ∷ f32), "camera flat forward rotates with yaw"
    fixum triga.Vector3 right_turn ← triga.camera_dextra_ex_yaw(90.0)
    adfirma (right_turn.z - 1.0).absolutum() ≤ 0.0001 et right_turn.y ≡ (0.0 ∷ f32), "camera right rotates with yaw"

    fixum triga.Box3 bounds ← triga.Box3 { min = triga.vector3(-1.0 ∷ f32, -1.0 ∷ f32, -1.0 ∷ f32), max = triga.vector3(1.0, 1.0, 1.0) }
    adfirma bounds.validum(), "box validates ordered extents"
    fixum triga.Box3 ∪ nihil minmax_bounds ← triga.box3_ex_minimo_et_maximo(triga.vector3(-2.0 ∷ f32, -3.0 ∷ f32, -4.0 ∷ f32), triga.vector3(2.0, 3.0, 4.0))
    adfirma (minmax_bounds non est nihil et minmax_bounds!.min.y ≡ (-3.0 ∷ f32)) et minmax_bounds!.max.z ≡ (4.0 ∷ f32), "min-max box construction preserves explicit extents"
    fixum triga.Vector3 ∪ nihil bounds_size ← bounds.mensura()
    adfirma bounds_size non est nihil et bounds_size!.x ≡ (2.0 ∷ f32), "box size derives from min and max"
    fixum triga.Vector3 ∪ nihil bounds_center ← bounds.centrum()
    adfirma bounds_center non est nihil et bounds_center!.x ≡ (0.0 ∷ f32), "box center derives from min and max"
    fixum triga.Box3 ∪ nihil player_box ← triga.box3_ex_minimo_et_mensura(triga.vector3(-0.3 ∷ f32, 0.0, -0.3 ∷ f32), triga.vector3(0.6, 1.8, 0.6))
    adfirma player_box non est nihil et player_box!.max.y ≡ (1.8 ∷ f32), "box construction supports player collision extents"
    fixum triga.Vector3 centered_box_center ← triga.Vector3 { x = bounds_center!.x, y = bounds_center!.y, z = bounds_center!.z }
    fixum triga.Vector3 centered_box_size ← triga.Vector3 { x = bounds_size!.x, y = bounds_size!.y, z = bounds_size!.z }
    fixum triga.Box3 ∪ nihil centered_cell_box ← triga.box3_ex_centro_et_mensura(centered_box_center, centered_box_size)
    adfirma (centered_cell_box non est nihil et centered_cell_box!.min.x ≡ (-1.0 ∷ f32)) et centered_cell_box!.max.z ≡ (1.0 ∷ f32), "center-size box construction supports voxel selection bounds"
    adfirma bounds.continet_capsam(bounds), "box containment accepts matching extents"
    adfirma triga.box3_ex_minimo_et_mensura(triga.vector3(0.0, 0.0, 0.0), triga.vector3(0.0, 1.0, 1.0)) est nihil, "box construction rejects non-positive size"
    adfirma triga.box3_ex_centro_et_mensura(triga.vector3(0.0, 0.0, 0.0), triga.vector3(1.0, 0.0, 1.0)) est nihil, "center-size box construction rejects non-positive size"
    adfirma bounds.continet(triga.vector3(0.0, 0.0, 0.0)), "box contains origin"
    fixum triga.Box3 shifted_bounds ← bounds.translata(triga.vector3(2.0, 0.0, 0.0))
    adfirma shifted_bounds.min.x ≡ (1.0 ∷ f32) et shifted_bounds.max.x ≡ (3.0 ∷ f32), "box translation preserves extent"
    adfirma bounds.intersecat(shifted_bounds), "touching boxes intersect"
    fixum triga.Vector3 ∪ nihil overlap ← bounds.superpositio(shifted_bounds)
    adfirma ((overlap non est nihil et overlap!.x ≡ (0.0 ∷ f32)) et overlap!.y ≡ (2.0 ∷ f32)) et overlap!.z ≡ (2.0 ∷ f32), "box overlap records shared extent per axis"
    fixum triga.Vector3 overlap_value ← triga.Vector3 { x = overlap!.x, y = overlap!.y, z = overlap!.z }
    adfirma ((overlap_value.x ≡ (0.0 ∷ f32) et overlap_value.y ≡ (2.0 ∷ f32)) et overlap_value.z ≡ (2.0 ∷ f32)), "box overlap exposes axis-specific collision extents"
    fixum triga.Box3 ∪ nihil union_bounds ← bounds.unio(shifted_bounds)
    adfirma (union_bounds non est nihil et union_bounds!.min.x ≡ (-1.0 ∷ f32)) et union_bounds!.max.x ≡ (3.0 ∷ f32), "box union covers both input boxes"
    fixum triga.Box3 inflated_bounds ← bounds.inflata(0.1)
    adfirma (inflated_bounds.min.x + 1.1).absolutum() ≤ 0.0001 et (inflated_bounds.max.x - 1.1).absolutum() ≤ 0.0001, "box inflation supports selection tolerance"
    fixum triga.Box3 shrunken_bounds ← bounds.inflata(-0.5 ∷ f32)
    adfirma shrunken_bounds.min.x ≡ (-0.5 ∷ f32) et shrunken_bounds.max.x ≡ (0.5 ∷ f32), "box inflation supports negative collision padding"
    adfirma bounds.inflata(-2.0 ∷ f32) est nihil, "box inflation rejects inverted output"
    fixum triga.Box3 distant_bounds ← bounds.translata(triga.vector3(3.1, 0.0, 0.0))
    adfirma bounds.intersecat(distant_bounds) ≡ falsum, "separated boxes do not intersect"
    adfirma bounds.superpositio(distant_bounds) est nihil, "separated boxes do not produce overlap extents"
    adfirma bounds.superpositio_facta(distant_bounds) est nihil, "separated boxes do not produce overlap fact records"
    adfirma bounds.continet_capsam(distant_bounds) ≡ falsum, "box containment rejects escaped bounds"
    fixum triga.Box3 invalid_bounds ← triga.Box3 { min = triga.vector3(2.0, 0.0, 0.0), max = triga.vector3(1.0, 1.0, 1.0) }
    adfirma invalid_bounds.validum() ≡ falsum, "box rejects inverted x extent"
    adfirma triga.box3_ex_minimo_et_maximo(invalid_bounds.min, invalid_bounds.max) est nihil, "min-max box construction rejects inverted extents"
    adfirma invalid_bounds.intersecat(bounds) ≡ falsum, "invalid boxes do not intersect"
    adfirma invalid_bounds.superpositio(bounds) est nihil, "box overlap rejects invalid input"
    adfirma invalid_bounds.superpositio(shifted_bounds) est nihil, "axis-specific box overlap rejects invalid input"
    adfirma bounds.continet_capsam(invalid_bounds) ≡ falsum, "box containment rejects invalid child bounds"
    adfirma invalid_bounds.unio(bounds) est nihil, "box union rejects invalid input"
    adfirma invalid_bounds.inflata(0.1) est nihil, "box inflation rejects invalid input"
    fixum triga.Sphere sphere ← triga.Sphere { center = triga.vector3(0.0, 0.0, 0.0), radius = 2.0 }
    adfirma sphere.continet(triga.vector3(1.0, 0.0, 0.0)), "sphere contains interior point"
    fixum triga.Plane plane ← triga.Plane { normal = triga.vector3(0.0, 1.0, 0.0), constant = -2.0 ∷ f32 }
    adfirma plane.distantia(triga.vector3(0.0, 5.0, 0.0)) ≡ (3.0 ∷ f32), "plane signed distance"
    fixum triga.Ray ray ← triga.Ray { origin = triga.vector3(0.0, 0.0, 0.0), direction = triga.vector3(1.0, 0.0, 0.0) }
    fixum triga.Vector3 ray_point ← ray.punctum(3.0)
    adfirma ray_point.x ≡ (3.0 ∷ f32), "ray point at distance"
    fixum _ ray_hit ← ray.intersecat_capsam(shifted_bounds, 6.0)
    adfirma ray_hit non est nihil, "ray reports a box entry within maximum distance"
    fixum triga.RayBox3Hit ∪ nihil ray_box_hit ← ray.box3_hit(shifted_bounds, 6.0)
    adfirma ((ray_box_hit non est nihil et (ray_box_hit!.distance - 1.0).absolutum() ≤ 0.0001) et ray_box_hit!.normal.x ≡ (-1.0 ∷ f32)) et (ray_box_hit!.point.x - 1.0).absolutum() ≤ 0.0001, "ray box hit records entry point and outward face normal"
    fixum triga.RayBox3Hit ray_box_hit_value ← triga.RayBox3Hit { distance = ray_box_hit!.distance, point = ray_box_hit!.point, normal = ray_box_hit!.normal }
    adfirma (ray_box_hit_value.hit_face_code() vel 0) ≡ 1, "ray box hit face code records negative x entry"
    adfirma ((ray_box_hit_value.hit_face_offset_x() vel 0) ≡ -1 et (ray_box_hit_value.hit_face_offset_y() vel 99) ≡ 0) et (ray_box_hit_value.hit_face_offset_z() vel 99) ≡ 0, "ray box hit face offset records negative x placement direction"
    fixum numerus ray_face_code ← ray_box_hit_value.hit_face_code() vel 0
    fixum numerus generic_ray_x_offset ← triga.face_code_x_offset(ray_face_code) vel 0
    adfirma generic_ray_x_offset ≡ (ray_box_hit_value.hit_face_offset_x() vel 0), "ray box face code agrees with generic face-code offset"
    fixum triga.Vector3 ∪ nihil generic_ray_normal ← triga.face_code_normal(ray_face_code)
    adfirma ((generic_ray_normal non est nihil et generic_ray_normal!.x ≡ ray_box_hit_value.normal.x) et generic_ray_normal!.y ≡ ray_box_hit_value.normal.y) et generic_ray_normal!.z ≡ ray_box_hit_value.normal.z, "ray box face code agrees with generic face-code normal"
    adfirma (triga.face_code_axis_code(ray_face_code) vel 0) ≡ 1, "generic face-code axis records x-axis faces"
    adfirma (triga.face_code_opposite(ray_face_code) vel 0) ≡ 2, "generic face-code opposite records paired x-axis faces"
    fixum triga.FaceCodeFacts ∪ nihil ray_face_facts ← triga.face_code_facts(ray_face_code)
    adfirma ray_face_facts non est nihil, "face code facts package validated face metadata"
    adfirma (ray_face_facts!.code ≡ 1 et ray_face_facts!.axis_code ≡ 1) et ray_face_facts!.opposite_code ≡ 2, "face code facts preserve code, axis, and opposite metadata"
    adfirma (ray_face_facts!.x_offset ≡ -1 et ray_face_facts!.y_offset ≡ 0) et ray_face_facts!.z_offset ≡ 0, "face code facts preserve edit offsets"
    adfirma ((ray_face_facts!.normal.x ≡ (-1.0 ∷ f32) et ray_face_facts!.normal.y ≡ (0.0 ∷ f32)) et ray_face_facts!.normal.z ≡ (0.0 ∷ f32)) et ray_face_facts!.color.r > 0.7, "face code facts preserve normal and color"
    fixum triga.FaceCodeFacts ∪ nihil ray_hit_face_facts ← ray_box_hit_value.hit_face_facts()
    adfirma ray_hit_face_facts non est nihil, "ray box hit face facts package selection face metadata"
    adfirma (ray_hit_face_facts!.code ≡ ray_face_facts!.code et ray_hit_face_facts!.x_offset ≡ ray_face_facts!.x_offset) et ray_hit_face_facts!.normal.x ≡ ray_box_hit_value.normal.x, "ray box hit face facts agree with ray hit normal and offsets"
    fixum triga.Ray negative_ray ← triga.Ray { origin = triga.vector3(5.0, 0.0, 0.0), direction = triga.vector3(-1.0 ∷ f32, 0.0, 0.0) }
    fixum triga.RayBox3Hit ∪ nihil negative_hit ← negative_ray.box3_hit(shifted_bounds, 6.0)
    adfirma negative_hit non est nihil et negative_hit!.normal.x ≡ (1.0 ∷ f32), "ray box hit records positive face normals"
    fixum triga.RayBox3Hit negative_hit_value ← triga.RayBox3Hit { distance = negative_hit!.distance, point = negative_hit!.point, normal = negative_hit!.normal }
    adfirma (negative_hit_value.hit_face_code() vel 0) ≡ 2, "ray box hit face code records positive x entry"
    adfirma ((negative_hit_value.hit_face_offset_x() vel 0) ≡ 1 et (negative_hit_value.hit_face_offset_y() vel 99) ≡ 0) et (negative_hit_value.hit_face_offset_z() vel 99) ≡ 0, "ray box hit face offset records positive x placement direction"
    fixum numerus ∪ nihil generic_positive_x_offset ← triga.face_code_x_offset(2)
    adfirma (generic_positive_x_offset vel 0) ≡ 1, "generic face-code offset records positive x placement direction"
    adfirma triga.face_code_x_offset(0) est nihil, "generic face-code offset rejects invalid face codes"
    fixum triga.Ray y_ray ← triga.Ray { origin = triga.vector3(2.0, -3.0 ∷ f32, 0.0), direction = triga.vector3(0.0, 1.0, 0.0) }
    fixum triga.RayBox3Hit ∪ nihil y_hit ← y_ray.box3_hit(shifted_bounds, 6.0)
    adfirma y_hit non est nihil, "ray box hit records y-axis entry"
    fixum triga.RayBox3Hit y_hit_value ← triga.RayBox3Hit { distance = y_hit!.distance, point = y_hit!.point, normal = y_hit!.normal }
    adfirma (y_hit_value.hit_face_code() vel 0) ≡ 3 et (y_hit_value.hit_face_offset_y() vel 0) ≡ -1, "ray box hit face offset records negative y placement direction"
    adfirma (triga.face_code_axis_code(3) vel 0) ≡ 2 et (triga.face_code_opposite(3) vel 0) ≡ 4, "generic face-code metadata records y-axis pairs"
    adfirma (triga.face_code_axis_code(5) vel 0) ≡ 3 et (triga.face_code_opposite(5) vel 0) ≡ 6, "generic face-code metadata records z-axis pairs"
    fixum triga.Vector3 ∪ nihil generic_y_normal ← triga.face_code_normal(3)
    fixum triga.Vector3 ∪ nihil generic_z_normal ← triga.face_code_normal(6)
    adfirma (((generic_y_normal non est nihil et generic_y_normal!.y ≡ (-1.0 ∷ f32)) et generic_y_normal!.x ≡ (0.0 ∷ f32)) et generic_z_normal non est nihil) et generic_z_normal!.z ≡ (1.0 ∷ f32), "generic face-code normals record y and z axis directions"
    adfirma triga.face_code_axis_code(0) est nihil et triga.face_code_opposite(0) est nihil, "generic face-code metadata rejects invalid face codes"
    adfirma triga.face_code_normal(0) est nihil, "generic face-code normal rejects invalid face codes"
    adfirma triga.face_code_facts(0) est nihil, "face code facts reject invalid face codes"
    fixum triga.FaceQuad ∪ nihil negative_x_quad_result ← triga.face_code_unit_quad(1, 10.0, 20.0, 30.0, 2.0)
    adfirma negative_x_quad_result non est nihil, "face-code unit quad accepts valid negative x face"
    fixum triga.FaceQuad negative_x_quad ← triga.FaceQuad { a = negative_x_quad_result!.a, b = negative_x_quad_result!.b, c = negative_x_quad_result!.c, d = negative_x_quad_result!.d }
    adfirma ((negative_x_quad.a.x ≡ (10.0 ∷ f32) et negative_x_quad.b.z ≡ (32.0 ∷ f32)) et negative_x_quad.c.y ≡ (22.0 ∷ f32)) et negative_x_quad.d.z ≡ (30.0 ∷ f32), "face-code unit quad locks negative x corner coordinates"
    fixum triga.Vector3 negative_x_edge_ab ← negative_x_quad.b.subtracta(negative_x_quad.a)
    fixum triga.Vector3 negative_x_edge_ac ← negative_x_quad.c.subtracta(negative_x_quad.a)
    fixum triga.Vector3 negative_x_winding_normal ← negative_x_edge_ab.transversum(negative_x_edge_ac).normata()
    fixum triga.Vector3 ∪ nihil expected_negative_x_normal ← triga.face_code_normal(1)
    adfirma ((expected_negative_x_normal non est nihil et negative_x_winding_normal.x ≡ expected_negative_x_normal!.x) et negative_x_winding_normal.y ≡ expected_negative_x_normal!.y) et negative_x_winding_normal.z ≡ expected_negative_x_normal!.z, "face-code unit quad winding matches negative x face normal"
    fixum triga.FaceQuad ∪ nihil positive_z_quad_result ← triga.face_code_unit_quad(6, 0.0, 0.0, 0.0, 1.0)
    adfirma positive_z_quad_result non est nihil, "face-code unit quad accepts valid positive z face"
    fixum triga.FaceQuad positive_z_quad ← triga.FaceQuad { a = positive_z_quad_result!.a, b = positive_z_quad_result!.b, c = positive_z_quad_result!.c, d = positive_z_quad_result!.d }
    fixum triga.Vector3 positive_z_edge_ab ← positive_z_quad.b.subtracta(positive_z_quad.a)
    fixum triga.Vector3 positive_z_edge_ac ← positive_z_quad.c.subtracta(positive_z_quad.a)
    fixum triga.Vector3 positive_z_winding_normal ← positive_z_edge_ab.transversum(positive_z_edge_ac).normata()
    fixum triga.Vector3 ∪ nihil expected_positive_z_normal ← triga.face_code_normal(6)
    adfirma ((expected_positive_z_normal non est nihil et positive_z_winding_normal.x ≡ expected_positive_z_normal!.x) et positive_z_winding_normal.y ≡ expected_positive_z_normal!.y) et positive_z_winding_normal.z ≡ expected_positive_z_normal!.z, "face-code unit quad winding matches positive z face normal"
    fixum triga.Ray z_ray ← triga.Ray { origin = triga.vector3(2.0, 0.0, 3.0), direction = triga.vector3(0.0, 0.0, -1.0 ∷ f32) }
    fixum triga.RayBox3Hit ∪ nihil z_hit ← z_ray.box3_hit(shifted_bounds, 6.0)
    adfirma z_hit non est nihil, "ray box hit records z-axis entry"
    fixum triga.RayBox3Hit z_hit_value ← triga.RayBox3Hit { distance = z_hit!.distance, point = z_hit!.point, normal = z_hit!.normal }
    adfirma (z_hit_value.hit_face_code() vel 0) ≡ 6 et (z_hit_value.hit_face_offset_z() vel 0) ≡ 1, "ray box hit face offset records positive z placement direction"
    fixum numerus ∪ nihil generic_positive_z_offset ← triga.face_code_z_offset(6)
    adfirma (generic_positive_z_offset vel 0) ≡ 1, "generic face-code offset records positive z placement direction"
    fixum triga.RayBox3Hit y_positive_face ← triga.RayBox3Hit { distance = 1.0, point = triga.vector3(0.0, 0.0, 0.0), normal = triga.vector3(0.0, 1.0, 0.0) }
    adfirma (y_positive_face.hit_face_code() vel 0) ≡ 4 et (y_positive_face.hit_face_offset_y() vel 0) ≡ 1, "ray box hit face offset records positive y placement direction"
    fixum numerus ∪ nihil generic_positive_y_offset ← triga.face_code_y_offset(4)
    adfirma (generic_positive_y_offset vel 0) ≡ 1, "generic face-code offset records positive y placement direction"
    fixum triga.RayBox3Hit z_negative_face ← triga.RayBox3Hit { distance = 1.0, point = triga.vector3(0.0, 0.0, 0.0), normal = triga.vector3(0.0, 0.0, -1.0 ∷ f32) }
    adfirma (z_negative_face.hit_face_code() vel 0) ≡ 5 et (z_negative_face.hit_face_offset_z() vel 0) ≡ -1, "ray box hit face offset records negative z placement direction"
    fixum triga.Ray inside_ray ← triga.Ray { origin = triga.vector3(2.0, 0.0, 0.0), direction = triga.vector3(1.0, 0.0, 0.0) }
    fixum triga.RayBox3Hit ∪ nihil inside_hit ← inside_ray.box3_hit(shifted_bounds, 6.0)
    adfirma (inside_hit non est nihil et inside_hit!.distance ≡ (0.0 ∷ f32)) et inside_hit!.normal.x ≡ (0.0 ∷ f32), "inside ray box hit uses zero distance and no entry normal"
    fixum triga.RayBox3Hit inside_hit_value ← triga.RayBox3Hit { distance = inside_hit!.distance, point = inside_hit!.point, normal = inside_hit!.normal }
    adfirma inside_hit_value.hit_face_code() est nihil, "inside ray box hit has no entry face code"
    adfirma (inside_hit_value.hit_face_offset_x() est nihil et inside_hit_value.hit_face_offset_y() est nihil) et inside_hit_value.hit_face_offset_z() est nihil, "inside ray box hit has no edit placement offset"
    adfirma inside_hit_value.hit_face_facts() est nihil, "inside ray box hit does not invent face facts"
    fixum _ ray_miss ← ray.intersecat_capsam(shifted_bounds, 0.5)
    adfirma ray_miss est nihil, "ray rejects hits beyond maximum distance"
    adfirma ray.box3_hit(shifted_bounds, 0.5) est nihil, "ray box hit rejects hits beyond maximum distance"
    adfirma ray.box3_hit(invalid_bounds, 6.0) est nihil, "ray box hit rejects invalid boxes"
    fixum triga.Ray parallel_miss ← triga.Ray { origin = triga.vector3(0.0, 2.0, 0.0), direction = triga.vector3(1.0, 0.0, 0.0) }
    adfirma parallel_miss.intersecat_capsam(shifted_bounds, 6.0) est nihil, "parallel ray outside slab misses"
    fixum triga.Vector3 forward_direction ← triga.camera_directio_ex_yaw_pitch(0.0, 0.0)
    adfirma (forward_direction.x.absolutum() ≤ 0.0001 et forward_direction.y.absolutum() ≤ 0.0001) et (forward_direction.z + 1.0).absolutum() ≤ 0.0001, "camera yaw zero looks down negative z"
    fixum triga.Vector3 right_direction ← triga.camera_directio_ex_yaw_pitch(90.0, 0.0)
    adfirma (right_direction.x - 1.0).absolutum() ≤ 0.0001 et right_direction.z.absolutum() ≤ 0.0001, "camera positive yaw turns toward positive x"
    fixum triga.Vector3 clamped_pitch_direction ← triga.camera_directio_ex_yaw_pitch(0.0, 100.0)
    adfirma clamped_pitch_direction.y > 0.99 et clamped_pitch_direction.y < 1.0, "camera pitch clamps below vertical"
    fixum triga.Ray camera_ray ← triga.camera_ray_ex_yaw_pitch(triga.vector3(2.0, 3.0, 4.0), 0.0, 0.0)
    adfirma camera_ray.origin.y ≡ (3.0 ∷ f32) et (camera_ray.direction.z + 1.0).absolutum() ≤ 0.0001, "camera ray preserves origin and yaw-pitch direction"
    fixum triga.CameraYawPitchFacts camera_facts ← triga.camera_yaw_pitch_facts(triga.vector3(2.0, 3.0, 4.0), 90.0, 100.0)
    adfirma (camera_facts.yaw_degrees ≡ (90.0 ∷ f32) et camera_facts.pitch_degrees ≡ (100.0 ∷ f32)) et camera_facts.clamped_pitch_degrees ≡ (89.0 ∷ f32), "camera yaw-pitch facts preserve input yaw and expose clamped pitch"
    adfirma (camera_facts.direction.y > 0.99 et camera_facts.direction.x > 0.01) et camera_facts.direction.z.absolutum() ≤ 0.0001, "camera yaw-pitch facts expose clamped view direction"
    adfirma (camera_facts.planar_forward.x > 0.99 et camera_facts.planar_forward.z.absolutum() ≤ 0.0001) et camera_facts.planar_right.z > 0.99, "camera yaw-pitch facts expose yaw-derived planar basis"
    adfirma ((camera_facts.ray.origin.x ≡ (2.0 ∷ f32) et camera_facts.ray.origin.y ≡ (3.0 ∷ f32)) et camera_facts.ray.origin.z ≡ (4.0 ∷ f32)) et camera_facts.ray.direction.y ≡ camera_facts.direction.y, "camera yaw-pitch facts expose a matching camera ray"
    fixum triga.Vector3 forward_motion ← triga.camera_motus_planus_ex_yaw(0.0, 1.0, 0.0, 4.0, 0.5)
    adfirma (forward_motion.x.absolutum() ≤ 0.0001 et forward_motion.y.absolutum() ≤ 0.0001) et (forward_motion.z + 2.0).absolutum() ≤ 0.0001, "camera planar motion applies speed and frame time"
    fixum triga.Vector3 diagonal_motion ← triga.camera_motus_planus_ex_yaw(0.0, 1.0, 1.0, 1.0, 1.0)
    adfirma (diagonal_motion.longitudo() - 1.0).absolutum() ≤ 0.0001, "camera planar motion normalizes diagonal input"
    fixum triga.Vector3 yawed_motion ← triga.camera_motus_planus_ex_yaw(90.0, 1.0, 0.0, 3.0, 1.0)
    adfirma (yawed_motion.x - 3.0).absolutum() ≤ 0.0001 et yawed_motion.z.absolutum() ≤ 0.0001, "camera planar motion follows yaw"
    fixum triga.Vector3 stopped_motion ← triga.camera_motus_planus_ex_yaw(0.0, 1.0, 0.0, 4.0, 0.0)
    adfirma stopped_motion.longitudo() ≡ (0.0 ∷ f32), "camera planar motion rejects zero frame time"

    fixum triga.Color midpoint_color ← triga.color_interpolata(triga.Color { r = 0.0, g = 0.0, b = 0.0 }, triga.Color { r = 1.0, g = 0.5, b = 0.25 }, 0.5)
    adfirma midpoint_color.r ≡ (0.5 ∷ f32), "color interpolation"
    adfirma scale.determinans_affinis() ≡ (24.0 ∷ f32), "affine determinant"
    fixum triga.Matrix4 transposed_translation ← translation.transposita()
    adfirma (transposed_translation.elements)[3] ≡ (5.0 ∷ f32), "matrix transpose x"
}
