+++
term = "triga-box3-genus-spike"
kind = "concept"
category = "library"
canonical = true
summary = "Box free functions — cross-import construction and overlap probes."
syntax = "importa ex \"triga:triga\" privata triga"
+++
# exempla/triga-box3-genus-spike — Phase 0 spike for API shape rework.
#
# Box operations are free functions over Box<N> (generic receivers do not
# specialize). The z-separation cases remain the overlap oracle.

import from "triga:math" math

main {
    const math.Box<3> bounds ← math.Box<3> {minima = [0.0, 0.0, 0.0] ↦ vector<f32, 3>, maxima = [2.0, 2.0, 2.0] ↦ vector<f32, 3>}

    const math.Box<3> overlap_box ← math.Box<3> {minima = [1.0, 1.0, 1.0] ↦ vector<f32, 3>, maxima = [3.0, 3.0, 3.0] ↦ vector<f32, 3>}

    const math.Box<3> expanded ← math.box_inflated(bounds, 1.0)

    var math.Box<3> mutable_bounds ← math.Box<3> {minima = [0.0, 0.0, 0.0] ↦ vector<f32, 3>, maxima = [1.0, 1.0, 1.0] ↦ vector<f32, 3>}
    mutable_bounds ← math.box_inflated(mutable_bounds, 2.0)

    # --- z-separation runtime probe (the dee26f5 fix coverage) --
    #   1. sep_corrected vs small — z-separated via the CORRECTED second
    #      disjunct (self.minima z 3 > other.maxima z 1) -> false.
    #   2. bounds vs sep_corrected — z-separated via the first disjunct
    #      (self.maxima z 2 < other.minima z 3) -> false.
    #   3. bounds vs overlap_box — overlapping on every axis -> true.
    #   4. bug_discriminator vs bug_low — z OVERLAPS while a y/z typo
    #      would false-positive -> true.
    const math.Box<3> sep_corrected ← math.Box<3> {minima = [0.0, 0.0, 3.0] ↦ vector<f32, 3>, maxima = [2.0, 2.0, 5.0] ↦ vector<f32, 3>}
    const math.Box<3> small ← math.Box<3> {minima = [0.0, 0.0, 0.0] ↦ vector<f32, 3>, maxima = [1.0, 1.0, 1.0] ↦ vector<f32, 3>}
    const math.Box<3> bug_low ← math.Box<3> {minima = [0.0, 0.0, 0.0] ↦ vector<f32, 3>, maxima = [1.0, 4.0, 1.0] ↦ vector<f32, 3>}
    const math.Box<3> bug_discriminator ← math.Box<3> {minima = [0.0, 3.0, 0.0] ↦ vector<f32, 3>, maxima = [2.0, 5.0, 4.0] ↦ vector<f32, 3>}

    print math.box_intersects(sep_corrected, small)
    print math.box_intersects(bounds, sep_corrected)
    print math.box_intersects(bounds, overlap_box)
    print math.box_intersects(bug_discriminator, bug_low)
    print expanded
}
