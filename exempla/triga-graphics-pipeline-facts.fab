+++
term = "triga-graphics-pipeline-facts"
kind = "concept"
category = "library"
canonical = true
summary = "Triga-side facts for the locked graphics pipeline contract: shader stages, color target, depth, topology, and vertex inputs."
+++

import from "triga:math" math

import from "triga:material/base" base

import from "triga:material/basic" basic

main {
    # Shader stage codes
    let int shader_stage_compute ← 0
    let int shader_stage_vertex ← 1
    let int shader_stage_fragment ← 2
    print shader_stage_fragment

    # Primitive topology codes
    let int topology_triangle_list ← 1
    let int topology_line_list ← 2
    let int topology_point_list ← 3
    print topology_triangle_list

    # Vertex format codes
    let int vertex_format_float32x3 ← 3
    print vertex_format_float32x3

    # Step mode codes
    let int step_mode_vertex ← 1
    let int step_mode_instance ← 2
    print step_mode_vertex

    # Color target format codes (canonical radix table: 1 = bgra8unorm, 2 = bgra8unorm-srgb; no rgba8unorm code)
    let int color_target_bgra8_unorm ← 1
    let int color_target_bgra8_unorm_srgb ← 2
    print color_target_bgra8_unorm

    # Depth compare codes (canonical radix table: 0 = no depth attachment sentinel, not a compare function; 1-7 = less..always)
    let int depth_attachment_none ← 0
    let int depth_compare_less ← 1
    let int depth_compare_always ← 7
    print depth_compare_less

    # Goal 01 material
    let goal_color ← math.Color {r = 1.0, g = 0.2, b = 0.2}
    let basic.UnlitMaterial ∪ none goal_material_result ← basic.basic_material("goal-material", goal_color)
    let goal_material ← basic.UnlitMaterial {base = goal_material_result!.base, color = goal_material_result!.color}
    let base.MaterialPipelineFacts ∪ none goal_pipeline_result ← goal_material.pipeline_facts()
    let goal_pipeline ← base.MaterialPipelineFacts {side_code = goal_pipeline_result!.side_code, depth_test_enabled = goal_pipeline_result!.depth_test_enabled, depth_write_enabled = goal_pipeline_result!.depth_write_enabled, transparent = goal_pipeline_result!.transparent, alpha = goal_pipeline_result!.alpha, alpha_test = goal_pipeline_result!.alpha_test}
    print goal_pipeline.depth_test_enabled
    print goal_pipeline.transparent
    print goal_pipeline.side_code
}
