+++
term = "triga-graphics-pipeline-facts"
kind = "concept"
category = "library"
canonical = true
summary = "Triga-side facts for the locked graphics pipeline contract: shader stages, color target, depth, topology, and vertex inputs."
+++

import from "triga:math" private math

import from "triga:material/base" private base

import from "triga:material/basic" private basic

main {
    # Shader stage codes
    const int shader_stage_compute ← 0
    const int shader_stage_vertex ← 1
    const int shader_stage_fragment ← 2
    print shader_stage_fragment

    # Primitive topology codes
    const int topology_triangle_list ← 1
    const int topology_line_list ← 2
    const int topology_point_list ← 3
    print topology_triangle_list

    # Vertex format codes
    const int vertex_format_float32x3 ← 3
    print vertex_format_float32x3

    # Step mode codes
    const int step_mode_vertex ← 1
    const int step_mode_instance ← 2
    print step_mode_vertex

    # Color target format codes (canonical radix table: 1 = bgra8unorm, 2 = bgra8unorm-srgb; no rgba8unorm code)
    const int color_target_bgra8_unorm ← 1
    const int color_target_bgra8_unorm_srgb ← 2
    print color_target_bgra8_unorm

    # Depth compare codes (canonical radix table: 0 = no depth attachment sentinel, not a compare function; 1-7 = less..always)
    const int depth_attachment_none ← 0
    const int depth_compare_less ← 1
    const int depth_compare_always ← 7
    print depth_compare_less

    # Goal 01 material
    const math.Color goal_color ← math.Color {r = 1.0, g = 0.2, b = 0.2}
    const basic.MeshBasicMaterial ∪ null goal_material_result ← basic.mesh_basic_material("goal-material", goal_color)
    const basic.MeshBasicMaterial goal_material ← basic.MeshBasicMaterial {base = goal_material_result!.base, color = goal_material_result!.color}
    const base.MaterialPipelineFacts ∪ null goal_pipeline_result ← basic.mesh_basic_material_pipeline_facts(goal_material)
    const base.MaterialPipelineFacts goal_pipeline ← base.MaterialPipelineFacts {side_code = goal_pipeline_result!.side_code, depth_test_enabled = goal_pipeline_result!.depth_test_enabled, depth_write_enabled = goal_pipeline_result!.depth_write_enabled, transparent = goal_pipeline_result!.transparent, alpha = goal_pipeline_result!.alpha, alpha_test = goal_pipeline_result!.alpha_test}
    print goal_pipeline.depth_test_enabled
    print goal_pipeline.transparent
    print goal_pipeline.side_code
}
