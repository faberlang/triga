+++
term = "triga-scene-store"
kind = "concept"
category = "library"
canonical = true
summary = "Stable heterogeneous Triga scene store: insertion, visibility, and traversal."
+++
import from "triga:scene" scene

import from "triga:math" math

import from "triga:resource" resource

main {
    # Resource handles
    let geom_handle ← resource.ResourceHandle {index = 7, generation = 2}
    let mat_handle ← resource.ResourceHandle {index = 3, generation = 1}

    # Resource transitions
    let resource.ResourceTransition stable ← geom_handle.transition_unchanged()
    let resource.ResourceTransition replaced ← mat_handle.transition_replaced()

    # Scene construction and insertion (Imperativus — requires varia)
    mut scene.SceneStore store ← scene.scene_store()
    let scene.SceneNode mesh_node ← scene.scene_mesh("cube", geom_handle, mat_handle)
    let scene.SceneHandle mesh_handle ← store.insert(mesh_node)

    # Hierarchy: insert a child mesh
    let scene.SceneNode child_node ← scene.scene_mesh("child", geom_handle, mat_handle)
    let scene.SceneHandle child_handle ← store.insert(child_node)

    # Visible-meshes query (single traversal, multiple accessors)
    let scene.VisibleMeshes ∪ none visibilia ← scene.visible_meshes(store, mesh_handle, math.matrix_identity())
    print visibilia

    # SceneNode mesh accessors
    let scene.SceneNode ∪ none fetched ← store.take(mesh_handle)
}
