+++
term = "triga-scene-store"
kind = "concept"
category = "library"
canonical = true
summary = "Stable heterogeneous Triga scene store: insertion, attachment, visibility, and traversal."
+++
importa ex "triga:scene" privata scene
importa ex "triga:math" privata math
importa ex "triga:scene/resource" privata resource

incipit {
    # Resource handles
    fixum resource.ResourceHandle geom_handle ← resource.ResourceHandle { index = 7, generation = 2 }
    fixum resource.ResourceHandle mat_handle ← resource.ResourceHandle { index = 3, generation = 1 }

    # Resource transitions
    fixum resource.ResourceTransition stable ← resource.resource_transition_unchanged(geom_handle)
    fixum resource.ResourceTransition replaced ← resource.resource_transition_replaced(mat_handle)

    # Scene construction and insertion (Imperativus — requires varia)
    varia scene.SceneStore store ← scene.scene_store()
    fixum scene.SceneNode mesh_node ← scene.scene_mesh("cube", geom_handle, mat_handle)
    fixum scene.SceneHandle mesh_handle ← store.insere(mesh_node)

    # Hierarchy: attach a child mesh
    fixum scene.SceneNode child_node ← scene.scene_mesh("child", geom_handle, mat_handle)
    fixum scene.SceneHandle child_handle ← store.insere(child_node)

    # Visibility and world matrix

    # Name lookup

    # Traversal

    # Visibilia query (single traversal, multiple accessors)
    fixum scene.VisibiliaRetium ∪ nihil visibilia ← scene.visibilia(store, mesh_handle, math.matrix4_identitas())
    nota visibilia

    # Removal

    # SceneNode mesh accessors
    fixum scene.SceneNode ∪ nihil fetched ← store.cape(mesh_handle)
}
