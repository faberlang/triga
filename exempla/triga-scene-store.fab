+++
term = "triga-scene-store"
kind = "concept"
category = "library"
canonical = true
summary = "Stable heterogeneous Triga scene store: insertion, visibility, and traversal."
+++
import from "triga:scene" scene

import from "triga:math" math

import from "triga:resource" resource

main {
    # Resource handles
    const _ geom_handle ← resource.ResourceHandle {index = 7, generation = 2}
    const _ mat_handle ← resource.ResourceHandle {index = 3, generation = 1}

    # Resource transitions
    const resource.ResourceTransition stable ← geom_handle.transition_unchanged()
    const resource.ResourceTransition replaced ← mat_handle.transition_replaced()

    # Scene construction and insertion (Imperativus — requires varia)
    var scene.SceneStore store ← scene.scene_store()
    const scene.SceneNode mesh_node ← scene.scene_mesh("cube", geom_handle, mat_handle)
    const scene.SceneHandle mesh_handle ← store.insere(mesh_node)

    # Hierarchy: insert a child mesh
    const scene.SceneNode child_node ← scene.scene_mesh("child", geom_handle, mat_handle)
    const scene.SceneHandle child_handle ← store.insere(child_node)

    # Visibilia query (single traversal, multiple accessors)
    const scene.VisibiliaRetium ∪ null visibilia ← scene.visibilia(store, mesh_handle, math.matrix4_identitas())
    print visibilia

    # SceneNode mesh accessors
    const scene.SceneNode ∪ null fetched ← store.cape(mesh_handle)
}
