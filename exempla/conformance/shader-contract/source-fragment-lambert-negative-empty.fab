# Conformance:
# triga_stage4_source_fragment_lambert_negative_empty_body_has_no_lambert_math
# (moved from radix U4).
#
# Negative assertion: an empty @fragment body with the same contract facts
# emits the default output and no Lambert machinery:
#   * NOT `light_direction`
#   * NOT `max(`
#   * NOT `lit_color`

importa ex "triga:geometry/data" privata data
importa ex "triga:primitives/basic" privata basic

@ shader_contract "vertex_layout"
functio vertex_layout_matches(
    numerus geo,
    numerus index,
    textus source_name,
    numerus shader_location,
    numerus format_code,
    numerus offset_bytes,
    numerus stride_bytes,
    numerus step_mode_code
) → bivalens {
    redde verum
}

@ shader_contract "varying"
functio varying_matches(
    textus source_name,
    numerus shader_location,
    numerus format_code,
    numerus interpolation_code
) → bivalens {
    redde verum
}

@ shader_contract "fragment_output"
functio fragment_output_matches(
    numerus location,
    numerus format_code
) → bivalens {
    redde verum
}

@ fragment
functio hello_voxel_fragment() → vacuum {
}

incipit {
    fixum data.BufferGeometry ∪ nihil plane ← basic.plane_geometry(2.0, 2.0)
    adfirma plane non est nihil secus
        "conformance requires valid plane geometry"
    adfirma vertex_layout_matches(0, 0, "normal", 0, 3, 0, 12, 1) secus
        "normal input layout"
    adfirma vertex_layout_matches(0, 1, "color", 1, 3, 0, 12, 1) secus
        "color input layout"
    adfirma varying_matches("normal", 0, 3, 1) secus
        "normal varying"
    adfirma varying_matches("color", 1, 3, 1) secus
        "color varying"
    adfirma fragment_output_matches(0, 4) secus
        "fragment output location 0: vec4<f32>"
}
