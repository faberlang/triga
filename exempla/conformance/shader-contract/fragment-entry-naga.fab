# Conformance: triga_stage4_fragment_entry_validates_with_naga (moved from
# radix U4). Identical facts to source-fragment-emits-wgsl; the harness
# additionally validates the emitted WGSL with `naga`.

import from "triga:geometry/data" private data

import from "triga:primitives/basic" private basic

@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "varying"
fn varying_matches(string source_name, int shader_location, int format_code, int interpolation_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "fragment_output"
fn fragment_output_matches(int location, int format_code, int stage_io_role_code) → bool {
    return true
}

@ fragment { }
fn hello_voxel_fragment() → void {
}

main {
    const data.BufferGeometry ∪ null plane ← basic.plane_geometry(2.0, 2.0)
    assert plane not is null secus "conformance requires valid plane geometry"
    assert vertex_layout_matches(0, 0, "normal", 0, 3, 0, 12, 1, 4) secus "normal input layout (stage-io role: other)"
    assert vertex_layout_matches(0, 1, "uv", 1, 2, 0, 8, 1, 4) secus "uv input layout (stage-io role: other)"
    assert varying_matches("normal", 0, 3, 1, 4) secus "varying fact location 0: vec3<f32> normal (stage-io role: other)"
    assert varying_matches("uv", 1, 2, 1, 4) secus "varying fact location 1: vec2<f32> uv (stage-io role: other)"
    assert fragment_output_matches(0, 4, 2) secus "fragment output location 0: vec4<f32> (stage-io role: color)"
}
