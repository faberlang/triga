# Conformance: triga_stage4_vertex_body_validates_with_naga (moved from radix
# U4). Identical facts to vertex-body-emits-wgsl; the harness additionally
# validates the emitted WGSL with `naga`.

import from "triga:geometry/data" private data

import from "triga:primitives/basic" private basic

@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

@ vertex { }
fn hello_voxel_vertex() → void {
    out_position ← position
}

main {
    const data.BufferGeometry ∪ null plane ← basic.plane_geometry(2.0, 2.0)
    assert plane not is null secus "conformance requires valid plane geometry"
    assert vertex_layout_matches(0, 0, "position", 0, 3, 0, 12, 1, 1) secus "position input layout (stage-io role: position)"
    assert vertex_layout_matches(0, 1, "color", 1, 3, 12, 12, 1, 2) secus "color input layout (stage-io role: color)"
}
