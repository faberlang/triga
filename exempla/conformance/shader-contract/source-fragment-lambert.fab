+++
term = "shader-contract-source-fragment-lambert"
kind = "concept"
category = "library"
canonical = true
summary = "U5 conformance (moved from radix U4): authored Lambert @fragment body emits via the generic shader-contract surface."
+++
# Conformance: triga_stage4_source_fragment_lambert_emits_authored_math
# (moved from radix U4).
#
# Expected WGSL (harness-asserted):
#   * var light_direction: vec3<f32>; + assignment
#   * input.normal.x * light_direction.x
#   * max(
#   * input.color.x * lighting_vec.x
#   * out.color = vec4<f32>(lit_color.x, lit_color.y, lit_color.z, ...)
#   * naga-valid

importa ex "triga:geometry/data" privata data
importa ex "triga:primitives/basic" privata basic

@ shader_contract "vertex_layout"
functio vertex_layout_matches(
    numerus geo,
    numerus index,
    textus source_name,
    numerus shader_location,
    numerus format_code,
    numerus offset_bytes,
    numerus stride_bytes,
    numerus step_mode_code,
    numerus stage_io_role_code
) → bivalens {
    redde verum
}

@ shader_contract "varying"
functio varying_matches(
    textus source_name,
    numerus shader_location,
    numerus format_code,
    numerus interpolation_code,
    numerus stage_io_role_code
) → bivalens {
    redde verum
}

@ shader_contract "fragment_output"
functio fragment_output_matches(
    numerus location,
    numerus format_code,
    numerus stage_io_role_code
) → bivalens {
    redde verum
}

@ fragment
functio hello_voxel_fragment() → vacuum {
    fixum vf32[3] light_direction ← [0.0, 0.0, 1.0] ↦ vf32[3]
    fixum fractus<f32> diffuse ← normal.productum(light_direction).maximus(0.0)
    fixum fractus<f32> lighting ← 0.2 + 0.8 * diffuse
    fixum vf32[3] lighting_vec ← [lighting, lighting, lighting] ↦ vf32[3]
    fixum vf32[3] lit_color ← color.multiplica(lighting_vec)
    out_color ← lit_color
}

incipit {
    fixum data.BufferGeometry ∪ nihil plane ← basic.plane_geometry(2.0, 2.0)
    adfirma plane non est nihil secus
        "conformance requires valid plane geometry"
    adfirma vertex_layout_matches(0, 0, "normal", 0, 3, 0, 12, 1, 4) secus
        "normal input layout (stage-io role: other)"
    adfirma vertex_layout_matches(0, 1, "color", 1, 3, 0, 12, 1, 2) secus
        "color input layout (stage-io role: color)"
    adfirma varying_matches("normal", 0, 3, 1, 4) secus
        "normal varying (stage-io role: other)"
    adfirma varying_matches("color", 1, 3, 1, 2) secus
        "color varying (stage-io role: color)"
    adfirma fragment_output_matches(0, 4, 2) secus
        "fragment output location 0: vec4<f32> (stage-io role: color)"
}
