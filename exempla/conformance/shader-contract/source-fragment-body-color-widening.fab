# Conformance: triga_stage4_source_fragment_body_emits_authored_color_widening
# (moved from radix U4).
#
# Expected WGSL (harness-asserted):
#   * fragment input struct: normal vec3 at location 0, color vec3 at location 1
#   * authored color widening: out.color = vec4<f32>(input.color.x, input.color.y, input.color.z, ...)
#   * NOT the empty-body default (out.color = vec4<f32>(0.0, 0.0, 0.0, 1.0))
#   * naga-valid

import from "triga:geometry/data" data

import from "triga:primitives/basic" basic

@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "varying"
fn varying_matches(string source_name, int shader_location, int format_code, int interpolation_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "fragment_output"
fn fragment_output_matches(int location, int format_code, int stage_io_role_code) → bool {
    return true
}

@ fragment { }
fn hello_voxel_fragment() → void {
    out_color ← color
}

main {
    const data.BufferGeometry ∪ null plane ← basic.plane_geometry(2.0, 2.0)
    assert plane not is null panic "conformance requires valid plane geometry"
    assert vertex_layout_matches(0, 0, "normal", 0, 3, 0, 12, 1, 4) panic "normal input layout (stage-io role: other)"
    assert vertex_layout_matches(0, 1, "color", 1, 3, 0, 12, 1, 2) panic "color input layout (stage-io role: color)"
    assert varying_matches("normal", 0, 3, 1, 4) panic "normal varying (stage-io role: other)"
    assert varying_matches("color", 1, 3, 1, 2) panic "color varying (stage-io role: color)"
    assert fragment_output_matches(0, 4, 2) panic "fragment output location 0: vec4<f32> (stage-io role: color)"
}
