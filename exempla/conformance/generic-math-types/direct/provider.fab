+++
locale = "en"
+++

# S0-T1 direct-candidate provider: compiler-owned register carriers used
# directly, with dimension-neutral Triga operations and no Vector or Matrix
# alias layer. Box remains the Triga spatial genus over register vectors.
#
# At radix 9a78fb080 this surface checks green at source typecheck. Two
# probed gaps are deliberately absent here and recorded in
# docs/factory/generic-math-types/representation-decision.md: applied-generic
# nominal record construction (Box value construction does not parse) and
# size-parametric glyph matmul (glyph_static_shape_required).

@ public
class Box<size N> {
    vector<f32, N> minima
    vector<f32, N> maxima
}

@ public
fn add<size N>(vector<f32, N> a, vector<f32, N> b) → vector<f32, N> {
    return a.added(b)
}

@ public
fn dot<size N>(vector<f32, N> a, vector<f32, N> b) → f32 {
    return a.dot(b)
}

@ public
fn cross(vector<f32, 3> a, vector<f32, 3> b) → vector<f32, 3> {
    return a.cross(b)
}

@ public
fn lane(vector<f32, 3> a) → f32 {
    const vector<f32, 3> swapped ← a.swizzle("zyx")
    return swapped.dot(a)
}

@ public
fn multiply(matrix<f32, [3, 2]> a, matrix<f32, [2, 3]> b) → matrix<f32, [3, 3]> {
    return a · b
}

@ public
fn box_minima<size N>(Box<N> b) → vector<f32, N> {
    return b.minima
}

# Same-file use: construction at widths 2, 3, and 4 through the one
# conversion posture, generic calls substituting each width, outer products,
# and concrete-shape matrix multiplication.

fn same_file() → f32 {
    const vector<f32, 2> a2 ← [1.0, 2.0] ↦ vector<f32, 2>
    const vector<f32, 2> b2 ← [2.0, 4.0] ↦ vector<f32, 2>
    const vector<f32, 3> a3 ← [1.0, 2.0, 3.0] ↦ vector<f32, 3>
    const vector<f32, 3> b3 ← [2.0, 4.0, 6.0] ↦ vector<f32, 3>
    const vector<f32, 4> a4 ← [1.0, 2.0, 3.0, 4.0] ↦ vector<f32, 4>
    const vector<f32, 4> b4 ← [2.0, 4.0, 6.0, 8.0] ↦ vector<f32, 4>
    const vector<f32, 2> s2 ← add(a2, b2)
    const vector<f32, 3> s3 ← add(a3, b3)
    const vector<f32, 4> s4 ← add(a4, b4)
    const vector<f32, 3> x3 ← cross(a3, b3)
    const matrix<f32, [3, 2]> outer ← a3 ⊗ b2
    const matrix<f32, [2, 3]> inner ← b2 ⊗ a3
    const matrix<f32, [3, 3]> product ← outer · inner
    return ((s2.dot(b2) + s3.dot(b3)) + s4.dot(b4)) + (x3.dot(a3) + lane(a3))
}
