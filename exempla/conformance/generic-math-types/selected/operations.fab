locale = "en"
+++

# S0-T2 selected-operations proof for the DIRECT NATIVE representation
# (representation-decision.md §1): `vector<f32, N>` / `matrix<f32, [R, C]>`
# carriers with dimension-neutral Triga free operations; `Box<N>` stays a
# generic Triga nominal over the selected vector values.
#
# Every §2.4 operation-map row is proven here at its natural width, with the
# placement classification recorded per row. Rows whose dimension-neutral
# (parametric) form is blocked at the selection pin are proven at concrete
# width here; the runner's S0-T2 gap probes record the blocking diagnostic
# identities, and representation-decision.md §7 routes them as the proven
# compiler prerequisite. No row is TBD and no numbered compatibility
# spelling exists.
#
# Placement key: [I] compiler intrinsic · [F] dimension-neutral Triga free
# function · [R] surviving receiver on a Triga genus · [T] explicit
# type-invariant retirement.

# --- §2.4 Vector<N>: dimension-neutral rows ------------------------------
# [I] `.added` / `.subtract` / `.multiply` (elementwise) / `.dot` are
# compiler intrinsics; the free functions below are the Triga surface.

fn addita<size N>(vector<f32, N> a, vector<f32, N> b) → vector<f32, N> {
    return a.added(b)
}

fn subtracta<size N>(vector<f32, N> a, vector<f32, N> b) → vector<f32, N> {
    return a.subtract(b)
}

fn multiplicata<size N>(vector<f32, N> a, vector<f32, N> b) → vector<f32, N> {
    return a.multiply(b)
}

fn productum<size N>(vector<f32, N> a, vector<f32, N> b) → f32 {
    return a.dot(b)
}

# [F] length via the Babylonian root on the dot product — the same scalar
# helper shape the current `radix_f32` uses. The `.power` intrinsic is
# avoided because its emitted TypeScript prelude member is not strict-green
# at the pin (decision §7 N4).

fn radix_f32(f32 value) → f32 {
    if value ≤ 0.0 then return 0.0
    var f32 estimate ← value
    for range 0‥12 const iteration {
        estimate ← (estimate + value / estimate) * 0.5
    }
    return estimate
}

fn longitudo<size N>(vector<f32, N> v) → f32 {
    return radix_f32(v.dot(v))
}

fn distantia<size N>(vector<f32, N> a, vector<f32, N> b) → f32 {
    return longitudo(a.subtract(b))
}

# --- §2.4 Vector<3>: cross product and 3D camera/face/ray uses ----------

fn transversum(vector<f32, 3> a, vector<f32, 3> b) → vector<f32, 3> {
    return a.cross(b)
}

fn angulus_reductus(f32 angle) → f32 {
    var f32 reduced ← angle
    while reduced ≻ 3.14159265 {
        reduced ← reduced - 6.2831853
    }
    while reduced ≺ -3.14159265 {
        reduced ← reduced + 6.2831853
    }
    return reduced
}

fn sinus_f32(f32 angle) → f32 {
    const f32 x ← angulus_reductus(angle)
    const f32 x2 ← x * x
    const f32 x4 ← x2 * x2
    const f32 x6 ← x4 * x2
    const f32 x8 ← x6 * x2
    return x * ((((1.0 - x2 / 6.0) + x4 / 120.0) - x6 / 5040.0) + x8 / 362880.0)
}

fn cosinus_f32(f32 angle) → f32 {
    const f32 x ← angulus_reductus(angle)
    const f32 x2 ← x * x
    const f32 x4 ← x2 * x2
    const f32 x6 ← x4 * x2
    const f32 x8 ← x6 * x2
    return (((1.0 - x2 / 2.0) + x4 / 24.0) - x6 / 720.0) + x8 / 40320.0
}

# [F] concrete lane access at width 3 through basis-dot. Lane access for
# sizes 2/3/4 is proven in lanes_2 / lanes_3 / lanes_4 below; the parametric
# `v[i]` form is blocked at the pin (decision §7 N2).

fn lanes_2(vector<f32, 2> v) → f32 {
    const vector<f32, 2> e0 ← [1.0, 0.0] ↦ vector<f32, 2>
    const vector<f32, 2> e1 ← [0.0, 1.0] ↦ vector<f32, 2>
    return v.dot(e0) + v.dot(e1)
}

fn lanes_3(vector<f32, 3> v) → f32 {
    const vector<f32, 3> e0 ← [1.0, 0.0, 0.0] ↦ vector<f32, 3>
    const vector<f32, 3> e1 ← [0.0, 1.0, 0.0] ↦ vector<f32, 3>
    const vector<f32, 3> e2 ← [0.0, 0.0, 1.0] ↦ vector<f32, 3>
    return (v.dot(e0) + v.dot(e1)) + v.dot(e2)
}

fn lanes_4(vector<f32, 4> v) → f32 {
    const vector<f32, 4> e0 ← [1.0, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e1 ← [0.0, 1.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e2 ← [0.0, 0.0, 1.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e3 ← [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, 4>
    return ((v.dot(e0) + v.dot(e1)) + v.dot(e2)) + v.dot(e3)
}

# [F] uniform construction at concrete widths through a repeated-index
# swizzle: every lane becomes the seed's lane 0. The parametric uniform
# (and with it the parametric scalar scale) is blocked at the pin
# (decision §7 N1).

fn uniform_3(f32 value) → vector<f32, 3> {
    const vector<f32, 3> seed ← [value, 0.0, 0.0] ↦ vector<f32, 3>
    return seed.swizzle("xxx")
}

fn uniform_4(f32 value) → vector<f32, 4> {
    const vector<f32, 4> seed ← [value, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    return seed.swizzle("xxxx")
}

# [F] scalar scale, guarded normalization, interpolation, and projection
# proven at width 4 (elementwise multiply against the uniform). The width-3
# forms compose identically over uniform_3; one width proves the behavior.

fn scala(vector<f32, 4> v, f32 s) → vector<f32, 4> {
    return v.multiply(uniform_4(s))
}

fn normata(vector<f32, 4> v) → vector<f32, 4> {
    const f32 length ← longitudo(v)
    if length ≤ 0.000001 then return uniform_4(0.0)
    return v.multiply(uniform_4(1.0 / length))
}

fn interpolata(vector<f32, 4> a, vector<f32, 4> b, f32 ratio) → vector<f32, 4> {
    return a.added(b.subtract(a).multiply(uniform_4(ratio)))
}

fn projecta(vector<f32, 4> v, vector<f32, 4> axis) → vector<f32, 4> {
    const f32 denominator ← axis.dot(axis)
    if denominator ≤ 0.000001 then return uniform_4(0.0)
    return axis.multiply(uniform_4(v.dot(axis) / denominator))
}

# [F] camera direction at width 3 — the current camera helper shape over
# the selected carrier (concrete `.normalize` intrinsic).

fn camera_directio(f32 yaw_radians, f32 pitch_radians) → vector<f32, 3> {
    const f32 horizontal ← cosinus_f32(pitch_radians)
    const vector<f32, 3> directed ← [sinus_f32(yaw_radians) * horizontal, sinus_f32(pitch_radians), -(cosinus_f32(yaw_radians) * horizontal)] ↦ vector<f32, 3>
    return directed.normalize()
}

# [F] face normal at width 3 — literal lane construction, no nominal
# wrapper needed for the retired `.x/.y/.z` access.

fn face_normal(int code) → vector<f32, 3> ∪ null {
    if code ≡ 1 then return [-1.0, 0.0, 0.0] ↦ vector<f32, 3>
    if code ≡ 2 then return [1.0, 0.0, 0.0] ↦ vector<f32, 3>
    if code ≡ 3 then return [0.0, -1.0, 0.0] ↦ vector<f32, 3>
    if code ≡ 4 then return [0.0, 1.0, 0.0] ↦ vector<f32, 3>
    if code ≡ 5 then return [0.0, 0.0, -1.0] ↦ vector<f32, 3>
    if code ≡ 6 then return [0.0, 0.0, 1.0] ↦ vector<f32, 3>
    return null
}

# [F] one axis' ray-box slab at width 3 — the retired `axis_interval`
# shape with explicit lane reads.

fn axis_interval(f32 origin, f32 direction, f32 minimum, f32 maximum) → f32 ∪ null {
    if direction.abs() ≤ 0.000001 {
        if origin ≺ minimum or origin ≻ maximum then return null
        const f32 zero ← 0.0
        return zero
    }
    var f32 first ← (minimum - origin) / direction
    var f32 second ← (maximum - origin) / direction
    if first ≻ second {
        const f32 swap ← first
        first ← second
        second ← swap
    }
    return first
}

# --- §2.4 Matrix<R,C>: dimension-neutral rows ----------------------------
# [I] generic glyph matmul checks at source (S0-G7). Its rust emission
# stays the routed R4 residual; concrete `·` emits and compiles.

fn multiplicata_matrix<size R, size K, size C>(matrix<f32, [R, K]> a, matrix<f32, [K, C]> b) → matrix<f32, [R, C]> {
    return a · b
}

fn addita_matrix<size R, size C>(matrix<f32, [R, C]> a, matrix<f32, [R, C]> b) → matrix<f32, [R, C]> {
    return a.added(b)
}

fn subtracta_matrix<size R, size C>(matrix<f32, [R, C]> a, matrix<f32, [R, C]> b) → matrix<f32, [R, C]> {
    return a.subtract(b)
}

# [F] two-axis access: `for from m at [r, c]` iterates every cell with its
# coordinates (row-major order). Parametric at source.

fn cells_summa<size R, size C>(matrix<f32, [R, C]> m) → f32 {
    var f32 acc ← 0.0
    for from m at [r, c] const cell {
        acc ← acc + cell
    }
    return acc
}

# [F] matrix-vector application (compiler intrinsic `.apply` receiver).
# The parametric form rejects with matrix_applica_requires_literal_shape
# at the pin (decision §7 N3); [4, 4] is the owning width.

fn applica(matrix<f32, [4, 4]> m, vector<f32, 4> v) → vector<f32, 4> {
    return m.apply(v)
}

# [F] compile-time shape is the type: mismatched shapes reject in Faber
# analysis (negative/matrix-shape.fab); the proof here composes shaped
# operations end to end at [4, 4].

# --- §2.4 Matrix<4,4>: domain rows ---------------------------------------
# [F] construction from four column vectors via basis outer products: a
# matrix with columns c0..c3 is Σ cj ⊗ ej. Column-major by construction.

fn ex_columnis(vector<f32, 4> c0, vector<f32, 4> c1, vector<f32, 4> c2, vector<f32, 4> c3) → matrix<f32, [4, 4]> {
    const vector<f32, 4> e0 ← [1.0, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e1 ← [0.0, 1.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e2 ← [0.0, 0.0, 1.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e3 ← [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, 4>
    return (c0 ⊗ e0).added(c1 ⊗ e1).added(c2 ⊗ e2).added(c3 ⊗ e3)
}

fn basis_4(int index) → vector<f32, 4> {
    if index ≡ 0 then return [1.0, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    if index ≡ 1 then return [0.0, 1.0, 0.0, 0.0] ↦ vector<f32, 4>
    if index ≡ 2 then return [0.0, 0.0, 1.0, 0.0] ↦ vector<f32, 4>
    return [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, 4>
}

fn columna(matrix<f32, [4, 4]> m, int index) → vector<f32, 4> {
    return m.apply(basis_4(index))
}

fn elementum(matrix<f32, [4, 4]> m, int row, int col) → f32 {
    return columna(m, col).dot(basis_4(row))
}

fn identitas() → matrix<f32, [4, 4]> {
    const vector<f32, 4> e0 ← [1.0, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e1 ← [0.0, 1.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e2 ← [0.0, 0.0, 1.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e3 ← [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, 4>
    return ex_columnis(e0, e1, e2, e3)
}

fn translatio(vector<f32, 3> offset) → matrix<f32, [4, 4]> {
    const vector<f32, 4> e0 ← [1.0, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e1 ← [0.0, 1.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e2 ← [0.0, 0.0, 1.0, 0.0] ↦ vector<f32, 4>
    const f32 tx ← offset.dot(e0_basis3(0))
    const f32 ty ← offset.dot(e0_basis3(1))
    const f32 tz ← offset.dot(e0_basis3(2))
    const vector<f32, 4> t ← [tx, ty, tz, 1.0] ↦ vector<f32, 4>
    return ex_columnis(e0, e1, e2, t)
}

fn e0_basis3(int index) → vector<f32, 3> {
    if index ≡ 0 then return [1.0, 0.0, 0.0] ↦ vector<f32, 3>
    if index ≡ 1 then return [0.0, 1.0, 0.0] ↦ vector<f32, 3>
    return [0.0, 0.0, 1.0] ↦ vector<f32, 3>
}

fn scala_diagonals(vector<f32, 3> scale) → matrix<f32, [4, 4]> {
    const vector<f32, 4> e0 ← [1.0, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e1 ← [0.0, 1.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e2 ← [0.0, 0.0, 1.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> e3 ← [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, 4>
    const f32 sx ← scale.dot(e0_basis3(0))
    const f32 sy ← scale.dot(e0_basis3(1))
    const f32 sz ← scale.dot(e0_basis3(2))
    const vector<f32, 4> c0 ← [sx, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c1 ← [0.0, sy, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c2 ← [0.0, 0.0, sz, 0.0] ↦ vector<f32, 4>
    return ex_columnis(c0, c1, c2, e3)
}

# [F] quaternion composition: position + normalized rotation + scale into
# one affine matrix (the retired matrix4_composita shape).

class Quaternion {
    f32 x
    f32 y
    f32 z
    f32 w
}

fn composita(vector<f32, 3> position, Quaternion rotation, vector<f32, 3> scale) → matrix<f32, [4, 4]> {
    const f32 xx ← rotation.x * rotation.x
    const f32 yy ← rotation.y * rotation.y
    const f32 zz ← rotation.z * rotation.z
    const f32 xy ← rotation.x * rotation.y
    const f32 xz ← rotation.x * rotation.z
    const f32 yz ← rotation.y * rotation.z
    const f32 wx ← rotation.w * rotation.x
    const f32 wy ← rotation.w * rotation.y
    const f32 wz ← rotation.w * rotation.z
    const f32 sx ← scale.dot(e0_basis3(0))
    const f32 sy ← scale.dot(e0_basis3(1))
    const f32 sz ← scale.dot(e0_basis3(2))
    const vector<f32, 4> c0 ← [(1.0 - 2.0 * (yy + zz)) * sx, (2.0 * (xy + wz)) * sx, (2.0 * (xz - wy)) * sx, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c1 ← [(2.0 * (xy - wz)) * sy, (1.0 - 2.0 * (xx + zz)) * sy, (2.0 * (yz + wx)) * sy, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c2 ← [(2.0 * (xz + wy)) * sz, (2.0 * (yz - wx)) * sz, (1.0 - 2.0 * (xx + yy)) * sz, 0.0] ↦ vector<f32, 4>
    const f32 px ← position.dot(e0_basis3(0))
    const f32 py ← position.dot(e0_basis3(1))
    const f32 pz ← position.dot(e0_basis3(2))
    const vector<f32, 4> c3 ← [px, py, pz, 1.0] ↦ vector<f32, 4>
    return ex_columnis(c0, c1, c2, c3)
}

fn radians_ex_gradibus(f32 degrees) → f32 {
    return degrees * 0.017453292519943295
}

# [F] perspective: domain failures (fov, aspect, near/far ordering) stay
# explicit nullable checks — the lane-count guard is NOT among them.

fn perspectiva(f32 fov_y_degrees, f32 aspect, f32 near, f32 far) → matrix<f32, [4, 4]> ∪ null {
    if fov_y_degrees ≤ 0.0 or fov_y_degrees ≥ 180.0 then return null
    if aspect ≤ 0.0 then return null
    if near ≤ 0.0 or far ≤ near then return null
    const f32 half_angle ← radians_ex_gradibus(fov_y_degrees) * 0.5
    const f32 sine ← sinus_f32(half_angle)
    if sine.abs() ≤ 0.000001 then return null
    const f32 focal ← cosinus_f32(half_angle) / sine
    const f32 depth ← far / (near - far)
    const vector<f32, 4> c0 ← [focal / aspect, 0.0, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c1 ← [0.0, focal, 0.0, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c2 ← [0.0, 0.0, depth, -1.0 ∷ f32] ↦ vector<f32, 4>
    const vector<f32, 4> c3 ← [0.0, 0.0, near * depth, 0.0] ↦ vector<f32, 4>
    return ex_columnis(c0, c1, c2, c3)
}

# [F] look-at/view construction — collinear inputs return null.

fn conspectus(vector<f32, 3> eye, vector<f32, 3> target, vector<f32, 3> up) → matrix<f32, [4, 4]> ∪ null {
    const vector<f32, 3> forward ← target.subtract(eye).normalize()
    if longitudo(forward) ≤ 0.000001 then return null
    const vector<f32, 3> side ← forward.cross(up).normalize()
    if longitudo(side) ≤ 0.000001 then return null
    const vector<f32, 3> camera_up ← side.cross(forward)
    const f32 fx ← forward.dot(e0_basis3(0))
    const f32 fy ← forward.dot(e0_basis3(1))
    const f32 fz ← forward.dot(e0_basis3(2))
    const f32 sx ← side.dot(e0_basis3(0))
    const f32 sy ← side.dot(e0_basis3(1))
    const f32 sz ← side.dot(e0_basis3(2))
    const f32 ux ← camera_up.dot(e0_basis3(0))
    const f32 uy ← camera_up.dot(e0_basis3(1))
    const f32 uz ← camera_up.dot(e0_basis3(2))
    const vector<f32, 4> c0 ← [sx, ux, -fx, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c1 ← [sy, uy, -fy, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c2 ← [sz, uz, -fz, 0.0] ↦ vector<f32, 4>
    const f32 ex ← side.dot(eye)
    const f32 ey ← camera_up.dot(eye)
    const f32 ez ← forward.dot(eye)
    const vector<f32, 4> c3 ← [-ex, -ey, ez, 1.0] ↦ vector<f32, 4>
    return ex_columnis(c0, c1, c2, c3)
}

# [F] affine determinant over readable elements — no runtime lane guard.

fn determinans_affinis(matrix<f32, [4, 4]> m) → f32 {
    const f32 a00 ← elementum(m, 0, 0)
    const f32 a01 ← elementum(m, 0, 1)
    const f32 a02 ← elementum(m, 0, 2)
    const f32 a10 ← elementum(m, 1, 0)
    const f32 a11 ← elementum(m, 1, 1)
    const f32 a12 ← elementum(m, 1, 2)
    const f32 a20 ← elementum(m, 2, 0)
    const f32 a21 ← elementum(m, 2, 1)
    const f32 a22 ← elementum(m, 2, 2)
    return (a00 * (a11 * a22 - a12 * a21) - a01 * (a10 * a22 - a12 * a20)) + a02 * (a10 * a21 - a11 * a20)
}

# [F] homogeneous point application with the explicit w divide.

fn applica_punctum(matrix<f32, [4, 4]> m, vector<f32, 3> punctum) → vector<f32, 3> {
    const vector<f32, 4> e3 ← [0.0, 0.0, 0.0, 1.0] ↦ vector<f32, 4>
    const f32 px ← punctum.dot(e0_basis3(0))
    const f32 py ← punctum.dot(e0_basis3(1))
    const f32 pz ← punctum.dot(e0_basis3(2))
    const vector<f32, 4> p ← [px, py, pz, 1.0] ↦ vector<f32, 4>
    const vector<f32, 4> applied ← m.apply(p)
    const f32 w ← applied.dot(e3)
    var f32 divisor ← w
    if w.abs() ≤ 0.000001 {
        divisor ← 1.0
    }
    const vector<f32, 4> divided ← applied.multiply(uniform_4(1.0 / divisor))
    const f32 rx ← divided.dot(basis_4(0))
    const f32 ry ← divided.dot(basis_4(1))
    const f32 rz ← divided.dot(basis_4(2))
    return [rx, ry, rz] ↦ vector<f32, 3>
}

# [F] affine inverse: near-zero determinant is a domain failure (nihil),
# distinct from the retired lane-count guard.

fn inversa_affinis(matrix<f32, [4, 4]> m) → matrix<f32, [4, 4]> ∪ null {
    const f32 determinant ← determinans_affinis(m)
    if determinant.abs() ≤ 0.000001 then return null
    const f32 d ← 1.0 / determinant
    const f32 a00 ← elementum(m, 0, 0)
    const f32 a01 ← elementum(m, 0, 1)
    const f32 a02 ← elementum(m, 0, 2)
    const f32 a10 ← elementum(m, 1, 0)
    const f32 a11 ← elementum(m, 1, 1)
    const f32 a12 ← elementum(m, 1, 2)
    const f32 a20 ← elementum(m, 2, 0)
    const f32 a21 ← elementum(m, 2, 1)
    const f32 a22 ← elementum(m, 2, 2)
    const f32 tx ← elementum(m, 0, 3)
    const f32 ty ← elementum(m, 1, 3)
    const f32 tz ← elementum(m, 2, 3)
    const f32 i00 ← (a11 * a22 - a12 * a21) * d
    const f32 i01 ← (a02 * a21 - a01 * a22) * d
    const f32 i02 ← (a01 * a12 - a02 * a11) * d
    const f32 i10 ← (a12 * a20 - a10 * a22) * d
    const f32 i11 ← (a00 * a22 - a02 * a20) * d
    const f32 i12 ← (a02 * a10 - a00 * a12) * d
    const f32 i20 ← (a10 * a21 - a11 * a20) * d
    const f32 i21 ← (a01 * a20 - a00 * a21) * d
    const f32 i22 ← (a00 * a11 - a01 * a10) * d
    const vector<f32, 4> c0 ← [i00, i10, i20, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c1 ← [i01, i11, i21, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c2 ← [i02, i12, i22, 0.0] ↦ vector<f32, 4>
    const vector<f32, 4> c3 ← [-((i00 * tx + i01 * ty) + i02 * tz), -((i10 * tx + i11 * ty) + i12 * tz), -((i20 * tx + i21 * ty) + i22 * tz), 1.0] ↦ vector<f32, 4>
    return ex_columnis(c0, c1, c2, c3)
}

# [F] transpose at [4, 4]: rows of m become the constructed columns. The
# glyph `ᵀ` and a `.transpose` member do not exist on matrix at the pin
# (decision §7 N3); construction from read columns is the proven form.

fn transposita(matrix<f32, [4, 4]> m) → matrix<f32, [4, 4]> {
    const vector<f32, 4> r0 ← [elementum(m, 0, 0), elementum(m, 1, 0), elementum(m, 2, 0), elementum(m, 3, 0)] ↦ vector<f32, 4>
    const vector<f32, 4> r1 ← [elementum(m, 0, 1), elementum(m, 1, 1), elementum(m, 2, 1), elementum(m, 3, 1)] ↦ vector<f32, 4>
    const vector<f32, 4> r2 ← [elementum(m, 0, 2), elementum(m, 1, 2), elementum(m, 2, 2), elementum(m, 3, 2)] ↦ vector<f32, 4>
    const vector<f32, 4> r3 ← [elementum(m, 0, 3), elementum(m, 1, 3), elementum(m, 2, 3), elementum(m, 3, 3)] ↦ vector<f32, 4>
    return ex_columnis(r0, r1, r2, r3)
}

# [T] Retired `Matrix4.validum()` has NO runtime replacement:
# `matrix<f32, [4, 4]>` makes the 16-lane condition a type invariant — a
# non-16-lane value cannot be constructed or passed (negative/matrix-shape).
# Caller guard removals are mapped in the migration record; separate domain
# failures (perspectiva/conspectus/inversa_affinis above) are preserved.

# --- §2.4 Box<N>: generic nominal over two selected vectors ---------------

class Box<size N> {
    vector<f32, N> minima
    vector<f32, N> maxima

    # [R] receivers expressible dimension-neutrally today.
    fn mensura() → vector<f32, N> {
        return self.maxima.subtract(self.minima)
    }

    fn translata(vector<f32, N> offset) → Box<N> {
        return Box {minima = self.minima.added(offset), maxima = self.maxima.added(offset)}
    }
}

# [F] Box<3> predicate/geometry receivers (validity, containment,
# intersection, inflate, center, overlap, union) at the width that owns
# them today; the parametric Box<N> forms are the routed N2 prerequisite.

fn capsa_validum(Box<3> capsam) → bool {
    const vector<f32, 3> mensura ← capsam.mensura()
    const f32 dx ← mensura.dot(e0_basis3(0))
    const f32 dy ← mensura.dot(e0_basis3(1))
    const f32 dz ← mensura.dot(e0_basis3(2))
    return (dx ≥ 0.0 and dy ≥ 0.0) and dz ≥ 0.0
}

fn capsa_continet(Box<3> capsam, vector<f32, 3> punctum) → bool {
    const f32 px ← punctum.dot(e0_basis3(0))
    const f32 py ← punctum.dot(e0_basis3(1))
    const f32 pz ← punctum.dot(e0_basis3(2))
    const f32 minx ← capsam.minima.dot(e0_basis3(0))
    const f32 miny ← capsam.minima.dot(e0_basis3(1))
    const f32 minz ← capsam.minima.dot(e0_basis3(2))
    const f32 maxx ← capsam.maxima.dot(e0_basis3(0))
    const f32 maxy ← capsam.maxima.dot(e0_basis3(1))
    const f32 maxz ← capsam.maxima.dot(e0_basis3(2))
    return ((((px ≥ minx and px ≤ maxx) and py ≥ miny) and py ≤ maxy) and pz ≥ minz) and pz ≤ maxz
}

fn capsa_intersecat(Box<3> una, Box<3> alia) → bool {
    const f32 minx ← una.minima.dot(e0_basis3(0))
    const f32 miny ← una.minima.dot(e0_basis3(1))
    const f32 minz ← una.minima.dot(e0_basis3(2))
    const f32 maxx ← una.maxima.dot(e0_basis3(0))
    const f32 maxy ← una.maxima.dot(e0_basis3(1))
    const f32 maxz ← una.maxima.dot(e0_basis3(2))
    const f32 aminx ← alia.minima.dot(e0_basis3(0))
    const f32 aminy ← alia.minima.dot(e0_basis3(1))
    const f32 aminz ← alia.minima.dot(e0_basis3(2))
    const f32 amaxx ← alia.maxima.dot(e0_basis3(0))
    const f32 amaxy ← alia.maxima.dot(e0_basis3(1))
    const f32 amaxz ← alia.maxima.dot(e0_basis3(2))
    if maxx ≺ aminx or minx ≻ amaxx then return false
    if maxy ≺ aminy or miny ≻ amaxy then return false
    if maxz ≺ aminz or minz ≻ amaxz then return false
    return true
}

fn capsa_inflata(Box<3> capsam, f32 quantitas) → Box<3> {
    return Box {minima = capsam.minima.subtract(uniform_3(quantitas)), maxima = capsam.maxima.added(uniform_3(quantitas))}
}

fn capsa_centrum(Box<3> capsam) → vector<f32, 3> {
    const vector<f32, 3> half ← uniform_3(0.5)
    const f32 ax ← capsam.minima.dot(e0_basis3(0))
    const f32 ay ← capsam.minima.dot(e0_basis3(1))
    const f32 az ← capsam.minima.dot(e0_basis3(2))
    const f32 bx ← capsam.maxima.dot(e0_basis3(0))
    const f32 by ← capsam.maxima.dot(e0_basis3(1))
    const f32 bz ← capsam.maxima.dot(e0_basis3(2))
    const vector<f32, 3> inferior ← [ax, ay, az] ↦ vector<f32, 3>
    const vector<f32, 3> superior ← [bx, by, bz] ↦ vector<f32, 3>
    return inferior.added(superior).multiply(half)
}

fn capsa_superpositio(Box<3> una, Box<3> alia) → vector<f32, 3> ∪ null {
    if capsa_intersecat(una, alia) ≡ false then return null
    const f32 minx ← una.maxima.dot(e0_basis3(0))
    const f32 miny ← una.maxima.dot(e0_basis3(1))
    const f32 minz ← una.maxima.dot(e0_basis3(2))
    const f32 maxx ← alia.minima.dot(e0_basis3(0))
    const f32 maxy ← alia.minima.dot(e0_basis3(1))
    const f32 maxz ← alia.minima.dot(e0_basis3(2))
    return [minx - maxx, miny - maxy, minz - maxz] ↦ vector<f32, 3>
}

fn capsa_unio(Box<3> una, Box<3> alia) → Box<3> ∪ null {
    if capsa_validum(una) ≡ false or capsa_validum(alia) ≡ false then return null
    const f32 minx ← una.minima.dot(e0_basis3(0))
    const f32 miny ← una.minima.dot(e0_basis3(1))
    const f32 minz ← una.minima.dot(e0_basis3(2))
    const f32 maxx ← una.maxima.dot(e0_basis3(0))
    const f32 maxy ← una.maxima.dot(e0_basis3(1))
    const f32 maxz ← una.maxima.dot(e0_basis3(2))
    const f32 aminx ← alia.minima.dot(e0_basis3(0))
    const f32 aminy ← alia.minima.dot(e0_basis3(1))
    const f32 aminz ← alia.minima.dot(e0_basis3(2))
    const f32 amaxx ← alia.maxima.dot(e0_basis3(0))
    const f32 amaxy ← alia.maxima.dot(e0_basis3(1))
    const f32 amaxz ← alia.maxima.dot(e0_basis3(2))
    const f32 ux ← minx ⤓ aminx
    const f32 uy ← miny ⤓ aminy
    const f32 uz ← minz ⤓ aminz
    const f32 ox ← maxx ⤒ amaxx
    const f32 oy ← maxy ⤒ amaxy
    const f32 oz ← maxz ⤒ amaxz
    const vector<f32, 3> inferior ← [ux, uy, uz] ↦ vector<f32, 3>
    const vector<f32, 3> superior ← [ox, oy, oz] ↦ vector<f32, 3>
    const Box<3> united ← Box {minima = inferior, maxima = superior}
    return united
}

# [R] mutable inflate is ROUTED, not proven: field stores on applied
# generic nominals reject with incompatible_tensor_index at the pin, and
# the generic-class mutator would need the parametric uniform (N1). The
# immutable capsa_inflata above is the proven form; the runner's S0-T2 gap
# probes record the mutable-store identity (decision §7 N2).

# [F] ray interval/hit at Box<3> — the three-axis behavior the §2.4 Box<3>
# row names, over the selected carriers. Each axis contributes a slab
# [entry, exit]; the box hit is the intersection of the three slabs.

fn capsa_intersecat_radium(Box<3> capsam, vector<f32, 3> origin, vector<f32, 3> direction, f32 distantia_maxima) → f32 ∪ null {
    if capsa_validum(capsam) ≡ false then return null
    if distantia_maxima ≺ 0.0 then return null
    const f32 ∪ null x_entry ← axis_interval(origin.dot(e0_basis3(0)), direction.dot(e0_basis3(0)), capsam.minima.dot(e0_basis3(0)), capsam.maxima.dot(e0_basis3(0)))
    if x_entry is null then return null
    const f32 ∪ null y_entry ← axis_interval(origin.dot(e0_basis3(1)), direction.dot(e0_basis3(1)), capsam.minima.dot(e0_basis3(1)), capsam.maxima.dot(e0_basis3(1)))
    if y_entry is null then return null
    const f32 ∪ null z_entry ← axis_interval(origin.dot(e0_basis3(2)), direction.dot(e0_basis3(2)), capsam.minima.dot(e0_basis3(2)), capsam.maxima.dot(e0_basis3(2)))
    if z_entry is null then return null
    const f32 xe ← x_entry coalesce 0.0
    const f32 ye ← y_entry coalesce 0.0
    const f32 ze ← z_entry coalesce 0.0
    var f32 entry ← xe
    if ye ≻ entry then entry ← ye
    if ze ≻ entry then entry ← ze
    if entry ≺ 0.0 then entry ← 0.0
    if entry ≻ distantia_maxima then return null
    return entry
}
