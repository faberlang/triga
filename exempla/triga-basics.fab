+++ toml
term = "triga-basics"
kind = "concept"
category = "library"
canonical = true
summary = "Triga math and material basics."
locale = "en"

+++ faber
import from "triga:math"

import from "triga:material/base"

import from "triga:material/basic"

main {
    let vector<f32, size 3> origin ← [0.0, 0.0, 0.0] ↦ vector<f32, size 3>
    let vector<f32, size 3> offset ← [1.5, 2.5, 3.0] ↦ vector<f32, size 3>
    print origin[0]
    print offset[2]
    let matrix<f32, [4, 4]> matrix ← math.matrix_identity()

    # Material construction and validation
    let base.Material base_material ← base.material_from_name("hello-voxel")
    let _ valid_color ← math.Color {r = 1.0, g = 0.0, b = 0.5}
    let _ invalid_color ← math.Color {r = 1.1, g = 0.0, b = 0.0}

    # Material pipeline facts
    print base_material.pipeline_facts()

    # Double-sided material
    print base_material.double_sided().is_double_sided()

    # UnlitMaterial
    let _ unlit_color ← math.Color {r = 1.0, g = 0.5, b = 0.0}
    let basic.UnlitMaterial ∪ none unlit ← basic.basic_material("hello-voxel-unlit", unlit_color)
    assert unlit not is none
    print unlit.color.g

    # Invalid material handling
    let base.Material invalid ← base.material_from_name("")
}

