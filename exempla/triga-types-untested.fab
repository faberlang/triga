+++
term = "triga-types-untested"
kind = "concept"
category = "library"
canonical = true
summary = "Constructor and field-access examples for triga genus types."
syntax = "importa ex \"triga:triga\" privata triga"
+++
# exempla/triga-types-untested — instantiation and field defaults for types
# that previously had zero exempla coverage.
#
# Covers: native vector/matrix widths, Mesh, Scene, StandardMaterial,
# PhongMaterial, OrthographicCamera, Object standalone.
#
# Mesh binds Geometry (triga:geometry/data); Mesh lives in
# triga:renderable/mesh.

import from "triga:math" math

import from "triga:graph/object" object as graph_object
import from "triga:graph/camera" camera

import from "triga:geometry/data" data

import from "triga:geometry/attribute" attribute

import from "triga:geometry/batch" batch

import from "triga:renderable/mesh" mesh

import from "triga:material/base" base

import from "triga:material/standard" standard

import from "triga:material/lit" lit

main {
    # Width-2 construction
    const vector<f32, 2> vec2 ← [3.0, 4.0] ↦ vector<f32, 2>
    print vec2

    # Width-4 construction
    const vector<f32, 4> vec4 ← [1.0, 2.0, 3.0, 4.0] ↦ vector<f32, 4>
    print vec4

    # 3×3 identity via column outer products
    const vector<f32, 3> e0 ← [1.0, 0.0, 0.0] ↦ vector<f32, 3>
    const vector<f32, 3> e1 ← [0.0, 1.0, 0.0] ↦ vector<f32, 3>
    const vector<f32, 3> e2 ← [0.0, 0.0, 1.0] ↦ vector<f32, 3>
    const matrix<f32, [3, 3]> first ← e0 ⊗ e0
    const matrix<f32, [3, 3]> second ← first.added(e1 ⊗ e1)
    const matrix<f32, [3, 3]> matrix3 ← second.added(e2 ⊗ e2)

    # Object standalone
    const _ standalone ← graph_object.Object {position = [0.0, 0.0, 0.0] ↦ vector<f32, 3>, rotation = math.Euler {x = 0.0, y = 0.0, z = 0.0, order = "XYZ"}, quaternion = math.Quaternion {x = 0.0, y = 0.0, z = 0.0, w = 1.0}, scale = [1.0, 1.0, 1.0] ↦ vector<f32, 3>, matrix = math.matrix_identity(), children = empty, visible = true, name = "standalone"}
    print standalone.visible

    # Scene with background color
    const _ scene ← graph_object.Scene {base = standalone, background = math.Color {r = 0.5, g = 0.6, b = 0.7}}
    print scene.background

    # OrthographicCamera
    const _ ortho ← camera.OrthographicCamera {base = standalone, left = -10.0, right = 10.0, top = 10.0, bottom = -10.0, near = 0.1, far = 2000.0}
    print ortho.left
    print ortho.near

    # Mesh with StandardMaterial
    const _ white ← math.Color {r = 1.0, g = 1.0, b = 1.0}
    const _ emissive ← math.Color {r = 0.0, g = 0.0, b = 0.0}
    const _ pbr_material ← standard.StandardMaterial {base = base.material_from_name("pbr"), color = white, roughness = 0.5, metalness = 0.8, emissive = emissive, emissive_intensity = 0.0}

    const list<attribute.Attribute> empty_attributes ← empty
    const _ empty_range ← batch.DrawRange {start = 0, count = 0}
    const data.Geometry empty_geometry ← data.triangle_geometry(0, empty_attributes, empty_range, empty)
    const _ mesh ← mesh.Mesh {base = standalone, geometry = empty_geometry}
    print pbr_material.roughness

    # PhongMaterial
    const _ spec ← math.Color {r = 0.2, g = 0.2, b = 0.2}
    const _ phong ← lit.PhongMaterial {base = base.material_from_name("phong"), color = white, specular = spec, shininess = 60.0}
    print phong.shininess
}
