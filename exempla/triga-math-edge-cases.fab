+++
term = "triga-math-edge-cases"
kind = "concept"
category = "library"
canonical = true
summary = "Degenerate-input and edge-case examples for triga math."
+++

import from "triga:math" private math

import from "triga:graph/object" private object as graph_object

import from "triga:graph/camera" private camera

main {
    # Vector3 projecta with zero-length axis
    const math.Vector3 projected_point ← math.vector3(1.0, 2.0, 3.0)
    const math.Vector3 zero_axis ← math.vector3(0.0, 0.0, 0.0)
    const math.Vector3 projected ← projected_point.projecta(zero_axis)
    print projected.x

    # Quaternion normata with all-zero quaternion
    const math.Quaternion zero_q ← math.quaternion(0.0, 0.0, 0.0, 0.0)
    const math.Quaternion normalized_zero_q ← zero_q.normata()
    print normalized_zero_q.w

    # Vector3 normata with all-zero input
    const math.Vector3 all_zero ← math.vector3(0.0, 0.0, 0.0)
    const math.Vector3 zero_normalized ← all_zero.normata()
    print zero_normalized.x

    # Color construction with out-of-range components
    const f32 negative_value ← 0.0 - 0.1
    const math.Color bad_g ← math.Color {r = 0.5, g = negative_value, b = 0.0}
    const math.Color bad_r ← math.Color {r = negative_value, g = 0.5, b = 0.5}

    # Ray and Box3 construction
    const math.Box3 test_box ← math.Box3 {min = math.vector3(-1.0 ∷ f32, -1.0 ∷ f32, -1.0 ∷ f32), max = math.vector3(1.0, 1.0, 1.0)}
    const math.Ray ray ← math.Ray {origin = math.vector3(-3.0 ∷ f32, 0.0, 0.0), direction = math.vector3(1.0, 0.0, 0.0)}

    # PerspectiveCamera construction from an Object3D base
    const graph_object.Object3D cam_base ← graph_object.Object3D {position = math.vector3(0.0, 0.0, 5.0), rotation = math.Euler {x = 0.0, y = 0.0, z = 0.0, order = "XYZ"}, quaternion = math.Quaternion {x = 0.0, y = 0.0, z = 0.0, w = 1.0}, scale = math.vector3(1.0, 1.0, 1.0), matrix = math.matrix4_identitas(), children = vacua, visible = true, name = "cam"}
    const camera.PerspectiveCamera test_camera ← camera.PerspectiveCamera {base = cam_base, fov = 90.0, aspect = 1.0, near = 0.1, far = 100.0}
}
