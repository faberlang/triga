summary = "Degenerate-input and edge-case examples for triga math."
syntax = "importa ex \"triga:triga\" privata triga"
+++
# exempla/triga-math-edge-cases — degenerate inputs and boundary cases.

importa ex "triga:math" privata math
importa ex "triga:graph/object" privata object
importa ex "triga:graph/camera" privata camera

incipit {
    # Vector3 projecta with zero-length axis
    fixum math.Vector3 projected_point ← math.vector3(1.0, 2.0, 3.0)
    fixum math.Vector3 zero_axis ← math.vector3(0.0, 0.0, 0.0)
    fixum math.Vector3 projected ← projected_point.projecta(zero_axis)
    nota projected.x

    # Quaternion normata with all-zero quaternion
    fixum math.Quaternion zero_q ← math.quaternion(0.0, 0.0, 0.0, 0.0)
    fixum math.Quaternion normalized_zero_q ← zero_q.normata()
    nota normalized_zero_q.w

    # Vector3 normata with all-zero input
    fixum math.Vector3 all_zero ← math.vector3(0.0, 0.0, 0.0)
    fixum math.Vector3 zero_normalized ← all_zero.normata()
    nota zero_normalized.x

    # Color validation with out-of-range components
    fixum f32 negative_value ← 0.0 - 0.1
    fixum f32 over_value ← 1.0 + 0.1
    fixum math.Color bad_g ← math.Color { r = 0.5, g = negative_value, b = 0.0 }

    fixum math.Color bad_r ← math.Color { r = negative_value, g = 0.5, b = 0.5 }

    # Ray intersect box3 with negative max_distance
    fixum math.Box3 test_box ← math.Box3 { min = math.vector3(-1.0 ∷ f32, -1.0 ∷ f32, -1.0 ∷ f32), max = math.vector3(1.0, 1.0, 1.0) }
    fixum math.Ray ray ← math.Ray { origin = math.vector3(-3.0 ∷ f32, 0.0, 0.0), direction = math.vector3(1.0, 0.0, 0.0) }

    # Camera pitch coercita at boundaries

    # Camera view projection
    fixum object.Object3D cam_base ← object.Object3D { position = math.vector3(0.0, 0.0, 5.0), rotation = math.Euler { x = 0.0, y = 0.0, z = 0.0, order = "XYZ" }, quaternion = math.Quaternion { x = 0.0, y = 0.0, z = 0.0, w = 1.0 }, scale = math.vector3(1.0, 1.0, 1.0), matrix = math.matrix4_identitas(), children = vacua, visible = verum, name = "cam" }
    fixum camera.PerspectiveCamera test_camera ← camera.PerspectiveCamera { base = cam_base, fov = 90.0, aspect = 1.0, near = 0.1, far = 100.0 }
    fixum math.Vector3 cam_eye ← math.vector3(0.0, 0.0, 5.0)
    fixum math.Vector3 cam_target ← math.vector3(0.0, 0.0, 0.0)
    fixum math.Vector3 cam_up ← math.vector3(0.0, 1.0, 0.0)
}
