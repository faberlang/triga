#!/usr/bin/env python3
"""Validate the Stage 0 coverage scorecard against the committed inventory."""

from __future__ import annotations

import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[2]
SCORECARD = ROOT / "proof" / "coverage-scorecard.json"
INVENTORY = ROOT / "proof" / "inventory" / "triga-inventory.json"
DERIVER = ROOT / "proof" / "coverage" / "derive-scorecard.sh"
EXPECTED_MODULE_COUNT = 26
EXPECTED_TIERS = [
    "structural",
    "executed-proba",
    "target",
    "browser-numeric-pixel",
    "stress",
    "clean-install",
]
BASE_SCORECARD_KEYS = {
    "coverage_schema_version",
    "coverage_revision",
    "package",
    "stage0_unit",
    "inventory",
    "exempla_inventory",
    "evidence_tier_enum",
    "stale_claims",
    "modules",
}
BASE_MODULE_KEYS = {
    "path",
    "lines",
    "symbol_counts",
    "co_located_proba_refs",
    "co_located_proba",
    "exempla_coverage_refs",
    "evidence_tier",
    "stale_claims",
}
EXECUTION_KEYS = {
    "proba_path",
    "case_count",
    "command",
    "command_text",
    "exit_status",
    "passed",
    "failed",
    "blocked",
    "skipped",
    "status",
    "evidence_tier",
    "diagnostic_codes",
    "failures",
}
STAGE_KEYS = {
    "unit",
    "status",
    "complete",
    "run_at_utc",
    "module_count",
    "proba_source_count",
    "executed_module_count",
    "executed_tier",
    "package_path",
    "faber_bin",
    "faber_library_home",
    "filter_mode",
    "command_template",
    "prerequisites",
    "observed_diagnostic_codes",
    "discovery_errors",
    "failures",
}
BANNER = (
    "live coverage data superseded by `proof/coverage-scorecard.json` "
    "(2026-08-16); this section is archival"
)
STALE_WORDS = re.compile(r"61 non-facade|75 import|pre-split|future", re.IGNORECASE)
IMPORT_PATTERN = re.compile(r'import from "triga:([^"]+)"')
README_PATTERN = re.compile(r"^  ([^\s]+\.fab)[^\s]*", re.MULTILINE)
REVISION_RE = re.compile(r"[0-9a-f]{40}")
DIGEST_RE = re.compile(r"sha256:[0-9a-f]{64}")
INVENTORY_KEYS = {
    "path",
    "inventory_schema_version",
    "inventory_revision",
    "source_revision",
    "module_count",
    "observed_source_revision",
    "observed_source_digest",
    "inventory_mismatch",
}


def load(path: Path, errors: list[str], label: str) -> object | None:
    try:
        with path.open(encoding="utf-8") as source:
            return json.load(source)
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"{label}: cannot load JSON: {exc}")
        return None


def expect_keys(
    errors: list[str],
    value: object,
    expected: set[str],
    label: str,
    optional: set[str] | None = None,
) -> None:
    if not isinstance(value, dict):
        errors.append(f"{label}: expected object")
        return
    optional = optional or set()
    actual = set(value)
    missing = sorted(expected - actual)
    extra = sorted(actual - expected - optional)
    if missing:
        errors.append(f"{label}: missing fields: {', '.join(missing)}")
    if extra:
        errors.append(f"{label}: unexpected fields: {', '.join(extra)}")


def documented_exempla(errors: list[str]) -> list[str]:
    try:
        documented_names = sorted(README_PATTERN.findall((ROOT / "exempla" / "README.md").read_text(encoding="utf-8")))
    except OSError as exc:
        errors.append(f"exempla README: cannot read: {exc}")
        return []
    actual_names = sorted(path.name for path in (ROOT / "exempla").glob("*.fab"))
    if documented_names != actual_names:
        errors.append(
            "exempla README/file inventory mismatch: "
            f"documented={documented_names!r} actual={actual_names!r}"
        )
    return [f"exempla/{name}" for name in documented_names]


def imported_exempla(errors: list[str]) -> dict[str, list[str]]:
    refs: dict[str, list[str]] = {}
    for path in sorted((ROOT / "exempla").rglob("*.fab")):
        relative = path.relative_to(ROOT).as_posix()
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError as exc:
            errors.append(f"{relative}: cannot read: {exc}")
            continue
        for line in lines:
            for match in IMPORT_PATTERN.finditer(line):
                module_id = f"triga:{match.group(1)}"
                refs.setdefault(module_id, []).append(relative)
    for values in refs.values():
        values[:] = sorted(set(values))
    return refs


def walk_live_strings(value: object, path: tuple[str, ...] = ()) -> list[tuple[str, str]]:
    """Return banned strings outside the scorecard's stale-claim registry."""
    if "stale_claims" in path:
        return []
    if isinstance(value, str):
        return [(".".join(path), value)] if STALE_WORDS.search(value) else []
    if isinstance(value, list):
        result: list[tuple[str, str]] = []
        for index, item in enumerate(value):
            result.extend(walk_live_strings(item, path + (str(index),)))
        return result
    if isinstance(value, dict):
        result = []
        for key, item in value.items():
            result.extend(walk_live_strings(item, path + (key,)))
        return result
    return []


def check_archives(errors: list[str]) -> None:
    module_map = (ROOT / "docs" / "module-map.md").read_text(encoding="utf-8")
    report = (ROOT / "docs" / "factory" / "test-decomposition-report.md").read_text(encoding="utf-8")
    if module_map.count(BANNER) < 2:
        errors.append("docs/module-map.md: archive banners missing from both stale sections")
    if report.count(BANNER) < 1:
        errors.append("docs/factory/test-decomposition-report.md: archive banner missing")


def proba_shape(path: Path) -> dict[str, object]:
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    return {
        "module": "",
        "lines": len(lines),
        "groups": sum(1 for line in lines if re.match(r'^\s*describe "', line)),
        "cases": sum(1 for line in lines if re.match(r'^\s*test "', line)),
    }


def baseline_projection(value: object) -> object:
    """Drop the execution overlay before comparing a refreshed receipt to its baseline."""
    projected = json.loads(json.dumps(value))
    if not isinstance(projected, dict):
        return projected
    projected.pop("stage0_5", None)
    inventory = projected.get("inventory")
    if isinstance(inventory, dict):
        # Observed provenance is a write-time mark, not the structural census.
        inventory.pop("observed_source_revision", None)
        inventory.pop("observed_source_digest", None)
        inventory.pop("inventory_mismatch", None)
        inventory.pop("source_revision", None)
    rows = projected.get("modules")
    if isinstance(rows, list):
        for row in rows:
            if isinstance(row, dict):
                row.pop("proba_execution", None)
                # Stage 0.5 refreshes these observed fields from the proba
                # files; the derived baseline owns neither execution result.
                row.pop("co_located_proba_refs", None)
                row.pop("co_located_proba", None)
                row.pop("evidence_tier", None)
    return projected


def check_stage0_5(errors: list[str], scorecard: dict[str, object], rows: list[object]) -> None:
    """Validate the optional revision-3 execution overlay without changing its receipt."""
    if scorecard.get("coverage_revision") != 3:
        return
    stage = scorecard.get("stage0_5")
    if stage is None:
        errors.append("scorecard.stage0_5 is required for coverage revision 3")
        return
    expect_keys(errors, stage, STAGE_KEYS, "scorecard.stage0_5")
    if not isinstance(stage, dict):
        return

    if stage.get("unit") != "tgh-s05-gate":
        errors.append("scorecard.stage0_5.unit must be tgh-s05-gate")
    if stage.get("status") not in {"blocked", "complete"}:
        errors.append("scorecard.stage0_5.status must be blocked or complete")
    if not isinstance(stage.get("complete"), bool):
        errors.append("scorecard.stage0_5.complete must be boolean")
    if stage.get("module_count") != EXPECTED_MODULE_COUNT:
        errors.append("scorecard.stage0_5.module_count must remain 26")
    if stage.get("proba_source_count") != EXPECTED_MODULE_COUNT:
        errors.append("scorecard.stage0_5.proba_source_count must remain 26")
    if stage.get("executed_tier") != "executed-proba":
        errors.append("scorecard.stage0_5.executed_tier must be executed-proba")
    if not isinstance(stage.get("executed_module_count"), int) or not 0 <= stage["executed_module_count"] <= EXPECTED_MODULE_COUNT:
        errors.append("scorecard.stage0_5.executed_module_count must be between 0 and 26")
    if not isinstance(stage.get("package_path"), str) or not stage.get("package_path"):
        errors.append("scorecard.stage0_5.package_path must be a non-empty string")
    if not isinstance(stage.get("faber_bin"), str) or not stage.get("faber_bin"):
        errors.append("scorecard.stage0_5.faber_bin must be a non-empty string")
    if not isinstance(stage.get("faber_library_home"), str) or not stage.get("faber_library_home"):
        errors.append("scorecard.stage0_5.faber_library_home must be a non-empty string")
    if stage.get("filter_mode") != "package-include-per-proba":
        errors.append("scorecard.stage0_5.filter_mode is not the package proba route")
    if not isinstance(stage.get("command_template"), list) or not all(isinstance(item, str) for item in stage["command_template"]):
        errors.append("scorecard.stage0_5.command_template must be a string list")
    for key in ("prerequisites", "observed_diagnostic_codes"):
        if not isinstance(stage.get(key), dict):
            errors.append(f"scorecard.stage0_5.{key} must be an object")
    for key in ("discovery_errors", "failures"):
        if not isinstance(stage.get(key), list) or not all(isinstance(item, (str, dict)) for item in stage[key]):
            errors.append(f"scorecard.stage0_5.{key} must be a list")

    executed_count = 0
    for index, row in enumerate(rows):
        if not isinstance(row, dict):
            continue
        label = f"scorecard.modules[{index}]"
        execution = row.get("proba_execution")
        if execution is None:
            errors.append(f"{label}.proba_execution is required for coverage revision 3")
            continue
        expect_keys(errors, execution, EXECUTION_KEYS, f"{label}.proba_execution")
        if not isinstance(execution, dict):
            continue
        proba_refs = row.get("co_located_proba_refs")
        if not isinstance(proba_refs, list) or len(proba_refs) != 1:
            errors.append(f"{label}.co_located_proba_refs must contain the selected proba")
        if execution.get("proba_path") != (proba_refs or [None])[0]:
            errors.append(f"{label}.proba_execution.proba_path disagrees with co-located proba")
        proba_path = ROOT / execution["proba_path"] if isinstance(execution.get("proba_path"), str) else None
        if proba_path is None or not proba_path.is_file():
            errors.append(f"{label}.proba_execution.proba_path does not name a repository file")
        else:
            expected_shape = proba_shape(proba_path)
            expected_shape["module"] = row.get("path")
            if row.get("co_located_proba") != expected_shape:
                errors.append(f"{label}.co_located_proba does not match its proba source")
        if execution.get("evidence_tier") not in EXPECTED_TIERS:
            errors.append(f"{label}.proba_execution.evidence_tier is outside the fixed enum")
        if row.get("evidence_tier") != execution.get("evidence_tier"):
            errors.append(f"{label}.evidence_tier disagrees with proba_execution.evidence_tier")
        if execution.get("evidence_tier") == "executed-proba":
            executed_count += 1
        if not isinstance(execution.get("case_count"), int) or execution["case_count"] < 0:
            errors.append(f"{label}.proba_execution.case_count must be a non-negative integer")
        counts = [execution.get(key) for key in ("passed", "failed", "blocked", "skipped")]
        if any(value is not None and (not isinstance(value, int) or value < 0) for value in counts):
            errors.append(f"{label}.proba_execution result counts must be non-negative integers or null")
        elif all(value is not None for value in counts) and isinstance(execution.get("case_count"), int):
            if sum(counts) != execution["case_count"]:
                errors.append(f"{label}.proba_execution result counts do not sum to case_count")
        if execution.get("status") == "passed":
            if execution.get("evidence_tier") != "executed-proba" or execution.get("exit_status") != 0:
                errors.append(f"{label}.proba_execution passed status is not executed-proba evidence")
            if execution.get("passed") != execution.get("case_count") or execution.get("failed") != 0 or execution.get("blocked") != 0 or execution.get("skipped") != 0:
                errors.append(f"{label}.proba_execution passed status has inconsistent counts")
        if not isinstance(execution.get("diagnostic_codes"), dict):
            errors.append(f"{label}.proba_execution.diagnostic_codes must be an object")
        if not isinstance(execution.get("failures"), list) or not all(isinstance(item, str) for item in execution["failures"]):
            errors.append(f"{label}.proba_execution.failures must be a string list")

    if stage.get("executed_module_count") != executed_count:
        errors.append("scorecard.stage0_5.executed_module_count disagrees with module execution rows")
    complete = executed_count == EXPECTED_MODULE_COUNT and not stage.get("discovery_errors") and not stage.get("failures")
    if stage.get("complete") != complete:
        errors.append("scorecard.stage0_5.complete is inconsistent with the execution receipt")
    if stage.get("status") != ("complete" if complete else "blocked"):
        errors.append("scorecard.stage0_5.status is inconsistent with the execution receipt")


def main() -> int:
    errors: list[str] = []
    scorecard = load(SCORECARD, errors, "scorecard")
    inventory = load(INVENTORY, errors, "inventory")
    if not isinstance(scorecard, dict) or not isinstance(inventory, dict):
        return 1

    # Inventory shape and live module membership are checked below.  The
    # inventory generator is intentionally independent: Stage 0.5 receipts
    # may carry a newer proba overlay than that structural baseline.

    expect_keys(
        errors,
        scorecard,
        BASE_SCORECARD_KEYS,
        "scorecard",
        optional={"stage0_5"},
    )
    if scorecard.get("coverage_schema_version") != 1:
        errors.append("scorecard.coverage_schema_version must be 1")
    if scorecard.get("coverage_revision") != 3:
        errors.append("scorecard.coverage_revision must be 3")
    if scorecard.get("package") != "triga":
        errors.append("scorecard.package must be triga")
    if scorecard.get("stage0_unit") != "tgh-s0-3":
        errors.append("scorecard.stage0_unit must be tgh-s0-3")
    if scorecard.get("evidence_tier_enum") != EXPECTED_TIERS:
        errors.append("scorecard.evidence_tier_enum is not the fixed Stage 0 enum")

    score_inventory = scorecard.get("inventory")
    expect_keys(
        errors,
        score_inventory,
        INVENTORY_KEYS,
        "scorecard.inventory",
    )
    if isinstance(score_inventory, dict):
        for key in ("inventory_schema_version", "inventory_revision"):
            if score_inventory.get(key) != inventory.get(key):
                errors.append(f"scorecard.inventory.{key} does not match committed inventory")
        if score_inventory.get("module_count") != inventory.get("totals", {}).get("modules"):
            errors.append("scorecard.inventory.module_count does not match committed inventory")
        if score_inventory.get("path") != "proof/inventory/triga-inventory.json":
            errors.append("scorecard.inventory.path is not the committed inventory path")
        snapshot = score_inventory.get("source_revision")
        observed = score_inventory.get("observed_source_revision")
        digest = score_inventory.get("observed_source_digest")
        mismatch = score_inventory.get("inventory_mismatch")
        if not isinstance(snapshot, str) or not REVISION_RE.fullmatch(snapshot):
            errors.append("scorecard.inventory.source_revision must be a 40-character git revision")
        if not isinstance(observed, str) or not REVISION_RE.fullmatch(observed):
            errors.append(
                "scorecard.inventory.observed_source_revision must be a 40-character git revision"
            )
        if not isinstance(digest, str) or not DIGEST_RE.fullmatch(digest):
            errors.append(
                "scorecard.inventory.observed_source_digest must be a sha256:<hex> digest"
            )
        if not isinstance(mismatch, bool):
            errors.append("scorecard.inventory.inventory_mismatch must be boolean")
        elif isinstance(snapshot, str) and isinstance(observed, str):
            if mismatch != (snapshot != observed):
                errors.append(
                    "scorecard.inventory.inventory_mismatch disagrees with observed vs snapshot revision"
                )
            if snapshot != inventory.get("source_revision") and mismatch is not True:
                errors.append(
                    "scorecard.inventory.source_revision differs from committed inventory "
                    "without inventory_mismatch=true"
                )

    documented = documented_exempla(errors)
    exemplar_section = scorecard.get("exempla_inventory")
    expect_keys(
        errors,
        exemplar_section,
        {"readme", "checker", "documented_files"},
        "scorecard.exempla_inventory",
    )
    if isinstance(exemplar_section, dict):
        if exemplar_section.get("readme") != "exempla/README.md":
            errors.append("scorecard.exempla_inventory.readme is incorrect")
        if exemplar_section.get("checker") != "scripta/check-exempla-inventory":
            errors.append("scorecard.exempla_inventory.checker is incorrect")
        if exemplar_section.get("documented_files") != documented:
            errors.append("scorecard.exempla_inventory.documented_files is stale")

    stale_claims = scorecard.get("stale_claims")
    stale_ids: list[str] = []
    if not isinstance(stale_claims, list) or not stale_claims:
        errors.append("scorecard.stale_claims must be a non-empty list")
    else:
        for index, claim in enumerate(stale_claims):
            label = f"scorecard.stale_claims[{index}]"
            expect_keys(errors, claim, {"id", "claim", "stale_source", "replacement"}, label)
            if not isinstance(claim, dict):
                continue
            claim_id = claim.get("id")
            if not isinstance(claim_id, str) or not claim_id:
                errors.append(f"{label}.id must be a non-empty string")
            elif claim_id in stale_ids:
                errors.append(f"{label}.id is duplicated: {claim_id}")
            else:
                stale_ids.append(claim_id)
            stale_source = claim.get("stale_source")
            if not isinstance(stale_source, str):
                errors.append(f"{label}.stale_source must be a string")
            else:
                source_path = stale_source.split("#", 1)[0]
                if not (ROOT / source_path).is_file():
                    errors.append(f"{label}.stale_source does not name a repository file: {stale_source}")
            if not isinstance(claim.get("replacement"), str) or "proof/coverage-scorecard.json" not in claim.get("replacement", ""):
                errors.append(f"{label}.replacement must point at the live scorecard")

    inventory_modules = inventory.get("modules")
    if not isinstance(inventory_modules, list):
        errors.append("inventory.modules must be a list")
        inventory_modules = []
    inventory_by_path = {
        record.get("path"): record
        for record in inventory_modules
        if isinstance(record, dict) and isinstance(record.get("path"), str)
    }
    if len(inventory_by_path) != EXPECTED_MODULE_COUNT:
        errors.append(f"committed inventory module count is {len(inventory_by_path)}, expected {EXPECTED_MODULE_COUNT}")
    live_paths = sorted(str(path.relative_to(ROOT)) for path in (ROOT / "src").rglob("*.fab"))
    if sorted(inventory_by_path) != live_paths:
        errors.append("committed inventory module set does not equal live src/**/*.fab")

    rows = scorecard.get("modules")
    if not isinstance(rows, list):
        errors.append("scorecard.modules must be a list")
        rows = []
    if len(rows) != EXPECTED_MODULE_COUNT:
        errors.append(f"scorecard module row count is {len(rows)}, expected {EXPECTED_MODULE_COUNT}")

    all_exempla = sorted(
        path.relative_to(ROOT).as_posix() for path in (ROOT / "exempla").rglob("*.fab")
    )
    imported = imported_exempla(errors)
    consumer_map = inventory.get("consumer_import_map", {})
    seen: set[str] = set()
    expected_symbol_counts = {
        "classes": "classes",
        "unions": "unions",
        "functions_total": "functions_total",
        "functions_underscore_private": "functions_underscore_private",
        "functions_public": "functions_public",
    }
    for index, row in enumerate(rows):
        label = f"scorecard.modules[{index}]"
        expect_keys(
            errors,
            row,
            BASE_MODULE_KEYS,
            label,
            optional={"proba_execution"},
        )
        if not isinstance(row, dict):
            continue
        path = row.get("path")
        if not isinstance(path, str):
            errors.append(f"{label}.path must be a string")
            continue
        if path in seen:
            errors.append(f"{label}.path is duplicated: {path}")
        seen.add(path)
        record = inventory_by_path.get(path)
        if record is None:
            errors.append(f"{label}.path is absent from committed inventory: {path}")
            continue
        if row.get("lines") != record.get("lines"):
            errors.append(f"{label}.lines does not match committed inventory")
        symbol_counts = row.get("symbol_counts")
        expect_keys(
            errors,
            symbol_counts,
            set(expected_symbol_counts) | {"total", "public"},
            f"{label}.symbol_counts",
        )
        if isinstance(symbol_counts, dict):
            for score_key, inventory_key in expected_symbol_counts.items():
                if symbol_counts.get(score_key) != record.get(inventory_key):
                    errors.append(f"{label}.symbol_counts.{score_key} does not match committed inventory")
            if symbol_counts.get("total") != record.get("classes", 0) + record.get("unions", 0) + record.get("functions_total", 0):
                errors.append(f"{label}.symbol_counts.total is inconsistent")
            if symbol_counts.get("public") != record.get("classes", 0) + record.get("unions", 0) + record.get("functions_public", 0):
                errors.append(f"{label}.symbol_counts.public is inconsistent")

        proba = record.get("co_located_proba")
        expected_proba_refs = [proba] if isinstance(proba, str) else []
        if "proba_execution" not in row:
            if row.get("co_located_proba_refs") != expected_proba_refs:
                errors.append(f"{label}.co_located_proba_refs does not match committed inventory")
            expected_proba = inventory.get("co_located_tests", {}).get(proba) if isinstance(proba, str) else None
            if row.get("co_located_proba") != expected_proba:
                errors.append(f"{label}.co_located_proba does not match committed inventory")

        module_id = f"triga:{path[len('src/'):-len('.fab')]}" if path.startswith("src/") and path.endswith(".fab") else ""
        expected_refs = sorted(set(imported.get(module_id, [])))
        inventory_refs = sorted(set(consumer_map.get(module_id, {}).get("consumers", []))) if isinstance(consumer_map, dict) else []
        if expected_refs != inventory_refs:
            errors.append(f"{module_id}: exempla imports disagree with committed inventory consumer map")
        if row.get("exempla_coverage_refs") != expected_refs:
            errors.append(f"{label}.exempla_coverage_refs is stale")
        for ref in row.get("exempla_coverage_refs", []) if isinstance(row.get("exempla_coverage_refs"), list) else []:
            if ref not in all_exempla or not (ROOT / ref).is_file():
                errors.append(f"{label}.exempla_coverage_refs names a nonexistent exemplum file: {ref}")

        if row.get("evidence_tier") not in EXPECTED_TIERS:
            errors.append(f"{label}.evidence_tier is outside the fixed enum")
        if "proba_execution" not in row and row.get("evidence_tier") != record.get("evidence_tier"):
            errors.append(f"{label}.evidence_tier does not match committed inventory")
        if row.get("stale_claims") != stale_ids:
            errors.append(f"{label}.stale_claims must reference every scorecard stale claim")

    if sorted(seen) != sorted(inventory_by_path):
        errors.append("scorecard module row set does not equal committed inventory module set")

    check_stage0_5(errors, scorecard, rows)

    for path, value in walk_live_strings(scorecard):
        errors.append(f"scorecard live field {path} contains stale/future language: {value!r}")

    check_archives(errors)

    with tempfile.TemporaryDirectory(prefix="triga-scorecard-check-") as work:
        derived = Path(work) / "coverage-scorecard.json"
        result = subprocess.run(
            [str(DERIVER), str(derived)],
            cwd=ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            errors.append(f"derive-scorecard.sh failed: {result.stderr.strip() or result.stdout.strip()}")
        else:
            try:
                derived_value = json.loads(derived.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                errors.append(f"derived scorecard: cannot load JSON: {exc}")
            else:
                if not isinstance(derived_value, dict) or derived_value.get("coverage_revision") != scorecard.get("coverage_revision"):
                    errors.append("derived scorecard does not share coverage revision 3")
                elif baseline_projection(derived_value) != baseline_projection(scorecard):
                    errors.append("committed scorecard differs from a fresh derived baseline")

    if errors:
        for message in errors:
            print(f"error: {message}", file=sys.stderr)
        return 1

    print(f"scorecard ok: {EXPECTED_MODULE_COUNT} live modules; no stale live claims")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
