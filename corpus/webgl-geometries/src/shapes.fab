# Primitive showcase for the triga corpus — recreation reference:
# three.js `webgl_geometries`. One mesh per triga:primitives generator,
# arranged on a static grid with per-mesh material colors.
#
# The primitives generate position/normal/uv BufferGeometry; the host
# pipeline consumes interleaved pos3+normal3+color3, so colors are applied
# here per vertex and grid offsets are baked into positions.

import from "triga:geometry/data" private data

import from "triga:geometry/attribute" private attribute

import from "triga:primitives/basic" private basic

class CorpusMesh {
    string name
    int vertex_count
    int index_count
    list<f32> vertex_payload
    list<int<u32>> index_payload
}

@ private { }
fn _float_values(ref attribute.BufferAttribute attr) → list<f32> ∪ null {
    return attr.float32_values()
}

@ private { }
fn _mesh_ex_geometry(string name, ref data.BufferGeometry geom, f32 ox, f32 oy, f32 oz, f32 r, f32 g, f32 b) → CorpusMesh ∪ null {
    if geom.attributes.longitudo() ≺ 2 then return null
    const list<f32> ∪ null pos_opt ← _float_values(geom.attributes[0])
    const list<f32> ∪ null nrm_opt ← _float_values(geom.attributes[1])
    if pos_opt is null or nrm_opt is null then return null
    const list<f32> pos ← pos_opt
    const list<f32> nrm ← nrm_opt
    if pos.longitudo() ≠ geom.vertex_count * 3 then return null
    if nrm.longitudo() ≠ geom.vertex_count * 3 then return null
    var list<f32> payload ← vacua
    var int v ← 0
    while v ≺ geom.vertex_count {
        payload.appende(pos[v * 3] + ox)
        payload.appende(pos[v * 3 + 1] + oy)
        payload.appende(pos[v * 3 + 2] + oz)
        payload.appende(nrm[v * 3])
        payload.appende(nrm[v * 3 + 1])
        payload.appende(nrm[v * 3 + 2])
        payload.appende(r)
        payload.appende(g)
        payload.appende(b)
        v ← v + 1
    }
    return CorpusMesh {name = name, vertex_count = geom.vertex_count, index_count = geom.indices.longitudo(), vertex_payload = payload, index_payload = geom.indices}
}

@ private { }
fn _add_mesh(list<CorpusMesh> meshes, string name, data.BufferGeometry ∪ null geom_opt, f32 ox, f32 oy, f32 oz, f32 r, f32 g, f32 b) → list<CorpusMesh> {
    if geom_opt is null then return meshes
    const CorpusMesh ∪ null mesh_opt ← _mesh_ex_geometry(name, geom_opt, ox, oy, oz, r, g, b)
    if mesh_opt is null then return meshes
    const CorpusMesh mesh ← mesh_opt
    if mesh.vertex_count ≡ 0 then return meshes
    meshes.appende(mesh)
    return meshes
}

# Grid layout mirroring the three.js geometries page: 4 columns × 2 rows.
fn geometry_showcase_meshes() → list<CorpusMesh> {
    var list<CorpusMesh> meshes ← vacua

    # Back row (z = -1.8).
    meshes ← _add_mesh(meshes, "plane", basic.plane_geometry(2.2, 2.2), -4.8 ∷ f32, 0.0, -1.8 ∷ f32, 0.9, 0.55, 0.45)
    meshes ← _add_mesh(meshes, "box", basic.box_geometry(1.5, 1.5, 1.5), -1.6 ∷ f32, 0.0, -1.8 ∷ f32, 0.45, 0.7, 0.9)
    meshes ← _add_mesh(meshes, "circle", basic.circle_geometry(1.1), 1.6, 0.0, -1.8 ∷ f32, 0.55, 0.85, 0.55)
    meshes ← _add_mesh(meshes, "sphere", basic.sphere_geometry(1.1), 4.8, 0.0, -1.8 ∷ f32, 0.9, 0.75, 0.4)

    # Front row (z = +1.8).
    meshes ← _add_mesh(meshes, "cylinder", basic.cylinder_geometry(0.85, 1.8), -4.8 ∷ f32, 0.0, 1.8, 0.75, 0.55, 0.9)
    meshes ← _add_mesh(meshes, "cone", basic.cone_geometry(1.0, 1.8), -1.6 ∷ f32, 0.0, 1.8, 0.45, 0.85, 0.8)
    meshes ← _add_mesh(meshes, "torus", basic.torus_geometry(0.95, 0.35), 1.6, 0.0, 1.8, 0.9, 0.5, 0.65)
    meshes ← _add_mesh(meshes, "slab", basic.box_geometry(1.9, 0.6, 1.1), 4.8, 0.0, 1.8, 0.65, 0.65, 0.7)
    return meshes
}
