+++
locale = "en"
+++
import from "triga:math" private math

import from "triga:graph/object" private object as graph_object

import from "triga:graph/camera" private camera

class CameraInput {
    bool yaw_left = false
    bool yaw_right = false
    bool pitch_up = false
    bool pitch_down = false
    bool dolly_in = false
    bool dolly_out = false
    bool pan_left = false
    bool pan_right = false
    bool pan_forward = false
    bool pan_back = false
}

class OrbitCamera {
    math.Vector3 target
    f32 yaw_degrees
    f32 pitch_degrees
    f32 distance
    CameraInput input
}

fn spawn_camera() → OrbitCamera {
    return OrbitCamera {target = math.vector3(0.0, 0.0, 0.0), yaw_degrees = -30.0 ∷ f32, pitch_degrees = -20.0 ∷ f32, distance = 15.0, input = CameraInput {}}
}

fn _clamp_distance(f32 distance) → f32 {
    if distance ≺ 5.0 then return 5.0
    if distance ≻ 40.0 then return 40.0
    return distance
}

fn _clamp_delta(f32 delta_seconds) → f32 {
    if delta_seconds ≺ 0.0 then return 0.0
    if delta_seconds ≻ 0.05 then return 0.05
    return delta_seconds
}

fn _input_axis(bool negative, bool positive) → f32 {
    if negative and positive then return 0.0
    if negative then return 0.0 - 1.0
    if positive then return 1.0
    return 0.0
}

fn set_key_by_code(ref CameraInput input, string code, bool pressed) → CameraInput {
    var CameraInput next ← CameraInput {yaw_left = input.yaw_left, yaw_right = input.yaw_right, pitch_up = input.pitch_up, pitch_down = input.pitch_down, dolly_in = input.dolly_in, dolly_out = input.dolly_out, pan_left = input.pan_left, pan_right = input.pan_right, pan_forward = input.pan_forward, pan_back = input.pan_back}
    if code ≡ "ArrowLeft" {
        next ← CameraInput {yaw_left = pressed, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "ArrowRight" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = pressed, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "ArrowUp" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = pressed, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "ArrowDown" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = pressed, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "KeyW" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = pressed, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "KeyS" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = pressed, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "KeyA" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = pressed, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "KeyD" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = pressed, pan_forward = next.pan_forward, pan_back = next.pan_back}
    }
    if code ≡ "KeyQ" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = pressed, pan_back = next.pan_back}
    }
    if code ≡ "KeyE" {
        next ← CameraInput {yaw_left = next.yaw_left, yaw_right = next.yaw_right, pitch_up = next.pitch_up, pitch_down = next.pitch_down, dolly_in = next.dolly_in, dolly_out = next.dolly_out, pan_left = next.pan_left, pan_right = next.pan_right, pan_forward = next.pan_forward, pan_back = pressed}
    }
    return next
}

fn step_camera(ref OrbitCamera camera, f32 delta_seconds) → OrbitCamera {
    const f32 safe_delta ← _clamp_delta(delta_seconds)
    const f32 yaw_axis ← _input_axis(camera.input.yaw_left, camera.input.yaw_right)
    const f32 pitch_axis ← _input_axis(camera.input.pitch_down, camera.input.pitch_up)
    const f32 dolly_axis ← _input_axis(camera.input.dolly_in, camera.input.dolly_out)
    const f32 pan_right_axis ← _input_axis(camera.input.pan_left, camera.input.pan_right)
    const f32 pan_forward_axis ← _input_axis(camera.input.pan_back, camera.input.pan_forward)
    const f32 next_yaw ← camera.yaw_degrees + (yaw_axis * 55.0) * safe_delta
    const f32 next_pitch ← math.camera_pitch_coercita(camera.pitch_degrees + (pitch_axis * 38.0) * safe_delta)
    const f32 next_distance ← _clamp_distance(camera.distance + (dolly_axis * 14.0) * safe_delta)
    const math.Vector3 pan ← math.camera_motus_planus_ex_yaw(next_yaw, pan_forward_axis, pan_right_axis, 6.0, safe_delta)
    return OrbitCamera {target = camera.target.addita(pan), yaw_degrees = next_yaw, pitch_degrees = next_pitch, distance = next_distance, input = camera.input}
}

fn view_projection(ref OrbitCamera cam, f32 aspect) → math.Matrix4 ∪ null {
    const math.Vector3 direction ← math.camera_directio_ex_yaw_pitch(cam.yaw_degrees, cam.pitch_degrees)
    const math.Vector3 eye ← cam.target.subtracta(direction.multiplicata(cam.distance))
    const camera.PerspectiveCamera perspective ← camera.PerspectiveCamera {base = graph_object.Object3D {position = math.vector3(0.0, 0.0, 0.0), rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = math.vector3(1.0, 1.0, 1.0), matrix = math.matrix4_identitas(), children = vacua, visible = true, name = "corpus-orbit"}, fov = 45.0, aspect = aspect, near = 0.1, far = 200.0}
    return perspective.visus_projectio(eye, cam.target, math.vector3(0.0, 1.0, 0.0))
}

fn transform_payload(ref OrbitCamera cam, f32 aspect) → math.TransformPayload ∪ null {
    const math.Matrix4 ∪ null view_projection_result ← view_projection(cam, aspect)
    if view_projection_result is null then return null
    const math.Matrix4 view_projection_matrix ← math.Matrix4 {elements = view_projection_result!.elements}
    return math.transform_payload(math.matrix4_identitas(), view_projection_matrix)
}
