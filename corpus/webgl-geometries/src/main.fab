+++
locale = "la"
+++
importa ex "tela:web" web
importa ex "tela:dom" dom
importa ex "./camera_controls" camera_controls
importa ex "./scene" scene
importa ex "./shapes" shapes
importa ex "triga:math" math

functio floats_textus(de lista<f32> values) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < values.length() {
        si i ≡ 0 {
            output ↤ values[i]
        }
        secus {
            output ← "§ §"(output, values[i] ↦ textus)
        }
        i ← i + 1
    }
    redde output
}

functio indices_textus(de lista<u32> values) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < values.length() {
        si i ≡ 0 {
            output ↤ values[i]
        }
        secus {
            output ← "§ §"(output, values[i] ↦ textus)
        }
        i ← i + 1
    }
    redde output
}

functio object_geometry_textus(de shapes.CorpusMesh obj) → textus {
    redde "§;§;§;§;§;§"(obj.name, "static", obj.vertex_count ↦ textus, obj.index_count ↦ textus, floats_textus(obj.vertex_payload), indices_textus(obj.index_payload))
}

functio scene_geometry_blob(de scene.CorpusGeometryManifest manifest) → textus {
    varia textus output ← ""
    varia numerus i ← 0
    dum i < manifest.objects.length() {
        fixum textus piece ← object_geometry_textus((manifest.objects)[i])
        si i ≡ 0 {
            output ← piece
        }
        secus {
            output ← "§|§"(output, piece)
        }
        i ← i + 1
    }
    redde output
}

functio publish_scene_geometry(dom.Element facts_element) → vacuum {
    fixum scene.CorpusGeometryManifest manifest ← scene.corpus_scene_geometry()
    dom.attr_set(facts_element, "data-scene-geometry", scene_geometry_blob(manifest))
    dom.attr_set(facts_element, "data-scene-object-count", manifest.objects.length() ↦ textus)
}

functio publish_transform(dom.Element facts_element, de camera_controls.OrbitCamera orbit, f32 aspect) → vacuum {
    fixum math.TransformPayload ∪ nihil payload_result ← camera_controls.transform_payload(orbit, aspect)
    si payload_result est nihil {
        dom.attr_set(facts_element, "data-transform-status", "invalid")
        redde
    }
    dom.attr_set(facts_element, "data-transform-status", "ready")
    dom.attr_set(facts_element, "data-transform-payload", floats_textus(payload_result!.values))
    dom.attr_set(facts_element, "data-camera-yaw", orbit.yaw_degrees ↦ textus)
    dom.attr_set(facts_element, "data-camera-pitch", orbit.pitch_degrees ↦ textus)
    dom.attr_set(facts_element, "data-camera-distance", orbit.distance ↦ textus)
}

@ WebController { selector = "#triga-corpus-geometries" }
functio corpus_geometries_controller(dom.Scope scope) → lista<dom.Subscription> {
    fixum dom.Element status ← dom.require(scope, ".corpus-status")
    fixum dom.Element facts ← dom.require(scope, ".triga-facts")
    varia camera_controls.OrbitCamera orbit ← camera_controls.spawn_camera()
    fixum f32 canvas_aspect ← 960.0 / 540.0

    dom.attr_set(facts, "data-scene-name", "triga-corpus-webgl-geometries")
    dom.attr_set(facts, "data-render-status", "awaiting-host")
    dom.attr_set(facts, "data-render-gate", "pending-host-init")
    dom.attr_set(facts, "data-device-status", "unknown")
    dom.text_set(status, "scene-ready")

    publish_scene_geometry(facts)
    publish_transform(facts, orbit, canvas_aspect)

    fixum dom.Subscription frame_sub ← dom.on_frame((dom.FrameState frame) → vacuum ∴ fac {
        fixum f32 delta_seconds ← frame.delta_ms / 1000.0
        orbit ← camera_controls.step_camera(orbit, delta_seconds)
        publish_transform(facts, orbit, canvas_aspect)
        dom.attr_set(facts, "data-frame", frame.frame ↦ textus)
    })

    fixum dom.Subscription keydown_sub ← dom.on_keyboard(facts, "keydown", (dom.KeyboardState key) → vacuum ∴ fac {
        orbit ← camera_controls.OrbitCamera { target = orbit.target, yaw_degrees = orbit.yaw_degrees, pitch_degrees = orbit.pitch_degrees, distance = orbit.distance, input = camera_controls.set_key_by_code(orbit.input, key.code, verum) }
        publish_transform(facts, orbit, canvas_aspect)
    })

    fixum dom.Subscription keyup_sub ← dom.on_keyboard(facts, "keyup", (dom.KeyboardState key) → vacuum ∴ fac {
        orbit ← camera_controls.OrbitCamera { target = orbit.target, yaw_degrees = orbit.yaw_degrees, pitch_degrees = orbit.pitch_degrees, distance = orbit.distance, input = camera_controls.set_key_by_code(orbit.input, key.code, falsum) }
        publish_transform(facts, orbit, canvas_aspect)
    })

    fixum dom.Subscription resize_sub ← dom.on_resize((dom.ResizeState resize) → vacuum ∴ fac {
        nota resize
        publish_transform(facts, orbit, canvas_aspect)
    })

    redde [frame_sub, keydown_sub, keyup_sub, resize_sub]
}
