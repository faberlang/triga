+++
locale = "en"
+++
# Procedural heightfield terrain for the triga corpus — recreation reference:
# three.js `webgl_geometry_terrain`. One generated grid mesh with per-vertex
# normals and elevation-ramp colors, plus a flat water plane in the valleys.
#
# Deterministic value noise (integer lattice hash + smoothstep interpolation,
# three octaves). Normals come from central differences of the same height
# function, so lighting follows the land.

import from "triga:math" private math

class TerrainMesh {
    string name
    int vertex_count
    int index_count
    list<f32> vertex_payload
    list<int<u32>> index_payload
}

const int GRID_SEGMENTS ← 48

const f32 GRID_EXTENT ← 80.0

const f32 HEIGHT_BASE ← 5.2

const f32 HEIGHT_RANGE ← 10.5

const f32 WATER_LEVEL ← 0.0 - 1.3

# --- Deterministic value noise --------------------------------------------

@ private { }
fn _lattice_hash(int ix, int iy) → f32 {
    const int h ← (((ix * 7349 + iy * 15683) + (ix * iy) * 7919) + 104729) % 4096
    return (h ↦ f32) / 4096.0
}

@ private { }
fn _smoothstep(f32 t) → f32 {
    return (t * t) * (3.0 - 2.0 * t)
}

@ private { }
fn _value_noise(f32 x, f32 y) → f32 {
    const int ix ← x ↦ int
    const int iy ← y ↦ int
    const f32 sx ← _smoothstep(x - (ix ↦ f32))
    const f32 sy ← _smoothstep(y - (iy ↦ f32))
    const f32 v00 ← _lattice_hash(ix, iy)
    const f32 v10 ← _lattice_hash(ix + 1, iy)
    const f32 v01 ← _lattice_hash(ix, iy + 1)
    const f32 v11 ← _lattice_hash(ix + 1, iy + 1)
    const f32 top ← v00 + (v10 - v00) * sx
    const f32 bottom ← v01 + (v11 - v01) * sx
    return top + (bottom - top) * sy
}

# Height above/below the waterline. +400 keeps lattice coordinates positive
# so f32 → numerus truncation behaves like floor.
fn terrain_height(f32 wx, f32 wz) → f32 {
    const f32 sx ← wx + 400.0
    const f32 sz ← wz + 400.0
    const f32 n1 ← _value_noise(sx * 0.055, sz * 0.055)
    const f32 n2 ← _value_noise(sx * 0.11, sz * 0.11)
    const f32 n3 ← _value_noise(sx * 0.22, sz * 0.22)
    return ((n1 * 6.0 + n2 * 3.0) + n3 * 1.5) - HEIGHT_BASE
}

# --- Local f32 helpers (triga:math keeps these private) --------------------

@ private { }
fn _radix_f32(f32 value) → f32 {
    if value ≤ 0.0 then return 0.0
    var f32 scaled ← value
    var f32 scale ← 1.0
    while scaled ≻ 4.0 {
        scaled ← scaled * 0.25
        scale ← scale * 2.0
    }
    while scaled ≺ 0.25 {
        scaled ← scaled * 4.0
        scale ← scale * 0.5
    }
    var f32 estimate ← 1.0
    var int iteration ← 0
    while iteration ≺ 8 {
        estimate ← (estimate + scaled / estimate) * 0.5
        iteration ← iteration + 1
    }
    return estimate * scale
}

@ private { }
fn _clamp01(f32 value) → f32 {
    if value ≺ 0.0 then return 0.0
    if value ≻ 1.0 then return 1.0
    return value
}

# --- Elevation color ramp ---------------------------------------------------

@ private { }
fn _elevation_color(f32 height) → math.Color {
    const f32 t ← _clamp01((height + HEIGHT_BASE) / HEIGHT_RANGE)
    const math.Color sand ← math.Color {r = 0.76, g = 0.7, b = 0.5}
    const math.Color grass ← math.Color {r = 0.29, g = 0.49, b = 0.25}
    const math.Color rock ← math.Color {r = 0.45, g = 0.42, b = 0.4}
    const math.Color snow ← math.Color {r = 0.9, g = 0.92, b = 0.95}
    if t ≺ 0.35 then return math.color_interpolata(sand, grass, t / 0.35)
    if t ≺ 0.7 then return math.color_interpolata(grass, rock, (t - 0.35) / 0.35)
    return math.color_interpolata(rock, snow, (t - 0.7) / 0.3)
}

# --- Mesh generation --------------------------------------------------------

@ private { }
fn _terrain_mesh() → TerrainMesh {
    const int verts_per_row ← GRID_SEGMENTS + 1
    const f32 cell ← GRID_EXTENT / (GRID_SEGMENTS ↦ f32)
    const f32 half ← GRID_EXTENT * 0.5
    var list<f32> payload ← vacua
    var int gz ← 0
    while gz ≺ verts_per_row {
        const f32 wz ← (0.0 - half) + (gz ↦ f32) * cell
        var int gx ← 0
        while gx ≺ verts_per_row {
            const f32 wx ← (0.0 - half) + (gx ↦ f32) * cell
            const f32 wy ← terrain_height(wx, wz)

            # Central-difference normal of the height function.
            const f32 hl ← terrain_height(wx - cell, wz)
            const f32 hr ← terrain_height(wx + cell, wz)
            const f32 hd ← terrain_height(wx, wz - cell)
            const f32 hu ← terrain_height(wx, wz + cell)
            const f32 nx ← hl - hr
            const f32 ny ← 2.0 * cell
            const f32 nz ← hd - hu
            const f32 nlen ← _radix_f32((nx * nx + ny * ny) + nz * nz)
            const math.Color color ← _elevation_color(wy)
            payload.append(wx)
            payload.append(wy)
            payload.append(wz)
            payload.append(nx / nlen)
            payload.append(ny / nlen)
            payload.append(nz / nlen)
            payload.append(color.r)
            payload.append(color.g)
            payload.append(color.b)
            gx ← gx + 1
        }
        gz ← gz + 1
    }
    var list<int<u32>> indices ← vacua
    var int cz ← 0
    while cz ≺ GRID_SEGMENTS {
        var int cx ← 0
        while cx ≺ GRID_SEGMENTS {
            const int<u32> a ← cz * verts_per_row + cx ↦ int<u32>
            const int<u32> b ← (cz * verts_per_row + cx) + 1 ↦ int<u32>
            const int<u32> c ← (cz + 1) * verts_per_row + cx ↦ int<u32>
            const int<u32> d ← ((cz + 1) * verts_per_row + cx) + 1 ↦ int<u32>
            indices.append(a)
            indices.append(c)
            indices.append(b)
            indices.append(b)
            indices.append(c)
            indices.append(d)
            cx ← cx + 1
        }
        cz ← cz + 1
    }
    return TerrainMesh {name = "terrain", vertex_count = verts_per_row * verts_per_row, index_count = indices.length(), vertex_payload = payload, index_payload = indices}
}

@ private { }
fn _water_mesh() → TerrainMesh {
    const f32 half ← GRID_EXTENT * 0.5
    const f32 level ← WATER_LEVEL
    var list<f32> payload ← vacua

    # Four corners, normal up, deep-water blue.
    const list<f32> corners ← [0.0 - half, level, 0.0 - half, half, level, 0.0 - half, half, level, half, 0.0 - half, level, half]
    var int v ← 0
    while v ≺ 4 {
        payload.append(corners[v * 3])
        payload.append(corners[v * 3 + 1])
        payload.append(corners[v * 3 + 2])
        payload.append(0.0)
        payload.append(1.0)
        payload.append(0.0)
        payload.append(0.2)
        payload.append(0.45)
        payload.append(0.6)
        v ← v + 1
    }
    return TerrainMesh {name = "water", vertex_count = 4, index_count = 6, vertex_payload = payload, index_payload = [0, 2, 1, 0, 3, 2]}
}

fn terrain_meshes() → list<TerrainMesh> {
    var list<TerrainMesh> meshes ← vacua
    meshes.append(_terrain_mesh())
    meshes.append(_water_mesh())
    return meshes
}
