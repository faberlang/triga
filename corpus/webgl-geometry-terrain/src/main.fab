import from "tela:web" web
import from "tela:dom" dom
import from "./camera_controls" camera_controls
import from "./scene" scene
import from "./terrain" terrain
import from "triga:math" math

fn floats_textus(ref list<f32> values) → string {
    mut string output ← ""
    mut int i ← 0
    while i ≺ values.length() {
        if i ≡ 0 {
            output ↤ values[i]
        }
        else {
            output ← "§ §"(output, values[i] ↦ string)
        }
        i ← i + 1
    }
    return output
}

fn indices_textus(ref list<u32> values) → string {
    mut string output ← ""
    mut int i ← 0
    while i ≺ values.length() {
        if i ≡ 0 {
            output ↤ values[i]
        }
        else {
            output ← "§ §"(output, values[i] ↦ string)
        }
        i ← i + 1
    }
    return output
}

fn object_geometry_textus(ref terrain.TerrainMesh obj) → string {
    return "§;§;§;§;§;§"(obj.name, "static", obj.vertex_count ↦ string, obj.index_count ↦ string, floats_textus(obj.vertex_payload), indices_textus(obj.index_payload))
}

fn scene_geometry_blob(ref scene.CorpusGeometryManifest manifest) → string {
    mut string output ← ""
    mut int i ← 0
    while i ≺ manifest.objects.length() {
        let string piece ← object_geometry_textus((manifest.objects)[i])
        if i ≡ 0 {
            output ← piece
        }
        else {
            output ← "§|§"(output, piece)
        }
        i ← i + 1
    }
    return output
}

fn publish_scene_geometry(dom.Element facts_element) → void {
    let scene.CorpusGeometryManifest manifest ← scene.corpus_scene_geometry()
    dom.attr_set(facts_element, "data-scene-geometry", scene_geometry_blob(manifest))
    dom.attr_set(facts_element, "data-scene-object-count", manifest.objects.length() ↦ string)
}

fn publish_transform(dom.Element facts_element, ref camera_controls.OrbitCamera orbit, f32 aspect) → void {
    let math.TransformPayload ∪ none payload_result ← camera_controls.transform_payload(orbit, aspect)
    if payload_result is none {
        dom.attr_set(facts_element, "data-transform-status", "invalid")
        return
    }
    dom.attr_set(facts_element, "data-transform-status", "ready")
    dom.attr_set(facts_element, "data-transform-payload", floats_textus(payload_result!.values))
    dom.attr_set(facts_element, "data-camera-yaw", orbit.yaw_degrees ↦ string)
    dom.attr_set(facts_element, "data-camera-pitch", orbit.pitch_degrees ↦ string)
    dom.attr_set(facts_element, "data-camera-distance", orbit.distance ↦ string)
}

@ WebController { selector = "#triga-corpus-terrain" }
fn corpus_terrain_controller(dom.Scope scope) → list<dom.Subscription> {
    let dom.Element status ← dom.require(scope, ".corpus-status")
    let dom.Element facts ← dom.require(scope, ".triga-facts")
    mut camera_controls.OrbitCamera orbit ← camera_controls.spawn_camera()
    let f32 canvas_aspect ← 960.0 / 540.0

    dom.attr_set(facts, "data-scene-name", "triga-corpus-webgl-geometry-terrain")
    dom.attr_set(facts, "data-render-status", "awaiting-host")
    dom.attr_set(facts, "data-render-gate", "pending-host-init")
    dom.attr_set(facts, "data-device-status", "unknown")
    dom.text_set(status, "scene-ready")

    publish_scene_geometry(facts)
    publish_transform(facts, orbit, canvas_aspect)

    let dom.Subscription frame_sub ← dom.on_frame((dom.FrameState frame) → void ∴ do {
        let f32 delta_seconds ← frame.delta_ms / 1000.0
        orbit ← camera_controls.step_camera(orbit, delta_seconds)
        publish_transform(facts, orbit, canvas_aspect)
        dom.attr_set(facts, "data-frame", frame.frame ↦ string)
    })

    let dom.Subscription keydown_sub ← dom.on_keyboard(facts, "keydown", (dom.KeyboardState key) → void ∴ do {
        orbit ← camera_controls.OrbitCamera { target = orbit.target, yaw_degrees = orbit.yaw_degrees, pitch_degrees = orbit.pitch_degrees, distance = orbit.distance, input = camera_controls.set_key_by_code(orbit.input, key.code, true) }
        publish_transform(facts, orbit, canvas_aspect)
    })

    let dom.Subscription keyup_sub ← dom.on_keyboard(facts, "keyup", (dom.KeyboardState key) → void ∴ do {
        orbit ← camera_controls.OrbitCamera { target = orbit.target, yaw_degrees = orbit.yaw_degrees, pitch_degrees = orbit.pitch_degrees, distance = orbit.distance, input = camera_controls.set_key_by_code(orbit.input, key.code, false) }
        publish_transform(facts, orbit, canvas_aspect)
    })

    let dom.Subscription resize_sub ← dom.on_resize((dom.ResizeState resize) → void ∴ do {
        print resize
        publish_transform(facts, orbit, canvas_aspect)
    })

    return [frame_sub, keydown_sub, keyup_sub, resize_sub]
}
