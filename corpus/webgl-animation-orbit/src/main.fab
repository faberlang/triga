+++
locale = "en"
+++
import from "web:web" private web
import from "web:dom" private dom
import from "triga:geometry/data" private data
import from "triga:geometry/attribute" private attribute
import from "triga:math" private math
import from "triga:primitives/basic" private basic

class AnimatedMesh {
    string name
    int vertex_count
    int index_count
    list<f32> vertex_payload
    list<int<u32>> index_payload
}

fn floats_textus(de list<f32> values) → string {
    var string output ← ""
    var int i ← 0
    while i < values.longitudo() {
        if i ≡ 0 {
            output ← values[i] ↦ string
        }
        else {
            output ← "§ §"(output, values[i] ↦ string)
        }
        i ← i + 1
    }
    return output
}

fn indices_textus(de list<int<u32>> values) → string {
    var string output ← ""
    var int i ← 0
    while i < values.longitudo() {
        if i ≡ 0 {
            output ← values[i] ↦ string
        }
        else {
            output ← "§ §"(output, values[i] ↦ string)
        }
        i ← i + 1
    }
    return output
}

fn _float_values(de attribute.BufferAttribute attr) → list<f32> ∪ null {
    return attr.float32_values()
}

fn _mesh_ex_geometry(string name, de data.BufferGeometry geom, f32 ox, f32 oy, f32 oz, f32 r, f32 g, f32 b) → AnimatedMesh ∪ null {
    if geom.attributes.longitudo() ≺ 2 then return null
    const list<f32> ∪ null pos_opt ← _float_values(geom.attributes[0])
    const list<f32> ∪ null nrm_opt ← _float_values(geom.attributes[1])
    if pos_opt is null or nrm_opt is null then return null
    const list<f32> pos ← pos_opt
    const list<f32> nrm ← nrm_opt
    if pos.longitudo() ≠ geom.vertex_count * 3 then return null
    if nrm.longitudo() ≠ geom.vertex_count * 3 then return null
    var list<f32> payload ← vacua
    var int v ← 0
    while v < geom.vertex_count {
        payload.appende(pos[v * 3] + ox)
        payload.appende(pos[v * 3 + 1] + oy)
        payload.appende(pos[v * 3 + 2] + oz)
        payload.appende(nrm[v * 3])
        payload.appende(nrm[v * 3 + 1])
        payload.appende(nrm[v * 3 + 2])
        payload.appende(r)
        payload.appende(g)
        payload.appende(b)
        v ← v + 1
    }
    return AnimatedMesh {name = name, vertex_count = geom.vertex_count, index_count = geom.indices.longitudo(), vertex_payload = payload, index_payload = geom.indices}
}

fn _add_mesh(list<AnimatedMesh> meshes, string name, data.BufferGeometry ∪ null geom_opt, f32 ox, f32 oy, f32 oz, f32 r, f32 g, f32 b) → list<AnimatedMesh> {
    if geom_opt is null then return meshes
    const data.BufferGeometry geom ← geom_opt
    const AnimatedMesh ∪ null mesh_opt ← _mesh_ex_geometry(name, geom, ox, oy, oz, r, g, b)
    if mesh_opt is null then return meshes
    meshes.appende(mesh_opt)
    return meshes
}

fn scene_meshes() → list<AnimatedMesh> {
    var list<AnimatedMesh> meshes ← vacua
    meshes ← _add_mesh(meshes, "orbital-box", basic.box_geometry(1.8, 1.8, 1.8), -2.8 ∷ f32, 0.0, 0.0, 0.92, 0.46, 0.28)
    meshes ← _add_mesh(meshes, "orbital-torus", basic.torus_geometry(1.25, 0.34), 0.0, 0.0, 0.0, 0.28, 0.78, 0.92)
    meshes ← _add_mesh(meshes, "orbital-sphere", basic.sphere_geometry(1.25), 2.8 ∷ f32, 0.0, 0.0, 0.9, 0.82, 0.28)
    return meshes
}

fn scene_geometry_blob(de list<AnimatedMesh> meshes) → string {
    var string output ← ""
    var int i ← 0
    while i < meshes.longitudo() {
        const AnimatedMesh mesh ← meshes[i]
        const string piece ← "§;§;§;§;§;§"(mesh.name, "static", mesh.vertex_count ↦ string, mesh.index_count ↦ string, floats_textus(mesh.vertex_payload), indices_textus(mesh.index_payload))
        if i ≡ 0 {
            output ← piece
        }
        else {
            output ← "§|§"(output, piece)
        }
        i ← i + 1
    }
    return output
}

fn model_matrix(f32 elapsed_seconds) → math.Matrix4 {
    const math.Euler rotation ← math.euler(elapsed_seconds * 0.55, elapsed_seconds * 0.9, 0.0)
    const math.Quaternion ∪ null quaternion_result ← rotation.ad_quaternionem()
    if quaternion_result is null then return math.matrix4_identitas()
    const math.Quaternion quaternion ← math.Quaternion {x = quaternion_result!.x, y = quaternion_result!.y, z = quaternion_result!.z, w = quaternion_result!.w}
    return math.matrix4_composita(math.vector3(0.0, 0.0, 0.0), quaternion, math.vector3(1.0, 1.0, 1.0))
}

fn view_projection(f32 camera_yaw_degrees, f32 aspect) → math.Matrix4 ∪ null {
    const math.Vector3 target ← math.vector3(0.0, 0.0, 0.0)
    const math.Vector3 direction ← math.camera_directio_ex_yaw_pitch(camera_yaw_degrees, -22.0)
    const math.Vector3 eye ← target.subtracta(direction.multiplicata(13.0))
    const math.Matrix4 ∪ null projection_result ← math.matrix4_perspectiva(45.0, aspect, 0.1, 200.0)
    if projection_result is null then return null
    const math.Matrix4 ∪ null view_result ← math.matrix4_conspectus(eye, target, math.vector3(0.0, 1.0, 0.0))
    if view_result is null then return null
    const math.Matrix4 projection ← math.Matrix4 {elements = projection_result!.elements}
    const math.Matrix4 view ← math.Matrix4 {elements = view_result!.elements}
    return projection.multiplicata(view)
}

fn transform_payload(f32 elapsed_seconds, f32 aspect) → math.TransformPayload ∪ null {
    const math.Matrix4 ∪ null view_projection_result ← view_projection(-35.0 + elapsed_seconds * 10.0, aspect)
    if view_projection_result is null then return null
    const math.Matrix4 view_projection_matrix ← math.Matrix4 {elements = view_projection_result!.elements}
    const math.Matrix4 model ← model_matrix(elapsed_seconds)
    return math.transform_payload(model, view_projection_matrix)
}

@ WebController { selector = "#triga-corpus-animation-orbit" }
fn corpus_animation_orbit_controller(dom.Scope scope) → list<dom.Subscription> {
    const dom.Element status ← dom.require(scope, ".corpus-status")
    const dom.Element facts ← dom.require(scope, ".triga-facts")
    const list<AnimatedMesh> meshes ← scene_meshes()
    var f32 elapsed_seconds ← 0.0
    const f32 canvas_aspect ← 960.0 / 540.0

    dom.attr_set(facts, "data-scene-name", "triga-corpus-webgl-animation-orbit")
    dom.attr_set(facts, "data-render-status", "awaiting-host")
    dom.attr_set(facts, "data-render-gate", "pending-host-init")
    dom.attr_set(facts, "data-device-status", "unknown")
    dom.attr_set(facts, "data-scene-geometry", scene_geometry_blob(meshes))
    dom.text_set(status, "animation-ready")

    const math.TransformPayload ∪ null initial_payload ← transform_payload(elapsed_seconds, canvas_aspect)
    if initial_payload is null {
        dom.attr_set(facts, "data-transform-status", "invalid")
    }
    else {
        dom.attr_set(facts, "data-transform-payload", floats_textus(initial_payload!.values))
    }

    const dom.Subscription frame_sub ← dom.on_frame((dom.FrameState frame) → void ∴ fac {
        const f32 delta_seconds ← frame.delta_ms / 1000.0
        elapsed_seconds ← elapsed_seconds + delta_seconds
        const math.TransformPayload ∪ null payload ← transform_payload(elapsed_seconds, canvas_aspect)
        if payload is null {
            dom.attr_set(facts, "data-transform-status", "invalid")
        }
        else {
            dom.attr_set(facts, "data-transform-payload", floats_textus(payload!.values))
        }
        dom.attr_set(facts, "data-frame", frame.frame ↦ string)
        dom.attr_set(facts, "data-animation-seconds", elapsed_seconds ↦ string)
    })

    return [frame_sub]
}
