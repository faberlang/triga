+++
locale = "en"
+++

# Presenter fixture: SceneStore (two boxes) + DirectionalLight + PhongMaterial.
# Module consts are the single source for record fields and the @fragment body
# (authored GPU bodies cannot yet read arbitrary storage by name; `.power` is
# not WGSL-emittable — specular uses diffuse⁴ as a stand-in for shininess).

import from "triga:geometry/data" data

import from "triga:primitives/basic" basic

import from "triga:math" math

import from "triga:graph/object" graph_object

import from "triga:graph/camera" camera

import from "triga:lighting/light" lighting

import from "triga:material/base" material_base

import from "triga:material/lit" lit

import from "triga:scene" scene

import from "triga:resource" resource

import from "triga:shader" shader

# Light: position (2,4,1), target (0,0,-1) → toward-light normalize(2,4,2).
const f32 LIGHT_DX = 0.4082
const f32 LIGHT_DY = 0.8165
const f32 LIGHT_DZ = 0.4082
const f32 LIGHT_INTENSITY = 1.0
const f32 LIGHT_R = 1.0
const f32 LIGHT_G = 0.98
const f32 LIGHT_B = 0.92

# PhongMaterial fields — deliberately loud so the browser oracle is obvious
# against the red/yellow albedo (strong cyan tint + hot white specular).
const f32 MAT_R = 0.15
const f32 MAT_G = 1.0
const f32 MAT_B = 1.0
const f32 SPEC_R = 1.0
const f32 SPEC_G = 1.0
const f32 SPEC_B = 1.0
const f32 MAT_SHININESS = 32.0

@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "varying"
fn varying_matches(string source_name, int shader_location, int format_code, int interpolation_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "fragment_output"
fn fragment_output_matches(int location, int format_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "pipeline"
fn pipeline_matches(int color_target_format_code, int depth_compare_code, int depth_write_enabled_code, int primitive_topology_code, int vertex_count) → bool {
    return true
}

@ shader_contract "resource_binding"
fn resource_binding_matches(int group, int binding, int kind_code, int role_code, int access_code, int element_count, int layout_code, string source_name, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "bound_resource_binding"
fn bound_matches(int group, int binding, string source_name) → bool {
    return true
}

@ vertex { }
fn presenter_vertex() → void {
}

@ fragment { }
fn presenter_fragment(shader.Texture2D albedo, shader.Sampler albedo_sampler) → void {
    const vector<f32, 3> light_direction ↤ [LIGHT_DX, LIGHT_DY, LIGHT_DZ]
    const f32 ndotl ← (normal · light_direction).maximum(0.0)
    const f32 lighting_term ← 0.12 + 0.88 * ndotl * LIGHT_INTENSITY
    const vector<f32, 4> sampled ← shader.sample(albedo, albedo_sampler, uv)
    const vector<f32, 4> tint ↤ [MAT_R * LIGHT_R, MAT_G * LIGHT_G, MAT_B * LIGHT_B, 1.0]
    const vector<f32, 4> lighting_vec ↤ [lighting_term, lighting_term, lighting_term, 1.0]
    const vector<f32, 4> diffuse_lit ← sampled ⊙ tint ⊙ lighting_vec
    # diffuse² stand-in until `.power` emits to WGSL (shininess stays on the record).
    # Kept wide so lit faces show a clear white hotspot.
    const f32 spec ← ndotl * ndotl
    const vector<f32, 4> spec_term ↤ [SPEC_R * spec, SPEC_G * spec, SPEC_B * spec, 0.0]
    out_color ← diffuse_lit + spec_term
}

fn presenter_camera_object() → graph_object.Object {
    return graph_object.Object {position = [0.0, 1.8, 4.2] ↦ vector<f32, 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, 3>, matrix = math.matrix_identity(), children = empty, visible = true, name = "presenter-camera"}
}

fn presenter_light_object() → graph_object.Object {
    return graph_object.Object {position = [2.0, 4.0, 1.0] ↦ vector<f32, 3>, rotation = math.euler(0.0, 0.0, 0.0), quaternion = math.quaternion(0.0, 0.0, 0.0, 1.0), scale = [1.0, 1.0, 1.0] ↦ vector<f32, 3>, matrix = math.matrix_identity(), children = empty, visible = true, name = "presenter-sun"}
}

main {
    const data.Geometry ∪ none box_result ← basic.box(1.0, 1.0, 1.0)
    assert box_result not is none panic "presenter requires valid Triga box"

    const resource.ResourceHandle geom ← resource.ResourceHandle {index = 0, generation = 0}
    const resource.ResourceHandle mat ← resource.ResourceHandle {index = 0, generation = 0}

    var scene.SceneStore store ← scene.scene_store()
    const scene.SceneHandle root ← store.insert(scene.scene_group("root"))
    const scene.SceneHandle left ← store.insert(scene.scene_mesh("left", geom, mat))
    const scene.SceneHandle right ← store.insert(scene.scene_mesh("right", geom, mat))
    assert store.attach(left, root) panic "attach left"
    assert store.attach(right, root) panic "attach right"
    assert store.set_local_matrix(left, math.matrix_translation([-1.25, 0.0, 0.0] ↦ vector<f32, 3>)) panic "left translate"
    assert store.set_local_matrix(right, math.matrix_translation([1.25, 0.0, 0.0] ↦ vector<f32, 3>)) panic "right translate"
    assert store.refresh_world(root) panic "refresh world"

    const camera.PerspectiveCamera cam ← camera.PerspectiveCamera {base = presenter_camera_object(), fov = 42.0, aspect = 1.0, near = 0.1, far = 40.0}
    const matrix<f32, [4, 4]> ∪ none view_proj_opt ← cam.view_projection([0.0, 1.8, 4.2] ↦ vector<f32, 3>, [0.0, 0.0, 0.0] ↦ vector<f32, 3>, [0.0, 1.0, 0.0] ↦ vector<f32, 3>)
    assert view_proj_opt not is none panic "presenter camera must form a view-projection"
    const matrix<f32, [4, 4]> view_proj ← view_proj_opt

    const scene.VisibleMeshes ∪ none visible_opt ← scene.visible_meshes(store, root, view_proj)
    assert visible_opt not is none panic "visible_meshes"
    const scene.VisibleMeshes visible ← visible_opt
    assert visible.handles.length() ≡ 2 panic "two visible meshes"
    assert visible.payloads.length() ≡ 2 panic "two transform payloads"
    assert visible.payloads[0].values.length() ≡ 32 panic "left TransformPayload"
    assert visible.payloads[1].values.length() ≡ 32 panic "right TransformPayload"

    const math.Color light_color ← math.Color {r = LIGHT_R, g = LIGHT_G, b = LIGHT_B}
    const lighting.DirectionalLight sun ← lighting.DirectionalLight {base = lighting.Light {base = presenter_light_object(), color = light_color, intensity = LIGHT_INTENSITY}, target_position = [0.0, 0.0, -1.0] ↦ vector<f32, 3>}
    assert sun.base.base.name ≡ "presenter-sun" panic "sun object"
    assert sun.base.color.r ≡ LIGHT_R panic "sun color"

    const math.Color phong_color ← math.Color {r = MAT_R, g = MAT_G, b = MAT_B}
    const math.Color phong_specular ← math.Color {r = SPEC_R, g = SPEC_G, b = SPEC_B}
    const lit.PhongMaterial phong ← lit.PhongMaterial {base = material_base.material_from_name("phong"), color = phong_color, specular = phong_specular, shininess = MAT_SHININESS}
    assert phong.color.r ≡ MAT_R panic "phong color"
    assert phong.specular.g ≡ SPEC_G panic "phong specular"
    assert phong.shininess ≡ MAT_SHININESS panic "phong shininess"

    assert vertex_layout_matches(0, 0, "position", 0, 3, 0, 12, 1, 1) panic "position input layout"
    assert vertex_layout_matches(0, 1, "normal", 1, 3, 0, 12, 1, 4) panic "normal input layout"
    assert vertex_layout_matches(0, 2, "uv", 2, 2, 0, 8, 1, 4) panic "uv input layout"
    assert varying_matches("normal", 0, 3, 1, 4) panic "normal varying"
    assert varying_matches("uv", 1, 2, 1, 4) panic "uv varying"
    assert fragment_output_matches(0, 4, 2) panic "fragment color output"
    assert pipeline_matches(1, 1, 1, 1, 36) panic "shared box pipeline"
    assert resource_binding_matches(0, 0, 1, 1, 1, 32, 1, "transform", 3) panic "transform resource"
    assert bound_matches(1, 0, "albedo") panic "albedo texture"
    assert bound_matches(1, 1, "albedo_sampler") panic "albedo sampler"
}
